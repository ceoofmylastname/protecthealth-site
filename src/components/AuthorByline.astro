---
// E-E-A-T byline. Two modes:
//   mode="author"   → "Written by" — used on the 22 blog pillars.
//   mode="reviewer" → "Reviewed by" — used on the 88 Q&A pages and the FAQ.
//
// The distinction is deliberate and it is a truthfulness decision, not a design
// one. A named licensed broker as AUTHOR is publicly standing behind the words.
// On the Q&A and FAQ layer the accurate claim is that a licensed broker checked
// the answer, so the byline says exactly that and the schema uses reviewedBy.
//
// The Person JSON-LD is emitted by the PAGE (via personSchema in site.ts), not
// here — one Person node per page, referenced by @id from BlogPosting/QAPage.
// This component is the visible half only. Do not add a second JSON-LD block.
import { authorPhoto, type Author } from '../lib/site';

// `date` is optional and currently unused by both callers: the blog template
// prints Published/Updated in its own meta line, and the reviewer mode must not
// assert a review date we have no record of. Kept in the interface so a page
// that genuinely has a review date can pass one without a component rewrite.
interface Props {
  author: Author;
  mode?: 'author' | 'reviewer';
  date?: string;
}
const { author, mode = 'author', date } = Astro.props;
const label = mode === 'author' ? 'Written by' : 'Reviewed by';
const photo = authorPhoto(author);
---
<aside class={`byline byline-${mode}`}>
  <a class="by-photo" href={`/team-members/${author.slug}`} aria-hidden="true" tabindex="-1">
    <img
      src={photo}
      alt={`${author.name}, ${author.role} at ProtectHealth`}
      width="72"
      height="72"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="by-text">
    <p class="by-label">{label}</p>
    <p class="by-name">
      <a href={`/team-members/${author.slug}`}>{author.name}</a>
      <span class="by-role">{author.role}</span>
    </p>
    <p class="by-cred">{author.credential}</p>
    <p class="by-bio">{author.short}</p>
    {/* Author mode only, and it prints datePublished — never dateModified.
        Reviewer mode prints NO date on purpose: we have no record of when the
        review actually happened, and "Answer reviewed <publish date>" would be
        asserting an event that may not have occurred on that day. The real
        dates live in the JSON-LD, which is what Google reads. */}
    {date && mode === 'author' && <p class="by-date">Published {date}</p>}
  </div>
</aside>

<style>
  /* Mobile-first: stacks under 520px, side-by-side above. */
  .byline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: 26px 0;
    padding: 20px 22px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }
  .byline-author { border-left: 5px solid var(--accent); }
  .byline-reviewer { border-left: 5px solid var(--gold); }

  .by-photo {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
    background: #cfe2f8;
  }
  .by-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .by-text p { margin: 0; }
  .by-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .by-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--navy);
    margin-top: 3px !important;
  }
  /* 44px hit area without moving the text, per the touch-target rule. */
  .by-name a {
    color: var(--navy);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .by-name a:hover { color: var(--blue); text-decoration: underline; }
  .by-role {
    display: block;
    font-family: var(--font);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: -6px;
  }
  .by-cred {
    font-size: 0.84rem;
    color: var(--muted);
    margin-top: 6px !important;
  }
  .by-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink);
    margin-top: 9px !important;
  }
  .by-date {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 9px !important;
  }

  @media (min-width: 520px) {
    .byline { grid-template-columns: 72px 1fr; gap: 18px; align-items: start; }
  }
</style>
