---
// Native booking widget for broker landing + calendar pages. Talks to the
// ph-book edge function: loads open slots for this agent, lets the visitor pick
// a day (horizontal strip) then a time (wrapped pills), enter details, and book
// it. The booking creates a contact in that agent's CRM, their pipeline deal,
// and a ph_appointments row on that agent's calendar. No GoHighLevel.
//
// Layout is intentionally compact and horizontal so it doesn't run the page
// down a tall column. Styling is one cohesive blue system (no rainbow). A
// successful booking fires a confetti burst.
interface Props {
  agentId: string;
  agentName: string;
  lines?: string[];
  variant?: 'card' | 'page';
}
const { agentId, agentName, lines = [], variant = 'card' } = Astro.props;
const first = (agentName || '').trim().split(/\s+/)[0] || 'us';
const FN_URL = 'https://hrzonmnswzwridwqbspb.supabase.co/functions/v1';
const ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
---
<div class:list={['sched', variant === 'page' && 'sched-full']} data-agent={agentId} id="sched">
  <canvas class="sched-confetti" aria-hidden="true"></canvas>
  <div class="sched-card">
    <div class="sched-head">
      <div class="sched-title">Book time with {first}</div>
      <div class="sched-sub">Times shown in Las Vegas time. Pick a day, then a time.</div>
    </div>
    <div class="sched-status">Loading available times…</div>

    <div class="sched-cal" hidden>
      <div class="sched-daywrap">
        <div class="sched-days"></div>
      </div>
      <div class="sched-times"></div>
    </div>

    <form class="sched-form" hidden>
      <div class="sched-chosen"></div>
      <div class="sched-row">
        <label>Your name<input name="name" required autocomplete="name" /></label>
      </div>
      <div class="sched-row two">
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Phone<input name="phone" inputmode="tel" autocomplete="tel" /></label>
      </div>
      {lines.length > 0 && (
        <div class="sched-row">
          <label>What's this about?
            <select name="line">
              <option value="">Not sure yet</option>
              {lines.map((l) => <option value={l}>{l}</option>)}
            </select>
          </label>
        </div>
      )}
      <div class="sched-row">
        <label>Anything we should know? (optional)<textarea name="notes" rows="2"></textarea></label>
      </div>
      <div class="sched-actions">
        <button type="submit" class="sched-btn">Confirm booking</button>
        <button type="button" class="sched-back">← Pick another time</button>
      </div>
    </form>

    <div class="sched-done" hidden></div>
    <p class="sched-err" role="alert"></p>
  </div>
</div>

<script is:inline define:vars={{ agentId, FN_URL, ANON, agentFirst: first }}>
  (function () {
    const root = document.getElementById('sched');
    if (!root) return;
    const FN = FN_URL + '/ph-book';
    const $ = (s) => root.querySelector(s);
    const statusEl = $('.sched-status'), cal = $('.sched-cal'), daysEl = $('.sched-days'),
      timesEl = $('.sched-times'), form = $('.sched-form'), doneEl = $('.sched-done'), errEl = $('.sched-err'),
      canvas = $('.sched-confetti');
    let data = null, selDay = null, chosen = null;

    async function call(body) {
      const r = await fetch(FN, { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + ANON }, body: JSON.stringify(body) });
      return { ok: r.ok, data: await r.json().catch(() => ({})) };
    }
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    function dayLabel(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      const dt = new Date(Date.UTC(y, m - 1, d, 12));
      return {
        wd: dt.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' }),
        mo: dt.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }),
        dnum: String(d),
        full: dt.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' }),
      };
    }

    async function load() {
      const { ok, data: d } = await call({ action: 'slots', agent_id: agentId });
      if (!ok || !d || !Array.isArray(d.days) || !d.days.length) {
        statusEl.textContent = 'No open times online right now — call or email using the buttons above and we’ll get you set.';
        return;
      }
      data = d; selDay = d.days[0].date;
      statusEl.hidden = true; cal.hidden = false;
      renderDays(); renderTimes();
    }
    function renderDays() {
      daysEl.innerHTML = data.days.map((day) => {
        const l = dayLabel(day.date);
        return `<button type="button" class="sched-day${day.date === selDay ? ' on' : ''}" data-date="${day.date}"><span class="dwd">${l.wd}</span><b class="dnum">${l.dnum}</b><span class="dmo">${l.mo}</span></button>`;
      }).join('');
      daysEl.querySelectorAll('.sched-day').forEach((b) => b.addEventListener('click', () => { selDay = b.dataset.date; renderDays(); renderTimes(); }));
    }
    function renderTimes() {
      const day = data.days.find((x) => x.date === selDay);
      timesEl.innerHTML = (day ? day.slots : []).map((s) => `<button type="button" class="sched-time" data-iso="${s.start_at}" data-label="${esc(s.label)}">${esc(s.label)}</button>`).join('');
      timesEl.querySelectorAll('.sched-time').forEach((b) => b.addEventListener('click', () => {
        const l = dayLabel(selDay);
        chosen = { iso: b.dataset.iso, label: b.dataset.label, day: l.full };
        showForm();
      }));
    }
    function showForm() {
      cal.hidden = true; form.hidden = false; errEl.textContent = '';
      form.querySelector('.sched-chosen').innerHTML = `<b>${esc(chosen.day)} at ${esc(chosen.label)}</b> — 30 minutes with ${esc(agentFirst)}`;
    }
    $('.sched-back').addEventListener('click', () => { form.hidden = true; cal.hidden = false; });

    // Lightweight self-contained confetti burst (no dependency).
    function confetti() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = root.getBoundingClientRect();
      canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
      canvas.style.width = rect.width + 'px'; canvas.style.height = rect.height + 'px';
      const ctx = canvas.getContext('2d'); ctx.scale(dpr, dpr);
      const W = rect.width, H = rect.height;
      const colors = ['#2563c9', '#6366f1', '#22d3ee', '#f5b301', '#0ea472', '#ffffff'];
      const N = 130, parts = [];
      for (let i = 0; i < N; i++) {
        parts.push({
          x: W / 2 + (Math.random() - 0.5) * 60, y: H * 0.34,
          vx: (Math.random() - 0.5) * 9, vy: Math.random() * -11 - 4,
          g: 0.32 + Math.random() * 0.12, w: 6 + Math.random() * 6, h: 4 + Math.random() * 5,
          rot: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.4,
          c: colors[(Math.random() * colors.length) | 0], life: 0,
        });
      }
      let raf; const start = performance.now();
      (function frame(t) {
        const elapsed = t - start;
        ctx.clearRect(0, 0, W, H);
        parts.forEach((p) => {
          p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.vx *= 0.99;
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
          ctx.globalAlpha = Math.max(0, 1 - elapsed / 2200);
          ctx.fillStyle = p.c; ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (elapsed < 2200) raf = requestAnimationFrame(frame);
        else ctx.clearRect(0, 0, W, H);
      })(start);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.textContent = '';
      const btn = form.querySelector('.sched-btn'); btn.disabled = true; btn.textContent = 'Booking…';
      const body = {
        action: 'book', agent_id: agentId, start_at: chosen.iso,
        name: form.name.value.trim(), email: form.email.value.trim(), phone: form.phone.value.trim(),
        line: form.line ? form.line.value : '', notes: form.notes.value.trim(),
      };
      const { ok, data: res } = await call(body);
      btn.disabled = false; btn.textContent = 'Confirm booking';
      if (!ok || !res.ok) {
        errEl.textContent = res.error || 'Something went wrong. Please try another time.';
        if (res.error && /taken|available/i.test(res.error)) { form.hidden = true; cal.hidden = false; load(); }
        return;
      }
      form.hidden = true; cal.hidden = true;
      doneEl.hidden = false;
      doneEl.innerHTML = `<div class="sched-check">✓</div><h3>You're booked</h3><p><b>${esc(res.when)}</b> with ${esc(res.agent)}.</p><p>A confirmation is on its way to your email.</p>`;
      confetti();
    });

    load();
  })();
</script>

<style is:global>
  /* Global (not scoped) because the day + time pills are built at runtime via
     innerHTML — Astro's scoped data-attribute never lands on them, so scoped
     rules would silently skip them. Everything is namespaced under .sched. */
  .sched { --navy:#0b2a4a; --blue:#2563c9; --blueDk:#1d4ed8; --muted:#5b6b7c; --edge:#e6edf6; --bg:#f6f9fe;
    position:relative; isolation:isolate; }
  .sched-confetti { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:5; }
  .sched-card { position:relative; z-index:1; border-radius:22px; padding:26px;
    background:#fff; border:1px solid var(--edge);
    box-shadow:0 22px 50px rgba(11,42,74,.12), 0 2px 6px rgba(11,42,74,.05); }
  /* one restrained blue glow, top-right — cohesive, not multi-color */
  .sched-card::before { content:''; position:absolute; z-index:-1; top:-24px; right:-24px; width:180px; height:180px;
    border-radius:50%; background:radial-gradient(circle, rgba(37,99,201,.14), transparent 70%); filter:blur(6px); }
  .sched-full .sched-card { padding:28px; }

  .sched-head { margin-bottom:18px; }
  .sched-title { font-weight:800; font-size:1.3rem; letter-spacing:-.4px; line-height:1.15; color:var(--navy); }
  .sched-sub { color:var(--muted); font-size:.88rem; margin-top:4px; }
  .sched-status { color:var(--muted); padding:16px 0; }

  /* Horizontal day strip */
  .sched-daywrap { position:relative; }
  .sched-days { display:flex; gap:9px; overflow-x:auto; padding:2px 2px 12px; scrollbar-width:thin; scroll-snap-type:x proximity; }
  .sched-days::-webkit-scrollbar { height:6px; }
  .sched-days::-webkit-scrollbar-thumb { background:#cdd9ea; border-radius:6px; }
  /* Modern date cards: weekday / big number / month, stacked */
  .sched-day { flex:0 0 auto; scroll-snap-align:start; display:flex; flex-direction:column; align-items:center; gap:1px; white-space:nowrap;
    padding:11px 15px 10px; border:1px solid var(--edge); border-radius:16px; background:#fff; cursor:pointer; min-width:62px;
    box-shadow:0 2px 8px rgba(11,42,74,.05); transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease, background .16s ease; }
  .sched-day:hover { transform:translateY(-3px); border-color:#bcd0ee; box-shadow:0 12px 24px rgba(37,99,201,.16); }
  .sched-day .dwd { font-size:.6rem; font-weight:800; letter-spacing:.9px; text-transform:uppercase; color:#8493a6; }
  .sched-day .dnum { font-size:1.24rem; font-weight:800; color:var(--navy); line-height:1.12; letter-spacing:-.5px; }
  .sched-day .dmo { font-size:.6rem; font-weight:800; text-transform:uppercase; letter-spacing:.7px; color:#9aa7b8; }
  .sched-day.on { background:linear-gradient(158deg,#3b74e6,#1d4ed8); border-color:transparent;
    box-shadow:0 14px 28px rgba(37,99,201,.42); transform:translateY(-2px); }
  .sched-day.on .dwd { color:rgba(255,255,255,.82); }
  .sched-day.on .dnum { color:#fff; }
  .sched-day.on .dmo { color:rgba(255,255,255,.72); }

  /* Wrapped time pills — compact, cohesive, no gradient */
  .sched-times { display:grid; grid-template-columns:repeat(auto-fill, minmax(96px,1fr)); gap:9px; margin-top:14px; }
  .sched-time { padding:11px 6px; border:1px solid var(--edge); border-radius:12px; background:#fff; color:var(--navy);
    font-weight:650; cursor:pointer; font-size:.9rem; text-align:center; transition:border-color .12s ease, background .12s ease, color .12s ease, transform .12s ease; }
  .sched-time:hover { border-color:var(--blue); background:#eef4fe; transform:translateY(-1px); }
  .sched-time:active, .sched-time.on { background:var(--blue); border-color:var(--blue); color:#fff; }

  .sched-chosen { background:#eef4fe; border:1px solid #d3e2fb; border-radius:14px; padding:13px 16px; color:var(--navy); margin-bottom:18px; font-size:.95rem; }
  .sched-row { margin-bottom:14px; }
  .sched-row.two { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .sched label { display:block; font-size:.82rem; font-weight:700; color:var(--navy); }
  .sched input, .sched select, .sched textarea { width:100%; margin-top:6px; padding:13px 14px; border:1px solid #d7e0ec;
    border-radius:12px; font-size:.95rem; font-family:inherit; box-sizing:border-box; background:#fff; transition:box-shadow .14s, border-color .14s; }
  .sched input:focus, .sched select:focus, .sched textarea:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 4px rgba(37,99,201,.14); }
  .sched-actions { display:flex; align-items:center; gap:16px; margin-top:8px; flex-wrap:wrap; }
  .sched-btn { background:var(--blue); color:#fff; border:0; border-radius:12px; padding:14px 30px; font-weight:750; cursor:pointer;
    box-shadow:0 12px 24px rgba(37,99,201,.28); transition:background .14s, transform .14s, box-shadow .14s; }
  .sched-btn:hover { background:var(--blueDk); transform:translateY(-1px); box-shadow:0 16px 30px rgba(37,99,201,.34); }
  .sched-btn:disabled { opacity:.6; }
  .sched-back { background:none; border:0; color:var(--muted); cursor:pointer; font-weight:600; }
  .sched-err { color:#c0392b; margin:10px 0 0; min-height:1em; font-size:.9rem; }
  .sched-done { text-align:center; padding:26px 6px; }
  .sched-check { width:60px; height:60px; margin:0 auto 16px; border-radius:50%; background:var(--blue); color:#fff;
    font-size:1.9rem; display:grid; place-items:center; box-shadow:0 14px 30px rgba(37,99,201,.34);
    animation:sched-pop .45s cubic-bezier(.2,1.4,.5,1) both; }
  @keyframes sched-pop { 0%{ transform:scale(.4); opacity:0 } 100%{ transform:scale(1); opacity:1 } }
  .sched-done h3 { color:var(--navy); margin:0 0 6px; font-size:1.3rem; }
  .sched-done p { color:var(--muted); margin:4px 0; }

  @media (max-width:520px){
    .sched-card { padding:20px; }
    .sched-times { grid-template-columns:repeat(auto-fill, minmax(86px,1fr)); }
    .sched-row.two { grid-template-columns:1fr; }
  }
</style>
