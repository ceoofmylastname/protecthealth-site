---
/**
 * ContentRail — the compact replacement for the tall reading-library grids.
 *
 * Two render modes, both a single horizontal line that auto-drifts:
 *   items -> card rail (image, badge, clamped title, read cue; NO description)
 *   pills -> dual-row question marquee, rows drifting in opposite directions
 *
 * Why it exists: the old grids stacked 2-3 cards per row with full
 * descriptions, which added 1,500px+ of page height below the CTA on every
 * hub page. This keeps every destination reachable at a fraction of the
 * height. All links are static <a href> in the HTML, so crawlability never
 * depends on the animation.
 *
 * Mechanics: the set is rendered 4 times and the track translates by -25%,
 * which is exactly one content period, so the loop is seamless. Copies 2-4
 * are aria-hidden with tabindex -1 so screen readers and keyboard users see
 * each destination once.
 *
 * Motion rules (CLAUDE.md): on coarse pointers and under reduced motion the
 * animation is disabled AND the clones are hidden, leaving a normal
 * swipeable scroll-snap row. Never disable the animation without hiding the
 * clones, or mobile users get every card four times.
 */
import { srcsetIfArt, SIZES_CARD } from '../lib/site';

interface Item { href: string; img?: string; alt?: string; badge?: string; title: string }
interface Pill { href: string; label: string }
interface Props { items?: Item[]; pills?: Pill[]; cue?: string }
const { items = [], pills = [], cue = 'Read →' } = Astro.props;

const COPIES = [0, 1, 2, 3];
// Slower for bigger sets so speed feels constant.
const itemDur = Math.max(30, items.length * 7);
const rowA = pills.filter((_, i) => i % 2 === 0);
const rowB = pills.filter((_, i) => i % 2 === 1);
const pillDur = (n: number) => Math.max(28, n * 9);
---

{items.length > 0 && (
  <div class="crail" style={`--dur:${itemDur}s`}>
    <div class="crail-track">
      {COPIES.map((c) => (
        <div class="crail-set" aria-hidden={c > 0 ? 'true' : undefined} data-clone={c > 0 ? '' : undefined}>
          {items.map((it) => (
            <a class="crail-card" href={it.href} tabindex={c > 0 ? -1 : undefined}>
              {it.img && <span class="cc-art"><img src={it.img} srcset={srcsetIfArt(it.img)} sizes={SIZES_CARD} alt={c > 0 ? '' : (it.alt ?? '')} loading="lazy" width="480" height="270" /></span>}
              <span class="cc-body">
                {it.badge && <span class="cc-badge">{it.badge}</span>}
                <b>{it.title}</b>
                <span class="cc-go">{cue}</span>
              </span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
)}

{pills.length > 0 && (
  <div class="qrail">
    {[{ row: rowA, rev: false }, { row: rowB, rev: true }].map(({ row, rev }) => row.length > 0 && (
      <div class={`qrail-row${rev ? ' rev' : ''}`} style={`--dur:${pillDur(row.length)}s`}>
        <div class="qrail-track">
          {COPIES.map((c) => (
            <div class="qrail-set" aria-hidden={c > 0 ? 'true' : undefined} data-clone={c > 0 ? '' : undefined}>
              {row.map((p) => (
                <a class="qrail-pill" href={p.href} tabindex={c > 0 ? -1 : undefined}>{p.label}<i>→</i></a>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
)}

<style>
  /* ===== card rail ===== */
  .crail { overflow: hidden; margin-top: 22px; padding: 4px 0 8px;
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .crail-track { display: flex; width: max-content; animation: crailDrift var(--dur) linear infinite; }
  .crail:hover .crail-track { animation-play-state: paused; }
  .crail-set { display: flex; gap: 14px; padding-right: 14px; }
  @keyframes crailDrift { to { transform: translateX(-25%); } }

  .crail-card { display: flex; flex-direction: column; width: 248px; flex: 0 0 auto; overflow: hidden;
    border-radius: 15px; text-decoration: none; background: #fff;
    border: 1.5px solid rgba(15,53,103,0.1); box-shadow: 0 4px 14px rgba(15,53,103,0.05);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; }
  .crail-card:hover { border-color: rgba(25,123,255,0.45); box-shadow: 0 10px 26px rgba(15,53,103,0.11); transform: translateY(-3px); }
  .cc-art { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: rgba(15,53,103,0.06); }
  .cc-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cc-body { display: flex; flex-direction: column; flex: 1; padding: 12px 14px 13px; }
  .cc-badge { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
  .crail-card b { font-size: 0.88rem; color: var(--navy); line-height: 1.3; font-weight: 800;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cc-go { margin-top: auto; padding-top: 9px; font-size: 0.76rem; font-weight: 800; color: var(--blue); }

  /* ===== pill marquee, two counter-drifting rows ===== */
  .qrail { display: grid; gap: 10px; margin-top: 20px; }
  .qrail-row { overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .qrail-track { display: flex; width: max-content; animation: crailDrift var(--dur) linear infinite; }
  .qrail-row.rev .qrail-track { animation-direction: reverse; }
  .qrail-row:hover .qrail-track { animation-play-state: paused; }
  .qrail-set { display: flex; gap: 10px; padding-right: 10px; }
  .qrail-pill { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; flex: 0 0 auto;
    min-height: 44px; padding: 10px 18px; border-radius: 999px; text-decoration: none;
    font-size: 0.86rem; font-weight: 700; color: var(--navy);
    background: linear-gradient(#fff, #fff) padding-box,
      linear-gradient(120deg, rgba(25,123,255,0.4), rgba(25,200,255,0.2) 55%, rgba(0,125,179,0.4)) border-box;
    border: 1.5px solid transparent;
    transition: color 0.2s, box-shadow 0.2s, transform 0.2s; }
  .qrail-pill i { font-style: normal; color: var(--blue); transition: transform 0.2s; }
  .qrail-pill:hover { color: var(--blue); box-shadow: 0 8px 20px rgba(25,123,255,0.16); transform: translateY(-2px); }
  .qrail-pill:hover i { transform: translateX(3px); }

  /* ===== touch tier + reduced motion: static swipeable rows, clones hidden.
     Disabling the drift without hiding the clones would show every card four
     times, so these two moves always happen together. ===== */
  @media (pointer: coarse), (max-width: 1023px) {
    .crail-track, .qrail-track { animation: none; width: auto; }
    .crail, .qrail-row { overflow-x: auto; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; scrollbar-width: none; mask-image: none; -webkit-mask-image: none; }
    .crail::-webkit-scrollbar, .qrail-row::-webkit-scrollbar { display: none; }
    .crail-card, .qrail-pill { scroll-snap-align: start; }
    [data-clone] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crail-track, .qrail-track { animation: none; width: auto; }
    .crail, .qrail-row { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    [data-clone] { display: none; }
  }
</style>
