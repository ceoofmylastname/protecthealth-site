---
import { SITE, ASSETS, organizationSchema } from '../lib/site';
import ReviewBadge from '../components/ReviewBadge.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schemas?: object[]; // page-specific JSON-LD blocks
  noindex?: boolean;
  // Per-page alt for the og:image. Falls back to the brand line, which is
  // right for the default card but wrong for per-post art (BLOG_ART/QA_ART
  // carry real descriptions of their own images).
  ogImageAlt?: string;
  // Article pages (blog posts, Q&A) pass real editorial dates. When set,
  // og:type flips to "article" and the article:* meta family is emitted —
  // the machine-readable freshness signal that mirrors the visible
  // "Published … · Updated …" line and JSON-LD datePublished/dateModified
  // (wiki: date-modified-schema). modifiedTime and authorName only render
  // when provided; a never-edited post gets no article:modified_time, same
  // rule as dateModified in the schema.
  article?: { publishedTime: string; modifiedTime?: string; authorName?: string };
  // Broker pages override the header call-to-action with THAT broker's number,
  // so a prospect reading one person's page always reaches that person.
  // Everywhere else this falls back to the main office line.
  navPhone?: string;
  navPhoneHref?: string;
}
const { title, description, canonical, ogImage, schemas = [], noindex = false, ogImageAlt, article, navPhone, navPhoneHref } = Astro.props;
const headerPhone = navPhone || SITE.phone;
const headerPhoneHref = navPhoneHref || SITE.phoneHref;
// Clean URLs: Cloudflare Pages serves /page from /page.html, so canonicals are extensionless.
const computedUrl = new URL(Astro.url.pathname, SITE.domain).href
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '');
const canonicalUrl = canonical ?? (computedUrl || SITE.domain);
const ogImg = ogImage ?? `${SITE.domain}/assets/og-default.webp`;
const ogAlt = ogImageAlt ?? 'ProtectHealth, Las Vegas insurance brokerage. Strategy first, insurance second.';
const orgSchema = organizationSchema();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover is required for env(safe-area-inset-*) to resolve to
         anything other than 0px on iOS. FloatingMagnet already relies on it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* Icons, generated from the real ProtectHealth mark in
        public/assets/icon-source.png via scripts/make-icons.py.
        No SVG: the source is raster, and a link to a non-existent favicon.svg
        would just 404 on every page load.
        The tab favicons keep transparency. The apple-touch-icon does NOT , 
        iOS renders a transparent home-screen icon on black, and this mark is
        grey and mid-blue, so it would all but vanish. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f3567" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article && article.authorName && <meta property="article:author" content={article.authorName} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImg} />
    {/* Dimensions let a platform reserve the card before the image downloads,
        which is the difference between a card that renders instantly and one
        that pops in. Alt text is read by screen readers on the unfurled card. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Fonts: preconnect + swap (wiki: core-web-vitals-blog-template) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet" />

    <!-- Standalone Organization schema in global layout (wiki: faq-single-source-architecture) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    {/* First focusable element on every page. Without it a keyboard user tabs
        the logo, six nav items, the phone number, the CTA and the burger
        before reaching content, on all 148 pages. */}
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" id="siteHeader">
      <div class="container">
        <div class="nav-shell">
          <a href="/" class="logo" aria-label="ProtectHealth home">
            {/* 511x132 intrinsic, rendered at 44px tall. The attrs must match the
                real aspect ratio or the browser reserves the wrong box and the
                nav shifts when the logo decodes. */}
            <img src={ASSETS.logo} alt="ProtectHealth: Medical, Medicare, Life, Annuity, Supplements" width="511" height="132" />
          </a>
          {/* Eight top-level children overflowed the shell and `flex-wrap: wrap`
              dropped the CTA onto a second row, doubling the header height. The
              education pages now live under one Learn group, so the row is five
              items and CANNOT wrap, `.nav` is `flex-wrap: nowrap`. Adding a
              seventh top-level link here will overflow again; add it to the
              Learn menu instead. */}
          <nav class="nav" aria-label="Main">
            <a href="/services">Services</a>
            <a href="/self-employed">Self-Employed</a>
            <a href="/employers">Employers</a>
            <div class="nav-group" data-navgroup>
              <button type="button" class="nav-group-btn" aria-expanded="false" aria-haspopup="true" aria-controls="learnMenu">
                Learn<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="nav-menu" id="learnMenu" role="menu">
                <a href="/blog" role="menuitem"><b>Blog</b><span>Guides and strategy breakdowns</span></a>
                <a href="/qa" role="menuitem"><b>Q&amp;A</b><span>Straight answers to single questions</span></a>
                <a href="/buyers-guide" role="menuitem"><b>Buyer's Guide</b><span>How to choose coverage</span></a>
                <a href="/faq" role="menuitem"><b>FAQ</b><span>Common questions about ProtectHealth</span></a>
              </div>
            </div>
            <a href="/about-us">About</a>
            <a href={headerPhoneHref} class="nav-phone">{headerPhone}</a>
            <a href="/talk-to-a-broker" class="btn">Talk To A Broker</a>
          </nav>
          <button type="button" class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
            <span class="nb-text"><i>Menu</i><i>Close</i></span>
            <span class="nb-icon"><b></b><b></b></span>
          </button>
        </div>
      </div>
    </header>

    <div class="mnav" id="mnav" aria-hidden="true">
      <div class="mnav-scrim" data-mnav-close></div>
      <div class="mnav-panel">
        <div class="mnav-layer l1"></div>
        <div class="mnav-layer l2"></div>
        <div class="mnav-layer l3">
          <button type="button" class="mnav-x" data-mnav-close aria-label="Close menu">✕</button>
          <div class="mnav-inner">
            <ul class="mnav-list" aria-label="Mobile navigation">
              {[
                { href: '/services', label: 'Services', n: '01' },
                { href: '/self-employed', label: 'Self-Employed', n: '02' },
                { href: '/employers', label: 'Employers', n: '03' },
                { href: '/blog', label: 'Blog', n: '04' },
                { href: '/qa', label: 'Q&A', n: '05' },
                { href: '/buyers-guide', label: "Buyer's Guide", n: '06' },
                { href: '/about-us', label: 'About', n: '07' },
              ].map((l) => (
                <li><span class="mnav-clip"><a href={l.href}><em>{l.n}</em>{l.label}</a></span></li>
              ))}
            </ul>
            <div class="mnav-foot">
              <a href="/talk-to-a-broker" class="btn big no-arrow">Talk To A Broker</a>
              <a href={headerPhoneHref} class="mnav-phone">{headerPhone}</a>
              <p>{SITE.address.street}, {SITE.address.locality}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* tabindex="-1" so the skip link actually moves focus here. Without it the
        browser scrolls to #main but focus stays on the link, and the next Tab
        lands back in the nav. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script is:inline>
      // Floating nav: elevate on scroll
      (() => {
        const h = document.getElementById('siteHeader');
        if (!h) return;
        const onScroll = () => h.classList.toggle('scrolled', scrollY > 12);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
      // Desktop "Learn" dropdown. Hover opens it on real pointer devices; click
      // and keyboard work everywhere, so it is operable without a mouse. The
      // links are static <a href> in the DOM either way, so crawlability never
      // depends on this script running.
      (() => {
        const group = document.querySelector('[data-navgroup]');
        if (!group) return;
        const btn = group.querySelector('.nav-group-btn');
        const set = (v) => { group.classList.toggle('open', v); btn.setAttribute('aria-expanded', String(v)); };
        btn.addEventListener('click', (e) => { e.preventDefault(); set(!group.classList.contains('open')); });
        if (matchMedia('(hover: hover)').matches) {
          group.addEventListener('pointerenter', () => set(true));
          group.addEventListener('pointerleave', () => set(false));
        }
        // Focus moving out of the group closes it, which keeps tabbing past the
        // menu from leaving an open panel floating over the page.
        group.addEventListener('focusout', (e) => { if (!group.contains(e.relatedTarget)) set(false); });
        document.addEventListener('click', (e) => { if (!group.contains(e.target)) set(false); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      })();
      // Pointer spotlight for .spot cards (site-wide)
      document.addEventListener('pointermove', (e) => {
        const t = e.target.closest && e.target.closest('.spot');
        if (!t) return;
        const r = t.getBoundingClientRect();
        t.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
        t.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
      }, { passive: true });
      // Mobile kinetic menu
      (() => {
        const burger = document.getElementById('navBurger');
        const mnav = document.getElementById('mnav');
        if (!burger || !mnav) return;
        const panel = mnav.querySelector('.mnav-layer.l3');
        let open = false;
        let hideTimer = null;
        let itemTimer = null;

        const set = (v) => {
          open = v;
          burger.classList.toggle('open', open);
          burger.setAttribute('aria-expanded', String(open));
          mnav.setAttribute('aria-hidden', String(!open));
          document.documentElement.style.overflow = open ? 'hidden' : '';

          if (open) {
            clearTimeout(hideTimer);
            clearTimeout(itemTimer);
            // Both classes in the SAME tick, deliberately.
            //
            // This used to add `open` inside a double requestAnimationFrame to
            // guarantee a start frame for the transition. That was a bad trade:
            // on first landing the homepage is still initialising the hero
            // background, Ken Burns, mesh layers, the carousel and several
            // observers, and rAF callbacks get starved for seconds. Until the
            // second frame arrived, `open` was never added, so the panel sat at
            // translateX(101%) while the burger already read "Close", open in
            // state, invisible on screen. Never gate a user-initiated animation
            // on rAF landing promptly.
            mnav.classList.add('is-open', 'open');
            // Step 3: stagger the links only once the panel has STOPPED.
            // .mnav-layer.l3 scrolls and is transformed, so iOS composites its
            // subtree into one texture while it slides. Anything animating in
            // there during the slide is invisible. transitionend is the accurate
            // signal; the timeout is the fallback for when it does not fire
            // (interrupted transition, background tab, reduced motion).
            // Items wait for the panel to stop moving. transitionend is the
            // accurate signal; the timer is the fallback for a starved frame
            // budget, an interrupted transition, or reduced motion. Whichever
            // fires first wins and the other is a no-op.
            const start = () => { if (open) mnav.classList.add('items-in'); };
            if (panel) panel.addEventListener('transitionend', start, { once: true });
            itemTimer = setTimeout(start, 460);
          } else {
            clearTimeout(itemTimer);
            mnav.classList.remove('open', 'items-in');
            hideTimer = setTimeout(() => mnav.classList.remove('is-open'), 480);
          }
        };

        // pointerdown, not click. iOS holds click for ~300ms in case the tap
        // becomes a double-tap zoom, which is the lag you feel before anything
        // moves. preventDefault stops the synthetic click that would re-toggle.
        burger.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          set(!open);
        });
        // Keyboard and any environment without pointer events.
        burger.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(!open); }
        });
        mnav.querySelectorAll('a, [data-mnav-close]').forEach((el) =>
          el.addEventListener('click', () => set(false)));
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) set(false); });
      })();
      // v8: global scroll reveal + 3D tilt (site-wide)
      (() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('.reveal');
        // Failsafe: nothing stays invisible if observation stalls on slow devices
        setTimeout(() => els.forEach((el) => el.classList.add('in')), 3000);
        if (reduce) { els.forEach((el) => el.classList.add('in')); }
        else {
          const io = new IntersectionObserver((ens) => {
            ens.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
          }, { threshold: 0.15 });
          els.forEach((el) => io.observe(el));
        }
        if (reduce || matchMedia('(hover: none)').matches) return;
        document.addEventListener('pointermove', (e) => {
          const t = e.target.closest && e.target.closest('.tilt');
          if (!t) return;
          const r = t.getBoundingClientRect();
          const rx = ((e.clientY - r.top) / r.height - 0.5) * -7;
          const ry = ((e.clientX - r.left) / r.width - 0.5) * 7;
          t.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-3px)`;
        }, { passive: true });
        document.addEventListener('pointerout', (e) => {
          const t = e.target.closest && e.target.closest('.tilt');
          if (t && !t.contains(e.relatedTarget)) t.style.transform = '';
        }, { passive: true });
      })();
    </script>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-logo"><img src={ASSETS.logo} alt="ProtectHealth logo" width="511" height="132" loading="lazy" /></div>
            <p>Las Vegas, Nevada insurance brokerage. The product should serve the strategy, not become the strategy.</p>
            <p><a href={SITE.phoneHref} class="footer-phone">{SITE.phone}</a></p>
            <ReviewBadge variant="footer" />
          </div>
          <div>
            <h4>Coverage</h4>
            <ul>
              <li><a href="/services/health-insurance">Health Insurance</a></li>
              <li><a href="/services/life-insurance">Life Insurance</a></li>
              <li><a href="/services/gap-health-insurance">GAP Health Insurance</a></li>
              <li><a href="/services/medicare">Medicare Solutions</a></li>
              <li><a href="/services/dental-insurance">Dental Insurance</a></li>
              <li><a href="/services/vision-insurance">Vision Insurance</a></li>
            </ul>
          </div>
          <div>
            <h4>For You</h4>
            <ul>
              <li><a href="/self-employed">Realtors &amp; 1099s</a></li>
              <li><a href="/employers">Business Owners</a></li>
              <li><a href="/free-quote">Get Started</a></li>
              <li><a href="/our-team">Our Team</a></li>
              <li><a href="/contact-us">Contact Us</a></li>
            </ul>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href="/sitemap">Site Map</a></li>
              <li><a href="/sitemap/blog">All Blog Posts</a></li>
              <li><a href="/sitemap/qa">All Q&amp;A Pages</a></li>
              <li><a href="/faq">FAQ</a></li>
              <li><a href="/blog">Latest Articles</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-sitemap">
          <slot name="footer-sitemap" />
        </div>
        <div class="footer-legal">
          <p>© {new Date().getFullYear()} ProtectHealth. Insurance products and availability vary by individual situation, business structure, and eligibility. ProtectHealth brokers are insurance professionals, not tax professionals. For tax or business-structure decisions, a conversation with a licensed tax professional is a make-sense next step.</p>
          <p class="footer-legal-links">
            <a href="/privacy-policy">Privacy Policy</a>
            <span aria-hidden="true">·</span>
            <a href="/terms-and-conditions">Terms &amp; Conditions</a>
            <span aria-hidden="true">·</span>
            <a href="/app">Agent Login</a>
          </p>
        </div>
      </div>
      <div class="footer-mark" aria-hidden="true">
        <div class="footer-wordmark">
          {'PROTECTHEALTH'.split('').map((ch) => <span class="fw-l">{ch}</span>)}
        </div>
        <div class="footer-badge"><img src={ASSETS.logo} alt="" loading="lazy" /></div>
      </div>
    </footer>
  </body>
</html>
