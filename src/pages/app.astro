    // ---- Admin: custom field manager ----
    function openFieldManager() {
      const rows = () => state.customFields.map((f) => `
        <div class="feed-item"><div class="feed-ic">▦</div>
          <div><div style="font-weight:650">${esc(f.label)}</div><div class="cell-sub">${esc(f.field_type)}${f.options ? ' · ' + (f.options || []).join(', ') : ''}</div></div>
          <button class="btn btn-ghost btn-sm" data-cf-del="${f.id}" style="margin-left:auto">Remove</button>
        </div>`).join('') || '<div class="cell-sub">No custom fields yet.</div>';
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Contact card fields</div><div class="cell-sub">These appear in Client data on every contact, for every agent</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div id="cf-list">${rows()}</div>
          <div class="section-t">Add a field</div>
          <form id="cf-form">
            <div class="field"><label>Label *</label><input name="label" required placeholder="e.g. Medicare Number"/></div>
            <div class="grid2">
              <div class="field"><label>Type</label><select name="field_type"><option value="text">Text</option><option value="number">Number</option><option value="date">Date</option><option value="select">Dropdown</option></select></div>
              <div class="field"><label>Dropdown options</label><input name="options" placeholder="Comma-separated"/></div>
            </div>
            <button class="btn btn-primary btn-sm" type="submit">Add field</button>
            <p class="cell-sub" id="cf-status" style="margin-top:8px"></p>
          </form>
          <div class="section-t">Tags brokers can use</div>
          <div id="tg-list" style="display:flex;flex-wrap:wrap;gap:8px"></div>
          <form id="tg-form" style="display:flex;gap:8px;margin-top:10px">
            <input name="name" placeholder="New tag, e.g. VIP" style="flex:1"/>
            <button class="btn btn-primary btn-sm" type="submit">Add tag</button>
          </form>
          <p class="cell-sub" id="tg-status" style="margin-top:6px"></p>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      const wireDeletes = () => $$('#cf-list [data-cf-del]').forEach((b) => b.addEventListener('click', async () => {
        const id = b.dataset.cfDel;
        const { error } = await sb.from('ph_custom_fields').update({ is_active: false }).eq('id', id);
        if (error) { toast('Could not remove field.'); return; }
        state.customFields = state.customFields.filter((f) => f.id !== id);
        $('#cf-list').innerHTML = rows(); wireDeletes(); toast('Field removed');
      }));
      wireDeletes();
      $('#cf-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target;
        const label = f.label.value.trim(); if (!label) return;
        const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
        const type = f.field_type.value;
        const opts = type === 'select' ? f.options.value.split(',').map((s) => s.trim()).filter(Boolean) : null;
        if (type === 'select' && (!opts || !opts.length)) { $('#cf-status').textContent = 'Dropdown needs at least one option.'; return; }
        const { data, error } = await sb.from('ph_custom_fields').insert({ key, label, field_type: type, options: opts, position: 100 + state.customFields.length }).select('*').single();
        if (error) { $('#cf-status').textContent = 'Could not add: ' + error.message; return; }
        state.customFields.push(data);
        $('#cf-list').innerHTML = rows(); wireDeletes();
        f.reset(); $('#cf-status').textContent = 'Added — it now shows on every contact card.';
      });

      // Tag vocabulary (admin-only writes; brokers pick from this list).
      const paintTags = () => {
        $('#tg-list').innerHTML = state.adminTags.map((t) => `<span class="fchip">${esc(t.name)}<button data-tg-del="${t.id}" aria-label="Remove">✕</button></span>`).join('') || '<span class="cell-sub">No tags yet.</span>';
        $$('#tg-list [data-tg-del]').forEach((b) => b.addEventListener('click', async () => {
          const { error } = await sb.from('ph_tags').update({ is_active: false }).eq('id', b.dataset.tgDel);
          if (error) { toast('Could not remove tag.'); return; }
          state.adminTags = state.adminTags.filter((t) => t.id !== b.dataset.tgDel);
          paintTags(); toast('Tag removed');
        }));
      };
      paintTags();
      $('#tg-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = e.target.name.value.trim().toLowerCase(); if (!name) return;
        const { data, error } = await sb.from('ph_tags').insert({ name, position: 100 + state.adminTags.length }).select('*').single();
        if (error) { $('#tg-status').textContent = 'Could not add: ' + error.message; return; }
        state.adminTags.push(data); e.target.reset(); paintTags();
        $('#tg-status').textContent = 'Added — brokers can use it now.';
      });
    }

