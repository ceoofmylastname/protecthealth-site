---

// ProtectHealth CRM — the broker/admin app.
//
// Trust model (unchanged from phase 1): every byte ships to the browser with
// the ANON key. Row Level Security decides what comes back. No query here
// filters by ownership — the database already does. A broker's ph_leads /
// ph_contacts read returns only their own rows; an admin's returns everything.
// If a page ever adds a JS ownership filter, that is a bug even when it looks
// right. See "Access Control Audit" in the project.
//
// Auth (login / claim / recover / reset) is verbatim the flow shipped Aug 10 —
// password login, magic link for recovery only. The post-auth shell below is
// the new part: demo-styled sidebar CRM (Dashboard, Contacts, Leads, Pipeline,
// Calendar) reading live data. Admins additionally get links to /admin.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
const LOGO = 'https://www.protecthealth.com/assets/og-logo-source.png';

// Google Calendar tutorial, shared with /help/google-calendar so the popup and
// the page can never disagree. Injected into the modal below with set:html.
import { GCAL_HELP_HTML } from '../lib/gcal-help';
---

<!-- Standalone document on purpose: the CRM is a full-screen app and must NOT
     inherit the marketing site's header, footer, or .btn arrow chrome from
     Base.astro. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>ProtectHealth CRM</title>
  <link rel="icon" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet" />
  <style>html,body{margin:0;padding:0;height:100%;background:#f4f7fc;overflow:hidden}</style>
</head>
<body>
  <div class="ph" data-supabase-url={SUPABASE_URL} data-supabase-anon={SUPABASE_ANON} data-logo={LOGO}>

    <!-- ============ AUTH GATES (shown before the app) ============
         Split-screen sign-in: form left, branded hero right. All the class
         hooks the auth JS depends on (.ag-login-form, .ag-forgot-form,
         .ag-setpw-form, .ag-status, .ag-go-forgot, .ag-go-signin, .ag-signout,
         data-view names) are unchanged — this is a reskin, not a rewire. -->
    <div class="ag-shell" data-gate>
      <div class="ag-view" data-view="loading">
        <div class="ag-center"><p class="ag-muted">Checking your session…</p></div>
      </div>

      <div class="ag-view" data-view="signin" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo ag-anim d1" src={LOGO} alt="ProtectHealth" />
          <h1 class="ag-anim d2">Welcome back</h1>
          <p class="ag-muted ag-anim d3">Sign in to your broker dashboard.</p>
          <form class="ag-login-form">
            <label class="ag-field ag-anim d4">
              <span>Email address</span>
              <div class="ag-input"><input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="username" required /></div>
            </label>
            <label class="ag-field ag-anim d5">
              <span>Password</span>
              <div class="ag-input has-eye">
                <input type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required />
                <button type="button" class="pw-eye" aria-label="Show or hide password">
                  <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-shut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                </button>
              </div>
            </label>
            <div class="ag-row ag-anim d6">
              <span class="ag-hint">Trouble signing in?</span>
              <a href="#" class="ag-go-forgot">Reset password</a>
            </div>
            <button type="submit" class="ag-btn ag-anim d7">Sign In</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small ag-anim d8">First time here? <a href="#" class="ag-go-firstrun">Set up your login</a> with the setup code from the office.</p>
        </div></div>
      </div>

      <!-- First-time setup. Backed by ph-auth action 'setup': the office code is
           checked BEFORE any roster detail is revealed, and the server refuses
           any account that already has a password, so a code spoken aloud in a
           room can never be used against a broker who is already set up. -->
      <div class="ag-view" data-view="firstrun" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo ag-anim d1" src={LOGO} alt="ProtectHealth" />
          <h1 class="ag-anim d2">Set up your login</h1>
          <p class="ag-muted ag-anim d3">For brokers signing in for the first time. You will need the setup code from the office.</p>
          <form class="ag-firstrun-form">
            <label class="ag-field ag-anim d4">
              <span>Work email</span>
              <div class="ag-input"><input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="username" required /></div>
            </label>
            <label class="ag-field ag-anim d5">
              <span>Setup code</span>
              <div class="ag-input"><input type="text" name="code" placeholder="From the office" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" required /></div>
            </label>
            <label class="ag-field ag-anim d6">
              <span>Create a password</span>
              <div class="ag-input has-eye">
                <input type="password" name="password" placeholder="At least 10 characters" autocomplete="new-password" required minlength="10" />
                <button type="button" class="pw-eye" aria-label="Show or hide password">
                  <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-shut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                </button>
              </div>
            </label>
            <label class="ag-field ag-anim d7">
              <span>Confirm password</span>
              <div class="ag-input"><input type="password" name="confirm" placeholder="Type it again" autocomplete="new-password" required minlength="10" /></div>
            </label>
            <p class="ag-rules ag-anim d7">At least 10 characters. Cannot contain your email address or obvious words like "password".</p>
            <button type="submit" class="ag-btn ag-anim d8">Create my login</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small ag-anim d8">Already set up? <a href="#" class="ag-go-signin">Back to sign in</a></p>
        </div></div>
      </div>

      <div class="ag-view" data-view="forgot" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo ag-anim d1" src={LOGO} alt="ProtectHealth" />
          <h1 class="ag-anim d2">Reset your password</h1>
          <p class="ag-muted ag-anim d3">Enter your work email and we'll send you a link to set a new password.</p>
          <form class="ag-forgot-form">
            <label class="ag-field ag-anim d4">
              <span>Email address</span>
              <div class="ag-input"><input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="username" required /></div>
            </label>
            <button type="submit" class="ag-btn ag-anim d5">Send Reset Link</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small ag-anim d6"><a href="#" class="ag-go-signin">← Back to sign in</a></p>
        </div></div>
      </div>

      <div class="ag-view" data-view="setpassword" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo ag-anim d1" src={LOGO} alt="ProtectHealth" />
          <h1 class="ag-setpw-title ag-anim d2">Set your password</h1>
          <p class="ag-muted ag-setpw-intro ag-anim d3">Choose a password for your account.</p>
          <form class="ag-setpw-form">
            <input type="email" name="email" autocomplete="username" hidden readonly />
            <label class="ag-field ag-anim d4">
              <span>New password</span>
              <div class="ag-input has-eye">
                <input type="password" name="password" placeholder="At least 10 characters" autocomplete="new-password" required minlength="10" />
                <button type="button" class="pw-eye" aria-label="Show or hide password">
                  <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-shut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                </button>
              </div>
            </label>
            <label class="ag-field ag-anim d5">
              <span>Confirm password</span>
              <div class="ag-input"><input type="password" name="confirm" placeholder="Type it again" autocomplete="new-password" required minlength="10" /></div>
            </label>
            <button type="submit" class="ag-btn ag-anim d6">Save Password</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small ag-anim d7">At least 10 characters.</p>
        </div></div>
      </div>

      <div class="ag-view" data-view="denied" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo" src={LOGO} alt="ProtectHealth" />
          <h1>No access</h1>
          <p class="ag-muted">You're signed in as <b data-who></b>, but that address isn't on the broker roster. If you're an admin, your dashboard is at <a href="/admin">/admin</a>. Otherwise ask the office to add you.</p>
          <button type="button" class="ag-btn ghost ag-signout">Sign out</button>
        </div></div>
      </div>

      <!-- Right column: branded hero. Decorative only — hidden from smaller
           screens and screen readers. -->
      <aside class="ag-hero" aria-hidden="true">
        <div class="ag-hero-inner">
          <div class="ag-hero-top ag-anim d3">
            <span class="ag-hero-pill">Broker Portal</span>
          </div>
          <div class="ag-hero-bottom">
            <blockquote class="ag-quote ag-anim d5">
              <p>"The product should serve the strategy — not become the strategy."</p>
              <cite>The ProtectHealth way</cite>
            </blockquote>
            <div class="ag-chips">
              <div class="ag-chip ag-anim d6"><b>60+</b><span>licensed brokers</span></div>
              <div class="ag-chip ag-anim d7"><b>8,000+</b><span>clients served</span></div>
              <div class="ag-chip ag-anim d8"><b>Las Vegas</b><span>Nevada, home base</span></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- ============ THE APP (shown after auth) ============ -->
    <div id="app" data-app hidden>
      <aside id="sidebar">
        <div class="brand"><span class="logo-chip"><img src={LOGO} alt="ProtectHealth" /></span></div>
        <nav id="nav"></nav>
        <div class="foot">
          <div data-who-name style="color:#cdd9ec;font-weight:650"></div>
          <div data-who style="font-size:.7rem"></div>
          <div style="margin-top:10px;display:flex;gap:12px;flex-wrap:wrap">
            <button type="button" id="edit-profile" style="color:#9fb2cc;font-size:.78rem;text-decoration:underline">Edit profile</button>
            <button type="button" id="change-password" style="color:#9fb2cc;font-size:.78rem;text-decoration:underline">Password</button>
            <button type="button" class="ag-signout" style="color:#9fb2cc;font-size:.78rem;text-decoration:underline">Sign out</button>
          </div>
        </div>
      </aside>

      <div id="main">
        <header id="topbar">
          <div>
            <div id="page-title">Dashboard</div>
            <div id="page-sub">A live look at your leads, appointments and pipeline</div>
          </div>
          <div class="searchbox">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input id="global-search" placeholder="Search your contacts and leads…" />
          </div>
          <div class="tz-chip" id="clock">Vegas</div>
          <div class="avatar" id="avatar" style="background:var(--grad)">JM</div>
        </header>
        <div id="view"><div class="empty"><div class="big">◐</div>Loading…</div></div>
      </div>
    </div>

    <!-- onboarding: first-login profile capture (headshot, bio, socials, lines) -->
    <div id="onboarding" hidden></div>

    <!-- Google Calendar how-to popup (opened from the Availability tab) -->
    <div class="gc-modal" id="gc-help" hidden>
      <div class="gc-modal-card" role="dialog" aria-modal="true" aria-label="How to connect your Google Calendar">
        <div class="gc-modal-h">
          <div>
            <div class="gc-modal-kick">Broker Guide</div>
            <div class="gc-modal-t">Connect Your Google Calendar</div>
          </div>
          <a class="gc-modal-open" href="/help/google-calendar" target="_blank" rel="noopener">Open as page ↗</a>
          <button class="drawer-x" type="button" data-gc-close aria-label="Close">✕</button>
        </div>
        <div class="gc-modal-b gh-body" set:html={GCAL_HELP_HTML}></div>
      </div>
    </div>

    <!-- drawer + toast, shared by all modules -->
    <div id="overlay"></div>
    <aside id="drawer"></aside>
    <div class="toast" id="toast"></div>
  </div>

  <style is:global>
  /* ProtectHealth brand tokens (from the demo, matched to global.css) */
  .ph{
    --navy:#0f3567; --navy2:#17457e; --navy-deep:#081d3d;
    --blue:#197bff; --cyan:#19c8ff; --accent:#007db3;
    --teal:#0D9488; --amber:#D97706; --violet:#7C3AED; --rose:#DB2777;
    --green:#15803d; --red:#b91c1c;
    --ink:#0f172a; --ink2:#42536b; --muted:#8494ab;
    --bg:#f4f7fc; --card:#ffffff; --line:#e3e9f2; --line2:#eef2f8;
    --grad:linear-gradient(92deg,var(--blue),var(--cyan) 70%,var(--accent));
    --radius:14px; --shadow:0 1px 2px rgba(15,23,42,.05),0 8px 24px -12px rgba(15,23,42,.12);
    --font:'Bricolage Grotesque','Avenir Next','Segoe UI',system-ui,-apple-system,sans-serif;
  }
  .ph, .ph *{box-sizing:border-box}
  .ph button{font-family:inherit;cursor:pointer;border:none;background:none;font-size:inherit;color:inherit}
  .ph input,.ph select,.ph textarea{font-family:inherit;font-size:.92rem;color:var(--ink)}

  /* ---- auth gates: split-screen (form left, hero right) ---- */
  .ag-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);height:100vh;background:#fff;font-family:var(--font)}
  .ag-shell[hidden]{display:none}
  .ag-view{min-width:0}
  .ag-view[hidden]{display:none}
  .ag-center{height:100vh;display:grid;place-items:center;padding:28px;overflow-y:auto}
  .ag-card{max-width:400px;width:100%;text-align:left}
  .ag-logo{height:38px;width:auto;margin-bottom:26px;display:block}
  .ag-card h1{font-size:2.1rem;font-weight:750;letter-spacing:-1.2px;color:var(--navy-deep);margin:0 0 8px;line-height:1.1}
  .ag-muted{color:var(--muted);font-size:.95rem;line-height:1.55}
  .ag-small{font-size:.84rem;margin-top:14px}
  .ag-small a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}
  .ag-login-form,.ag-forgot-form,.ag-setpw-form{display:grid;gap:14px;margin-top:22px}
  .ag-field{display:block}
  .ag-field>span{display:block;font-size:.82rem;font-weight:650;color:var(--ink2);margin-bottom:6px}
  .ag-input{position:relative;border:1.5px solid transparent;border-radius:15px;background:rgba(15,53,103,.055);transition:border-color .16s,background .16s,box-shadow .16s}
  .ag-input:focus-within{border-color:var(--blue);background:#fff;box-shadow:0 0 0 4px rgba(25,123,255,.13)}
  .ag-input input{width:100%;border:none;background:transparent;padding:13px 15px;font-size:1rem;border-radius:15px}
  .ag-input input:focus{outline:none}
  .ag-input.has-eye input{padding-right:46px}
  .pw-eye{position:absolute;top:0;right:4px;bottom:0;width:40px;display:grid;place-items:center;color:var(--muted);transition:color .15s}
  .pw-eye:hover{color:var(--ink2)}
  .pw-eye svg{width:19px;height:19px}
  .pw-eye .eye-shut{display:none}
  .pw-eye.on .eye-open{display:none}
  .pw-eye.on .eye-shut{display:block}
  .ag-row{display:flex;align-items:center;justify-content:space-between;font-size:.86rem;margin-top:-2px}
  .ag-hint{color:var(--muted)}
  .ag-row a{color:var(--blue);font-weight:650;text-decoration:none}
  .ag-row a:hover{text-decoration:underline;text-underline-offset:2px}
  .ag-setpw-form input[hidden]{display:none}
  .ph .ag-btn{background:var(--grad);color:#fff;border-radius:99px;padding:14px 18px;font-weight:700;font-size:.98rem;box-shadow:0 6px 18px -6px rgba(25,123,255,.6);transition:transform .12s,box-shadow .12s}
  .ph .ag-btn:hover{box-shadow:0 8px 22px -6px rgba(25,123,255,.72)}
  .ph .ag-btn:active{transform:scale(.98)}
  .ph .ag-btn.ghost{background:none;border:1px solid var(--line);color:var(--ink2);box-shadow:none}
  .ag-rules{font-size:.8rem;color:var(--muted);line-height:1.5;margin:-2px 0 2px}
  .ag-status{margin-top:12px;font-size:.9rem;color:var(--muted);min-height:1.2em}
  .ag-status.is-bad{color:#c0392b}

  /* hero column */
  .ag-hero{padding:16px 16px 16px 0;min-width:0}
  .ag-hero-inner{height:100%;border-radius:26px;background:url('/assets/login-hero.webp') center/cover no-repeat,#081d3d;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:30px;overflow:hidden}
  .ag-hero-pill{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#eaf3ff;font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:8px 16px;border-radius:99px}
  .ag-hero-bottom{display:grid;gap:14px}
  .ag-quote{margin:0;background:rgba(10,26,52,.42);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:20px;padding:22px 24px;color:#fff}
  .ag-quote p{margin:0 0 8px;font-size:1.18rem;font-weight:650;letter-spacing:-.3px;line-height:1.4}
  .ag-quote cite{font-style:normal;font-size:.82rem;color:#9fc3ee;font-weight:600;letter-spacing:.04em}
  .ag-chips{display:flex;gap:12px;flex-wrap:wrap}
  .ag-chip{flex:1;min-width:120px;background:rgba(10,26,52,.38);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-radius:16px;padding:14px 16px;color:#fff}
  .ag-chip b{display:block;font-size:1.15rem;font-weight:800;letter-spacing:-.4px}
  .ag-chip span{font-size:.76rem;color:#a9c6ea}

  /* entrance animation: fade + rise + de-blur (restarts each view swap) */
  .ag-anim{opacity:0;filter:blur(6px);transform:translateY(14px);animation:agIn .65s cubic-bezier(.22,1,.36,1) forwards}
  .ag-anim.d1{animation-delay:.04s}.ag-anim.d2{animation-delay:.1s}.ag-anim.d3{animation-delay:.16s}
  .ag-anim.d4{animation-delay:.22s}.ag-anim.d5{animation-delay:.28s}.ag-anim.d6{animation-delay:.34s}
  .ag-anim.d7{animation-delay:.4s}.ag-anim.d8{animation-delay:.46s}
  @keyframes agIn{to{opacity:1;filter:blur(0);transform:translateY(0)}}
  @media (prefers-reduced-motion: reduce){.ag-anim{animation:none;opacity:1;filter:none;transform:none}}

  @media (max-width: 920px){
    .ag-shell{grid-template-columns:1fr}
    .ag-hero{display:none}
  }

  /* ---- shell ---- */
  #app{display:grid;grid-template-columns:232px 1fr;height:100vh;background:var(--bg);color:var(--ink);font-family:var(--font)}
  #app[hidden]{display:none}
  #sidebar{background:linear-gradient(170deg,var(--navy-deep) 0%,var(--navy) 55%,var(--navy2) 100%);color:#dbe6f5;display:flex;flex-direction:column;overflow-y:auto}
  .brand{padding:16px 14px 12px}
  .brand .logo-chip{background:#fff;border-radius:13px;padding:10px 12px;display:block;box-shadow:0 6px 18px -8px rgba(8,29,61,.7)}
  .brand .logo-chip img{display:block;width:100%;height:auto}
  .nav-sec{font-size:.66rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#5f7396;padding:14px 20px 6px}
  .nav-item{display:flex;align-items:center;gap:11px;padding:9px 18px;margin:1px 10px;border-radius:10px;font-size:.9rem;font-weight:500;color:#b9c8dd;transition:background .15s,color .15s;position:relative;white-space:nowrap;width:calc(100% - 20px);text-align:left}
  .nav-item:hover{background:rgba(255,255,255,.06);color:#fff}
  .nav-item.active{background:rgba(25,123,255,.22);color:#fff;font-weight:650}
  .nav-item.active::before{content:"";position:absolute;left:-10px;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--grad)}
  .nav-item svg{width:17px;height:17px;flex:none;opacity:.85}
  .nav-item .count{margin-left:auto;font-size:.68rem;font-weight:700;background:rgba(255,255,255,.1);padding:2px 7px;border-radius:99px;color:#9fb2cc}
  #sidebar .foot{margin-top:auto;padding:14px 18px 18px;font-size:.72rem;color:#5f7396;line-height:1.5}

  #main{display:flex;flex-direction:column;min-width:0;height:100vh}
  #topbar{display:flex;align-items:center;gap:14px;padding:12px 26px;background:rgba(255,255,255,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);flex:none;z-index:20}
  #page-title{font-size:1.22rem;font-weight:800;letter-spacing:-.4px}
  #page-sub{font-size:.78rem;color:var(--muted);margin-top:1px}
  .searchbox{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:99px;padding:7px 14px;width:270px}
  .searchbox input{border:none;outline:none;background:none;width:100%}
  .searchbox svg{width:15px;height:15px;color:var(--muted);flex:none}
  .tz-chip{font-size:.74rem;color:var(--ink2);background:var(--card);border:1px solid var(--line);border-radius:99px;padding:6px 12px;white-space:nowrap}
  .avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-size:.72rem;font-weight:700;color:#fff;flex:none;overflow:hidden}
  .avatar img{width:34px;height:34px;object-fit:cover;object-position:center;border-radius:50%;display:block}

  #view{flex:1;overflow-y:auto;padding:22px 26px 60px;scroll-behavior:smooth}
  .view-grid{display:grid;gap:16px}

  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);position:relative;overflow:hidden}
  .card-h{display:flex;align-items:center;gap:10px;padding:15px 18px 0}
  .card-h h3{font-size:.95rem;font-weight:750;letter-spacing:-.2px}
  .card-h .sub{font-size:.75rem;color:var(--muted)}
  .card-h .right{margin-left:auto;display:flex;align-items:center;gap:8px}
  .card-b{padding:14px 18px 16px}
  .grad-label{font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .stat{padding:18px 20px 16px}
  .stat .lbl{font-size:.72rem;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
  .stat .num{font-size:2.3rem;font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-top:6px;font-variant-numeric:tabular-nums;color:var(--navy-deep)}
  .stat .delta{font-size:.75rem;font-weight:600;margin-top:4px;display:block}
  .stat .delta.up{color:var(--green)} .stat .delta.flat{color:var(--muted)}
  .stat .stat-ic{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:11px;display:grid;place-items:center;
    background:linear-gradient(135deg,rgba(25,123,255,.1),rgba(25,200,255,.14));color:var(--blue)}
  .stat .stat-ic svg{width:17px;height:17px}

  .btn{display:inline-flex;align-items:center;gap:7px;padding:8px 15px;border-radius:99px;font-size:.85rem;font-weight:650;transition:transform .12s;white-space:nowrap}
  .btn:active{transform:scale(.97)}
  .btn-primary{background:var(--grad);color:#fff;box-shadow:0 4px 14px -5px rgba(25,123,255,.55)}
  .btn-ghost{border:1px solid var(--line);background:var(--card);color:var(--ink2)}
  /* Destructive, and it should read that way without shouting over the page. */
  .btn-danger{border:1px solid #f0c4c0;background:#fff;color:#b3261e}
  .btn-danger:hover{background:#b3261e;border-color:#b3261e;color:#fff}
  .btn-sm{padding:5px 11px;font-size:.78rem}

  .chip{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;font-weight:600;padding:3px 9px;border-radius:99px;background:var(--line2);color:var(--ink2);white-space:nowrap}
  .chip.tag{background:#e7f2f8;color:#005f88}
  .pill-status{display:inline-flex;align-items:center;gap:6px;font-size:.73rem;font-weight:700;padding:3px 10px;border-radius:99px}
  .st-green{background:#e7f5ec;color:#15803d}.st-blue{background:#e8effd;color:#1d4ed8}
  .st-amber{background:#fdf1e2;color:#b45309}.st-red{background:#fdeaea;color:#b91c1c}
  .st-gray{background:var(--line2);color:var(--ink2)}.st-violet{background:#f1eafd;color:#6d28d9}
  .st-teal{background:#e2f5f2;color:#0f766e}

  table.data{width:100%;border-collapse:collapse;font-size:.86rem}
  table.data th{text-align:left;font-size:.7rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:10px 14px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--card);z-index:2;white-space:nowrap}
  table.data td{padding:11px 14px;border-bottom:1px solid var(--line2);vertical-align:middle}
  table.data tr.rowlink{cursor:pointer;transition:background .12s}
  table.data tr.rowlink:hover{background:#f7faff}
  .cell-name{display:flex;align-items:center;gap:10px;font-weight:650}
  .cell-sub{font-size:.74rem;color:var(--muted);font-weight:400;margin-top:1px}
  .toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 18px;border-bottom:1px solid var(--line2)}
  .toolbar select,.toolbar input[type=text]{border:1px solid var(--line);border-radius:9px;padding:7px 11px;background:var(--card);outline:none}
  .toolbar select:focus,.toolbar input:focus{border-color:var(--blue)}
  .pager{display:flex;align-items:center;gap:8px;padding:12px 18px;font-size:.8rem;color:var(--ink2)}
  .pager button{border:1px solid var(--line);border-radius:8px;padding:4px 10px;background:var(--card)}
  .pager button:disabled{opacity:.4;cursor:default}
  .avatar-sm{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:.68rem;font-weight:700;color:#fff;flex:none}

  #overlay{position:fixed;inset:0;background:rgba(10,25,48,.45);opacity:0;pointer-events:none;transition:opacity .22s;z-index:50}
  #overlay.on{opacity:1;pointer-events:auto}
  #drawer{position:fixed;top:0;right:-560px;width:560px;max-width:94vw;height:100vh;background:var(--card);z-index:60;transition:right .26s cubic-bezier(.3,.8,.3,1);box-shadow:-18px 0 50px -20px rgba(10,25,48,.35);display:flex;flex-direction:column}
  #drawer.on{right:0}
  .drawer-h{padding:20px 22px 14px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:14px;flex:none}
  .drawer-b{flex:1;overflow-y:auto;padding:18px 22px 40px}
  .drawer-x{margin-left:auto;width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:var(--muted);border:1px solid var(--line)}
  .kv{display:grid;grid-template-columns:130px 1fr;gap:7px 12px;font-size:.85rem}
  .kv .k{color:var(--muted);font-weight:600;font-size:.78rem;padding-top:1px}
  .kv .v{font-weight:550}
  .section-t{font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:20px 0 10px;display:flex;align-items:center;gap:8px}
  .section-t::after{content:"";flex:1;height:1px;background:var(--line)}

  /* Columns stretch to a common height: equal drop targets, and the board
     reads as one surface instead of a ragged skyline. */
  #kanban{display:flex;gap:14px;overflow-x:auto;padding-bottom:18px;align-items:stretch;min-height:340px}
  .kcol{flex:0 0 272px;background:#eef2f9;border:1px solid var(--line);border-radius:14px;max-height:calc(100vh - 230px);display:flex;flex-direction:column}
  .kcol-h{padding:12px 14px 8px;flex:none}
  .kcol-h .t{display:flex;align-items:center;gap:8px;font-size:.83rem;font-weight:750}
  .kcol-h .meta{font-size:.72rem;color:var(--muted);margin-top:3px;font-variant-numeric:tabular-nums}
  .kcol-b{padding:4px 10px 12px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;min-height:60px}
  .kcard{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:11px 12px;cursor:grab;box-shadow:0 1px 2px rgba(15,23,42,.06);transition:box-shadow .15s,transform .15s}
  .kcard:hover{box-shadow:0 6px 16px -6px rgba(15,23,42,.18)}
  .kcard.dragging{opacity:.45;transform:rotate(2deg)}
  .kcard .nm{font-weight:700;font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .kcard .meta{display:flex;align-items:center;gap:6px;margin-top:7px;font-size:.72rem;color:var(--muted)}
  /* rich pipeline card: who / what line / how they came in / tags / age */
  .kcard{padding:12px 13px}
  .k-top{display:flex;align-items:center;gap:9px;min-width:0}
  .k-top .avatar-sm{flex:none}
  .k-sub{font-size:.71rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
  .k-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
  .k-chips .chip{font-size:.66rem;padding:2px 8px;line-height:1.55}
  .chip.k-line{background:rgba(25,123,255,.1);color:#1553a8;font-weight:700}
  .chip.k-src{background:#f1f4f9;color:#5b6b7c}
  .k-foot{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:8px;border-top:1px solid var(--line2);
    font-size:.69rem;color:var(--muted);font-variant-numeric:tabular-nums}
  .k-time{font-weight:650}
  .k-time.is-stale{color:var(--amber)}
  .k-added{margin-left:auto}
  .k-val{margin-top:7px;font-weight:800;font-size:.88rem;color:var(--navy);font-variant-numeric:tabular-nums}
  .kcol-b.dropover{outline:2px dashed var(--blue);outline-offset:-4px;border-radius:11px;background:#e8effd66}
  .kcol-empty{border:1.5px dashed #d3dce8;border-radius:11px;padding:16px 10px;text-align:center;
    font-size:.72rem;color:#9aabc0}
  /* Won / Lost live on the card. Kept quiet until hover so the board still
     reads as names and stages rather than a wall of buttons. */
  .k-act{display:flex;gap:6px;margin-top:9px;opacity:0;transition:opacity .15s}
  .kcard:hover .k-act,.kcard:focus-within .k-act{opacity:1}
  .k-btn{flex:1;padding:5px 8px;border-radius:8px;font-size:.71rem;font-weight:750;cursor:pointer;
    border:1px solid var(--line);background:#fff;color:var(--ink2);font-family:inherit}
  .k-btn.is-won:hover{background:#0a7d3c;border-color:#0a7d3c;color:#fff}
  .k-btn.is-lost:hover{background:#b3261e;border-color:#b3261e;color:#fff}
  .kcol.is-closer .kcol-b{min-height:90px}
  .pipe-out{font-size:.8rem}
  @media(hover:none){.k-act{opacity:1}}

  /* Bulk selection on Contacts */
  .bulkbar{display:flex;align-items:center;gap:10px;padding:11px 18px;border-bottom:1px solid var(--line);background:#f3f8ff}
  .bulkbar[hidden]{display:none}
  .bulk-n{font-weight:800;font-size:.86rem;color:var(--navy)}
  .data th.pick-c,.data td.pick-c{width:34px;padding-right:0}
  .data input.pick{width:16px;height:16px;accent-color:var(--blue);cursor:pointer}
  .data tr.is-picked td{background:#f3f8ff}

  /* Dashboard: won / lost tiles */
  .out-card .out-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:16px 20px 20px}
  .out-cell .lbl{font-size:.72rem;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
  .out-cell .num{font-size:1.9rem;font-weight:800;letter-spacing:-.03em;line-height:1.15;margin-top:4px;
    font-variant-numeric:tabular-nums;color:var(--navy-deep)}
  @media(max-width:1100px){.out-card .out-grid{grid-template-columns:repeat(2,1fr)}}

  .cal-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .cal-title{font-size:1.15rem;font-weight:800;letter-spacing:-.3px;min-width:190px}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line);border-radius:0 0 12px 12px;overflow:hidden}
  .cal-dow{background:#f0f4fa;font-size:.7rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:8px 10px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .cal-cell{background:var(--card);min-height:104px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px;position:relative;overflow:hidden}
  .cal-cell.dim{background:#f8fafd}
  .cal-cell .dnum{font-size:.76rem;font-weight:700;color:var(--ink2);width:24px;height:24px;display:grid;place-items:center;border-radius:50%}
  .cal-cell.today .dnum{background:var(--blue);color:#fff}
  .cal-ev{font-size:.7rem;font-weight:650;padding:2px 7px;border-radius:6px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;color:#fff;background:var(--blue)}
  .cal-ev.bday{background:#fdf1e2;color:#b45309}
  .cal-ev-gcal{background:#eef2f8;color:#42536b;border:1px dashed #b9c8dd;cursor:default}

  /* ---- dashboard: two-column rows + stage bars ---- */
  .dash-2col{display:grid;grid-template-columns:1.6fr 1fr;gap:16px}
  @media (max-width:900px){ .dash-2col{grid-template-columns:1fr} }
  .bar-row{display:flex;align-items:center;gap:12px;padding:7px 0}
  .bar-lbl{width:150px;flex:none;font-size:.85rem;font-weight:600;color:var(--ink2);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bar-track{flex:1;height:10px;border-radius:99px;background:var(--line2);overflow:hidden}
  .bar-fill{height:100%;border-radius:99px;background:var(--grad);transform-origin:left center;
    animation:barGrow .7s cubic-bezier(.22,1,.36,1) both;animation-delay:var(--d,0ms)}
  @keyframes barGrow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .bar-n{width:34px;text-align:right;font-weight:750;font-size:.9rem;color:var(--navy)}
  @media (max-width:520px){ .bar-lbl{width:96px} }

  /* ---- dashboard polish (apple-design pass) ----
     Motion grammar: everything enters with the same critically-damped curve
     (cubic-bezier(.22,1,.36,1) ~ a settled spring, no overshoot because
     nothing here carried user momentum), staggered top-to-bottom so the eye
     is led down the page. Feedback is on press (:active, instant), hover
     lifts are subtle, and prefers-reduced-motion collapses all of it to
     simple fades. */
  /* Depth: a faint cool wash at the top of the scroll area so cards read as
     material sitting on a surface, not boxes on flat gray. Cards get a softer,
     larger-radius elevation (bigger surface = deeper, softer shadow). */
  #view{background:radial-gradient(85% 420px at 50% -120px, #e7f0fe 0%, rgba(231,240,254,0) 70%)}
  .dash-anim .card{border-radius:18px;border-color:rgba(15,53,103,.07);
    box-shadow:0 1px 2px rgba(15,23,42,.04), 0 14px 34px -20px rgba(15,42,84,.18)}
  .dash-anim > *{opacity:0;transform:translateY(12px);filter:blur(5px);
    animation:dvIn .55s cubic-bezier(.22,1,.36,1) forwards}
  .dash-anim > :nth-child(1){animation-delay:.02s}
  .dash-anim > :nth-child(2){animation-delay:.08s}
  .dash-anim > :nth-child(3){animation-delay:.15s}
  .dash-anim > :nth-child(4){animation-delay:.22s}
  .dash-anim > :nth-child(5){animation-delay:.29s}
  @keyframes dvIn{to{opacity:1;transform:none;filter:none}}
  .stat-row > .stat{transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s cubic-bezier(.22,1,.36,1)}
  .stat-row > .stat:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(15,23,42,.05),0 16px 36px -14px rgba(15,42,84,.22)}
  .ph .rowlink{transition:background .15s ease}
  .ph .rowlink:active{background:rgba(25,123,255,.06)}
  .ph .btn:active,.ph .btn-ghost:active{transform:scale(.97)}
  .spark .line{stroke-dasharray:1;stroke-dashoffset:1;animation:sparkDraw 1s cubic-bezier(.4,0,.2,1) .25s forwards}
  @keyframes sparkDraw{to{stroke-dashoffset:0}}
  .spark .area{opacity:0;animation:sparkArea .5s ease .85s forwards}
  @keyframes sparkArea{to{opacity:.12}}
  .spark .dot{opacity:0;animation:dotIn .3s ease 1.1s forwards}
  @keyframes dotIn{to{opacity:1}}
  @media (prefers-reduced-motion: reduce){
    .dash-anim > *{animation:dvIn .2s ease forwards;transform:none;filter:none}
    .bar-fill{animation-duration:.01s}
    .spark .line{animation-duration:.01s;animation-delay:0s}
    .spark .area,.spark .dot{animation-duration:.01s;animation-delay:0s}
    .stat-row > .stat,.stat-row > .stat:hover{transform:none;transition:none}
  }

  /* ---- Google Calendar how-to popup ---- */
  .gc-modal{position:fixed;inset:0;z-index:120;background:rgba(8,29,61,.55);backdrop-filter:blur(3px);
    display:grid;place-items:center;padding:24px;font-family:var(--font)}
  .gc-modal[hidden]{display:none}
  .gc-modal-card{background:#fff;border-radius:20px;width:100%;max-width:740px;max-height:88vh;display:flex;flex-direction:column;
    box-shadow:0 30px 80px rgba(8,29,61,.35);overflow:hidden}
  .gc-modal-h{display:flex;align-items:center;gap:12px;padding:20px 24px;border-bottom:1px solid var(--line);flex:none}
  .gc-modal-kick{font-size:.68rem;font-weight:750;letter-spacing:.14em;text-transform:uppercase;color:var(--blue)}
  .gc-modal-t{font-size:1.2rem;font-weight:800;letter-spacing:-.4px;color:var(--navy);margin-top:2px}
  .gc-modal-open{margin-left:auto;font-size:.82rem;font-weight:650;color:var(--blue);text-decoration:none;white-space:nowrap}
  .gc-modal-open:hover{text-decoration:underline}
  .gc-modal-b{padding:22px 26px 30px;overflow-y:auto;-webkit-overflow-scrolling:touch}
  /* body typography, matched to /help/google-calendar */
  .gh-body h3{color:var(--navy);font-size:1.08rem;letter-spacing:-.3px;margin:26px 0 9px;padding-top:20px;border-top:1px solid var(--line2)}
  .gh-body h3:first-of-type{margin-top:2px;padding-top:0;border-top:0}
  .gh-body p{color:var(--ink2);line-height:1.62;margin:0 0 11px;font-size:.94rem}
  .gh-body .gh-lede{font-size:.98rem}
  .gh-body ol{color:var(--ink2);line-height:1.62;padding-left:20px;margin:0 0 13px;font-size:.94rem}
  .gh-body ol li{margin-bottom:8px}
  .gh-body b{color:var(--navy)}
  .gh-body .gh-note{background:#f4f8ff;border-left:3px solid var(--blue);border-radius:0 10px 10px 0;padding:10px 13px;font-size:.9rem}
  .gh-body .gh-table{width:100%;border-collapse:collapse;margin-top:8px;font-size:.9rem}
  .gh-body .gh-table th{text-align:left;color:var(--muted);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;padding:0 10px 7px 0}
  .gh-body .gh-table td{padding:8px 10px 8px 0;border-top:1px solid var(--line2);color:var(--ink2);vertical-align:top}
  @media (max-width:640px){
    .gc-modal{padding:0}
    .gc-modal-card{max-width:none;max-height:100vh;height:100vh;border-radius:0}
    .gc-modal-open{display:none}
  }

  .feed-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line2);font-size:.84rem}
  .feed-item:last-child{border-bottom:none}
  .feed-ic{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;flex:none;font-size:.8rem;background:#e8effd}
  .feed-item .when{margin-left:auto;font-size:.72rem;color:var(--muted);white-space:nowrap;padding-top:2px}
  .empty{padding:44px 20px;text-align:center;color:var(--muted);font-size:.88rem}
  .empty .big{font-size:1.7rem;margin-bottom:8px}
  .toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,20px);background:var(--navy);color:#fff;padding:11px 20px;border-radius:12px;font-size:.85rem;font-weight:600;opacity:0;transition:all .25s;z-index:100;box-shadow:0 16px 40px -10px rgba(10,25,48,.6)}
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .spark path.line{fill:none;stroke-width:2;stroke-linecap:round}
  .spark path.area{opacity:.12}

  /* forms + record */
  .field{margin-bottom:12px}
  .field label{display:block;font-size:.74rem;font-weight:700;color:var(--ink2);margin-bottom:5px}
  .field input,.field select,.rec-select{width:100%;border:1px solid var(--line);border-radius:10px;padding:9px 12px;outline:none;background:#fbfcfe;font-size:.9rem}
  .field input:focus,.field select:focus,.rec-select:focus{border-color:var(--blue)}
  textarea.rec-select{resize:vertical;min-height:60px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .grid3{display:grid;grid-template-columns:1fr 80px 110px;gap:10px}
