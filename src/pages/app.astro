---

// ProtectHealth CRM — the broker/admin app.
//
// Trust model (unchanged from phase 1): every byte ships to the browser with
// the ANON key. Row Level Security decides what comes back. No query here
// filters by ownership — the database already does. A broker's ph_leads /
// ph_contacts read returns only their own rows; an admin's returns everything.
// If a page ever adds a JS ownership filter, that is a bug even when it looks
// right. See "Access Control Audit" in the project.
//
// Auth (login / claim / recover / reset) is verbatim the flow shipped Aug 10 —
// password login, magic link for recovery only. The post-auth shell below is
// the new part: demo-styled sidebar CRM (Dashboard, Contacts, Leads, Pipeline,
// Calendar) reading live data. Admins additionally get links to /admin.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
const LOGO = 'https://www.protecthealth.com/assets/og-logo-source.png';
---

<!-- Standalone document on purpose: the CRM is a full-screen app and must NOT
     inherit the marketing site's header, footer, or .btn arrow chrome from
     Base.astro. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>ProtectHealth CRM</title>
  <link rel="icon" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet" />
  <style>html,body{margin:0;padding:0;height:100%;background:#f4f7fc;overflow:hidden}</style>
</head>
<body>
  <div class="ph" data-supabase-url={SUPABASE_URL} data-supabase-anon={SUPABASE_ANON} data-logo={LOGO}>

    <!-- ============ AUTH GATES (shown before the app) ============ -->
    <div class="ag-shell" data-gate>
      <div class="ag-view" data-view="loading">
        <div class="ag-center"><p class="ag-muted">Checking your session…</p></div>
      </div>

      <div class="ag-view" data-view="signin" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo" src={LOGO} alt="ProtectHealth" />
          <h1>Broker sign-in</h1>
          <p class="ag-muted">Sign in with your email and password.</p>
          <form class="ag-login-form">
            <input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="username" required />
            <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
            <button type="submit" class="ag-btn">Sign In</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small"><a href="#" class="ag-go-forgot">Forgot your password?</a></p>
        </div></div>
      </div>

      <div class="ag-view" data-view="forgot" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo" src={LOGO} alt="ProtectHealth" />
          <h1>Reset your password</h1>
          <p class="ag-muted">Enter your work email and we'll send you a link to set a new password.</p>
          <form class="ag-forgot-form">
            <input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="username" required />
            <button type="submit" class="ag-btn">Send Reset Link</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small"><a href="#" class="ag-go-signin">Back to sign in</a></p>
        </div></div>
      </div>

      <div class="ag-view" data-view="setpassword" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo" src={LOGO} alt="ProtectHealth" />
          <h1 class="ag-setpw-title">Set your password</h1>
          <p class="ag-muted ag-setpw-intro">Choose a password for your account.</p>
          <form class="ag-setpw-form">
            <input type="email" name="email" autocomplete="username" hidden readonly />
            <input type="password" name="password" placeholder="New password" autocomplete="new-password" required minlength="10" />
            <input type="password" name="confirm" placeholder="Confirm password" autocomplete="new-password" required minlength="10" />
            <button type="submit" class="ag-btn">Save Password</button>
          </form>
          <p class="ag-status" role="status" aria-live="polite"></p>
          <p class="ag-muted ag-small">At least 10 characters.</p>
        </div></div>
      </div>

      <div class="ag-view" data-view="denied" hidden>
        <div class="ag-center"><div class="ag-card">
          <img class="ag-logo" src={LOGO} alt="ProtectHealth" />
          <h1>No access</h1>
          <p class="ag-muted">You're signed in as <b data-who></b>, but that address isn't on the broker roster. If you're an admin, your dashboard is at <a href="/admin">/admin</a>. Otherwise ask the office to add you.</p>
          <button type="button" class="ag-btn ghost ag-signout">Sign out</button>
        </div></div>
      </div>
    </div>

    <!-- ============ THE APP (shown after auth) ============ -->
    <div id="app" data-app hidden>
      <aside id="sidebar">
        <div class="brand"><span class="logo-chip"><img src={LOGO} alt="ProtectHealth" /></span></div>
        <nav id="nav"></nav>
        <div class="foot">
          <div data-who-name style="color:#cdd9ec;font-weight:650"></div>
          <div data-who style="font-size:.7rem"></div>
          <div style="margin-top:10px;display:flex;gap:12px">
            <button type="button" id="edit-profile" style="color:#9fb2cc;font-size:.78rem;text-decoration:underline">Edit profile</button>
            <button type="button" class="ag-signout" style="color:#9fb2cc;font-size:.78rem;text-decoration:underline">Sign out</button>
          </div>
        </div>
      </aside>

      <div id="main">
        <header id="topbar">
          <div>
            <div id="page-title">Dashboard</div>
            <div id="page-sub">A live look at your leads, appointments and pipeline</div>
          </div>
          <div class="searchbox">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input id="global-search" placeholder="Search your contacts and leads…" />
          </div>
          <div class="tz-chip" id="clock">Vegas</div>
          <div class="avatar" id="avatar" style="background:var(--grad)">JM</div>
        </header>
        <div id="view"><div class="empty"><div class="big">◐</div>Loading…</div></div>
      </div>
    </div>

    <!-- onboarding: first-login profile capture (headshot, bio, socials, lines) -->
    <div id="onboarding" hidden></div>

    <!-- drawer + toast, shared by all modules -->
    <div id="overlay"></div>
    <aside id="drawer"></aside>
    <div class="toast" id="toast"></div>
  </div>

  <style is:global>
  /* ProtectHealth brand tokens (from the demo, matched to global.css) */
  .ph{
    --navy:#0f3567; --navy2:#17457e; --navy-deep:#081d3d;
    --blue:#197bff; --cyan:#19c8ff; --accent:#007db3;
    --teal:#0D9488; --amber:#D97706; --violet:#7C3AED; --rose:#DB2777;
    --green:#15803d; --red:#b91c1c;
    --ink:#0f172a; --ink2:#42536b; --muted:#8494ab;
    --bg:#f4f7fc; --card:#ffffff; --line:#e3e9f2; --line2:#eef2f8;
    --grad:linear-gradient(92deg,var(--blue),var(--cyan) 70%,var(--accent));
    --radius:14px; --shadow:0 1px 2px rgba(15,23,42,.05),0 8px 24px -12px rgba(15,23,42,.12);
    --font:'Bricolage Grotesque','Avenir Next','Segoe UI',system-ui,-apple-system,sans-serif;
  }
  .ph, .ph *{box-sizing:border-box}
  .ph button{font-family:inherit;cursor:pointer;border:none;background:none;font-size:inherit;color:inherit}
  .ph input,.ph select,.ph textarea{font-family:inherit;font-size:.92rem;color:var(--ink)}

  /* ---- auth gates ---- */
  .ag-shell[hidden]{display:none}
  .ag-center{min-height:100vh;display:grid;place-items:center;background:var(--bg);padding:20px}
  .ag-card{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:34px 32px;max-width:420px;width:100%;text-align:left}
  .ag-logo{height:34px;width:auto;margin-bottom:18px;display:block}
  .ag-card h1{font-size:1.5rem;font-weight:800;letter-spacing:-.5px;color:var(--navy);margin:0 0 8px}
  .ag-muted{color:var(--muted);font-size:.92rem;line-height:1.5}
  .ag-small{font-size:.86rem;margin-top:12px}
  .ag-small a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}
  .ag-login-form,.ag-forgot-form,.ag-setpw-form{display:grid;gap:10px;margin-top:18px}
  .ag-login-form input,.ag-forgot-form input,.ag-setpw-form input{border:1.5px solid rgba(15,53,103,.16);border-radius:11px;padding:12px 14px;font-size:1rem}
  .ag-login-form input:focus,.ag-forgot-form input:focus,.ag-setpw-form input:focus{outline:none;border-color:var(--blue)}
  .ag-login-form input[hidden],.ag-forgot-form input[hidden],.ag-setpw-form input[hidden]{display:none}
  .ag-btn{background:var(--grad);color:#fff;border-radius:99px;padding:12px 18px;font-weight:700;font-size:.95rem;box-shadow:0 4px 14px -5px rgba(25,123,255,.55);transition:transform .12s}
  .ag-btn:active{transform:scale(.98)}
  .ag-btn.ghost{background:none;border:1px solid var(--line);color:var(--ink2);box-shadow:none}
  .ag-status{margin-top:10px;font-size:.9rem;color:var(--muted);min-height:1.2em}
  .ag-status.is-bad{color:#c0392b}

  /* ---- shell ---- */
  #app{display:grid;grid-template-columns:232px 1fr;height:100vh;background:var(--bg);color:var(--ink);font-family:var(--font)}
  #app[hidden]{display:none}
  #sidebar{background:linear-gradient(170deg,var(--navy-deep) 0%,var(--navy) 55%,var(--navy2) 100%);color:#dbe6f5;display:flex;flex-direction:column;overflow-y:auto}
  .brand{padding:16px 14px 12px}
  .brand .logo-chip{background:#fff;border-radius:13px;padding:10px 12px;display:block;box-shadow:0 6px 18px -8px rgba(8,29,61,.7)}
  .brand .logo-chip img{display:block;width:100%;height:auto}
  .nav-sec{font-size:.66rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#5f7396;padding:14px 20px 6px}
  .nav-item{display:flex;align-items:center;gap:11px;padding:9px 18px;margin:1px 10px;border-radius:10px;font-size:.9rem;font-weight:500;color:#b9c8dd;transition:background .15s,color .15s;position:relative;white-space:nowrap;width:calc(100% - 20px);text-align:left}
  .nav-item:hover{background:rgba(255,255,255,.06);color:#fff}
  .nav-item.active{background:rgba(25,123,255,.22);color:#fff;font-weight:650}
  .nav-item.active::before{content:"";position:absolute;left:-10px;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--grad)}
  .nav-item svg{width:17px;height:17px;flex:none;opacity:.85}
  .nav-item .count{margin-left:auto;font-size:.68rem;font-weight:700;background:rgba(255,255,255,.1);padding:2px 7px;border-radius:99px;color:#9fb2cc}
  #sidebar .foot{margin-top:auto;padding:14px 18px 18px;font-size:.72rem;color:#5f7396;line-height:1.5}

  #main{display:flex;flex-direction:column;min-width:0;height:100vh}
  #topbar{display:flex;align-items:center;gap:14px;padding:12px 26px;background:rgba(255,255,255,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);flex:none;z-index:20}
  #page-title{font-size:1.22rem;font-weight:800;letter-spacing:-.4px}
  #page-sub{font-size:.78rem;color:var(--muted);margin-top:1px}
  .searchbox{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:99px;padding:7px 14px;width:270px}
  .searchbox input{border:none;outline:none;background:none;width:100%}
  .searchbox svg{width:15px;height:15px;color:var(--muted);flex:none}
  .tz-chip{font-size:.74rem;color:var(--ink2);background:var(--card);border:1px solid var(--line);border-radius:99px;padding:6px 12px;white-space:nowrap}
  .avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-size:.72rem;font-weight:700;color:#fff;flex:none;overflow:hidden}
  .avatar img{width:34px;height:34px;object-fit:cover;object-position:center;border-radius:50%;display:block}

  #view{flex:1;overflow-y:auto;padding:22px 26px 60px;scroll-behavior:smooth}
  .view-grid{display:grid;gap:16px}

  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);position:relative;overflow:hidden}
  .card-h{display:flex;align-items:center;gap:10px;padding:15px 18px 0}
  .card-h h3{font-size:.95rem;font-weight:750;letter-spacing:-.2px}
  .card-h .sub{font-size:.75rem;color:var(--muted)}
  .card-h .right{margin-left:auto;display:flex;align-items:center;gap:8px}
  .card-b{padding:14px 18px 16px}
  .grad-label{font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .stat{padding:16px 18px}
  .stat .lbl{font-size:.74rem;font-weight:650;color:var(--ink2)}
  .stat .num{font-size:1.9rem;font-weight:800;letter-spacing:-1px;margin-top:5px;font-variant-numeric:tabular-nums}
  .stat .delta{font-size:.74rem;font-weight:650;margin-top:3px}
  .stat .delta.up{color:var(--green)} .stat .delta.flat{color:var(--muted)}
  .stat .tick{position:absolute;top:0;left:18px;right:18px;height:3px;border-radius:0 0 4px 4px;background:var(--grad);opacity:.85}

  .btn{display:inline-flex;align-items:center;gap:7px;padding:8px 15px;border-radius:99px;font-size:.85rem;font-weight:650;transition:transform .12s;white-space:nowrap}
  .btn:active{transform:scale(.97)}
  .btn-primary{background:var(--grad);color:#fff;box-shadow:0 4px 14px -5px rgba(25,123,255,.55)}
  .btn-ghost{border:1px solid var(--line);background:var(--card);color:var(--ink2)}
  .btn-sm{padding:5px 11px;font-size:.78rem}

  .chip{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;font-weight:600;padding:3px 9px;border-radius:99px;background:var(--line2);color:var(--ink2);white-space:nowrap}
  .chip.tag{background:#e7f2f8;color:#005f88}
  .pill-status{display:inline-flex;align-items:center;gap:6px;font-size:.73rem;font-weight:700;padding:3px 10px;border-radius:99px}
  .st-green{background:#e7f5ec;color:#15803d}.st-blue{background:#e8effd;color:#1d4ed8}
  .st-amber{background:#fdf1e2;color:#b45309}.st-red{background:#fdeaea;color:#b91c1c}
  .st-gray{background:var(--line2);color:var(--ink2)}.st-violet{background:#f1eafd;color:#6d28d9}
  .st-teal{background:#e2f5f2;color:#0f766e}

  table.data{width:100%;border-collapse:collapse;font-size:.86rem}
  table.data th{text-align:left;font-size:.7rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:10px 14px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--card);z-index:2;white-space:nowrap}
  table.data td{padding:11px 14px;border-bottom:1px solid var(--line2);vertical-align:middle}
  table.data tr.rowlink{cursor:pointer;transition:background .12s}
  table.data tr.rowlink:hover{background:#f7faff}
  .cell-name{display:flex;align-items:center;gap:10px;font-weight:650}
  .cell-sub{font-size:.74rem;color:var(--muted);font-weight:400;margin-top:1px}
  .toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 18px;border-bottom:1px solid var(--line2)}
  .toolbar select,.toolbar input[type=text]{border:1px solid var(--line);border-radius:9px;padding:7px 11px;background:var(--card);outline:none}
  .toolbar select:focus,.toolbar input:focus{border-color:var(--blue)}
  .pager{display:flex;align-items:center;gap:8px;padding:12px 18px;font-size:.8rem;color:var(--ink2)}
  .pager button{border:1px solid var(--line);border-radius:8px;padding:4px 10px;background:var(--card)}
  .pager button:disabled{opacity:.4;cursor:default}
  .avatar-sm{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:.68rem;font-weight:700;color:#fff;flex:none}

  #overlay{position:fixed;inset:0;background:rgba(10,25,48,.45);opacity:0;pointer-events:none;transition:opacity .22s;z-index:50}
  #overlay.on{opacity:1;pointer-events:auto}
  #drawer{position:fixed;top:0;right:-560px;width:560px;max-width:94vw;height:100vh;background:var(--card);z-index:60;transition:right .26s cubic-bezier(.3,.8,.3,1);box-shadow:-18px 0 50px -20px rgba(10,25,48,.35);display:flex;flex-direction:column}
  #drawer.on{right:0}
  .drawer-h{padding:20px 22px 14px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:14px;flex:none}
  .drawer-b{flex:1;overflow-y:auto;padding:18px 22px 40px}
  .drawer-x{margin-left:auto;width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:var(--muted);border:1px solid var(--line)}
  .kv{display:grid;grid-template-columns:130px 1fr;gap:7px 12px;font-size:.85rem}
  .kv .k{color:var(--muted);font-weight:600;font-size:.78rem;padding-top:1px}
  .kv .v{font-weight:550}
  .section-t{font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:20px 0 10px;display:flex;align-items:center;gap:8px}
  .section-t::after{content:"";flex:1;height:1px;background:var(--line)}

  #kanban{display:flex;gap:14px;overflow-x:auto;padding-bottom:18px;align-items:flex-start}
  .kcol{flex:0 0 268px;background:#eef2f9;border:1px solid var(--line);border-radius:14px;max-height:calc(100vh - 240px);display:flex;flex-direction:column}
  .kcol-h{padding:12px 14px 8px;flex:none}
  .kcol-h .t{display:flex;align-items:center;gap:8px;font-size:.83rem;font-weight:750}
  .kcol-h .meta{font-size:.72rem;color:var(--muted);margin-top:3px;font-variant-numeric:tabular-nums}
  .kcol-b{padding:4px 10px 12px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;min-height:60px}
  .kcard{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:11px 12px;cursor:grab;box-shadow:0 1px 2px rgba(15,23,42,.06);transition:box-shadow .15s,transform .15s}
  .kcard:hover{box-shadow:0 6px 16px -6px rgba(15,23,42,.18)}
  .kcard.dragging{opacity:.45;transform:rotate(2deg)}
  .kcard .nm{font-weight:700;font-size:.87rem}
  .kcard .meta{display:flex;align-items:center;gap:6px;margin-top:7px;font-size:.72rem;color:var(--muted)}
  .kcol-b.dropover{outline:2px dashed var(--blue);outline-offset:-4px;border-radius:11px;background:#e8effd66}

  .cal-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .cal-title{font-size:1.15rem;font-weight:800;letter-spacing:-.3px;min-width:190px}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line);border-radius:0 0 12px 12px;overflow:hidden}
  .cal-dow{background:#f0f4fa;font-size:.7rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:8px 10px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .cal-cell{background:var(--card);min-height:104px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px;position:relative;overflow:hidden}
  .cal-cell.dim{background:#f8fafd}
  .cal-cell .dnum{font-size:.76rem;font-weight:700;color:var(--ink2);width:24px;height:24px;display:grid;place-items:center;border-radius:50%}
  .cal-cell.today .dnum{background:var(--blue);color:#fff}
  .cal-ev{font-size:.7rem;font-weight:650;padding:2px 7px;border-radius:6px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;color:#fff;background:var(--blue)}
  .cal-ev.bday{background:#fdf1e2;color:#b45309}

  .feed-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line2);font-size:.84rem}
  .feed-item:last-child{border-bottom:none}
  .feed-ic{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;flex:none;font-size:.8rem;background:#e8effd}
  .feed-item .when{margin-left:auto;font-size:.72rem;color:var(--muted);white-space:nowrap;padding-top:2px}
  .empty{padding:44px 20px;text-align:center;color:var(--muted);font-size:.88rem}
  .empty .big{font-size:1.7rem;margin-bottom:8px}
  .toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,20px);background:var(--navy);color:#fff;padding:11px 20px;border-radius:12px;font-size:.85rem;font-weight:600;opacity:0;transition:all .25s;z-index:100;box-shadow:0 16px 40px -10px rgba(10,25,48,.6)}
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .spark path.line{fill:none;stroke-width:2;stroke-linecap:round}
  .spark path.area{opacity:.12}

  /* forms + record */
  .field{margin-bottom:12px}
  .field label{display:block;font-size:.74rem;font-weight:700;color:var(--ink2);margin-bottom:5px}
  .field input,.field select,.rec-select{width:100%;border:1px solid var(--line);border-radius:10px;padding:9px 12px;outline:none;background:#fbfcfe;font-size:.9rem}
  .field input:focus,.field select:focus,.rec-select:focus{border-color:var(--blue)}
  textarea.rec-select{resize:vertical;min-height:60px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .grid3{display:grid;grid-template-columns:1fr 80px 110px;gap:10px}
  .pickgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}
  .pickbox{display:flex;align-items:center;gap:7px;font-size:.84rem;padding:5px 2px;cursor:pointer}
  .pickbox input{width:15px;height:15px;flex:none}
  .dep-row{margin-bottom:10px;padding:10px;border:1px solid var(--line2);border-radius:10px;background:#fbfcfe}
  .dep-row input{border:1px solid var(--line);border-radius:8px;padding:7px 9px;font-size:.85rem;background:#fff;width:100%}
  .rec-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:16px;align-items:start}
  .rec-grid .card-b{max-height:none}
  @media(max-width:1150px){.rec-grid{grid-template-columns:1fr}}

  /* onboarding */
  #onboarding{position:fixed;inset:0;z-index:90;background:var(--bg)}
  #onboarding[hidden]{display:none}
  .ob-scroll{height:100vh;overflow-y:auto;display:flex;justify-content:center;padding:32px 20px 60px}
  .ob-card{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:34px 34px 30px;max-width:560px;width:100%;height:max-content}
  .ob-card h1{font-size:1.6rem;font-weight:800;letter-spacing:-.5px;color:var(--navy);margin:14px 0 8px}
  .ob-photo{display:flex;gap:16px;align-items:flex-start}
  .ob-photo-preview{width:96px;height:96px;border-radius:14px;background:#eef2f9;border:1px solid var(--line);display:grid;place-items:center;overflow:hidden;flex:none;color:var(--muted);font-size:.72rem;text-align:center}
  .ob-photo-preview img{width:100%;height:100%;object-fit:cover}
  @media(max-width:1100px){.stat-row{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:820px){#app{grid-template-columns:1fr}#sidebar{position:fixed;left:-240px;top:0;bottom:0;width:232px;z-index:80;transition:left .2s}#app.nav-open #sidebar{left:0}.searchbox{display:none}}
  /* Contacts filters + columns */
  .fpanel{border-bottom:1px solid var(--line);background:#f9fbfe;padding:16px 18px}
  .fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(200px,100%),1fr));gap:12px}
  .ffield{display:flex;flex-direction:column;gap:5px}
  .ffield>span{font-size:.7rem;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
  .ffield select,.ffield input{padding:9px 10px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:.88rem;background:#fff;color:var(--navy)}
  .frange{display:flex;align-items:center;gap:6px}
  .frange input{width:100%;min-width:0}
  .frange span{color:var(--muted)}
  .factions{display:flex;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}
  .fchips{display:flex;gap:8px;flex-wrap:wrap;padding:10px 18px;border-bottom:1px solid var(--line)}
  .fchip{display:inline-flex;align-items:center;gap:7px;background:#eaf1fd;border:1px solid #cddcf7;color:var(--blue);font-weight:650;font-size:.8rem;border-radius:999px;padding:5px 8px 5px 12px}
  .fchip button{background:none;border:0;color:var(--blue);cursor:pointer;font-size:.72rem;padding:2px 4px;border-radius:50%}
  .fchip button:hover{background:#d9e6fb}
  .fchip-n{display:inline-grid;place-items:center;background:var(--blue);color:#fff;border-radius:999px;min-width:17px;height:17px;font-size:.68rem;font-weight:800;padding:0 4px;margin-left:4px}
  .colpop{display:flex;flex-wrap:wrap;gap:8px;padding:14px 18px;border-bottom:1px solid var(--line);background:#f9fbfe}
  /* People | Companies toggle, policies, inline custom fields */
  .seg{display:flex;border:1px solid var(--line);border-radius:11px;overflow:hidden}
  .seg-btn{background:#fff;border:0;padding:9px 16px;font-weight:650;color:var(--muted);cursor:pointer;font-size:.88rem}
  .seg-btn.on{background:var(--blue);color:#fff}
  .pol-row{border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:8px;cursor:pointer;transition:border-color .12s, box-shadow .12s}
  .pol-row:hover{border-color:#bcd0ee;box-shadow:0 4px 12px rgba(11,42,74,.07)}
  .pol-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:2px}
  .pol-prem{font-weight:750;color:var(--navy);font-size:.95rem;margin-top:2px}
  .pol-prem em{color:var(--muted);font-style:normal;font-weight:600;font-size:.8rem}
  .cf-inline{width:100%;border:1px solid transparent;border-radius:8px;padding:4px 6px;font-family:inherit;font-size:.86rem;color:var(--navy);background:transparent;transition:border-color .12s, background .12s}
  .cf-inline:hover{border-color:var(--line);background:#fbfdff}
  .cf-inline:focus{outline:none;border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(37,99,201,.12)}
  /* Availability editor */
  .av-days{display:flex;flex-direction:column;gap:2px}
  .av-day{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 4px;border-bottom:1px solid var(--line)}
  .av-day:last-child{border-bottom:0}
  .av-toggle{display:flex;align-items:center;gap:10px;font-weight:650;color:var(--navy);cursor:pointer;min-width:120px}
  .av-toggle input{width:18px;height:18px;accent-color:var(--blue);cursor:pointer}
  .av-times{display:flex;align-items:center;gap:8px}
  .av-times input[type=time]{padding:8px 10px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:.92rem;background:#fff;color:var(--navy)}
  .av-times input:disabled{opacity:.4;background:#f6f9fe}
  .av-to{color:var(--muted);font-size:.85rem}
  .av-rules{display:grid;gap:14px}
  .av-field{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .av-field>span{font-weight:650;color:var(--navy);font-size:.92rem}
  .av-field select,.av-field input{padding:10px 12px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:.92rem;background:#fff;color:var(--navy)}
  .av-field input:disabled{opacity:.6;background:#f6f9fe}
  .av-inline{display:flex;align-items:center;gap:8px}
  .av-inline input{width:80px}
  .av-inline em{color:var(--muted);font-style:normal;font-size:.88rem}
  .av-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:4px}
  .av-status{font-weight:650;font-size:.9rem}
  .av-preview{margin-left:auto;color:var(--blue);font-weight:650;text-decoration:none;font-size:.9rem}
  @media(max-width:560px){.av-day{flex-direction:column;align-items:flex-start;gap:8px}.av-field{flex-direction:column;align-items:flex-start;gap:6px}.av-preview{margin-left:0}}
  </style>

  <script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector('.ph');
  if (root) {
    const sb = createClient(
      root.getAttribute('data-supabase-url'),
      root.getAttribute('data-supabase-anon'),
      { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } },
    );
    const LOGO = root.getAttribute('data-logo');

    const gate = root.querySelector('[data-gate]');
    const app = root.querySelector('[data-app]');
    const $ = (s, r = root) => r.querySelector(s);
    const $$ = (s, r = root) => Array.from(r.querySelectorAll(s));
    const view = (name) =>
      $$('.ag-view').forEach((v) => (v.hidden = v.getAttribute('data-view') !== name));

    const TZ = 'America/Los_Angeles';
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fmtDate = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric' }) : '';
    const fmtDateTime = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const fmtFull = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const nameOf = (r) => [r.first_name, r.last_name].filter(Boolean).join(' ') || r.email || r.phone || 'Unknown';
    const fmtPhone = (p) => { const d = String(p ?? '').replace(/\D/g, '').replace(/^1/, ''); return d.length === 10 ? `(${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}` : (p || ''); };
    const initials = (n) => String(n || '?').trim().split(/\s+/).slice(0,2).map((w) => w[0]).join('').toUpperCase();
    const AV = ['#197bff','#0D9488','#7C3AED','#D97706','#DB2777','#007db3','#15803d'];
    const avColor = (s) => AV[[...String(s||'')].reduce((a,c)=>a+c.charCodeAt(0),0) % AV.length];

    const toast = (msg) => {
      const t = $('#toast'); t.textContent = msg; t.classList.add('on');
      clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove('on'), 2200);
    };

    // ================= AUTH (verbatim from the Aug 10 flow) =================
    const AUTH_FN = `${root.getAttribute('data-supabase-url')}/functions/v1/ph-auth`;
    const authPost = async (body) => {
      const res = await fetch(AUTH_FN, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      let json = {}; try { json = await res.json(); } catch {}
      return { ok: res.ok, status: res.status, json };
    };
    const statusIn = (v) => root.querySelector(`.ag-view[data-view="${v}"] .ag-status`);
    const setStatus = (v, text, bad = false) => { const el = statusIn(v); if (!el) return; el.textContent = text; el.classList.toggle('is-bad', !!bad); };

    $('.ag-go-forgot')?.addEventListener('click', (e) => {
      e.preventDefault(); setStatus('signin', '');
      const typed = $('.ag-login-form')?.email?.value?.trim();
      if (typed) $('.ag-forgot-form').email.value = typed;
      view('forgot');
    });
    $('.ag-go-signin')?.addEventListener('click', (e) => { e.preventDefault(); setStatus('forgot', ''); view('signin'); });

    $('.ag-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const email = e.target.email.value.trim(); const password = e.target.password.value;
      btn.disabled = true; setStatus('signin', 'Signing in…');
      const { data, error } = await sb.auth.signInWithPassword({ email, password });
      if (error) { btn.disabled = false; setStatus('signin', 'That email and password did not match. Try again, or use Forgot your password.', true); return; }
      e.target.password.value = '';
      await enter(data?.session?.user?.email ?? email);
    });

    $('.ag-forgot-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]'); btn.disabled = true;
      setStatus('forgot', 'Sending…');
      await authPost({ action: 'recover', email: e.target.email.value.trim() });
      btn.disabled = false;
      setStatus('forgot', 'If that address is on the roster, a reset link is on its way. It expires in 60 minutes.');
    });

    let claimToken = null;
    $('.ag-setpw-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const password = e.target.password.value, confirm = e.target.confirm.value;
      if (password !== confirm) { setStatus('setpassword', 'Those two passwords do not match.', true); return; }
      if (password.length < 10) { setStatus('setpassword', 'Password must be at least 10 characters.', true); return; }
      btn.disabled = true; setStatus('setpassword', 'Saving…');
      if (claimToken) {
        const { ok, json } = await authPost({ action: 'claim', token: claimToken, password });
        if (!ok) { btn.disabled = false; setStatus('setpassword', json.error || 'That link is no longer valid.', true); return; }
        const { error } = await sb.auth.signInWithPassword({ email: json.email, password });
        if (error) { btn.disabled = false; setStatus('setpassword', 'Password saved. Please sign in.', true); view('signin'); return; }
        claimToken = null; history.replaceState({}, '', '/app');
        await enter(json.email); return;
      }
      const { error } = await sb.auth.updateUser({ password });
      if (error) { btn.disabled = false; setStatus('setpassword', error.message, true); return; }
      const { data } = await sb.auth.getSession();
      const who = data?.session?.user?.email;
      if (!who) { view('signin'); return; }
      history.replaceState({}, '', '/app');
      await enter(who);
    });

    $$('.ag-signout').forEach((b) => b.addEventListener('click', async () => { await sb.auth.signOut(); location.reload(); }));

    // ================= SESSION → APP =================
    const state = { me: null, isAdmin: false, leads: [], contacts: [], stages: [], calendars: [], contactCount: 0, carriers: [], pipelines: [], pipelineStages: [], opps: [], appts: [], mySched: null, companies: [], customFields: [], adminTags: [] };

    // Fixed vocabularies from Rob's spec.
    const DISPOSITIONS = ['Lead', 'Active Client', 'Follow-Up', 'Not Interested', 'No Answer', 'Wrong Number', 'Do Not Call'];
    const POLICY_STATUSES = ['Quoted', 'Applied', 'Pending', 'Issued', 'Active', 'Lapsed', 'Cancelled', 'Declined'];
    const PREMIUM_FREQS = ['Monthly', 'Quarterly', 'Semi-Annual', 'Annual', 'Single'];
    const fmtMoney = (n) => n == null || n === '' ? '' : '$' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    // Matches the pipeline lines one-to-one, so a checked line maps straight to
    // its pipeline (see ph_cov_to_line). Legacy labels still map server-side.
    const COVERAGE_TYPES = ['Health', 'Medicare', 'Dental', 'Vision', 'Life', 'Annuities', 'Group Benefits', 'Supplements', 'Accident / Gap'];
    const dispClass = (d) => ({
      'Active Client': 'st-green', 'Lead': 'st-blue', 'Follow-Up': 'st-amber',
      'Not Interested': 'st-gray', 'No Answer': 'st-gray', 'Wrong Number': 'st-red', 'Do Not Call': 'st-red',
    }[d] || 'st-gray');

    // Identity guard: /app and /admin share one Supabase session per browser,
    // so signing into one as a different person silently swaps the token under
    // any open tab. Without this, a tab keeps showing the OLD person's name
    // while every query runs as the NEW session (e.g. an admin's all-access
    // view rendered under a broker's name). If the live session user changes,
    // reload so the UI rebinds to who is actually signed in.
    let bootEmail = null;
    sb.auth.onAuthStateChange((_e, session) => {
      const now = session?.user?.email || null;
      if (bootEmail && now && now.toLowerCase() !== bootEmail.toLowerCase()) location.reload();
    });
    window.addEventListener('focus', async () => {
      if (!bootEmail) return;
      try {
        const { data } = await sb.auth.getSession();
        const now = data?.session?.user?.email;
        if (now && now.toLowerCase() !== bootEmail.toLowerCase()) location.reload();
      } catch {}
    });

    async function enter(email) {
      bootEmail = email;
      $$('[data-who]').forEach((el) => (el.textContent = email));

      // Prefer the LOCAL session for the uid — it is present the instant login
      // succeeds. getUser() validates against the server and can briefly return
      // null right after sign-in, which would leave state.uid empty.
      let uid = null;
      const { data: sess } = await sb.auth.getSession();
      uid = sess?.session?.user?.id ?? null;
      if (!uid) { const { data: authUser } = await sb.auth.getUser(); uid = authUser?.user?.id ?? null; }
      // Identity by UID first (roster emails change); email fallback only for a
      // roster row not yet linked to a login.
      const PROFILE_COLS = 'id, full_name, is_active, bio, headshot_url, social_links, lines_of_insurance, onboarding_completed_at';
      let me = null;
      if (uid) {
        const { data } = await sb.from('ph_agents').select(PROFILE_COLS).eq('auth_user_id', uid).limit(1);
        me = data?.[0] ?? null;
      }
      if (!me) {
        const { data } = await sb.from('ph_agents').select(PROFILE_COLS).ilike('email', email).limit(1);
        me = data?.[0] ?? null;
      }
      // Admin check is independent of the roster: some admins are not brokers.
      const { data: adminRows } = await sb.from('ph_admins').select('email').limit(1);
      state.isAdmin = Array.isArray(adminRows) && adminRows.length > 0;

      if (!me && !state.isAdmin) { view('denied'); return; }
      state.me = me || { full_name: email };
      state.uid = uid;

      // First login: a broker who hasn't finished their profile lands on the
      // onboarding form before the dashboard — Rob's "collect it all in the room"
      // step. Admins are never gated by it (they may not want a broker landing
      // page); they can still build one anytime via Edit profile.
      if (me && !me.onboarding_completed_at && !state.isAdmin) { openOnboarding(email); return; }
      enterApp(email);
    }

    $('#edit-profile')?.addEventListener('click', () => { if (state.email) openOnboarding(state.email, { editing: true }); });

    function enterApp(email) {
      state.email = email;
      $$('[data-who]').forEach((el) => (el.textContent = email));
      gate.hidden = true; $('#onboarding').hidden = true; app.hidden = false;
      const nm = state.me.full_name || email;
      $('[data-who-name]').textContent = nm;
      paintAvatar();
      startClock();
      buildNav();
      loadData().then(() => go(location.hash.replace('#', '') || 'dashboard'));
    }

    // Top-right avatar: show the broker's headshot if they have one, else initials.
    function paintAvatar() {
      const av = $('#avatar'); if (!av) return;
      const nm = state.me?.full_name || state.email || '';
      if (state.me?.headshot_url) {
        av.textContent = '';
        av.style.background = 'transparent';
        av.innerHTML = `<img src="${esc(state.me.headshot_url)}" alt=""/>`;
      } else {
        av.innerHTML = '';
        av.style.background = 'var(--grad)';
        av.textContent = initials(nm);
      }
    }

    // ================= ONBOARDING / PROFILE =================
    const BROKER_LINES = ['Health', 'Medicare', 'Dental', 'Vision', 'Life', 'Annuities', 'Group Benefits', 'Supplements', 'Accident / Gap'];
    let pendingHeadshotFile = null;

    function openOnboarding(email, opts = {}) {
      const editing = opts.editing === true;
      const me = state.me;
      const socials = me.social_links || {};
      const lines = new Set(me.lines_of_insurance || []);
      const firstName = String(me.full_name || '').split(' ')[0] || 'there';
      const lineOpts = BROKER_LINES.map((l) => `<label class="pickbox"><input type="checkbox" data-line="${esc(l)}" ${lines.has(l) ? 'checked' : ''}/> ${esc(l)}</label>`).join('');
      const el = $('#onboarding');
      el.innerHTML = `
        <div class="ob-scroll"><div class="ob-card">
          <img class="ag-logo" src="${LOGO}" alt="ProtectHealth" />
          <h1>${editing ? 'Edit your profile' : 'Welcome, ' + esc(firstName)}</h1>
          <p class="ag-muted">${editing ? 'Update how you appear on your landing page and Meet the Team.' : 'This sets up your ProtectHealth landing page and your Meet the Team profile. Takes two minutes.'}</p>

          <div class="section-t">Headshot</div>
          <div class="ob-photo">
            <div class="ob-photo-preview" id="ob-preview">${me.headshot_url ? `<img src="${esc(me.headshot_url)}" alt=""/>` : '<span>No photo yet</span>'}</div>
            <div>
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">Choose photo<input type="file" id="ob-file" accept="image/png,image/jpeg,image/webp" hidden/></label>
              <div class="hint">A clear, front-facing photo. JPG or PNG, up to 8&nbsp;MB. You can retake it anytime.</div>
            </div>
          </div>

          <div class="section-t">Short bio</div>
          <textarea id="ob-bio" class="rec-select" rows="4" maxlength="600" placeholder="A few sentences prospects will read on your page. Who you help and how.">${esc(me.bio || '')}</textarea>

          <div class="section-t">Social links <span class="ag-muted" style="font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></div>
          <div class="field"><label>LinkedIn</label><input id="ob-linkedin" value="${esc(socials.linkedin || '')}" placeholder="https://linkedin.com/in/…"/></div>
          <div class="grid2">
            <div class="field"><label>Facebook</label><input id="ob-facebook" value="${esc(socials.facebook || '')}" placeholder="https://facebook.com/…"/></div>
            <div class="field"><label>Instagram</label><input id="ob-instagram" value="${esc(socials.instagram || '')}" placeholder="https://instagram.com/…"/></div>
          </div>
          <div class="field"><label>Website</label><input id="ob-website" value="${esc(socials.website || '')}" placeholder="https://…"/></div>

          <div class="section-t">Lines of insurance you write</div>
          <div class="hint" style="margin-bottom:8px">This decides which sections show on your landing page — a Medicare writer won't show a health-only page.</div>
          <div class="pickgrid">${lineOpts}</div>

          <div style="display:flex;gap:10px;margin-top:24px;align-items:center">
            <button class="ag-btn" id="ob-save">${editing ? 'Save profile' : 'Save & continue'}</button>
            ${editing ? '<button class="btn btn-ghost" id="ob-cancel">Cancel</button>' : '<button class="btn btn-ghost" id="ob-skip">Skip for now</button>'}
            <span class="ag-status ob-status" style="min-height:1em"></span>
          </div>
        </div></div>`;
      gate.hidden = true; app.hidden = editing ? false : true; el.hidden = false;
      if (editing) app.hidden = true; // full-screen while editing too

      pendingHeadshotFile = null;
      $('#ob-file').addEventListener('change', (e) => {
        const f = e.target.files[0]; if (!f) return;
        if (f.size > 8 * 1024 * 1024) { setObStatus('That image is over 8 MB. Choose a smaller one.', true); return; }
        pendingHeadshotFile = f;
        const rd = new FileReader();
        rd.onload = () => { $('#ob-preview').innerHTML = `<img src="${rd.result}" alt=""/>`; };
        rd.readAsDataURL(f);
      });
      $('#ob-save').addEventListener('click', () => saveOnboarding(email, editing));
      $('#ob-skip')?.addEventListener('click', () => enterApp(email));
      $('#ob-cancel')?.addEventListener('click', () => enterApp(email));
    }
    const setObStatus = (t, bad = false) => { const el = $('.ob-status'); if (el) { el.textContent = t; el.classList.toggle('is-bad', !!bad); } };

    async function saveOnboarding(email, editing) {
      const btn = $('#ob-save'); btn.disabled = true; setObStatus('Saving…');
      let headshot_url = state.me.headshot_url || null;

      // Storage RLS on broker-photos grants INSERT to the `authenticated` role
      // ONLY, so the upload request must carry a valid, unexpired user token.
      // On a page reload Supabase restores the session as INITIAL_SESSION (not
      // SIGNED_IN), and the short-lived access token can go stale while the
      // broker sits on this form. When that happens the SDK's storage upload
      // sends a token the server rejects, the request is treated as `anon`,
      // and the insert fails with "new row violates row-level security policy"
      // even though the path carries the correct uid. Force a fresh token here
      // and send it explicitly so auth.uid() is always set server-side.
      let { data: { session } } = await sb.auth.getSession();
      const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
      if (session && stale) {
        const r = await sb.auth.refreshSession();
        if (r?.data?.session) session = r.data.session;
      }
      const token = session?.access_token || null;
      let uid = session?.user?.id || state.uid || null;
      state.uid = uid;
      if (!uid || !token) { btn.disabled = false; setObStatus('Your session expired. Please sign out and back in.', true); return; }

      // Upload the headshot through the server (ph-upload-headshot). The browser
      // could not reliably attach a Storage-valid token to a direct upload, so
      // the file is handed to a function that verifies the caller and writes it
      // with the service role. The stored path stays pinned to this uid, so a
      // broker can still only ever write into their own folder.
      if (pendingHeadshotFile) {
        const base = root.getAttribute('data-supabase-url');
        const anon = root.getAttribute('data-supabase-anon');
        const fd = new FormData();
        fd.append('file', pendingHeadshotFile);
        const resp = await fetch(`${base}/functions/v1/ph-upload-headshot`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, apikey: anon },
          body: fd,
        });
        const up = await resp.json().catch(() => ({}));
        if (!resp.ok || !up?.url) {
          btn.disabled = false;
          setObStatus('Photo upload failed: ' + (up?.error || ('error ' + resp.status)), true);
          return;
        }
        headshot_url = up.url;
      }

      const social_links = {};
      for (const k of ['linkedin', 'facebook', 'instagram', 'website']) {
        const v = $('#ob-' + k)?.value?.trim();
        if (v) social_links[k] = v;
      }
      const lines_of_insurance = $$('[data-line]').filter((c) => c.checked).map((c) => c.getAttribute('data-line'));
      const patch = {
        bio: $('#ob-bio').value.trim() || null,
        headshot_url,
        social_links,
        lines_of_insurance,
        onboarding_completed_at: new Date().toISOString(),
      };
      const { error } = await sb.from('ph_agents').update(patch).eq('auth_user_id', uid);
      if (error) { btn.disabled = false; setObStatus('Could not save: ' + error.message, true); return; }

      Object.assign(state.me, patch);
      toast(editing ? 'Profile updated' : 'Profile saved');
      enterApp(email);
    }

    function startClock() {
      const tick = () => {
        try {
          $('#clock').textContent = new Date().toLocaleString('en-US', { timeZone: TZ, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) + ' · Vegas';
        } catch {}
      };
      tick(); setInterval(tick, 30000);
    }

    // ---- nav ----
    const IC = {
      dashboard: '<path d="M3 12h7V3H3zm0 9h7v-7H3zm11 0h7V12h-7zm0-18v7h7V3z"/>',
      contacts: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/>',
      leads: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>',
      pipeline: '<path d="M4 4h16M6.5 4l3 7v9l5-2v-7l3-7"/>',
      calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4m8-4v4M3 10h18"/>',
      availability: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
      admin: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>',
    };
    function navItem(id, label, count, extraAttr = '') {
      const c = (count != null) ? `<span class="count">${count}</span>` : '';
      return `<button class="nav-item" data-route="${id}" ${extraAttr}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC[id] || IC.dashboard}</svg>${label}${c}</button>`;
    }
    function buildNav() {
      const n = $('#nav');
      let html = '<div class="nav-sec">Overview</div>';
      html += navItem('dashboard', 'Dashboard');
      html += '<div class="nav-sec">CRM</div>';
      html += navItem('contacts', 'Contacts', state.contactCount);
      html += navItem('leads', 'Leads', state.leads.length);
      html += navItem('pipeline', 'Pipeline');
      html += navItem('calendar', 'Calendar');
      html += navItem('availability', 'Availability');
      if (state.isAdmin) {
        html += '<div class="nav-sec">Admin</div>';
        html += `<a class="nav-item" href="/admin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.leads}</svg>All Leads</a>`;
        html += `<a class="nav-item" href="/admin/campaigns"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.calendar}</svg>Campaigns</a>`;
        html += `<a class="nav-item" href="/admin/staff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.contacts}</svg>Staff</a>`;
      }
      n.innerHTML = html;
      $$('.nav-item[data-route]', n).forEach((b) => b.addEventListener('click', () => go(b.dataset.route)));
    }

    // ---- data load (RLS scopes everything to this user automatically) ----
    async function loadData() {
      const [leadsRes, stagesRes, calsRes, cntRes, carrRes, pipeRes, pstgRes, oppRes, apptRes, schedRes, coRes, cfRes, tagRes] = await Promise.all([
        sb.from('ph_leads').select('*').order('created_at', { ascending: false }).limit(2000),
        sb.from('ph_stages').select('*').order('sort_order'),
        sb.from('ph_agent_calendars').select('*'),
        sb.from('ph_contacts').select('*', { count: 'exact', head: true }),
        sb.from('ph_carriers').select('id, name, is_active').eq('is_active', true).order('name'),
        sb.from('ph_pipelines').select('*').eq('is_active', true).order('position'),
        sb.from('ph_pipeline_stages').select('*').order('position'),
        sb.from('ph_opportunities').select('*').order('created_at', { ascending: false }),
        sb.from('ph_appointments').select('*').eq('status', 'booked').order('start_at'),
        sb.from('ph_agent_scheduling').select('*'),
        sb.from('ph_companies').select('*').order('name'),
        sb.from('ph_custom_fields').select('*').eq('is_active', true).order('position'),
        sb.from('ph_tags').select('*').eq('is_active', true).order('position'),
      ]);
      state.leads = leadsRes.data ?? [];
      state.stages = stagesRes.data ?? [];
      state.calendars = calsRes.data ?? [];
      state.contactCount = cntRes.count ?? 0;
      state.carriers = carrRes.data ?? [];
      state.pipelines = pipeRes.data ?? [];
      state.pipelineStages = pstgRes.data ?? [];
      state.opps = oppRes.data ?? [];
      state.appts = apptRes.data ?? [];
      // RLS returns only this agent's scheduling row (admins may get several).
      state.mySched = (schedRes.data || []).find((s) => s.agent_id === (state.me && state.me.id)) || (schedRes.data || [])[0] || null;
      state.companies = coRes.data ?? [];
      state.customFields = cfRes.data ?? [];
      state.adminTags = tagRes.data ?? [];
    }

    // Unified appointment feed: GHL-mirror leads that carry an appointment_start
    // PLUS native bookings from ph_appointments (landing-page bookings, which
    // create a contact — not a lead — so they'd otherwise be invisible here).
    function apptEvents() {
      const fromLeads = state.leads.filter((l) => l.appointment_start).map((l) => ({
        id: l.id, when: l.appointment_start, name: nameOf(l), native: false,
      }));
      const fromNative = (state.appts || []).map((a) => ({
        id: 'appt:' + a.id, when: a.start_at, name: a.invitee_name || 'Booking',
        native: true, email: a.invitee_email, phone: a.invitee_phone, line: a.line_key,
      }));
      return fromLeads.concat(fromNative).sort((a, b) => +new Date(a.when) - +new Date(b.when));
    }
    async function reloadOpps() {
      const { data } = await sb.from('ph_opportunities').select('*').order('created_at', { ascending: false });
      state.opps = data ?? [];
    }
    async function reloadCarriers() {
      const { data } = await sb.from('ph_carriers').select('id, name, is_active').order('name');
      state.carriers = (data ?? []).filter((c) => c.is_active);
      state.allCarriers = data ?? [];
    }

    // ---- router ----
    const TITLES = {
      dashboard: ['Dashboard', 'A live look at your leads, appointments and pipeline'],
      contacts: ['Contacts', 'Your book — search, tags, birthdays'],
      leads: ['Leads', 'Everyone assigned to you, newest first'],
      pipeline: ['Pipeline', 'Your deals by line — drag a card to move it through the stages'],
      calendar: ['Calendar', 'Your upcoming appointments'],
      availability: ['Availability', 'Set the hours people can book you — this updates your booking page right away'],
    };
    let currentRoute = null;
    function go(route) {
      if (!TITLES[route]) route = 'dashboard';
      currentRoute = route;
      history.replaceState({}, '', '#' + route);
      $('#page-title').textContent = TITLES[route][0];
      $('#page-sub').textContent = TITLES[route][1];
      $$('.nav-item[data-route]').forEach((n) => n.classList.toggle('active', n.dataset.route === route));
      root.classList.remove('nav-open');
      const v = $('#view'); v.scrollTop = 0;
      ({ dashboard: renderDashboard, contacts: renderContacts, leads: renderLeads, pipeline: renderPipeline, calendar: renderCalendar, availability: renderAvailability }[route])(v);
    }
    window.addEventListener('hashchange', () => { const r = location.hash.replace('#', ''); if (r && r !== currentRoute && TITLES[r]) go(r); });

    // ---- status → pill ----
    function stageOf(lead) { return state.stages.find((s) => s.id === lead.stage_id) || null; }
    function stagePill(lead) {
      const s = stageOf(lead);
      if (!s) return '<span class="pill-status st-gray">No stage</span>';
      const cls = s.is_won ? 'st-green' : s.is_lost ? 'st-red' : s.key === 'appt' ? 'st-violet' : s.key === 'contacted' ? 'st-amber' : 'st-blue';
      return `<span class="pill-status ${cls}">${esc(s.label)}</span>`;
    }

    // ================= DASHBOARD =================
    function renderDashboard(v) {
      const now = Date.now();
      const d30 = now - 30 * 864e5, d60 = now - 60 * 864e5;
      const last30 = state.leads.filter((l) => +new Date(l.created_at) >= d30);
      const prev30 = state.leads.filter((l) => { const t = +new Date(l.created_at); return t >= d60 && t < d30; });
      const events = apptEvents();
      const bookings = events.filter((e) => +new Date(e.when) >= now);
      const weekEnd = now + 7 * 864e5;
      const apptsWeek = events.filter((e) => { const t = +new Date(e.when); return t >= now && t <= weekEnd; });
      const won = state.leads.filter((l) => { const s = stageOf(l); return s && s.is_won; });
      const openLeads = state.leads.filter((l) => { const s = stageOf(l); return !s || (!s.is_won && !s.is_lost); });
      const delta = prev30.length ? Math.round((last30.length - prev30.length) / prev30.length * 100) : null;

      // sparkline of leads/day over 30 days
      const days = []; for (let i = 29; i >= 0; i--) { const d = new Date(now - i * 864e5); days.push({ label: d, n: 0 }); }
      last30.forEach((l) => { const idx = Math.floor((+new Date(l.created_at) - d30) / 864e5); if (idx >= 0 && idx < 30) days[idx].n++; });
      const max = Math.max(1, ...days.map((d) => d.n));
      const W = 620, H = 120;
      const pts = days.map((d, i) => [i / 29 * W, H - (d.n / max) * (H - 10) - 4]);
      const line = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ');
      const area = line + ` L${W} ${H} L0 ${H} Z`;

      const upNext = bookings.slice(0, 6);
      const recent = state.leads.slice(0, 8);

      v.innerHTML = `
      <div class="view-grid">
        ${myPagesCard()}
        <div class="stat-row">
          ${statCard('New leads · 30 days', last30.length, delta == null ? '' : `<span class="delta ${delta>=0?'up':'flat'}">${delta>=0?'▲':'▼'} ${Math.abs(delta)}% vs prior 30</span>`)}
          ${statCard('Appointments · this week', apptsWeek.length, `<span class="delta flat">${bookings.length} upcoming total</span>`)}
          ${statCard('Open leads', openLeads.length, `<span class="delta flat">in your pipeline</span>`)}
          ${statCard('Won · lifetime', won.length, `<span class="delta up">closed</span>`)}
        </div>

        <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:16px">
          <div class="card">
            <div class="card-h"><span class="grad-label">Intake</span><h3 style="margin-left:8px">Leads — last 30 days</h3></div>
            <div class="card-b">
              <svg class="spark" viewBox="0 0 ${W} ${H}" style="width:100%;height:150px" preserveAspectRatio="none">
                <path class="area" d="${area}" fill="var(--blue)"/>
                <path class="line" d="${line}" stroke="var(--blue)"/>
              </svg>
              <div style="display:flex;justify-content:space-between;font-size:.7rem;color:var(--muted);margin-top:4px">
                <span>${fmtDate(days[0].label)}</span><span>${fmtDate(days[15].label)}</span><span>${fmtDate(days[29].label)}</span>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-h"><span class="grad-label">Today</span><h3 style="margin-left:8px">Up next</h3></div>
            <div class="card-b" style="padding-top:6px">
              ${upNext.length ? upNext.map((e) => `
                <div class="feed-item">
                  <div class="feed-ic">📅</div>
                  <div><div style="font-weight:650">${esc(e.name)}</div><div class="cell-sub">${esc(fmtFull(e.when))}</div></div>
                  <span class="pill-status st-green" style="margin-left:auto">Confirmed</span>
                </div>`).join('') : '<div class="empty" style="padding:24px">No upcoming appointments.</div>'}
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-h"><span class="grad-label">Activity</span><h3 style="margin-left:8px">Recent leads</h3><div class="right"><button class="btn btn-ghost btn-sm" data-goto="leads">View all →</button></div></div>
          <div class="card-b" style="padding:6px 0 0">
            <table class="data"><thead><tr><th>Name</th><th>Stage</th><th>Source</th><th>Added</th></tr></thead>
            <tbody>${recent.map((l) => `
              <tr class="rowlink" data-lead="${l.id}">
                <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nameOf(l))}">${initials(nameOf(l))}</span><div>${esc(nameOf(l))}<div class="cell-sub">${esc(l.email || l.phone || '')}</div></div></div></td>
                <td>${stagePill(l)}</td><td><span class="chip">${esc(l.source_form || l.page || 'web')}</span></td><td class="cell-sub">${esc(fmtDate(l.created_at))}</td>
              </tr>`).join('') || '<tr><td colspan="4"><div class="empty">No leads yet.</div></td></tr>'}
            </tbody></table>
          </div>
        </div>
      </div>`;
      $$('[data-goto]', v).forEach((b) => b.addEventListener('click', () => go(b.dataset.goto)));
      $$('tr[data-lead]', v).forEach((r) => r.addEventListener('click', () => openLead(r.dataset.lead)));
      $$('[data-copy]', v).forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy); const t = b.textContent; b.textContent = 'Copied!'; setTimeout(() => (b.textContent = t), 1200); }
        catch (_e) { toast('Could not copy — long-press the link to copy it.'); }
      }));
    }
    const statCard = (lbl, num, delta) => `<div class="card stat"><div class="tick"></div><div class="lbl">${lbl}</div><div class="num">${num}</div>${delta}</div>`;

    // Slug matches the static build (broker-lines.ts brokerSlug) so the links resolve.
    function brokerSlug(name) {
      return String(name || '').toLowerCase().normalize('NFKD').replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-') || 'broker';
    }
    // Shown once a broker has completed onboarding — they have a landing + booking page.
    function myPagesCard() {
      if (!state.me?.onboarding_completed_at) return '';
      const slug = brokerSlug(state.me.full_name);
      const base = 'https://www.protecthealth.com';
      return `<div class="card" style="border:1.5px solid #d3e2ff;background:linear-gradient(180deg,#f1f7ff,#ffffff)">
        <div class="card-h"><span class="grad-label">Your pages</span><h3 style="margin-left:8px">Your landing page &amp; booking calendar</h3></div>
        <div class="card-b" style="display:grid;gap:12px;padding-top:8px">
          ${pageRow('Landing page', base + '/broker/' + slug, '🌐', 'Your public page — send it to prospects or link it in your bio.')}
          ${pageRow('Booking calendar', base + '/book/' + slug, '📅', 'People pick a time here and it lands in your CRM automatically.')}
          <div class="cell-sub" style="margin-top:2px">New or updated details go live the next time the site updates.</div>
        </div>
      </div>`;
    }
    function pageRow(label, url, icon, note) {
      const short = url.replace(/^https?:\/\/(www\.)?/, '');
      return `<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px;background:#fff">
        <div style="font-size:1.4rem;line-height:1">${icon}</div>
        <div style="flex:1;min-width:190px">
          <div style="font-weight:750;color:#0b2a4a">${label}</div>
          <a href="${url}" target="_blank" rel="noopener" style="color:#2563c9;font-weight:600;word-break:break-all">${esc(short)}</a>
          <div class="cell-sub" style="margin-top:2px">${esc(note)}</div>
        </div>
        <div style="display:flex;gap:8px">
          <a class="btn btn-primary btn-sm" href="${url}" target="_blank" rel="noopener">View</a>
          <button class="btn btn-ghost btn-sm" type="button" data-copy="${esc(url)}">Copy</button>
        </div>
      </div>`;
    }

    // ================= CONTACTS =================
    let cPage = 0, cQuery = '', cTag = '';
    // ---- Contacts filters + column preferences ----
    const cFilters = { disposition: '', tag: '', company_id: '', line: '', polStatus: '', carrier_id: '', premMin: '', premMax: '', bdayMonth: '' };
    const activeFilterCount = () => Object.values(cFilters).filter((x) => x !== '').length;
    const FREQ_X = { Monthly: 12, Quarterly: 4, 'Semi-Annual': 2, Annual: 1, Single: 1 };
    const MONTHS_L = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const ALL_COLS = [
      { key: 'email', label: 'Email' }, { key: 'phone', label: 'Phone' }, { key: 'tags', label: 'Tags' },
      { key: 'added', label: 'Added' }, { key: 'bday', label: 'Birthday' }, { key: 'company', label: 'Company' },
      { key: 'disposition', label: 'Disposition' }, { key: 'lines', label: 'Lines' },
      { key: 'carriers', label: 'Carriers' }, { key: 'policies', label: 'Policies' },
    ];
    let cCols;
    try { cCols = JSON.parse(localStorage.getItem('ph_cols_v1')) || null; } catch { cCols = null; }
    if (!Array.isArray(cCols) || !cCols.length) cCols = ['email', 'phone', 'tags', 'added'];
    let cMode = 'people'; // 'people' | 'companies'
    function renderContacts(v) {
      v.innerHTML = `
      <div class="card">
        <div class="toolbar">
          <div class="seg" role="group">
            <button class="seg-btn ${cMode==='people'?'on':''}" data-cmode="people">People</button>
            <button class="seg-btn ${cMode==='companies'?'on':''}" data-cmode="companies">Companies</button>
          </div>
          <input type="text" id="c-search" placeholder="Search name, email, phone…" value="${esc(cQuery)}" style="min-width:220px"/>
          ${cMode==='people' ? `<button class="btn btn-ghost btn-sm" id="c-filter-btn">⚙ Filters${activeFilterCount() ? ` <span class="fchip-n">${activeFilterCount()}</span>` : ''}</button>` : ''}
          ${cMode==='people' ? '<button class="btn btn-ghost btn-sm" id="c-cols-btn">☰ Columns</button>' : ''}
          ${cMode==='people'
            ? '<button class="btn btn-primary btn-sm" id="c-add">+ Add Contact</button>'
            : '<button class="btn btn-primary btn-sm" id="co-add">+ Add Company</button>'}
          ${state.isAdmin ? '<button class="btn btn-ghost btn-sm" id="c-carriers">Manage carriers</button>' : ''}
          ${state.isAdmin ? '<button class="btn btn-ghost btn-sm" id="c-fields">Manage fields</button>' : ''}
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)" id="c-count"></span>
        </div>
        <div class="fpanel" id="c-fpanel" hidden>
          <div class="fgrid">
            <label class="ffield"><span>Disposition</span><select data-f="disposition"><option value="">Any</option>${DISPOSITIONS.map((d)=>`<option ${cFilters.disposition===d?'selected':''}>${esc(d)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Tag</span><select data-f="tag" id="c-tag"><option value="">Any</option></select></label>
            <label class="ffield"><span>Company</span><select data-f="company_id"><option value="">Any</option>${state.companies.map((co)=>`<option value="${co.id}" ${cFilters.company_id===co.id?'selected':''}>${esc(co.name)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Line of insurance</span><select data-f="line"><option value="">Any</option>${COVERAGE_TYPES.map((l)=>`<option ${cFilters.line===l?'selected':''}>${esc(l)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Policy status</span><select data-f="polStatus"><option value="">Any</option>${POLICY_STATUSES.map((s)=>`<option ${cFilters.polStatus===s?'selected':''}>${esc(s)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Carrier</span><select data-f="carrier_id"><option value="">Any</option>${state.carriers.map((x)=>`<option value="${x.id}" ${cFilters.carrier_id===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Annual premium</span><div class="frange"><input type="number" data-f="premMin" placeholder="Min" value="${esc(cFilters.premMin)}"><span>–</span><input type="number" data-f="premMax" placeholder="Max" value="${esc(cFilters.premMax)}"></div></label>
            <label class="ffield"><span>Birthday month</span><select data-f="bdayMonth"><option value="">Any</option>${MONTHS_L.map((m,i)=>`<option value="${i+1}" ${String(cFilters.bdayMonth)===String(i+1)?'selected':''}>${esc(m)}</option>`).join('')}</select></label>
          </div>
          <div class="factions">
            <button class="btn btn-primary btn-sm" id="c-apply">Apply filters</button>
            <button class="btn btn-ghost btn-sm" id="c-clear">Clear all</button>
            <span class="cell-sub">Premium range uses each policy's annualized amount.</span>
          </div>
        </div>
        <div class="fchips" id="c-chips"></div>
        <div class="colpop" id="c-colpop" hidden>
          ${ALL_COLS.map((col)=>`<label class="pickbox"><input type="checkbox" data-col="${col.key}" ${cCols.includes(col.key)?'checked':''}/> ${esc(col.label)}</label>`).join('')}
        </div>
        <div id="c-table"></div>
        <div class="pager" id="c-pager"></div>
      </div>`;
      $$('[data-cmode]', v).forEach((b) => b.addEventListener('click', () => { cMode = b.dataset.cmode; renderContacts(v); }));
      const search = $('#c-search', v);
      let t; search.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { cQuery = search.value.trim(); cPage = 0; cMode === 'people' ? loadContacts(v) : renderCompanies(v); }, 250); });
      $('#c-filter-btn', v)?.addEventListener('click', () => { const p = $('#c-fpanel', v); p.hidden = !p.hidden; $('#c-colpop', v).hidden = true; });
      $('#c-cols-btn', v)?.addEventListener('click', () => { const p = $('#c-colpop', v); p.hidden = !p.hidden; $('#c-fpanel', v).hidden = true; });
      $('#c-apply', v)?.addEventListener('click', () => {
        $$('#c-fpanel [data-f]', v).forEach((el) => { cFilters[el.dataset.f] = el.value; });
        cPage = 0; renderContacts(v);
      });
      $('#c-clear', v)?.addEventListener('click', () => {
        Object.keys(cFilters).forEach((k) => cFilters[k] = ''); cPage = 0; renderContacts(v);
      });
      $$('#c-colpop [data-col]', v).forEach((cb) => cb.addEventListener('change', () => {
        cCols = ALL_COLS.map((c) => c.key).filter((k) => $(`#c-colpop [data-col="${k}"]`, v).checked);
        try { localStorage.setItem('ph_cols_v1', JSON.stringify(cCols)); } catch {}
        loadContacts(v);
      }));
      $('#c-add', v)?.addEventListener('click', () => openAddContact(v));
      $('#co-add', v)?.addEventListener('click', () => openCompanyForm(null, v));
      $('#c-carriers', v)?.addEventListener('click', openCarrierManager);
      $('#c-fields', v)?.addEventListener('click', openFieldManager);
      if (cMode === 'people') { paintFilterChips(v); loadTags(v); loadContacts(v); }
      else renderCompanies(v);
    }

    // Active filters as removable chips under the toolbar.
    function paintFilterChips(v) {
      const host = $('#c-chips', v); if (!host) return;
      const chip = (key, label) => `<span class="fchip">${esc(label)}<button data-fx="${key}" aria-label="Remove">✕</button></span>`;
      const parts = [];
      if (cFilters.disposition) parts.push(chip('disposition', cFilters.disposition));
      if (cFilters.tag) parts.push(chip('tag', 'Tag: ' + cFilters.tag));
      if (cFilters.company_id) parts.push(chip('company_id', state.companies.find((x) => x.id === cFilters.company_id)?.name || 'Company'));
      if (cFilters.line) parts.push(chip('line', cFilters.line));
      if (cFilters.polStatus) parts.push(chip('polStatus', 'Policy: ' + cFilters.polStatus));
      if (cFilters.carrier_id) parts.push(chip('carrier_id', state.carriers.find((x) => x.id === cFilters.carrier_id)?.name || 'Carrier'));
      if (cFilters.premMin || cFilters.premMax) parts.push(chip('prem', `Premium ${cFilters.premMin ? fmtMoney(cFilters.premMin) : '$0'}–${cFilters.premMax ? fmtMoney(cFilters.premMax) : '∞'}/yr`));
      if (cFilters.bdayMonth) parts.push(chip('bdayMonth', 'Birthday: ' + MONTHS_L[cFilters.bdayMonth - 1]));
      host.innerHTML = parts.join('');
      host.style.display = parts.length ? '' : 'none';
      $$('[data-fx]', host).forEach((b) => b.addEventListener('click', () => {
        if (b.dataset.fx === 'prem') { cFilters.premMin = ''; cFilters.premMax = ''; }
        else cFilters[b.dataset.fx] = '';
        cPage = 0; renderContacts(v);
      }));
    }

    // ---- Companies list ----
    function renderCompanies(v) {
      const q = cQuery.toLowerCase();
      const rows = state.companies.filter((co) => !q || (co.name || '').toLowerCase().includes(q));
      $('#c-count', v).textContent = `${rows.length} compan${rows.length === 1 ? 'y' : 'ies'}`;
      $('#c-table', v).innerHTML = rows.length ? `<table class="data"><thead><tr><th>Company</th><th>Industry</th><th>Phone</th><th>City</th><th>Added</th></tr></thead><tbody>${
        rows.map((co) => `<tr data-co="${co.id}" style="cursor:pointer"><td style="font-weight:650">${esc(co.name)}</td><td class="cell-sub">${esc(co.industry || '—')}</td><td class="cell-sub">${esc(fmtPhone(co.phone) || '—')}</td><td class="cell-sub">${esc(co.city || '—')}</td><td class="cell-sub">${esc(fmtDate(co.created_at))}</td></tr>`).join('')
      }</tbody></table>` : '<div class="empty" style="padding:30px">No companies yet. Add one for group/employer business — the people you add under it become regular contacts automatically.</div>';
      $('#c-pager', v).innerHTML = '';
      $$('[data-co]', v).forEach((r) => r.addEventListener('click', () => openCompany(r.dataset.co)));
    }

    function openCompanyForm(co, listView) {
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">${co ? 'Edit company' : 'Add Company'}</div><div class="cell-sub">Group / employer record</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b"><form id="co-form">
          <div class="field"><label>Company name *</label><input name="name" required value="${esc(co?.name || '')}"/></div>
          <div class="grid2">
            <div class="field"><label>Industry</label><input name="industry" value="${esc(co?.industry || '')}"/></div>
            <div class="field"><label>Employees</label><input name="employee_count" type="number" min="1" value="${esc(co?.employee_count ?? '')}"/></div>
          </div>
          <div class="grid2">
            <div class="field"><label>Phone</label><input name="phone" inputmode="tel" value="${esc(co?.phone || '')}"/></div>
            <div class="field"><label>Email</label><input name="email" type="email" value="${esc(co?.email || '')}"/></div>
          </div>
          <div class="field"><label>Street address</label><input name="street_address" value="${esc(co?.street_address || '')}"/></div>
          <div class="grid3">
            <div class="field"><label>City</label><input name="city" value="${esc(co?.city || '')}"/></div>
            <div class="field"><label>State</label><input name="state" maxlength="2" style="text-transform:uppercase" value="${esc(co?.state || '')}"/></div>
            <div class="field"><label>Zip</label><input name="postal_code" inputmode="numeric" value="${esc(co?.postal_code || '')}"/></div>
          </div>
          <div class="field"><label>Notes</label><textarea name="notes" rows="2">${esc(co?.notes || '')}</textarea></div>
          <button class="btn btn-primary" type="submit">${co ? 'Save changes' : 'Add company'}</button>
          <p class="cell-sub" id="co-status" style="margin-top:8px"></p>
        </form></div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#co-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target;
        const patch = {
          agent_id: co ? co.agent_id : state.me.id,
          name: f.name.value.trim(), industry: f.industry.value.trim() || null,
          employee_count: f.employee_count.value ? parseInt(f.employee_count.value, 10) : null,
          phone: f.phone.value.trim() || null, email: f.email.value.trim() || null,
          street_address: f.street_address.value.trim() || null, city: f.city.value.trim() || null,
          state: f.state.value.trim().toUpperCase() || null, postal_code: f.postal_code.value.trim() || null,
          notes: f.notes.value.trim() || null, updated_at: new Date().toISOString(),
        };
        const q = co ? sb.from('ph_companies').update(patch).eq('id', co.id).select('*').single()
                     : sb.from('ph_companies').insert(patch).select('*').single();
        const { data, error } = await q;
        if (error) { $('#co-status').textContent = 'Could not save: ' + error.message; return; }
        if (co) { const i = state.companies.findIndex((x) => x.id === co.id); if (i >= 0) state.companies[i] = data; }
        else state.companies.push(data);
        state.companies.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        closeDrawer(); toast(co ? 'Company updated' : 'Company added');
        if (co) openCompany(data.id); else if (listView && currentRoute === 'contacts') renderCompanies(listView);
      });
    }

