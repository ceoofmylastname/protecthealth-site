    async function saveContact(form, listView) {
      const status = $('.add-status');
      const g = (n) => form.elements[n]?.value?.trim() || null;
      const first = g('first_name');
      if (!first) { status.textContent = 'First name is required.'; status.classList.add('is-bad'); return; }
      const btn = form.querySelector('button[type="submit"]'); btn.disabled = true;
      status.classList.remove('is-bad'); status.textContent = 'Saving…';

      const coverage = $$('[data-cov]', form).filter((c) => c.checked).map((c) => c.getAttribute('data-cov'));
      const carrierIds = $$('[data-carrier]', form).filter((c) => c.checked).map((c) => c.getAttribute('data-carrier'));
      const dependents = $$('.dep-row', form).map((row, i) => {
        const rel = i === 0 ? 'Spouse' : 'Child';
        const d = {};
        $$('[data-dk]', row).forEach((inp) => { if (inp.value.trim()) d[inp.getAttribute('data-dk')] = inp.value.trim(); });
        return Object.keys(d).length ? { relation: rel, ...d } : null;
      }).filter(Boolean);

      // Local id keeps this out of the GHL sync's path entirely.
      const id = 'local:' + (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(16).slice(2));
      const row = {
        ghl_contact_id: id, origin: 'crm', tags: $$('[data-tagpick]').filter((x) => x.checked).map((x) => x.getAttribute('data-tagpick')), dnd: false, synced_at: new Date().toISOString(),
        first_name: first, last_name: g('last_name'), company: g('company'), company_id: form.elements['company_id']?.value || null, email: g('email'),
        phone: g('phone'), date_of_birth: g('date_of_birth'), street_address: g('street_address'),
        city: g('city'), state: (g('state') || '').toUpperCase() || null, postal_code: g('postal_code'),
        disposition: form.elements['disposition'].value, coverage_types: coverage, dependents,
        ghl_date_added: new Date().toISOString(),
        // agent_id intentionally omitted — the intake trigger assigns the owner.
      };
      const { error } = await sb.from('ph_contacts').insert(row);
      if (error) { btn.disabled = false; status.textContent = 'Could not save: ' + error.message; status.classList.add('is-bad'); return; }

      if (carrierIds.length) {
        const links = carrierIds.map((cid) => ({ contact_id: id, carrier_id: cid }));
        const { error: cErr } = await sb.from('ph_contact_carriers').insert(links);
        if (cErr) toast('Contact saved, but carriers did not attach.');
      }
      closeDrawer();
      toast('Contact added to your book');
      state.contactCount++; buildNav();
      reloadOpps();
      loadContacts(listView);
    }
    async function loadTags(v) {
      // Admin-defined tags first, then any other tags that exist in THIS
      // user's own book (ph_contact_tags is RLS-scoped, so a broker only ever
      // sees tags on their own contacts).
      const sel = $('#c-tag', v); if (!sel) return;
      const seen = new Set();
      state.adminTags.forEach((t) => { seen.add(t.name.toLowerCase()); const o = document.createElement('option'); o.value = t.name; o.textContent = t.name; sel.appendChild(o); });
      try {
        const { data } = await sb.rpc('ph_contact_tags');
        (data || []).slice(0, 60).forEach((row) => {
          const tag = row.tag || row; if (seen.has(String(tag).toLowerCase())) return;
          const o = document.createElement('option'); o.value = tag; o.textContent = tag + (row.uses ? ` (${row.uses})` : ''); sel.appendChild(o);
        });
      } catch {}
      if (cFilters.tag) sel.value = cFilters.tag;
    }
    async function loadContacts(v) {
      const per = 25;

      // Policy / carrier filters resolve to a set of contact ids first, then the
      // main contacts query narrows to that set. Policies are RLS-scoped, so an
      // agent only ever matches within their own book.
      let idSet = null;
      const needsPolicies = cFilters.polStatus || cFilters.premMin || cFilters.premMax ||
        (cFilters.line && (cFilters.polStatus || cFilters.premMin || cFilters.premMax));
      if (needsPolicies || cFilters.polStatus) {
        let pq = sb.from('ph_policies').select('contact_id, premium, premium_freq');
        if (cFilters.line) pq = pq.eq('line', cFilters.line);
        if (cFilters.polStatus) pq = pq.eq('status', cFilters.polStatus);
        if (cFilters.carrier_id) pq = pq.eq('carrier_id', cFilters.carrier_id);
        const { data: pols } = await pq;
        const min = cFilters.premMin !== '' ? parseFloat(cFilters.premMin) : null;
        const max = cFilters.premMax !== '' ? parseFloat(cFilters.premMax) : null;
        idSet = new Set((pols || []).filter((p) => {
          if (min == null && max == null) return true;
          if (p.premium == null) return false;
          const annual = Number(p.premium) * (FREQ_X[p.premium_freq] || 12);
          return (min == null || annual >= min) && (max == null || annual <= max);
        }).map((p) => p.contact_id));
      }
      if (cFilters.carrier_id && !needsPolicies && !cFilters.polStatus) {
        // Carrier filter alone: match via linked carriers OR any policy at that carrier.
        const [{ data: links }, { data: pols }] = await Promise.all([
          sb.from('ph_contact_carriers').select('contact_id').eq('carrier_id', cFilters.carrier_id),
          sb.from('ph_policies').select('contact_id').eq('carrier_id', cFilters.carrier_id),
        ]);
        idSet = new Set([...(links || []).map((r) => r.contact_id), ...(pols || []).map((r) => r.contact_id)]);
      }

      const tbl = $('#c-table', v);
      const cols = ALL_COLS.filter((c) => cCols.includes(c.key));
      const header = `<tr><th>Name</th>${cols.map((c) => `<th>${esc(c.label)}</th>`).join('')}</tr>`;

      if (idSet && idSet.size === 0) {
        tbl.innerHTML = `<table class="data"><thead>${header}</thead><tbody><tr><td colspan="${cols.length + 1}"><div class="empty">No contacts match these filters.</div></td></tr></tbody></table>`;
        $('#c-count', v).textContent = '0 contacts'; $('#c-pager', v).innerHTML = ''; return;
      }

      let q = sb.from('ph_contacts').select('*', { count: 'exact' }).order('ghl_date_added', { ascending: false, nullsFirst: false });
      if (cQuery) { const s = cQuery.replace(/[%,]/g, ' '); q = q.or(`first_name.ilike.%${s}%,last_name.ilike.%${s}%,email.ilike.%${s}%,phone.ilike.%${s}%`); }
      if (cFilters.tag) q = q.contains('tags', [cFilters.tag]);
      if (cFilters.disposition) q = q.eq('disposition', cFilters.disposition);
      if (cFilters.company_id) q = q.eq('company_id', cFilters.company_id);
      if (cFilters.line && !needsPolicies) q = q.contains('coverage_types', [cFilters.line]);
      if (cFilters.bdayMonth) q = q.eq('bday_month', parseInt(cFilters.bdayMonth, 10));
      if (idSet) q = q.in('ghl_contact_id', Array.from(idSet).slice(0, 900));
      q = q.range(cPage * per, cPage * per + per - 1);
      const { data, count } = await q;
      const rows = data ?? [];

      // Enrich the visible page only, and only for the columns that need it.
      const pageIds = rows.map((c) => c.ghl_contact_id);
      let carrierMap = {}, policyMap = {};
      if (pageIds.length && cCols.includes('carriers')) {
        const { data: links } = await sb.from('ph_contact_carriers').select('contact_id, carrier_id').in('contact_id', pageIds);
        (links || []).forEach((l) => {
          const n = state.carriers.find((x) => x.id === l.carrier_id)?.name; if (!n) return;
          (carrierMap[l.contact_id] ||= []).push(n);
        });
      }
      if (pageIds.length && cCols.includes('policies')) {
        const { data: pols } = await sb.from('ph_policies').select('contact_id, line, status, premium, premium_freq').in('contact_id', pageIds);
        (pols || []).forEach((p) => { (policyMap[p.contact_id] ||= []).push(p); });
      }

      const cellFor = (key, c) => {
        switch (key) {
          case 'email': return `<td class="cell-sub">${esc(c.email || '')}</td>`;
          case 'phone': return `<td class="cell-sub">${esc(fmtPhone(c.phone))}</td>`;
          case 'tags': return `<td>${(c.tags || []).slice(0, 3).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ')}</td>`;
          case 'added': return `<td class="cell-sub">${esc(fmtDate(c.ghl_date_added))}</td>`;
          case 'bday': return `<td class="cell-sub">${c.bday_month ? esc(MONTHS_L[c.bday_month - 1].slice(0, 3) + (c.bday_day ? ' ' + c.bday_day : '')) : '—'}</td>`;
          case 'company': { const co = c.company_id ? state.companies.find((x) => x.id === c.company_id) : null; return `<td class="cell-sub">${esc(co?.name || c.company || '—')}</td>`; }
          case 'disposition': return `<td><span class="pill-status ${dispClass(c.disposition)}">${esc(c.disposition || '—')}</span></td>`;
          case 'lines': return `<td>${(c.coverage_types || []).slice(0, 3).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">—</span>'}</td>`;
          case 'carriers': return `<td class="cell-sub">${esc((carrierMap[c.ghl_contact_id] || []).slice(0, 2).join(', ') || '—')}</td>`;
          case 'policies': {
            const pols = policyMap[c.ghl_contact_id] || [];
            if (!pols.length) return '<td class="cell-sub">—</td>';
            const annual = pols.reduce((s, p) => s + (p.premium != null ? Number(p.premium) * (FREQ_X[p.premium_freq] || 12) : 0), 0);
            return `<td><div style="font-weight:650">${pols.length} ${pols.length === 1 ? 'policy' : 'policies'}</div>${annual ? `<div class="cell-sub">${fmtMoney(annual)}/yr</div>` : ''}</td>`;
          }
          default: return '<td></td>';
        }
      };

      tbl.innerHTML = `<table class="data"><thead>${header}</thead><tbody>${
        rows.map((c) => `<tr class="rowlink" data-contact="${esc(c.ghl_contact_id)}">
          <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nameOf(c))}">${initials(nameOf(c))}</span>${esc(nameOf(c))}</div></td>
          ${cols.map((col) => cellFor(col.key, c)).join('')}</tr>`).join('') || `<tr><td colspan="${cols.length + 1}"><div class="empty">No contacts match.</div></td></tr>`
      }</tbody></table>`;
      const total = count ?? rows.length;
      $('#c-count', v).textContent = total.toLocaleString() + ' contact' + (total === 1 ? '' : 's');
      const pages = Math.max(1, Math.ceil(total / per));
      $('#c-pager', v).innerHTML = `<button ${cPage<=0?'disabled':''} data-pg="prev">← Prev</button><span>Page ${cPage+1} of ${Math.max(1,pages)}</span><button ${cPage>=pages-1?'disabled':''} data-pg="next">Next →</button>`;
      $$('[data-pg]', v).forEach((b) => b.addEventListener('click', () => { cPage += b.dataset.pg === 'next' ? 1 : -1; loadContacts(v); }));
      $$('tr[data-contact]', v).forEach((r) => r.addEventListener('click', () => openContact(r.dataset.contact, rows)));
    }

    // ================= LEADS =================
    let lFilter = 'all', lQuery = '';
    function renderLeads(v) {
      const stageOpts = ['<option value="all">All stages</option>', ...state.stages.map((s) => `<option value="${s.id}">${esc(s.label)}</option>`)].join('');
      v.innerHTML = `
      <div class="card">
        <div class="toolbar">
          <input type="text" id="l-search" placeholder="Search leads…" value="${esc(lQuery)}" style="min-width:220px"/>
          <select id="l-stage">${stageOpts}</select>
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)" id="l-count"></span>
        </div>
        <div id="l-table"></div>
      </div>`;
      const s = $('#l-search', v); let t;
      s.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { lQuery = s.value.trim().toLowerCase(); paintLeads(v); }, 200); });
      $('#l-stage', v).value = lFilter;
      $('#l-stage', v).addEventListener('change', (e) => { lFilter = e.target.value; paintLeads(v); });
      paintLeads(v);
    }
    function paintLeads(v) {
      let rows = state.leads;
      if (lFilter !== 'all') rows = rows.filter((l) => l.stage_id === lFilter);
      if (lQuery) rows = rows.filter((l) => (nameOf(l) + ' ' + (l.email||'') + ' ' + (l.phone||'')).toLowerCase().includes(lQuery));
      $('#l-count', v).textContent = rows.length + ' leads';
      $('#l-table', v).innerHTML = `<table class="data"><thead><tr><th>Name</th><th>Stage</th><th>Type</th><th>Source</th><th>Appointment</th><th>Added</th></tr></thead><tbody>${
        rows.map((l) => `<tr class="rowlink" data-lead="${l.id}">
          <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nameOf(l))}">${initials(nameOf(l))}</span><div>${esc(nameOf(l))}<div class="cell-sub">${esc(l.email || l.phone || '')}</div></div></div></td>
          <td>${stagePill(l)}</td><td><span class="chip">${esc(l.kind || 'form')}</span></td><td class="cell-sub">${esc(l.source_form || l.page || 'web')}</td>
          <td class="cell-sub">${l.appointment_start ? esc(fmtDateTime(l.appointment_start)) : '—'}</td><td class="cell-sub">${esc(fmtDate(l.created_at))}</td></tr>`).join('') || '<tr><td colspan="6"><div class="empty">No leads match.</div></td></tr>'
      }</tbody></table>`;
      $$('tr[data-lead]', v).forEach((r) => r.addEventListener('click', () => openLead(r.dataset.lead)));
    }

    // ============ PIPELINE (per-line opportunity board + line dropdown) ============
    let pipeLineKey = null;
    function pipeName(lk) { const p = state.pipelines.find((x) => x.line_key === lk); return p ? p.name : lk; }
    // Which pipelines this user sees: an admin sees all; a broker sees the lines
    // they wrote at onboarding, plus any line they already hold a deal in.
    function visiblePipelines() {
      if (state.isAdmin) return state.pipelines.slice();
      const mine = new Set(state.me?.lines_of_insurance || []);
      const withOpps = new Set(state.opps.map((o) => o.line_key));
      return state.pipelines.filter((p) => mine.has(p.name) || withOpps.has(p.line_key));
    }
    function renderPipeline(v) {
      const pipes = visiblePipelines().sort((a, b) => a.position - b.position);
      if (!pipes.length) {
        v.innerHTML = `<div class="card"><div class="empty">No pipelines to show yet. Pick the lines you write from <b>Edit profile</b> (bottom-left), or add a contact and choose a coverage type — the deal lands here automatically.</div></div>`;
        return;
      }
      if (!pipeLineKey || !pipes.some((p) => p.line_key === pipeLineKey)) pipeLineKey = pipes[0].line_key;
      const pipe = pipes.find((p) => p.line_key === pipeLineKey);
      const stages = state.pipelineStages.filter((s) => s.pipeline_id === pipe.id).sort((a, b) => a.position - b.position);
      const opts = pipes.map((p) => `<option value="${esc(p.line_key)}"${p.line_key === pipeLineKey ? ' selected' : ''}>${esc(p.name)}</option>`).join('');
      const total = state.opps.filter((o) => o.pipeline_id === pipe.id).length;
      v.innerHTML = `
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap">
          <label style="display:flex;align-items:center;gap:8px;font-weight:700;color:#0b2a4a">
            <span>Pipeline</span>
            <select id="pipe-line" style="padding:9px 12px;border:1.5px solid #d9e1ea;border-radius:10px;font-size:0.95rem;font-weight:600;background:#fff;color:#0b2a4a;min-width:190px">${opts}</select>
          </label>
          <div class="cell-sub">${total} deal${total === 1 ? '' : 's'} in ${esc(pipe.name)}</div>
        </div>
        <div id="kanban">${stages.map((s) => {
          const items = state.opps.filter((o) => o.pipeline_id === pipe.id && o.stage_id === s.id);
          const dot = s.is_won ? 'var(--green)' : s.is_lost ? 'var(--red)' : s.position === 1 ? 'var(--blue)' : s.position === 2 ? 'var(--amber)' : 'var(--violet)';
          return `<div class="kcol">
            <div class="kcol-h"><div class="t"><span class="status-dot" style="width:8px;height:8px;border-radius:50%;background:${dot}"></span>${esc(s.name)}</div><div class="meta">${items.length}</div></div>
            <div class="kcol-b" data-stage="${s.id}">${items.map(oppCard).join('')}</div>
          </div>`;
        }).join('')}</div>`;
      $('#pipe-line', v).addEventListener('change', (e) => { pipeLineKey = e.target.value; renderPipeline(v); });
      wirePipe(v);
    }
    const oppCard = (o) => `<div class="kcard" draggable="true" data-opp="${o.id}" data-contact="${esc(o.contact_id)}">
      <div class="nm">${esc(o.title || 'Untitled')}</div>
      <div class="meta"><span class="chip">${esc(pipeName(o.line_key))}</span>${o.value ? '$' + Number(o.value).toLocaleString() : esc(fmtDate(o.created_at))}</div></div>`;
    function wirePipe(v) {
      let dragId = null, didDrag = false;
      $$('.kcard', v).forEach((c) => {
        c.addEventListener('dragstart', () => { dragId = c.dataset.opp; didDrag = true; c.classList.add('dragging'); });
        c.addEventListener('dragend', () => { dragId = null; c.classList.remove('dragging'); setTimeout(() => { didDrag = false; }, 0); });
        c.addEventListener('click', () => { if (!didDrag) openContact(c.dataset.contact); });
      });
      $$('.kcol-b', v).forEach((col) => {
        col.addEventListener('dragover', (e) => { e.preventDefault(); col.classList.add('dropover'); });
        col.addEventListener('dragleave', () => col.classList.remove('dropover'));
        col.addEventListener('drop', async (e) => {
          e.preventDefault(); col.classList.remove('dropover');
          if (!dragId) return;
          const stageId = col.dataset.stage;
          const o = state.opps.find((x) => x.id === dragId);
          if (!o || o.stage_id === stageId) return;
          const stage = state.pipelineStages.find((s) => s.id === stageId);
          const prev = o.stage_id, prevStatus = o.status;
          o.stage_id = stageId;
          o.status = stage?.is_won ? 'won' : stage?.is_lost ? 'lost' : 'open';
          renderPipeline(v);
          const { error } = await sb.from('ph_opportunities')
            .update({ stage_id: stageId, status: o.status, updated_at: new Date().toISOString() })
            .eq('id', dragId);
          if (error) { o.stage_id = prev; o.status = prevStatus; renderPipeline(v); toast('Could not move that deal.'); }
          else { toast('Moved to ' + (stage ? stage.name : 'stage')); }
        });
      });
    }

    // ================= AVAILABILITY (broker sets their booking hours) =========
    // Writes ph_agent_scheduling, which ph-book reads live — so saving here
    // changes the slots on this broker's /book and /broker pages immediately,
    // no site rebuild needed. Weekday keys match ph-book: Sun=0 … Sat=6.
    function renderAvailability(v) {
      const s = state.mySched || {};
      const slot = s.slot_minutes || 30, advance = s.advance_days || 21, notice = s.min_notice_hours ?? 12;
      const avail = s.availability || { '1': [['09:00', '17:00']], '2': [['09:00', '17:00']], '3': [['09:00', '17:00']], '4': [['09:00', '17:00']], '5': [['09:00', '17:00']] };
      const DAYS = [['1', 'Monday'], ['2', 'Tuesday'], ['3', 'Wednesday'], ['4', 'Thursday'], ['5', 'Friday'], ['6', 'Saturday'], ['0', 'Sunday']];
      const dayRow = (num, label) => {
        const w = (avail[num] && avail[num][0]) || null;
        const on = !!w, start = w ? w[0] : '09:00', end = w ? w[1] : '17:00';
        return `<div class="av-day">
          <label class="av-toggle"><input type="checkbox" data-day="${num}" ${on ? 'checked' : ''}><span>${label}</span></label>
          <div class="av-times">
            <input type="time" data-start="${num}" value="${start}" ${on ? '' : 'disabled'}>
            <span class="av-to">to</span>
            <input type="time" data-end="${num}" value="${end}" ${on ? '' : 'disabled'}>
          </div>
        </div>`;
      };
      const slotOpts = [15, 20, 30, 45, 60].map((m) => `<option value="${m}" ${m === slot ? 'selected' : ''}>${m} minutes</option>`).join('');
      const slug = brokerSlug(state.me.full_name || '');
      v.innerHTML = `
        <div class="view-grid" style="max-width:780px">
          <div class="card">
            <div class="card-h"><span class="grad-label">Hours</span><h3 style="margin-left:8px">When can people book you?</h3></div>
            <div class="card-b"><div class="av-days">${DAYS.map(([n, l]) => dayRow(n, l)).join('')}</div>
              <p class="cell-sub" style="margin-top:12px">Turn a day off to remove it from your calendar entirely. Times are Las Vegas time.</p>
            </div>
          </div>
          <div class="card">
            <div class="card-h"><span class="grad-label">Rules</span><h3 style="margin-left:8px">Booking settings</h3></div>
            <div class="card-b av-rules">
              <label class="av-field"><span>Appointment length</span><select id="av-slot">${slotOpts}</select></label>
              <label class="av-field"><span>Let people book up to</span><div class="av-inline"><input type="number" id="av-advance" min="1" max="90" value="${advance}"><em>days ahead</em></div></label>
              <label class="av-field"><span>Minimum notice</span><div class="av-inline"><input type="number" id="av-notice" min="0" max="168" value="${notice}"><em>hours before</em></div></label>
              <label class="av-field"><span>Time zone</span><input type="text" value="Las Vegas (Pacific)" disabled></label>
            </div>
          </div>
          <div class="av-actions">
            <button class="btn" id="av-save">Save availability</button>
            <span class="av-status" id="av-status"></span>
            <a class="av-preview" href="/book/${slug}" target="_blank" rel="noopener">Preview my booking page →</a>
          </div>
        </div>`;
      $$('[data-day]', v).forEach((cb) => cb.addEventListener('change', () => {
        const n = cb.getAttribute('data-day');
        $(`[data-start="${n}"]`, v).disabled = !cb.checked;
        $(`[data-end="${n}"]`, v).disabled = !cb.checked;
      }));
      $('#av-save', v).addEventListener('click', async () => {
        const btn = $('#av-save', v), st = $('#av-status', v);
        const availability = {};
        $$('[data-day]', v).forEach((cb) => {
          if (!cb.checked) return;
          const n = cb.getAttribute('data-day');
          const start = $(`[data-start="${n}"]`, v).value || '09:00';
          const end = $(`[data-end="${n}"]`, v).value || '17:00';
          if (start < end) availability[n] = [[start, end]];
        });
        const patch = {
          agent_id: state.me.id, timezone: 'America/Los_Angeles',
          slot_minutes: parseInt($('#av-slot', v).value, 10) || 30,
          advance_days: Math.max(1, Math.min(90, parseInt($('#av-advance', v).value, 10) || 21)),
          min_notice_hours: Math.max(0, Math.min(168, parseInt($('#av-notice', v).value, 10) || 12)),
          availability, updated_at: new Date().toISOString(),
        };
        btn.disabled = true; st.textContent = 'Saving…'; st.style.color = '';
        const { error } = await sb.from('ph_agent_scheduling').upsert(patch, { onConflict: 'agent_id' });
        btn.disabled = false;
        if (error) { st.textContent = 'Could not save: ' + error.message; st.style.color = '#c0392b'; return; }
        state.mySched = patch;
        st.textContent = 'Saved — your booking page is updated.'; st.style.color = '#0ea472';
        toast('Availability saved');
      });
    }

    // ================= CALENDAR (month grid from appointments) =================
    let calMonth = null;
    function renderCalendar(v) {
      if (!calMonth) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
      const y = calMonth.getFullYear(), m = calMonth.getMonth();
      const first = new Date(y, m, 1), start = new Date(first); start.setDate(1 - ((first.getDay() + 6) % 7)); // Mon-first
      const appts = apptEvents();
      const byDay = {};
      appts.forEach((e) => { const d = new Date(e.when); const k = d.toLocaleDateString('en-CA', { timeZone: TZ }); (byDay[k] ||= []).push(e); });
      const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: TZ });
      const title = calMonth.toLocaleString('en-US', { month: 'long', year: 'numeric' });
      const dows = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
      let cells = '';
      for (let i = 0; i < 42; i++) {
        const d = new Date(start); d.setDate(start.getDate() + i);
        const k = d.toLocaleDateString('en-CA');
        const dim = d.getMonth() !== m ? 'dim' : '';
        const today = k === todayKey ? 'today' : '';
        const evs = (byDay[k] || []).slice(0, 3).map((e) => `<div class="cal-ev${e.native ? ' cal-ev-native' : ''}"${e.native ? '' : ` data-lead="${e.id}"`}>${new Date(e.when).toLocaleTimeString('en-US',{timeZone:TZ,hour:'numeric',minute:'2-digit'})} ${esc(e.name)}</div>`).join('');
        const more = (byDay[k] || []).length > 3 ? `<div class="cell-sub" style="margin-top:2px">+${byDay[k].length - 3} more</div>` : '';
        cells += `<div class="cal-cell ${dim} ${today}"><div class="dnum">${d.getDate()}</div>${evs}${more}</div>`;
      }
      v.innerHTML = `
        <div class="cal-head">
          <button class="btn btn-ghost btn-sm" data-mo="-1">←</button>
          <div class="cal-title">${title}</div>
          <button class="btn btn-ghost btn-sm" data-mo="1">→</button>
          <button class="btn btn-ghost btn-sm" data-mo="0">Today</button>
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)">${appts.length} appointment${appts.length===1?'':'s'} on your calendar</span>
        </div>
        <div class="card" style="padding:0">
          <div class="cal-grid">${dows.map((d) => `<div class="cal-dow">${d}</div>`).join('')}${cells}</div>
        </div>`;
      $$('[data-mo]', v).forEach((b) => b.addEventListener('click', () => {
        const d = +b.dataset.mo;
        if (d === 0) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
        else calMonth = new Date(y, m + d, 1);
        renderCalendar(v);
      }));
      $$('.cal-ev[data-lead]', v).forEach((e) => e.addEventListener('click', () => openLead(e.dataset.lead)));
    }

    // ================= DRAWERS =================
    function openDrawer(html) { $('#drawer').innerHTML = html; $('#drawer').classList.add('on'); $('#overlay').classList.add('on'); }
    function closeDrawer() { $('#drawer').classList.remove('on'); $('#overlay').classList.remove('on'); }
    $('#overlay').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

    async function openLead(id) {
      const l = state.leads.find((x) => x.id === id); if (!l) return;
      const { data: emails } = await sb.from('ph_emails').select('*').eq('lead_id', id).order('scheduled_for');
      const answers = [['Role', l.role], ['Structure', l.structure], ['Coverage', l.coverage], ['Priority', l.priority]].filter((r) => r[1]);
      openDrawer(`
        <div class="drawer-h">
          <span class="avatar-sm" style="width:44px;height:44px;font-size:.95rem;background:${avColor(nameOf(l))}">${initials(nameOf(l))}</span>
          <div><div style="font-size:1.15rem;font-weight:800">${esc(nameOf(l))}</div><div class="cell-sub">${esc(l.email || '')} ${l.phone ? '· ' + esc(fmtPhone(l.phone)) : ''}</div><div style="margin-top:6px">${stagePill(l)}</div></div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">
          <div class="kv">
            <div class="k">Type</div><div class="v">${esc(l.kind || 'form')}</div>
            <div class="k">Source</div><div class="v">${esc(l.source_form || l.page || 'web')}</div>
            <div class="k">Added</div><div class="v">${esc(fmtFull(l.created_at))}</div>
            ${l.appointment_start ? `<div class="k">Appointment</div><div class="v">${esc(fmtFull(l.appointment_start))}</div>` : ''}
          </div>
          ${answers.length ? `<div class="section-t">Intake answers</div><div class="kv">${answers.map((a) => `<div class="k">${esc(a[0])}</div><div class="v">${esc(a[1])}</div>`).join('')}</div>` : ''}
          ${l.notes ? `<div class="section-t">Notes</div><div style="font-size:.86rem;line-height:1.6;white-space:pre-wrap">${esc(l.notes)}</div>` : ''}
          <div class="section-t">Emails to this lead</div>
          ${(emails && emails.length) ? emails.map((e) => `<div class="feed-item"><div class="feed-ic">✉️</div><div><div style="font-weight:650">${esc(e.subject || e.kind)}</div><div class="cell-sub">${esc(e.status)} · ${esc(fmtDateTime(e.sent_at || e.scheduled_for))}</div></div></div>`).join('') : '<div class="cell-sub">None yet.</div>'}
          <div class="section-t">Move stage</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">${state.stages.map((s) => `<button class="btn ${s.id===l.stage_id?'btn-primary':'btn-ghost'} btn-sm" data-setstage="${s.id}">${esc(s.label)}</button>`).join('')}</div>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      const paintStageControls = () => {
        // Update the pill and the button row in place — do NOT reopen the drawer,
        // which would leave the overlay covering the page.
        const pillHost = $('#drawer .drawer-h > div > div:last-child');
        if (pillHost) pillHost.innerHTML = stagePill(l);
        $$('#drawer [data-setstage]').forEach((btn) => {
          const on = btn.dataset.setstage === l.stage_id;
          btn.classList.toggle('btn-primary', on);
          btn.classList.toggle('btn-ghost', !on);
        });
      };
      $$('[data-setstage]').forEach((b) => b.addEventListener('click', async () => {
        const stageId = b.dataset.setstage; if (stageId === l.stage_id) return;
        const prev = l.stage_id; l.stage_id = stageId; paintStageControls();
        const { error } = await sb.from('ph_leads').update({ stage_id: stageId }).eq('id', id);
        if (error) { l.stage_id = prev; paintStageControls(); toast('Could not update stage.'); }
        else { toast('Stage updated'); if (currentRoute === 'pipeline') go('pipeline'); }
      }));
    }

    // Contact record: full three-column view per Rob's layout —
    // LEFT client data · MIDDLE activity · RIGHT notes + appointments.
    async function openContact(cid, cached) {
      let c = (cached || []).find((x) => x.ghl_contact_id === cid);
      if (!c) { const { data } = await sb.from('ph_contacts').select('*').eq('ghl_contact_id', cid).maybeSingle(); c = data; }
      if (!c) return;
      currentRoute = 'contact-record';
      $('#page-title').textContent = nameOf(c);
      $('#page-sub').textContent = 'Client record';
      $$('.nav-item[data-route]').forEach((n) => n.classList.toggle('active', n.dataset.route === 'contacts'));
      const v = $('#view'); v.scrollTop = 0;

      // Pull the carriers linked to this client (RLS-scoped) + their policies.
      const [{ data: links }, { data: policies }] = await Promise.all([
        sb.from('ph_contact_carriers').select('carrier_id').eq('contact_id', cid),
        sb.from('ph_policies').select('*').eq('contact_id', cid).order('created_at', { ascending: false }),
      ]);
      const linkedIds = new Set((links || []).map((r) => r.carrier_id));
      const carrierNames = state.carriers.filter((x) => linkedIds.has(x.id)).map((x) => x.name);
      const deps = Array.isArray(c.dependents) ? c.dependents : [];
      const dob = c.date_of_birth ? new Date(c.date_of_birth).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' }) : '';
      const dispSel = DISPOSITIONS.map((d) => `<option ${d === c.disposition ? 'selected' : ''}>${esc(d)}</option>`).join('');
      const linkedCo = c.company_id ? state.companies.find((x) => x.id === c.company_id) : null;
      const custom = c.custom || {};
      const polStatusClass = (s) => ({ Active: 'st-green', Issued: 'st-green', Pending: 'st-amber', Applied: 'st-amber', Quoted: 'st-blue', Lapsed: 'st-red', Cancelled: 'st-red', Declined: 'st-red' }[s] || 'st-gray');
      const policyRow = (p) => `
        <div class="pol-row" data-pol="${p.id}">
          <div class="pol-top"><b>${esc(p.line)}</b><span class="pill-status ${polStatusClass(p.status)}">${esc(p.status)}</span></div>
          <div class="cell-sub">${esc([p.carrier_name, p.policy_number ? '#' + p.policy_number : ''].filter(Boolean).join(' · ') || 'No carrier yet')}</div>
          ${p.premium != null ? `<div class="pol-prem">${fmtMoney(p.premium)} <em>/ ${esc((p.premium_freq || 'Monthly').toLowerCase())}</em></div>` : ''}
          ${p.renewal_date ? `<div class="cell-sub">Renews ${esc(new Date(p.renewal_date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' }))}</div>` : ''}
        </div>`;
      const customFieldRow = (f) => {
        const val = custom[f.key] ?? '';
        if (f.field_type === 'select') {
          const opts = ['<option value=""></option>'].concat((f.options || []).map((o) => `<option ${o === val ? 'selected' : ''}>${esc(o)}</option>`)).join('');
          return `<div class="k">${esc(f.label)}</div><div class="v"><select class="cf-inline" data-cf="${esc(f.key)}">${opts}</select></div>`;
        }
        const type = f.field_type === 'number' ? 'number' : f.field_type === 'date' ? 'date' : 'text';
        return `<div class="k">${esc(f.label)}</div><div class="v"><input class="cf-inline" type="${type}" data-cf="${esc(f.key)}" value="${esc(val)}"/></div>`;
      };

      v.innerHTML = `
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
        <button class="btn btn-ghost btn-sm" id="rec-back">← Contacts</button>
        <span class="avatar-sm" style="width:40px;height:40px;font-size:.9rem;background:${avColor(nameOf(c))}">${initials(nameOf(c))}</span>
        <div><div style="font-size:1.2rem;font-weight:800">${esc(nameOf(c))}</div><div class="cell-sub">${esc(c.email || '')} ${c.phone ? '· ' + esc(fmtPhone(c.phone)) : ''}</div></div>
        <span class="pill-status ${dispClass(c.disposition)}" id="rec-disp-pill" style="margin-left:8px">${esc(c.disposition || 'No disposition')}</span>
      </div>
      <div class="rec-grid">
        <div class="card"><div class="card-h"><span class="grad-label">Client data</span></div><div class="card-b">
          <div class="kv">
            <div class="k">First name</div><div class="v">${esc(c.first_name || '—')}</div>
            <div class="k">Last name</div><div class="v">${esc(c.last_name || '—')}</div>
            <div class="k">Company</div><div class="v">${linkedCo ? `<a href="#" id="rec-company" style="color:var(--blue);font-weight:650;text-decoration:none">${esc(linkedCo.name)}</a>` : esc(c.company || '—')}</div>
            ${c.job_title ? `<div class="k">Role / title</div><div class="v">${esc(c.job_title)}</div>` : ''}
            <div class="k">Date of birth</div><div class="v">${esc(dob || '—')}</div>
            <div class="k">Email</div><div class="v">${esc(c.email || '—')}</div>
            <div class="k">Phone</div><div class="v">${esc(fmtPhone(c.phone) || '—')}</div>
            <div class="k">Address</div><div class="v">${esc([c.street_address, c.city, [c.state, c.postal_code].filter(Boolean).join(' ')].filter(Boolean).join(', ') || '—')}</div>
            <div class="k">How we met</div><div class="v"><input class="cf-inline" id="rec-source" value="${esc(c.source || '')}" placeholder="Referral, website, event…"/></div>
            ${state.customFields.map(customFieldRow).join('')}
          </div>
          <div class="section-t">Disposition</div>
          <select id="rec-disp" class="rec-select">${dispSel}</select>
          <div class="hint" id="rec-disp-hint">Active Client marks the client in-force (issued) and records you as the writing agent.</div>
          <div class="section-t">Policies <button class="btn btn-ghost btn-sm" id="rec-add-policy" style="margin-left:auto">+ Add</button></div>
          <div id="rec-policies">${(policies && policies.length) ? policies.map(policyRow).join('') : '<span class="cell-sub">None yet — add what you quote or write for this client.</span>'}</div>
          <div class="section-t">Lines of insurance</div>
          <div>${(c.coverage_types || []).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None</span>'}</div>
          <div class="section-t">Carriers <button class="btn btn-ghost btn-sm" id="rec-edit-carriers" style="margin-left:auto">Edit</button></div>
          <div id="rec-carriers">${carrierNames.map((n) => `<span class="chip">${esc(n)}</span>`).join(' ') || '<span class="cell-sub">None selected</span>'}</div>
          ${deps.length ? `<div class="section-t">Dependents</div>${deps.map((d) => `<div class="feed-item"><div class="feed-ic">👤</div><div><div style="font-weight:650">${esc([d.first_name, d.last_name].filter(Boolean).join(' ') || d.relation)}</div><div class="cell-sub">${esc(d.relation)}${d.dob ? ' · ' + esc(d.dob) : ''}</div></div></div>`).join('')}` : ''}
          <div class="section-t">Tags <button class="btn btn-ghost btn-sm" id="rec-edit-tags" style="margin-left:auto">Edit</button></div>
          <div id="rec-tags">${(c.tags || []).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None</span>'}</div>
        </div></div>

        <div class="card"><div class="card-h"><span class="grad-label">Activity</span></div><div class="card-b" id="rec-activity">
          <div class="cell-sub">Loading…</div>
        </div></div>

        <div class="card"><div class="card-h"><span class="grad-label">Notes & appointments</span></div><div class="card-b">
          <div id="rec-appts"><div class="cell-sub">Loading…</div></div>
          <div class="section-t">Notes</div>
          <textarea id="rec-note" class="rec-select" rows="3" placeholder="Add a note…"></textarea>
          <button class="btn btn-primary btn-sm" id="rec-note-save" style="margin-top:8px">Save note</button>
          <div id="rec-notes" style="margin-top:12px"></div>
        </div></div>
      </div>`;

      $('#rec-back').addEventListener('click', () => go('contacts'));

      // disposition change → writes ph_contacts.disposition; DB trigger handles in-force.
      $('#rec-disp').addEventListener('change', async (e) => {
        const val = e.target.value; const prev = c.disposition;
        const { error } = await sb.from('ph_contacts').update({ disposition: val }).eq('ghl_contact_id', cid);
        if (error) { e.target.value = prev || ''; toast('Could not update disposition.'); return; }
        c.disposition = val;
        const pill = $('#rec-disp-pill'); pill.textContent = val; pill.className = 'pill-status ' + dispClass(val);
        toast(val === 'Active Client' ? 'Marked Active Client — client is now in-force' : 'Disposition updated');
      });

      $('#rec-edit-carriers').addEventListener('click', () => editContactCarriers(cid, linkedIds));
      $('#rec-company')?.addEventListener('click', (e) => { e.preventDefault(); openCompany(c.company_id); });

      // Tags: broker picks from the admin-defined list; legacy imported tags
      // on the record are preserved untouched.
      $('#rec-edit-tags').addEventListener('click', () => {
        const adminNames = state.adminTags.map((t) => t.name);
        const cur = c.tags || [];
        openDrawer(`
          <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Tags</div><div class="cell-sub">${esc(nameOf(c))} — pick from the office list</div></div><button class="drawer-x" data-x>✕</button></div>
          <div class="drawer-b">
            <div style="display:flex;flex-wrap:wrap;gap:8px">${adminNames.map((t) => `<label class="pickbox"><input type="checkbox" data-tp="${esc(t)}" ${cur.some((x) => x.toLowerCase() === t.toLowerCase()) ? 'checked' : ''}/> ${esc(t)}</label>`).join('') || '<span class="cell-sub">No tags defined — ask an admin to add some under Manage fields.</span>'}</div>
            <button class="btn btn-primary" id="tp-save" style="margin-top:16px">Save tags</button>
            <p class="cell-sub" id="tp-status" style="margin-top:8px"></p>
          </div>`);
        $('[data-x]').addEventListener('click', closeDrawer);
        $('#tp-save').addEventListener('click', async () => {
          const lowerAdmin = adminNames.map((t) => t.toLowerCase());
          const legacy = cur.filter((t) => !lowerAdmin.includes(t.toLowerCase()));
          const picked = $$('[data-tp]').filter((x) => x.checked).map((x) => x.getAttribute('data-tp'));
          const next = legacy.concat(picked);
          const { error } = await sb.from('ph_contacts').update({ tags: next }).eq('ghl_contact_id', cid);
          if (error) { $('#tp-status').textContent = 'Could not save: ' + error.message; return; }
          c.tags = next;
          $('#rec-tags').innerHTML = next.map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None</span>';
          closeDrawer(); toast('Tags updated');
        });
      });

      // "How we met" + custom fields autosave on change/blur.
      const saveField = async (patch, okMsg) => {
        const { error } = await sb.from('ph_contacts').update(patch).eq('ghl_contact_id', cid);
        if (error) toast('Could not save.'); else if (okMsg) toast(okMsg);
        return !error;
      };
      let srcT;
      $('#rec-source')?.addEventListener('change', (e) => {
        clearTimeout(srcT);
        srcT = setTimeout(async () => { if (await saveField({ source: e.target.value.trim() || null })) { c.source = e.target.value.trim(); toast('Saved'); } }, 200);
      });
      $$('.cf-inline[data-cf]', v).forEach((inp) => inp.addEventListener('change', async () => {
        const key = inp.getAttribute('data-cf');
        const next = Object.assign({}, c.custom || {});
        if (inp.value === '' || inp.value == null) delete next[key]; else next[key] = inp.value;
        if (await saveField({ custom: next })) { c.custom = next; toast('Saved'); }
      }));

      // ---- Policies: add / edit drawer ----
      let recPolicies = policies || [];
      const repaintPolicies = () => {
        $('#rec-policies').innerHTML = recPolicies.length ? recPolicies.map(policyRow).join('') : '<span class="cell-sub">None yet — add what you quote or write for this client.</span>';
        $$('#rec-policies [data-pol]').forEach((el) => el.addEventListener('click', () => openPolicyForm(recPolicies.find((p) => p.id === el.dataset.pol))));
      };
      function openPolicyForm(pol) {
        const lineOpts = COVERAGE_TYPES.map((l) => `<option ${pol && pol.line === l ? 'selected' : ''}>${esc(l)}</option>`).join('');
        const carOpts = ['<option value=""></option>'].concat(state.carriers.map((x) => `<option value="${x.id}" ${pol && pol.carrier_id === x.id ? 'selected' : ''}>${esc(x.name)}</option>`)).join('');
        const stOpts = POLICY_STATUSES.map((s) => `<option ${pol && pol.status === s ? 'selected' : (!pol && s === 'Quoted' ? 'selected' : '')}>${esc(s)}</option>`).join('');
        const frOpts = PREMIUM_FREQS.map((f) => `<option ${pol && pol.premium_freq === f ? 'selected' : (!pol && f === 'Monthly' ? 'selected' : '')}>${esc(f)}</option>`).join('');
        openDrawer(`
          <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">${pol ? 'Edit policy' : 'Add policy'}</div><div class="cell-sub">${esc(nameOf(c))}</div></div><button class="drawer-x" data-x>✕</button></div>
          <div class="drawer-b"><form id="pol-form">
            <div class="grid2">
              <div class="field"><label>Line of insurance *</label><select name="line">${lineOpts}</select></div>
              <div class="field"><label>Status</label><select name="status">${stOpts}</select></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Carrier</label><select name="carrier_id">${carOpts}</select></div>
              <div class="field"><label>Policy #</label><input name="policy_number" value="${esc(pol?.policy_number || '')}"/></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Premium</label><input name="premium" type="number" step="0.01" min="0" placeholder="0.00" value="${esc(pol?.premium ?? '')}"/></div>
              <div class="field"><label>Frequency</label><select name="premium_freq">${frOpts}</select></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Effective date</label><input name="effective_date" type="date" value="${esc(pol?.effective_date || '')}"/></div>
              <div class="field"><label>Renewal date</label><input name="renewal_date" type="date" value="${esc(pol?.renewal_date || '')}"/></div>
            </div>
            <div class="field"><label>Notes</label><textarea name="notes" rows="2">${esc(pol?.notes || '')}</textarea></div>
            <div style="display:flex;gap:10px;align-items:center">
              <button class="btn btn-primary" type="submit">${pol ? 'Save policy' : 'Add policy'}</button>
              ${pol ? '<button class="btn btn-ghost btn-sm" type="button" id="pol-del">Delete</button>' : ''}
            </div>
            <p class="cell-sub" id="pol-status" style="margin-top:8px"></p>
          </form></div>`);
        $('[data-x]').addEventListener('click', closeDrawer);
        $('#pol-del')?.addEventListener('click', async () => {
          if (!confirm('Delete this policy?')) return;
          const { error } = await sb.from('ph_policies').delete().eq('id', pol.id);
          if (error) { $('#pol-status').textContent = 'Could not delete: ' + error.message; return; }
          recPolicies = recPolicies.filter((p) => p.id !== pol.id);
          repaintPolicies(); closeDrawer(); toast('Policy deleted');
        });
        $('#pol-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.target;
          const carId = f.carrier_id.value || null;
          const patch = {
            contact_id: cid, agent_id: pol ? pol.agent_id : (c.agent_id || state.me.id),
            line: f.line.value, status: f.status.value,
            carrier_id: carId, carrier_name: carId ? (state.carriers.find((x) => x.id === carId)?.name ?? null) : null,
            policy_number: f.policy_number.value.trim() || null,
            premium: f.premium.value !== '' ? parseFloat(f.premium.value) : null,
            premium_freq: f.premium_freq.value,
            effective_date: f.effective_date.value || null, renewal_date: f.renewal_date.value || null,
            notes: f.notes.value.trim() || null, updated_at: new Date().toISOString(),
          };
          const q = pol ? sb.from('ph_policies').update(patch).eq('id', pol.id).select('*').single()
                        : sb.from('ph_policies').insert(patch).select('*').single();
          const { data, error } = await q;
          if (error) { $('#pol-status').textContent = 'Could not save: ' + error.message; return; }
          if (pol) { const i = recPolicies.findIndex((p) => p.id === pol.id); if (i >= 0) recPolicies[i] = data; }
          else {
            recPolicies.unshift(data);
            // The DB trigger unions the line into coverage_types (which auto-creates
            // the pipeline deal) — mirror it locally so the card reflects it now.
            if (!(c.coverage_types || []).includes(data.line)) { c.coverage_types = (c.coverage_types || []).concat(data.line); reloadOpps(); }
          }
          repaintPolicies(); closeDrawer(); toast(pol ? 'Policy updated' : 'Policy added — now in your pipeline too');
        });
      }
      $('#rec-add-policy').addEventListener('click', () => openPolicyForm(null));
      $$('#rec-policies [data-pol]').forEach((el) => el.addEventListener('click', () => openPolicyForm(recPolicies.find((p) => p.id === el.dataset.pol))));

      // Activity: emails + notes + record events, newest first.
      loadContactActivity(cid, c);
      loadContactNotes(cid);
      loadContactAppointments(c);
      $('#rec-note-save').addEventListener('click', () => saveNote(cid));
    }

    async function loadContactActivity(cid, c) {
      const host = $('#rec-activity'); if (!host) return;
      const items = [];
      items.push({ icon: '➕', title: 'Contact created', when: c.ghl_date_added });
      if (c.issued_at) items.push({ icon: '✅', title: 'Marked Active Client (in-force)', when: c.issued_at });
      items.sort((a, b) => +new Date(b.when || 0) - +new Date(a.when || 0));
      host.innerHTML = items.map((i) => `<div class="feed-item"><div class="feed-ic">${i.icon}</div><div><div style="font-weight:650">${esc(i.title)}</div><div class="cell-sub">${esc(fmtDateTime(i.when))}</div></div></div>`).join('') || '<div class="cell-sub">No activity yet.</div>';
    }
    async function loadContactAppointments(c) {
      const host = $('#rec-appts'); if (!host) return;
      // Match any lead for this contact that has an appointment.
      const appts = state.leads.filter((l) => l.ghl_contact_id === c.ghl_contact_id && l.appointment_start);
      host.innerHTML = appts.length ? appts.map((l) => `<div class="feed-item"><div class="feed-ic">📅</div><div><div style="font-weight:650">${esc(fmtFull(l.appointment_start))}</div><div class="cell-sub">${esc(l.kind || 'appointment')}</div></div></div>`).join('') : '<div class="cell-sub">No appointments.</div>';
    }
    async function loadContactNotes(cid) {
      const host = $('#rec-notes'); if (!host) return;
      const { data } = await sb.from('ph_notes').select('*').eq('contact_id', cid).order('created_at', { ascending: false }).limit(50);
      host.innerHTML = (data && data.length) ? data.map((n) => `<div class="feed-item"><div class="feed-ic">📝</div><div><div>${esc(n.body)}</div><div class="cell-sub">${esc(fmtDateTime(n.created_at))}</div></div></div>`).join('') : '<div class="cell-sub">No notes yet.</div>';
    }
    async function saveNote(cid) {
      const ta = $('#rec-note'); const body = ta.value.trim(); if (!body) return;
      const { error } = await sb.from('ph_notes').insert({ contact_id: cid, body });
      if (error) { toast('Could not save note.'); return; }
      ta.value = ''; toast('Note saved'); loadContactNotes(cid);
    }

    // Edit which carriers cover this client, in a small modal-like drawer section.
    function editContactCarriers(cid, linkedIds) {
      const opts = state.carriers.map((c) => `<label class="pickbox"><input type="checkbox" data-carrier="${c.id}" ${linkedIds.has(c.id) ? 'checked' : ''}/> ${esc(c.name)}</label>`).join('');
      openDrawer(`
        <div class="drawer-h"><div style="font-size:1.1rem;font-weight:800">Carriers for this client</div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div class="pickgrid">${opts || '<div class="cell-sub">No carriers.</div>'}</div>
          <button class="btn btn-primary" id="cc-save" style="margin-top:18px">Save carriers</button>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cc-save').addEventListener('click', async () => {
        const want = new Set($$('#drawer [data-carrier]').filter((c) => c.checked).map((c) => c.getAttribute('data-carrier')));
        const add = [...want].filter((id) => !linkedIds.has(id));
        const remove = [...linkedIds].filter((id) => !want.has(id));
        if (add.length) await sb.from('ph_contact_carriers').insert(add.map((carrier_id) => ({ contact_id: cid, carrier_id })));
        for (const id of remove) await sb.from('ph_contact_carriers').delete().eq('contact_id', cid).eq('carrier_id', id);
        closeDrawer(); toast('Carriers updated'); openContact(cid, null);
      });
    }

    // ================= ADMIN: CARRIER MANAGER =================
    async function openCarrierManager() {
      await reloadCarriers();
      const list = (state.allCarriers || []).map((c) => `
        <div class="feed-item" data-cid="${c.id}">
          <input class="cm-name" value="${esc(c.name)}" style="flex:1;border:1px solid var(--line);border-radius:8px;padding:6px 10px"/>
          <label class="cell-sub" style="display:flex;align-items:center;gap:5px"><input type="checkbox" class="cm-active" ${c.is_active ? 'checked' : ''}/> active</label>
          <button class="btn btn-ghost btn-sm cm-save">Save</button>
          <button class="btn btn-ghost btn-sm cm-del" style="color:var(--red)">Delete</button>
        </div>`).join('');
      openDrawer(`
        <div class="drawer-h"><div style="font-size:1.1rem;font-weight:800">Carriers</div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div class="hint">Changes here apply for every user's dropdown.</div>
          <div style="display:flex;gap:8px;margin:12px 0">
            <input id="cm-new" placeholder="New carrier name" style="flex:1;border:1px solid var(--line);border-radius:8px;padding:8px 11px"/>
            <button class="btn btn-primary btn-sm" id="cm-add">Add</button>
          </div>
          <div id="cm-list">${list}</div>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cm-add').addEventListener('click', async () => {
        const name = $('#cm-new').value.trim(); if (!name) return;
        const { error } = await sb.from('ph_carriers').insert({ name });
        if (error) { toast(error.message.includes('duplicate') ? 'That carrier already exists.' : 'Could not add.'); return; }
        toast('Carrier added'); openCarrierManager();
      });
      $$('#drawer [data-cid]').forEach((row) => {
        const id = row.getAttribute('data-cid');
        row.querySelector('.cm-save').addEventListener('click', async () => {
          const name = row.querySelector('.cm-name').value.trim();
          const is_active = row.querySelector('.cm-active').checked;
          const { error } = await sb.from('ph_carriers').update({ name, is_active }).eq('id', id);
          toast(error ? 'Could not save.' : 'Saved'); if (!error) reloadCarriers();
        });
        row.querySelector('.cm-del').addEventListener('click', async () => {
          const { error } = await sb.from('ph_carriers').delete().eq('id', id);
          if (error) { toast('In use — set inactive instead of deleting.'); return; }
          toast('Deleted'); openCarrierManager();
        });
      });
    }

    // global search → jump to contacts filtered
    $('#global-search').addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      cQuery = e.target.value.trim(); cPage = 0; go('contacts');
    });

    // ================= BOOT (verbatim auth arrival logic) =================
    (async () => {
      const params = new URLSearchParams(location.search);
      const token = params.get('claim');
      if (token) {
        view('loading');
        const { ok, json } = await authPost({ action: 'claim_info', token });
        if (ok && json.ok) {
          claimToken = token;
          $('.ag-setpw-form').email.value = json.email || '';
          $('.ag-setpw-title').textContent = 'Welcome, ' + (String(json.full_name || '').split(' ')[0] || 'there');
          $('.ag-setpw-intro').textContent = 'Set a password for ' + (json.email || 'your account') + '. You will use it to sign in from now on.';
          view('setpassword'); return;
        }
        const why = { used: 'That link has already been used. Sign in below, or use Forgot your password.', expired: 'That link has expired. Use Forgot your password below and we will send a fresh one.', invalid: 'That link is not valid. Check you copied the whole thing, or ask the office to resend it.' }[json.reason] || 'That link is not valid.';
        view('signin'); setStatus('signin', why, true); return;
      }
      let recovering = false;
      sb.auth.onAuthStateChange((event) => {
        if (event !== 'PASSWORD_RECOVERY') return;
        recovering = true; claimToken = null;
        $('.ag-setpw-title').textContent = 'Choose a new password';
        $('.ag-setpw-intro').textContent = 'Pick something you will remember. At least 10 characters.';
        view('setpassword');
      });
      let settled = false;
      const toSignin = () => { if (!settled) { settled = true; view('signin'); } };
      const stall = setTimeout(toSignin, 8000);
      try {
        const { data } = await sb.auth.getSession();
        const email = data?.session?.user?.email;
        clearTimeout(stall);
        if (recovering) { settled = true; return; }
        if (!email) { toSignin(); return; }
        settled = true;
        await enter(email);
      } catch (err) {
        clearTimeout(stall); toSignin();
        setStatus('signin', 'Could not check your session. Please sign in.', true);
      }
    })();
  }
  </script>
</body>
</html>
