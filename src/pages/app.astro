  </style>

  <script>
  import { createClient } from '@supabase/supabase-js';
  // CSV import: parser, alias table, matching rules and the batch runner. Shared
  // verbatim with /admin/contacts so the two importers cannot drift apart.
  import {
    readCsv, fieldsFor, matchOptions, autoMap, sampleValues, objectLabel,
    failedRowsCsv, runImport, BATCH_SIZE,
  } from '../lib/csv-import';

  const root = document.querySelector('.ph');
  if (root) {
    const sb = createClient(
      root.getAttribute('data-supabase-url'),
      root.getAttribute('data-supabase-anon'),
      { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } },
    );
    const LOGO = root.getAttribute('data-logo');
    // Read from the data attributes, not the Astro frontmatter — this script is
    // bundled separately and never sees the module-scope consts up top.
    const SB_URL = root.getAttribute('data-supabase-url');
    const SB_ANON = root.getAttribute('data-supabase-anon');
    const PETE_URL = 'https://help.guidedbroker.com/';

    const gate = root.querySelector('[data-gate]');
    const app = root.querySelector('[data-app]');
    const $ = (s, r = root) => r.querySelector(s);
    const $$ = (s, r = root) => Array.from(r.querySelectorAll(s));
    const view = (name) =>
      $$('.ag-view').forEach((v) => (v.hidden = v.getAttribute('data-view') !== name));

    const TZ = 'America/Los_Angeles';
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fmtDate = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric' }) : '';
    const fmtDateTime = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const fmtFull = (iso) => iso ? new Date(iso).toLocaleString('en-US', { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const nameOf = (r) => [r.first_name, r.last_name].filter(Boolean).join(' ') || r.email || r.phone || 'Unknown';
    const fmtPhone = (p) => { const d = String(p ?? '').replace(/\D/g, '').replace(/^1/, ''); return d.length === 10 ? `(${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}` : (p || ''); };
    const initials = (n) => String(n || '?').trim().split(/\s+/).slice(0,2).map((w) => w[0]).join('').toUpperCase();
    const AV = ['#197bff','#0D9488','#7C3AED','#D97706','#DB2777','#007db3','#15803d'];
    const avColor = (s) => AV[[...String(s||'')].reduce((a,c)=>a+c.charCodeAt(0),0) % AV.length];

    const toast = (msg) => {
      const t = $('#toast'); t.textContent = msg; t.classList.add('on');
      clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove('on'), 2200);
    };

    // ================= AUTH (verbatim from the Aug 10 flow) =================
    const AUTH_FN = `${root.getAttribute('data-supabase-url')}/functions/v1/ph-auth`;
    const authPost = async (body) => {
      const res = await fetch(AUTH_FN, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      let json = {}; try { json = await res.json(); } catch {}
      return { ok: res.ok, status: res.status, json };
    };
    const statusIn = (v) => root.querySelector(`.ag-view[data-view="${v}"] .ag-status`);
    const setStatus = (v, text, bad = false) => { const el = statusIn(v); if (!el) return; el.textContent = text; el.classList.toggle('is-bad', !!bad); };

    // Show/hide password toggles (the little eye inside password fields).
    root.addEventListener('click', (e) => {
      const b = e.target.closest('.pw-eye'); if (!b) return;
      const input = b.parentElement.querySelector('input'); if (!input) return;
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      b.classList.toggle('on', show);
    });

    $('.ag-go-forgot')?.addEventListener('click', (e) => {
      e.preventDefault(); setStatus('signin', '');
      const typed = $('.ag-login-form')?.email?.value?.trim();
      if (typed) $('.ag-forgot-form').email.value = typed;
      view('forgot');
    });
    // Every "back to sign in" link, not just the first one on the page.
    $$('.ag-go-signin').forEach((el) => el.addEventListener('click', (e) => {
      e.preventDefault(); setStatus('forgot', ''); setStatus('firstrun', ''); view('signin');
    }));
    $('.ag-go-firstrun')?.addEventListener('click', (e) => {
      e.preventDefault(); setStatus('signin', '');
      const typed = $('.ag-login-form')?.email?.value?.trim();
      if (typed) $('.ag-firstrun-form').email.value = typed;
      view('firstrun');
    });

    // First-time setup. The server does the real gatekeeping (office code,
    // roster membership, already-has-a-password check); this just collects the
    // four fields, then signs them straight in so they never type the password
    // twice in a row.
    $('.ag-firstrun-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target;
      const btn = f.querySelector('button[type="submit"]');
      const email = f.email.value.trim().toLowerCase();
      const code = f.code.value.trim();
      const password = f.password.value;
      const confirm = f.confirm.value;
      if (password !== confirm) { setStatus('firstrun', 'Those two passwords do not match.', true); return; }
      if (password.length < 10) { setStatus('firstrun', 'Password must be at least 10 characters.', true); return; }

      btn.disabled = true; setStatus('firstrun', 'Setting up your login…');
      const { ok, json } = await authPost({ action: 'setup', email, code, password });
      if (!ok) {
        btn.disabled = false;
        setStatus('firstrun', json.error || 'Could not set that up. Check the code and try again.', true);
        return;
      }
      f.password.value = ''; f.confirm.value = ''; f.code.value = '';
      const { data, error } = await sb.auth.signInWithPassword({ email: json.email || email, password });
      if (error) {
        btn.disabled = false;
        setStatus('signin', 'Your login is ready. Sign in with the password you just created.');
        view('signin');
        return;
      }
      await enter(data?.session?.user?.email ?? email);
    });

    $('.ag-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const email = e.target.email.value.trim(); const password = e.target.password.value;
      btn.disabled = true; setStatus('signin', 'Signing in…');
      const { data, error } = await sb.auth.signInWithPassword({ email, password });
      if (error) { btn.disabled = false; setStatus('signin', 'That email and password did not match. Try again, or use Forgot your password.', true); return; }
      e.target.password.value = '';
      await enter(data?.session?.user?.email ?? email);
    });

    $('.ag-forgot-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]'); btn.disabled = true;
      setStatus('forgot', 'Sending…');
      await authPost({ action: 'recover', email: e.target.email.value.trim() });
      btn.disabled = false;
      setStatus('forgot', 'If that address is on the roster, a reset link is on its way. It expires in 60 minutes.');
    });

    let claimToken = null;
    $('.ag-setpw-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const password = e.target.password.value, confirm = e.target.confirm.value;
      if (password !== confirm) { setStatus('setpassword', 'Those two passwords do not match.', true); return; }
      if (password.length < 10) { setStatus('setpassword', 'Password must be at least 10 characters.', true); return; }
      btn.disabled = true; setStatus('setpassword', 'Saving…');
      if (claimToken) {
        const { ok, json } = await authPost({ action: 'claim', token: claimToken, password });
        if (!ok) { btn.disabled = false; setStatus('setpassword', json.error || 'That link is no longer valid.', true); return; }
        const { error } = await sb.auth.signInWithPassword({ email: json.email, password });
        if (error) { btn.disabled = false; setStatus('setpassword', 'Password saved. Please sign in.', true); view('signin'); return; }
        claimToken = null; history.replaceState({}, '', '/app');
        await enter(json.email); return;
      }
      const { error } = await sb.auth.updateUser({ password });
      if (error) { btn.disabled = false; setStatus('setpassword', error.message, true); return; }
      const { data } = await sb.auth.getSession();
      const who = data?.session?.user?.email;
      if (!who) { view('signin'); return; }
      history.replaceState({}, '', '/app');
      await enter(who);
    });

    $$('.ag-signout').forEach((b) => b.addEventListener('click', async () => { await sb.auth.signOut(); location.reload(); }));

    // ================= SESSION → APP =================
    const state = { me: null, isAdmin: false, agentId: null, leads: [], contacts: [], stages: [], calendars: [], contactCount: 0, carriers: [], pipelines: [], pipelineStages: [], opps: [], appts: [], mySched: null, companies: [], customFields: [], adminTags: [], dash: null, recentContacts: [], outcomes: null, gcalEvents: null, oppContacts: {}, contactEmails: [], reviewRows: [] };

    // ---- personal scope ----
    // This app is a BROKER's desk, including when the broker happens to be an
    // admin. RLS alone does not give us that: its admin policy is a house-wide
    // read, so before this an admin opening /app saw all 8,200 contacts, every
    // broker's pipeline and everyone's availability mixed into their own.
    // Every agent-owned read therefore carries an explicit agent_id filter.
    // For a broker it is redundant with RLS and costs nothing; for an admin it
    // is the whole point. House-wide reading lives at /admin/contacts.
    //
    // A UUID that matches nothing, so an admin with no roster row of their own
    // gets a clean empty desk rather than an unfiltered query.
    const NO_AGENT = '00000000-0000-0000-0000-000000000000';
    const mine = (q) => q.eq('agent_id', state.agentId || NO_AGENT);

    // Fixed vocabularies from Rob's spec.
    const DISPOSITIONS = ['Lead', 'Active Client', 'Follow-Up', 'Not Interested', 'No Answer', 'Wrong Number', 'Do Not Call'];
    const POLICY_STATUSES = ['Quoted', 'Applied', 'Pending', 'Issued', 'Active', 'Lapsed', 'Cancelled', 'Declined'];
    const PREMIUM_FREQS = ['Monthly', 'Quarterly', 'Semi-Annual', 'Annual', 'Single'];
    const fmtMoney = (n) => n == null || n === '' ? '' : '$' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    // Matches the pipeline lines one-to-one, so a checked line maps straight to
    // its pipeline (see ph_cov_to_line). Legacy labels still map server-side.
    const COVERAGE_TYPES = ['Health', 'Medicare', 'Dental', 'Vision', 'Life', 'Annuities', 'Group Benefits', 'Supplements', 'Accident / Gap'];
    const dispClass = (d) => ({
      'Active Client': 'st-green', 'Lead': 'st-blue', 'Follow-Up': 'st-amber',
      'Not Interested': 'st-gray', 'No Answer': 'st-gray', 'Wrong Number': 'st-red', 'Do Not Call': 'st-red',
    }[d] || 'st-gray');

    // Identity guard: /app and /admin share one Supabase session per browser,
    // so signing into one as a different person silently swaps the token under
    // any open tab. Without this, a tab keeps showing the OLD person's name
    // while every query runs as the NEW session (e.g. an admin's all-access
    // view rendered under a broker's name). If the live session user changes,
    // reload so the UI rebinds to who is actually signed in.
    let bootEmail = null;
    sb.auth.onAuthStateChange((_e, session) => {
      const now = session?.user?.email || null;
      if (bootEmail && now && now.toLowerCase() !== bootEmail.toLowerCase()) location.reload();
    });
    window.addEventListener('focus', async () => {
      if (!bootEmail) return;
      try {
        const { data } = await sb.auth.getSession();
        const now = data?.session?.user?.email;
        if (now && now.toLowerCase() !== bootEmail.toLowerCase()) location.reload();
      } catch {}
    });

    async function enter(email) {
      bootEmail = email;
      $$('[data-who]').forEach((el) => (el.textContent = email));

      // Prefer the LOCAL session for the uid — it is present the instant login
      // succeeds. getUser() validates against the server and can briefly return
      // null right after sign-in, which would leave state.uid empty.
      let uid = null;
      const { data: sess } = await sb.auth.getSession();
      uid = sess?.session?.user?.id ?? null;
      if (!uid) { const { data: authUser } = await sb.auth.getUser(); uid = authUser?.user?.id ?? null; }
      // Identity by UID first (roster emails change); email fallback only for a
      // roster row not yet linked to a login.
      const PROFILE_COLS = 'id, full_name, email, is_active, phone, public_email, bio, headshot_url, social_links, lines_of_insurance, onboarding_completed_at';
      let me = null;
      if (uid) {
        const { data } = await sb.from('ph_agents').select(PROFILE_COLS).eq('auth_user_id', uid).limit(1);
        me = data?.[0] ?? null;
      }
      if (!me) {
        const { data } = await sb.from('ph_agents').select(PROFILE_COLS).ilike('email', email).limit(1);
        me = data?.[0] ?? null;
      }
      // Admin check is independent of the roster: some admins are not brokers.
      const { data: adminRows } = await sb.from('ph_admins').select('email').limit(1);
      state.isAdmin = Array.isArray(adminRows) && adminRows.length > 0;

      if (!me && !state.isAdmin) { view('denied'); return; }
      state.me = me || { full_name: email };
      state.uid = uid;
      // Drives mine(). Null for an admin who is not on the roster: they get an
      // empty personal desk and do their house-wide work under /admin.
      state.agentId = me?.id ?? null;

      // First login: a broker who hasn't finished their profile lands on the
      // onboarding form before the dashboard — Rob's "collect it all in the room"
      // step. Admins are never gated by it (they may not want a broker landing
      // page); they can still build one anytime via Edit profile.
      // profileGaps() mirrors the landing-page gate exactly, so a broker who is
      // missing a headshot or a bio is sent back here rather than being left to
      // discover months later that they never had a page.
      if (me && !state.isAdmin && (!me.onboarding_completed_at || profileGaps(me).length > 0)) { openOnboarding(email); return; }
      enterApp(email);
    }

    $('#edit-profile')?.addEventListener('click', () => { if (state.email) openOnboarding(state.email, { editing: true }); });

    // Change password from inside the app. Works for any signed-in session —
    // including one that arrived via a magic link — so a broker who used
    // Forgot password can set a real password here and use it from then on.
    $('#change-password')?.addEventListener('click', () => {
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Change password</div><div class="cell-sub">${esc(state.email || '')}</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b"><form id="pw-form">
          <div class="field"><label>New password</label><input name="pw1" type="password" minlength="10" required autocomplete="new-password" placeholder="At least 10 characters"/></div>
          <div class="field"><label>Confirm new password</label><input name="pw2" type="password" minlength="10" required autocomplete="new-password"/></div>
          <button class="btn btn-primary" type="submit">Save password</button>
          <p class="cell-sub" id="pw-status" style="margin-top:10px"></p>
        </form></div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#pw-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target, st = $('#pw-status');
        const pw1 = f.pw1.value, pw2 = f.pw2.value;
        if (pw1.length < 10) { st.textContent = 'Use at least 10 characters.'; return; }
        if (pw1 !== pw2) { st.textContent = 'Those passwords do not match.'; return; }
        const btn = f.querySelector('button'); btn.disabled = true; st.textContent = 'Saving…';
        // A stale token makes updateUser fail quietly — refresh first if near expiry.
        let { data: { session } } = await sb.auth.getSession();
        const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
        if (session && stale) { const r = await sb.auth.refreshSession(); if (r?.data?.session) session = r.data.session; }
        const { error } = await sb.auth.updateUser({ password: pw1 });
        btn.disabled = false;
        if (error) {
          st.textContent = /same/i.test(error.message) ? 'That is already your current password.' : 'Could not save: ' + error.message;
          return;
        }
        closeDrawer();
        toast('Password updated — use it next time you sign in');
      });
    });

    function enterApp(email) {
      state.email = email;
      $$('[data-who]').forEach((el) => (el.textContent = email));
      gate.hidden = true; $('#onboarding').hidden = true; app.hidden = false;
      const nm = state.me.full_name || email;
      $('[data-who-name]').textContent = nm;
      paintAvatar();
      startClock();
      startHeartbeat();
      buildNav();
      Promise.all([loadData(), loadDash().catch(() => {})]).then(() => {
        go(location.hash.replace('#', '') || 'dashboard');
        // Back from the Google OAuth round trip: land on Availability with a clear result.
        const q = new URLSearchParams(location.search);
        if (q.get('gcal')) {
          const ok = q.get('gcal') === 'connected';
          toast(ok ? 'Google Calendar connected' : 'Google connection failed: ' + (q.get('why') || 'try again'));
          history.replaceState({}, '', location.pathname + location.hash);
        }
      });
    }

    // Presence heartbeat: stamps last_seen_at on entry and every 5 minutes
    // while a tab is open. Powers the admin last-login view AND lead claiming —
    // the 60-minute TTL sweep treats "agent has been in the CRM since the lead
    // arrived" as claimed, so an open session counts, not just a fresh sign-in.
    let heartbeatTimer = null;
    function startHeartbeat() {
      const beat = () => {
        if (!state.uid) return;
        sb.from('ph_agents').update({ last_seen_at: new Date().toISOString() }).eq('auth_user_id', state.uid).then(() => {});
      };
      beat();
      if (!heartbeatTimer) heartbeatTimer = setInterval(beat, 5 * 60 * 1000);
    }

    // Top-right avatar: show the broker's headshot if they have one, else initials.
    function paintAvatar() {
      const av = $('#avatar'); if (!av) return;
      const nm = state.me?.full_name || state.email || '';
      if (state.me?.headshot_url) {
        av.textContent = '';
        av.style.background = 'transparent';
        av.innerHTML = `<img src="${esc(state.me.headshot_url)}" alt=""/>`;
      } else {
        av.innerHTML = '';
        av.style.background = 'var(--grad)';
        av.textContent = initials(nm);
      }
    }

    // ================= ONBOARDING / PROFILE =================
    const BROKER_LINES = ['Health', 'Medicare', 'Dental', 'Vision', 'Life', 'Annuities', 'Group Benefits', 'Supplements', 'Accident / Gap'];
    let pendingHeadshotFile = null;

    // Display/normalize helpers for the broker's own phone number. Stored
    // digits-only-ish values (+17029317099) become (702) 931-7099 on screen;
    // saving writes back a clean formatted string so landing pages, booking
    // pages and every email render the same thing.
    const fmtPhoneJs = (raw) => {
      const s = String(raw ?? '').trim(); if (!s) return '';
      const dg = s.replace(/\D/g, '');
      const ten = dg.length === 11 && dg.startsWith('1') ? dg.slice(1) : dg;
      return ten.length === 10 ? `(${ten.slice(0, 3)}) ${ten.slice(3, 6)}-${ten.slice(6)}` : s;
    };
    const phoneDigits = (raw) => {
      const dg = String(raw ?? '').replace(/\D/g, '');
      return dg.length === 11 && dg.startsWith('1') ? dg.slice(1) : dg;
    };

    // Landing-page prerequisites. A page is generated for a broker whose row
    // satisfies ph_public_brokers(): active, onboarded, headshot set, bio
    // non-blank. Phone is ours on top of that — a page that shows the main
    // office line instead of the broker is worse than no page.
    //
    // BIO_MIN is a QUALITY FLOOR ON NEW WRITES ONLY, enforced in saveOnboarding.
    // It is deliberately NOT part of profileGaps(), because profileGaps drives
    // the "is my page live" card and the login gate, and those have to mirror
    // the database exactly. Using 40 there told a broker with a short-but-real
    // bio that their page was "not live yet" while it was serving happily on
    // the public site — the same lie as before, just inverted. Never claim a
    // live page is missing.
    const BIO_MIN = 40;
    const bioText = (v) => String(v ?? '').trim().replace(/\s+/g, ' ');
    // Returns the human-readable list of what is still missing, in form order.
    // Mirrors ph_public_brokers() exactly: bio only has to be non-blank.
    function profileGaps(me) {
      const out = [];
      if (!me?.headshot_url) out.push('a headshot');
      if (phoneDigits(me?.phone).length !== 10) out.push('a phone number');
      if (!bioText(me?.bio)) out.push('a short bio');
      return out;
    }
    const listPhrase = (a) => a.length <= 1 ? (a[0] || '') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];

    function openOnboarding(email, opts = {}) {
      const editing = opts.editing === true;
      const me = state.me;
      // A broker only gets a landing page and a booking page once all three of
      // headshot, bio and phone are on the record — that is the exact gate in
      // ph_agents_mark_republish. Anything less and no page is ever generated,
      // so the broker walks away believing they are live when they are not.
      const gaps = profileGaps(me);
      // Someone who finished onboarding before a required field existed, or who
      // skipped one, gets sent back here for just that field, with copy saying why.
      const fixup = !editing && !!me.onboarding_completed_at && gaps.length > 0;
      const socials = me.social_links || {};
      const lines = new Set(me.lines_of_insurance || []);
      const firstName = String(me.full_name || '').split(' ')[0] || 'there';
      const lineOpts = BROKER_LINES.map((l) => `<label class="pickbox"><input type="checkbox" data-line="${esc(l)}" ${lines.has(l) ? 'checked' : ''}/> ${esc(l)}</label>`).join('');
      const el = $('#onboarding');
      el.innerHTML = `
        <div class="ob-scroll"><div class="ob-card">
          <img class="ag-logo" src="${LOGO}" alt="ProtectHealth" />
          <h1>${editing ? 'Edit your profile' : fixup ? 'One more thing, ' + esc(firstName) : 'Welcome, ' + esc(firstName)}</h1>
          <p class="ag-muted">${editing ? 'Update how you appear on your landing page and Meet the Team.'
            : fixup ? 'Your landing page and booking page are not live yet. They need ' + esc(listPhrase(gaps)) + ' before they can be built.'
            : 'This sets up your ProtectHealth landing page and your Meet the Team profile. Takes two minutes.'}</p>

          <div class="section-t">Headshot <span class="req">Required</span></div>
          <div class="ob-photo">
            <div class="ob-photo-preview" id="ob-preview">${me.headshot_url ? `<img src="${esc(me.headshot_url)}" alt=""/>` : '<span>No photo yet</span>'}</div>
            <div>
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">Choose photo<input type="file" id="ob-file" accept="image/png,image/jpeg,image/webp" hidden/></label>
              <div class="hint">A clear, front-facing photo. JPG or PNG, up to 8&nbsp;MB. You can retake it anytime. Without a photo your landing page is not built.</div>
            </div>
          </div>

          <div class="section-t">How clients reach you</div>
          <div class="hint" style="margin-bottom:8px">These appear on your landing page, your booking page, and in every email we send on your behalf. Use the line and inbox you actually answer.</div>
          <div class="grid2">
            <div class="field"><label>Phone number</label><input id="ob-phone" type="tel" inputmode="tel" autocomplete="tel" value="${esc(fmtPhoneJs(me.phone))}" placeholder="(702) 555-0148"/></div>
            <div class="field"><label>Contact email</label><input id="ob-pubemail" type="email" inputmode="email" autocomplete="email" value="${esc(me.public_email || '')}" placeholder="${esc(me.email || 'you@protecthealth.com')}"/></div>
          </div>
          <div class="hint" style="margin:-4px 0 0">Leave the email blank to use your login address (${esc(me.email || '')}). Set it if you would rather clients write somewhere else. Changing it never affects how you sign in.</div>

          <div class="section-t">Short bio <span class="req">Required</span></div>
          <textarea id="ob-bio" class="rec-select" rows="4" minlength="${BIO_MIN}" maxlength="600" placeholder="A few sentences prospects will read on your page. Who you help and how.">${esc(me.bio || '')}</textarea>
          <div class="ob-count" id="ob-bio-count"></div>

          <div class="section-t">Social links <span class="ag-muted" style="font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></div>
          <div class="field"><label>LinkedIn</label><input id="ob-linkedin" value="${esc(socials.linkedin || '')}" placeholder="https://linkedin.com/in/…"/></div>
          <div class="grid2">
            <div class="field"><label>Facebook</label><input id="ob-facebook" value="${esc(socials.facebook || '')}" placeholder="https://facebook.com/…"/></div>
            <div class="field"><label>Instagram</label><input id="ob-instagram" value="${esc(socials.instagram || '')}" placeholder="https://instagram.com/…"/></div>
          </div>
          <div class="field"><label>Website</label><input id="ob-website" value="${esc(socials.website || '')}" placeholder="https://…"/></div>

          <div class="section-t">Lines of insurance you write</div>
          <div class="hint" style="margin-bottom:8px">This decides which sections show on your landing page — a Medicare writer won't show a health-only page.</div>
          <div class="pickgrid">${lineOpts}</div>

          <div style="display:flex;gap:10px;margin-top:24px;align-items:center">
            <button class="ag-btn" id="ob-save">${editing ? 'Save profile' : 'Save & continue'}</button>
            ${editing ? '<button class="btn btn-ghost" id="ob-cancel">Cancel</button>'
              : fixup ? '' /* already onboarded and still missing a required field — no skip past it */
              : '<button class="btn btn-ghost" id="ob-skip">Skip for now — no landing page yet</button>'}
            <span class="ag-status ob-status" style="min-height:1em"></span>
          </div>
        </div></div>`;
      gate.hidden = true; app.hidden = editing ? false : true; el.hidden = false;
      if (editing) app.hidden = true; // full-screen while editing too

      // Format as they type so what they see is what gets stored.
      const phEl = $('#ob-phone');
      phEl?.addEventListener('blur', () => { phEl.value = fmtPhoneJs(phEl.value); });

      // Live bio counter, so the minimum is visible while typing instead of
      // arriving as a rejection after they press save.
      const bioEl = $('#ob-bio'), bioCount = $('#ob-bio-count');
      const paintBioCount = () => {
        const n = bioText(bioEl.value).length;
        const short = n < BIO_MIN;
        bioCount.textContent = short ? `${BIO_MIN - n} more characters needed` : `${n} / 600`;
        bioCount.classList.toggle('is-short', short);
        if (!short) bioEl.classList.remove('is-invalid');
      };
      bioEl.addEventListener('input', paintBioCount);
      paintBioCount();

      pendingHeadshotFile = null;
      $('#ob-file').addEventListener('change', (e) => {
        const f = e.target.files[0]; if (!f) return;
        if (f.size > 8 * 1024 * 1024) { setObStatus('That image is over 8 MB. Choose a smaller one.', true); return; }
        pendingHeadshotFile = f;
        $('#ob-preview').classList.remove('is-invalid');
        const rd = new FileReader();
        rd.onload = () => { $('#ob-preview').innerHTML = `<img src="${rd.result}" alt=""/>`; };
        rd.readAsDataURL(f);
      });
      $('#ob-save').addEventListener('click', () => saveOnboarding(email, editing));
      $('#ob-skip')?.addEventListener('click', () => enterApp(email));
      $('#ob-cancel')?.addEventListener('click', () => enterApp(email));
    }
    const setObStatus = (t, bad = false) => { const el = $('.ob-status'); if (el) { el.textContent = t; el.classList.toggle('is-bad', !!bad); } };

    async function saveOnboarding(email, editing) {
      const btn = $('#ob-save'); btn.disabled = true; setObStatus('Saving…');
      let headshot_url = state.me.headshot_url || null;

      // ---- validate before anything expensive ----
      // These run ahead of the headshot upload on purpose: failing after an
      // 8 MB upload wastes the broker's time and a round trip.
      //
      // Admins are not required to have a landing page (some are not brokers),
      // so the profile requirements only bind roster brokers.
      const mustHaveProfile = !state.isAdmin;

      // Phone is required for everyone here: it is the number on the landing
      // page, the booking page and every email sent on their behalf.
      const rawPhone = $('#ob-phone')?.value || '';
      const digits = phoneDigits(rawPhone);
      if (digits.length !== 10) {
        btn.disabled = false;
        setObStatus(digits.length ? 'That phone number needs 10 digits, like (702) 555-0148.' : 'Please add the phone number you want prospects to call.', true);
        $('#ob-phone')?.classList.add('is-invalid');
        $('#ob-phone')?.focus();
        return;
      }
      $('#ob-phone')?.classList.remove('is-invalid');

      // Headshot. Either one already on the record or one staged in this session.
      if (mustHaveProfile && !pendingHeadshotFile && !headshot_url) {
        btn.disabled = false;
        setObStatus('Add a headshot. Without one your landing page is never built.', true);
        $('#ob-preview')?.classList.add('is-invalid');
        $('#ob-preview')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      // Bio. This is the field that silently cost brokers their page: the form
      // used to accept a blank one, stamp onboarding_completed_at, and send the
      // broker away believing they were live.
      const bio = bioText($('#ob-bio')?.value);
      if (mustHaveProfile && bio.length < BIO_MIN) {
        btn.disabled = false;
        setObStatus(bio.length
          ? `Your bio needs at least ${BIO_MIN} characters — about one sentence. This is the text prospects read on your page.`
          : 'Add a short bio. Without one your landing page is never built.', true);
        $('#ob-bio')?.classList.add('is-invalid');
        $('#ob-bio')?.focus();
        return;
      }
      $('#ob-bio')?.classList.remove('is-invalid');

      // Optional public contact email. Blank means "use my login email".
      const pubEmail = ($('#ob-pubemail')?.value || '').trim();
      if (pubEmail && !/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(pubEmail)) {
        btn.disabled = false;
        setObStatus('That contact email does not look right. Check it, or leave it blank to use your login address.', true);
        $('#ob-pubemail')?.classList.add('is-invalid');
        $('#ob-pubemail')?.focus();
        return;
      }
      $('#ob-pubemail')?.classList.remove('is-invalid');

      // Storage RLS on broker-photos grants INSERT to the `authenticated` role
      // ONLY, so the upload request must carry a valid, unexpired user token.
      // On a page reload Supabase restores the session as INITIAL_SESSION (not
      // SIGNED_IN), and the short-lived access token can go stale while the
      // broker sits on this form. When that happens the SDK's storage upload
      // sends a token the server rejects, the request is treated as `anon`,
      // and the insert fails with "new row violates row-level security policy"
      // even though the path carries the correct uid. Force a fresh token here
      // and send it explicitly so auth.uid() is always set server-side.
      let { data: { session } } = await sb.auth.getSession();
      const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
      if (session && stale) {
        const r = await sb.auth.refreshSession();
        if (r?.data?.session) session = r.data.session;
      }
      const token = session?.access_token || null;
      let uid = session?.user?.id || state.uid || null;
      state.uid = uid;
      if (!uid || !token) { btn.disabled = false; setObStatus('Your session expired. Please sign out and back in.', true); return; }

      // Upload the headshot through the server (ph-upload-headshot). The browser
      // could not reliably attach a Storage-valid token to a direct upload, so
      // the file is handed to a function that verifies the caller and writes it
      // with the service role. The stored path stays pinned to this uid, so a
      // broker can still only ever write into their own folder.
      if (pendingHeadshotFile) {
        const base = root.getAttribute('data-supabase-url');
        const anon = root.getAttribute('data-supabase-anon');
        const fd = new FormData();
        fd.append('file', pendingHeadshotFile);
        const resp = await fetch(`${base}/functions/v1/ph-upload-headshot`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, apikey: anon },
          body: fd,
        });
        const up = await resp.json().catch(() => ({}));
        if (!resp.ok || !up?.url) {
          btn.disabled = false;
          setObStatus('Photo upload failed: ' + (up?.error || ('error ' + resp.status)), true);
          return;
        }
        headshot_url = up.url;
      }

      const social_links = {};
      for (const k of ['linkedin', 'facebook', 'instagram', 'website']) {
        const v = $('#ob-' + k)?.value?.trim();
        if (v) social_links[k] = v;
      }
      const lines_of_insurance = $$('[data-line]').filter((c) => c.checked).map((c) => c.getAttribute('data-line'));

      const patch = {
        phone: fmtPhoneJs(digits),
        public_email: pubEmail || null,
        bio: bio || null,
        headshot_url,
        social_links,
        lines_of_insurance,
      };
      // Only claim onboarding is finished when the record actually qualifies for
      // a landing page. Stamping it on an incomplete profile is what produced
      // brokers who believed they were live and had no page. The same rule is
      // enforced in the database by ph_agents_guard_profile, because this
      // update goes straight from the browser to PostgREST.
      // Mirrors ph_agents_guard_profile / ph_public_brokers: headshot present and
      // a non-blank bio. BIO_MIN is enforced separately above as a floor on what
      // a broker may SAVE; it is not what decides whether a page exists.
      const qualifies = !!headshot_url && bio.length > 0;
      if (qualifies || state.me.onboarding_completed_at) {
        patch.onboarding_completed_at = state.me.onboarding_completed_at && !qualifies
          ? state.me.onboarding_completed_at
          : new Date().toISOString();
      }
      const { error } = await sb.from('ph_agents').update(patch).eq('auth_user_id', uid);
      if (error) { btn.disabled = false; setObStatus('Could not save: ' + error.message, true); return; }

      Object.assign(state.me, patch);
      toast(editing ? 'Profile updated' : qualifies ? 'Profile saved — your page goes live in about a minute' : 'Profile saved');
      enterApp(email);
    }

    function startClock() {
      const tick = () => {
        try {
          $('#clock').textContent = new Date().toLocaleString('en-US', { timeZone: TZ, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) + ' · Vegas';
        } catch {}
      };
      tick(); setInterval(tick, 30000);
    }

    // ---- nav ----
    const IC = {
      dashboard: '<path d="M3 12h7V3H3zm0 9h7v-7H3zm11 0h7V12h-7zm0-18v7h7V3z"/>',
      contacts: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/>',
      leads: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>',
      pipeline: '<path d="M4 4h16M6.5 4l3 7v9l5-2v-7l3-7"/>',
      calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4m8-4v4M3 10h18"/>',
      availability: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
      reviews: '<path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.8 6.7 19.6l1.1-6L3.4 9.4l6-.8z"/>',
      admin: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>',
      support: '<circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.6-3 4"/><path d="M12 17.5h.01"/>',
    };
    function navItem(id, label, count, extraAttr = '') {
      const c = (count != null) ? `<span class="count">${count}</span>` : '';
      return `<button class="nav-item" data-route="${id}" ${extraAttr}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC[id] || IC.dashboard}</svg>${label}${c}</button>`;
    }
    function buildNav() {
      const n = $('#nav');
      let html = '<div class="nav-sec">Overview</div>';
      html += navItem('dashboard', 'Dashboard');
      html += '<div class="nav-sec">CRM</div>';
      // Leads is deliberately NOT a tab: a web inquiry is a contact with
      // disposition 'Lead' (Rob's three-tab rule). The "New leads" filter on
      // Contacts replaces it; #leads still routes for anyone with a bookmark.
      html += navItem('contacts', 'Contacts', state.contactCount);
      html += navItem('pipeline', 'Pipeline');
      html += navItem('calendar', 'Calendar');
      html += navItem('availability', 'Availability');
      html += navItem('reviews', 'Reviews');
      html += '<div class="nav-sec">Resources</div>';
      // The Resource Center is gated — it renders no carrier link and no
      // commission table until it knows who is asking. Rather than make a
      // signed-in broker retype their email, the click handler below asks
      // ph-concierge for a single-use, ten-minute handoff token and lands them
      // already identified. The href stays the plain URL so middle-click and
      // "open in new tab" still work; those just meet the gate, which is the
      // correct fallback rather than a broken link.
      html += `<a class="nav-item" id="ask-pete" href="${PETE_URL}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-2.5"/></svg>Ask Pete · Resources</a>`;
      // Support tickets. Opens in a new tab so a broker mid-call does not lose
      // whatever they had open here. /support reads the same Supabase session
      // off this origin and fills their name and email in itself, so nothing
      // personal has to ride along in the URL.
      html += `<a class="nav-item" href="/support" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.support}</svg>Get Support</a>`;
      if (state.isAdmin) {
        html += '<div class="nav-sec">Admin</div>';
        html += `<a class="nav-item" href="/admin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.leads}</svg>All Leads</a>`;
        html += `<a class="nav-item" href="/admin/tickets"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.support}</svg>Support Tickets</a>`;
        // The house-wide book. Everything above this line in the sidebar is the
        // signed-in person's own desk, admin or not.
        html += `<a class="nav-item" href="/admin/contacts"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.contacts}</svg>All Contacts</a>`;
        html += `<a class="nav-item" href="/admin/calendar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.calendar}</svg>House Calendar</a>`;
        html += `<a class="nav-item" href="/admin/campaigns"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.calendar}</svg>Campaigns</a>`;
        html += `<a class="nav-item" href="/admin/staff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${IC.contacts}</svg>Staff</a>`;
      }
      n.innerHTML = html;
      $$('.nav-item[data-route]', n).forEach((b) => b.addEventListener('click', () => go(b.dataset.route)));
      wireAskPete(n);
    }

    // Hand a signed-in broker straight into the Resource Center without making
    // them re-identify at the gate.
    //
    // The tab is opened synchronously inside the click, BEFORE any await. Safari
    // and Firefox only treat window.open as user-initiated in that same tick, so
    // opening after the fetch resolves gets silently blocked. We open about:blank
    // first and set its location once the token lands.
    function wireAskPete(scope) {
      const link = $('#ask-pete', scope);
      if (!link) return;

      link.addEventListener('click', async (ev) => {
        // Let modifier-clicks behave like a normal link.
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
        ev.preventDefault();

        // Deliberately NO 'noopener' in the feature string: passing it makes
        // window.open return null, which leaves an orphaned about:blank tab we
        // can never navigate. Null the opener on the handle instead — same
        // protection, and we keep the reference we need.
        const tab = window.open('about:blank', '_blank');
        if (tab) { try { tab.opener = null; } catch (_) { /* cross-origin, fine */ } }

        try {
          let { data: { session } } = await sb.auth.getSession();
          const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
          if (session && stale) {
            const r = await sb.auth.refreshSession();
            if (r?.data?.session) session = r.data.session;
          }
          const token = session?.access_token;
          if (!token) throw new Error('no session');

          const resp = await fetch(`${SB_URL}/functions/v1/ph-concierge`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: SB_ANON,
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ action: 'handoff' }),
          });
          const data = await resp.json();

          // A broker who is not on the active roster falls through to the plain
          // URL and meets the gate, which explains the problem far better than
          // a dead tab would.
          const dest = (data && data.ok && data.url) ? data.url : PETE_URL;
          if (tab) tab.location = dest; else window.location.href = dest;
        } catch (e) {
          if (tab) tab.location = PETE_URL; else window.location.href = PETE_URL;
        }
      });
    }

    // ---- data load (RLS + mine() scope everything to this user's own book) ----
    async function loadData() {
      const [leadsRes, stagesRes, calsRes, cntRes, carrRes, pipeRes, pstgRes, oppRes, apptRes, schedRes, coRes, cfRes, tagRes] = await Promise.all([
        mine(sb.from('ph_leads').select('*')).order('created_at', { ascending: false }).limit(2000),
        sb.from('ph_stages').select('*').order('sort_order'),
        mine(sb.from('ph_agent_calendars').select('*')),
        mine(sb.from('ph_contacts').select('*', { count: 'exact', head: true })).is('deleted_at', null),
        sb.from('ph_carriers').select('id, name, is_active').eq('is_active', true).order('name'),
        sb.from('ph_pipelines').select('*').eq('is_active', true).order('position'),
        sb.from('ph_pipeline_stages').select('*').order('position'),
        mine(sb.from('ph_opportunities').select('*')).order('created_at', { ascending: false }),
        mine(sb.from('ph_appointments').select('*').eq('status', 'booked')).order('start_at'),
        mine(sb.from('ph_agent_scheduling').select('*')),
        mine(sb.from('ph_companies').select('*')).order('name'),
        sb.from('ph_custom_fields').select('*').eq('is_active', true).order('position'),
        sb.from('ph_tags').select('*').eq('is_active', true).order('position'),
      ]);
      state.leads = leadsRes.data ?? [];
      state.stages = stagesRes.data ?? [];
      state.calendars = calsRes.data ?? [];
      state.contactCount = cntRes.count ?? 0;
      state.carriers = carrRes.data ?? [];
      state.pipelines = pipeRes.data ?? [];
      state.pipelineStages = pstgRes.data ?? [];
      state.opps = oppRes.data ?? [];
      loadOppContacts();   // fire and forget: the board re-renders when it lands
      state.appts = apptRes.data ?? [];
      // mine() already narrows this to the one row, so the find() is belt and
      // braces rather than the thing doing the work.
      state.mySched = (schedRes.data || []).find((s) => s.agent_id === state.agentId) || (schedRes.data || [])[0] || null;
      state.companies = coRes.data ?? [];
      state.customFields = cfRes.data ?? [];
      state.adminTags = tagRes.data ?? [];
    }

    // Unified appointment feed: GHL-mirror leads that carry an appointment_start
    // PLUS native bookings from ph_appointments (landing-page bookings, which
    // create a contact — not a lead — so they'd otherwise be invisible here).
    function apptEvents() {
      const fromLeads = state.leads.filter((l) => l.appointment_start).map((l) => ({
        id: l.id, when: l.appointment_start, name: nameOf(l), native: false,
      }));
      const fromNative = (state.appts || []).map((a) => ({
        id: 'appt:' + a.id, when: a.start_at, name: a.invitee_name || 'Booking',
        native: true, email: a.invitee_email, phone: a.invitee_phone, line: a.line_key,
      }));
      return fromLeads.concat(fromNative).sort((a, b) => +new Date(a.when) - +new Date(b.when));
    }
    async function reloadOpps() {
      const { data } = await mine(sb.from('ph_opportunities').select('*')).order('created_at', { ascending: false });
      state.opps = data ?? [];
      await loadOppContacts();
    }
    // Pipeline cards show who the person is, not just a deal title: name,
    // how they came in, their tags and when they were added. Those live on
    // ph_contacts, so pull just the rows the board needs (RLS still scopes
    // this to the signed-in broker) and key them by contact id.
    async function loadOppContacts() {
      const ids = [...new Set((state.opps || []).map((o) => o.contact_id).filter(Boolean))].slice(0, 900);
      if (!ids.length) { state.oppContacts = {}; return; }
      const { data } = await mine(sb.from('ph_contacts')
        .select('ghl_contact_id, first_name, last_name, email, phone, source, origin, tags, disposition, ghl_date_added'))
        .in('ghl_contact_id', ids).is('deleted_at', null);
      const map = {};
      (data || []).forEach((c) => { map[c.ghl_contact_id] = c; });
      state.oppContacts = map;
      // First paint can beat this fetch; repaint the board once names land.
      if (currentRoute === 'pipeline') renderPipeline($('#view'));
    }
    async function reloadAppts() {
      const { data } = await mine(sb.from('ph_appointments').select('*').eq('status', 'booked')).order('start_at');
      state.appts = data ?? [];
    }
    async function reloadLeadsLite() {
      const { data } = await mine(sb.from('ph_leads').select('*')).order('created_at', { ascending: false }).limit(2000);
      if (data) state.leads = data;
    }
    async function reloadCarriers() {
      const { data } = await sb.from('ph_carriers').select('id, name, is_active').order('name');
      state.carriers = (data ?? []).filter((c) => c.is_active);
      state.allCarriers = data ?? [];
    }

    // ---- router ----
    const TITLES = {
      dashboard: ['Dashboard', 'A live look at your leads, appointments and pipeline'],
      contacts: ['Contacts', 'Your book — search, tags, birthdays'],
      leads: ['Leads', 'Everyone assigned to you, newest first'],
      pipeline: ['Pipeline', 'Your deals by line — drag a card to move it through the stages'],
      calendar: ['Calendar', 'Your upcoming appointments'],
      availability: ['Availability', 'Set the hours people can book you — this updates your booking page right away'],
      reviews: ['Reviews', 'Who was asked, who opened it, what they rated and what they said'],
    };
    let currentRoute = null;
    function go(route) {
      if (!TITLES[route]) route = 'dashboard';
      currentRoute = route;
      history.replaceState({}, '', '#' + route);
      $('#page-title').textContent = TITLES[route][0];
      $('#page-sub').textContent = TITLES[route][1];
      $$('.nav-item[data-route]').forEach((n) => n.classList.toggle('active', n.dataset.route === route));
      root.classList.remove('nav-open');
      const v = $('#view'); v.scrollTop = 0;
      const renderers = { dashboard: renderDashboard, contacts: renderContacts, leads: renderLeads, pipeline: renderPipeline, calendar: renderCalendar, availability: renderAvailability, reviews: renderReviews };
      renderers[route](v);
      // Landing-page bookings arrive while the app is open: a visitor books,
      // the deal + appointment land in the DB, but this tab was rendered from
      // boot-time state. Refresh deals + appointments in the background on
      // every entry to the views that show them, then re-render in place.
      if (route === 'calendar') state.gcalEvents = null; // refetch Google events on entry
      if (route === 'dashboard' || route === 'pipeline' || route === 'calendar') {
        const jobs = [reloadOpps(), reloadAppts(), reloadLeadsLite()];
        if (route === 'dashboard') jobs.push(loadDash());
        Promise.all(jobs).then(() => {
          if (currentRoute === route) renderers[route]($('#view'));
        }).catch(() => {});
      }
      // Repaint the sidebar now that loadData has the real count. buildNav()
      // first runs during sign-in, when contactCount is still its initial 0,
      // and loadData updates the number without repainting — so the badge read
      // 0 no matter how many contacts you owned. The refresher below could not
      // rescue it either: it only repaints when the fetched count DIFFERS from
      // state, and state had already been set, so the guard always said "no
      // change" and skipped.
      buildNav();

      // Keep the Contacts badge honest: contacts created by landing-page
      // bookings and round robin arrive server-side while the app is open.
      mine(sb.from('ph_contacts').select('*', { count: 'exact', head: true })).is('deleted_at', null).then(({ count }) => {
        if (count != null && count !== state.contactCount) { state.contactCount = count; buildNav(); }
      });
    }
    window.addEventListener('hashchange', () => { const r = location.hash.replace('#', ''); if (r && r !== currentRoute && TITLES[r]) go(r); });

    // ---- status → pill ----
    function stageOf(lead) { return state.stages.find((s) => s.id === lead.stage_id) || null; }
    function stagePill(lead) {
      const s = stageOf(lead);
      if (!s) return '<span class="pill-status st-gray">No stage</span>';
      const cls = s.is_won ? 'st-green' : s.is_lost ? 'st-red' : s.key === 'appt' ? 'st-violet' : s.key === 'contacted' ? 'st-amber' : 'st-blue';
      return `<span class="pill-status ${cls}">${esc(s.label)}</span>`;
    }

    // ================= DASHBOARD =================
    // Everything on the dashboard reads CONTACTS / OPPORTUNITIES / POLICIES via
    // ph_dashboard_stats(). It used to read ph_leads (the old GHL intake log),
    // which went stale the moment leads were merged into contacts: a broker with
    // real contacts, deals and appointments saw zeros. Called with no argument
    // the RPC reports the CALLER'S OWN book, admin or not, which is what this
    // desk is for. /admin passes p_all for the house-wide numbers.
    async function loadDash() {
      const [statsRes, recentRes, outRes] = await Promise.all([
        sb.rpc('ph_dashboard_stats'),
        mine(sb.from('ph_contacts')
          .select('ghl_contact_id, first_name, last_name, email, phone, disposition, source, ghl_date_added'))
          .is('deleted_at', null)
          .order('ghl_date_added', { ascending: false, nullsFirst: false }).limit(8),
        // Won / lost over the trailing window. The RPC reports the caller's own
        // book (house-wide for an admin) and counts closed deals whose pipeline
        // has since been deleted, so retiring a line never rewrites history.
        sb.rpc('ph_pipeline_outcomes', { p_days: OUTCOME_DAYS }),
      ]);
      if (statsRes.data) state.dash = statsRes.data;
      state.recentContacts = recentRes.data ?? [];
      // The RPC returns a single-row table, so unwrap it.
      state.outcomes = (outRes && Array.isArray(outRes.data) ? outRes.data[0] : outRes?.data) || null;
    }
    const OUTCOME_DAYS = 90;

    const money0 = (n) => '$' + Math.round(Number(n) || 0).toLocaleString();

    function renderDashboard(v) {
      const d = state.dash || {};
      const now = Date.now();
      const events = apptEvents();
      const bookings = events.filter((e) => +new Date(e.when) >= now);
      const week = bookings.filter((e) => +new Date(e.when) <= now + 7 * 864e5);
      const new30 = d.new_30 ?? 0, prev30 = d.new_prev30 ?? 0;
      const delta = prev30 ? Math.round((new30 - prev30) / prev30 * 100) : null;

      // new contacts per day, 30 days, straight from the RPC
      const days = Array.isArray(d.daily) ? d.daily : [];
      const max = Math.max(1, ...days.map((x) => x.n));
      const W = 620, H = 120;
      const pts = days.map((x, i) => [days.length > 1 ? i / (days.length - 1) * W : 0, H - (x.n / max) * (H - 10) - 4]);
      const line = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ');
      const area = pts.length ? line + ` L${W} ${H} L0 ${H} Z` : '';
      const dayLabel = (i) => days[i] ? fmtDate(days[i].d) : '';

      const stages = Array.isArray(d.by_stage) ? d.by_stage : [];
      const stageMax = Math.max(1, ...stages.map((s) => s.n));
      const bdays = Array.isArray(d.birthdays) ? d.birthdays : [];
      const recent = state.recentContacts || [];
      // Won / lost over the trailing window, from ph_pipeline_outcomes.
      const oc = state.outcomes || {};
      const closed = (oc.won_count ?? 0) + (oc.lost_count ?? 0);
      const winRate = closed ? Math.round((oc.won_count ?? 0) / closed * 100) : null;
      const premiumLine = (d.policies ?? 0) > 0
        ? `${d.policies} polic${d.policies === 1 ? 'y' : 'ies'} · ${money0(d.annual_premium)}/yr in force`
        : 'add policies to track premium';

      const IC = {
        people: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
        cal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
        funnel: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18l-7 8.5V19l-4 2v-8.5Z"/></svg>',
        shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>',
      };
      v.innerHTML = `
      <div class="view-grid dash-anim">
        ${myPagesCard()}
        <div class="stat-row">
          ${statCard('New contacts · 30 days', new30, delta == null ? `<span class="delta flat">${d.total_contacts ?? 0} in your book</span>` : `<span class="delta ${delta >= 0 ? 'up' : 'flat'}">${delta >= 0 ? '▲' : '▼'} ${Math.abs(delta)}% vs prior 30</span>`, IC.people)}
          ${statCard('Appointments · next 7 days', week.length, `<span class="delta flat">${bookings.length} upcoming total</span>`, IC.cal)}
          ${statCard('Open deals', d.open_deals ?? 0, `<span class="delta flat">in your pipeline</span>`, IC.funnel)}
          ${statCard('Active clients', d.active_clients ?? 0, `<span class="delta up">${premiumLine}</span>`, IC.shield)}
        </div>

        <div class="card out-card">
          <div class="card-h"><span class="grad-label">Dispositions</span><h3 style="margin-left:8px">Deals closed — last ${OUTCOME_DAYS} days</h3><div class="right"><button class="btn btn-ghost btn-sm" data-goto="pipeline">Open pipeline →</button></div></div>
          <div class="out-grid">
            <div class="out-cell"><div class="lbl">Won</div><div class="num" style="color:var(--green)">${oc.won_count ?? 0}</div><div class="cell-sub">${money0(oc.won_value)} in deal value</div></div>
            <div class="out-cell"><div class="lbl">Lost</div><div class="num" style="color:var(--red)">${oc.lost_count ?? 0}</div><div class="cell-sub">${money0(oc.lost_value)} walked away</div></div>
            <div class="out-cell"><div class="lbl">Win rate</div><div class="num">${winRate == null ? '—' : winRate + '%'}</div><div class="cell-sub">${closed ? closed + ' closed' : 'nothing closed yet'}</div></div>
            <div class="out-cell"><div class="lbl">Still open</div><div class="num">${oc.open_count ?? 0}</div><div class="cell-sub">on the board now</div></div>
          </div>
        </div>

        <div class="dash-2col">
          <div class="card">
            <div class="card-h"><span class="grad-label">Intake</span><h3 style="margin-left:8px">New contacts — last 30 days</h3></div>
            <div class="card-b">
              <svg class="spark" viewBox="0 0 ${W} ${H}" style="width:100%;height:150px" preserveAspectRatio="none">
                <defs><linearGradient id="sparkfill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="var(--blue)"/><stop offset="1" stop-color="var(--blue)" stop-opacity="0"/>
                </linearGradient></defs>
                <path class="area" d="${area}" fill="url(#sparkfill)"/>
                <path class="line" d="${line}" stroke="var(--blue)" pathLength="1"/>
                ${pts.length ? `<circle class="dot" cx="${pts[pts.length - 1][0].toFixed(1)}" cy="${pts[pts.length - 1][1].toFixed(1)}" r="4" fill="var(--blue)" stroke="#fff" stroke-width="2"/>` : ''}
              </svg>
              <div style="display:flex;justify-content:space-between;font-size:.7rem;color:var(--muted);margin-top:4px">
                <span>${dayLabel(0)}</span><span>${dayLabel(15)}</span><span>${dayLabel(days.length - 1)}</span>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-h"><span class="grad-label">Today</span><h3 style="margin-left:8px">Up next</h3></div>
            <div class="card-b" style="padding-top:6px">
              ${bookings.slice(0, 6).map((e) => `
                <div class="feed-item">
                  <div class="feed-ic">📅</div>
                  <div style="min-width:0"><div style="font-weight:650">${esc(e.name)}</div><div class="cell-sub">${esc(fmtFull(e.when))}</div></div>
                  <span class="pill-status st-green" style="margin-left:auto">Confirmed</span>
                </div>`).join('') || '<div class="empty" style="padding:24px">No upcoming appointments.</div>'}
            </div>
          </div>
        </div>

        <div class="dash-2col">
          <div class="card">
            <div class="card-h"><span class="grad-label">Pipeline</span><h3 style="margin-left:8px">Open deals by stage</h3><div class="right"><button class="btn btn-ghost btn-sm" data-goto="pipeline">Open pipeline →</button></div></div>
            <div class="card-b">
              ${stages.length ? stages.map((s, i) => `
                <div class="bar-row">
                  <div class="bar-lbl">${esc(s.stage)}</div>
                  <div class="bar-track"><div class="bar-fill" style="width:${Math.max(6, s.n / stageMax * 100)}%;--d:${250 + i * 70}ms"></div></div>
                  <div class="bar-n">${s.n}</div>
                </div>`).join('') : '<div class="empty" style="padding:22px">No open deals yet. A deal is created automatically when a contact gets a line of insurance.</div>'}
            </div>
          </div>

          <div class="card">
            <div class="card-h"><span class="grad-label">Retention</span><h3 style="margin-left:8px">Birthdays — next 30 days</h3></div>
            <div class="card-b" style="padding-top:6px">
              ${bdays.length ? bdays.slice(0, 6).map((b) => `
                <div class="feed-item rowlink" data-contact="${esc(b.id)}">
                  <div class="feed-ic">🎂</div>
                  <div style="min-width:0"><div style="font-weight:650">${esc(b.name || 'Client')}</div><div class="cell-sub">${esc(fmtDate(b.when))}</div></div>
                </div>`).join('') : '<div class="empty" style="padding:22px">No birthdays in the next 30 days.</div>'}
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-h"><span class="grad-label">Activity</span><h3 style="margin-left:8px">Recently added contacts</h3><div class="right"><button class="btn btn-ghost btn-sm" data-goto="contacts">View all →</button></div></div>
          <div class="card-b" style="padding:6px 0 0">
            <table class="data"><thead><tr><th>Name</th><th>Disposition</th><th>Source</th><th>Added</th></tr></thead>
            <tbody>${recent.map((c) => {
              const nm = [c.first_name, c.last_name].filter(Boolean).join(' ') || '(no name)';
              return `<tr class="rowlink" data-contact="${esc(c.ghl_contact_id)}">
                <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nm)}">${initials(nm)}</span><div>${esc(nm)}<div class="cell-sub">${esc(c.email || c.phone || '')}</div></div></div></td>
                <td><span class="pill-status ${dispClass(c.disposition)}">${esc(c.disposition || 'Lead')}</span></td>
                <td><span class="chip">${esc(c.source || 'web')}</span></td>
                <td class="cell-sub">${esc(fmtDate(c.ghl_date_added))}</td>
              </tr>`;
            }).join('') || '<tr><td colspan="4"><div class="empty">No contacts yet.</div></td></tr>'}
            </tbody></table>
          </div>
        </div>
      </div>`;
      $$('[data-goto]', v).forEach((b) => b.addEventListener('click', () => go(b.dataset.goto)));
      $$('[data-contact]', v).forEach((r) => r.addEventListener('click', () => openContact(r.dataset.contact)));
      $$('[data-copy]', v).forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy); const t = b.textContent; b.textContent = 'Copied!'; setTimeout(() => (b.textContent = t), 1200); }
        catch (_e) { toast('Could not copy — long-press the link to copy it.'); }
      }));
      $('#mypages-fix', v)?.addEventListener('click', () => { if (state.email) openOnboarding(state.email, { editing: true }); });
    }
    const statCard = (lbl, num, delta, ic = '') => `<div class="card stat">${ic ? `<div class="stat-ic">${ic}</div>` : ''}<div class="lbl">${lbl}</div><div class="num">${num}</div>${delta}</div>`;

    // Slug matches the static build (broker-lines.ts brokerSlug) so the links resolve.
    function brokerSlug(name) {
      return String(name || '').toLowerCase().normalize('NFKD').replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-') || 'broker';
    }
    // The page only exists if the row passes ph_public_brokers(): is_active AND
    // onboarding_completed_at AND headshot_url AND non-blank bio. This card used
    // to gate on onboarding_completed_at alone, so a broker who was inactive, or
    // missing a headshot or bio, was shown a confident link with a View button to
    // a URL that 404s. Never advertise a page on weaker conditions than the ones
    // that build it.
    function myPagesCard() {
      const me = state.me;
      if (!me?.onboarding_completed_at) return '';
      const slug = brokerSlug(me.full_name);
      const base = 'https://www.protecthealth.com';

      // Mirrors ph_public_brokers() exactly. Do not tighten these past what the
      // database actually requires — a stricter rule here reports a live page as
      // missing, which is the same failure this card was built to remove.
      const blockers = [];
      if (me.is_active === false) blockers.push('your roster record is marked inactive — ask the office');
      if (!me.headshot_url) blockers.push('a headshot');
      if (!bioText(me.bio)) blockers.push('a short bio');

      const head = `<div class="card-h"><span class="grad-label">Your pages</span><h3 style="margin-left:8px">Your landing page &amp; booking calendar</h3></div>`;

      if (blockers.length) {
        return `<div class="card" style="border:1.5px solid #fecdca;background:linear-gradient(180deg,#fff7f6,#ffffff)">
          ${head}
          <div class="card-b" style="display:grid;gap:10px;padding-top:8px">
            <div style="font-weight:750;color:#b42318">Not live yet</div>
            <div class="cell-sub">Your pages are built from your profile. They need ${esc(listPhrase(blockers))} first. Nothing is published until then, so there is no link to share yet.</div>
            <div><button class="btn btn-primary btn-sm" type="button" id="mypages-fix">Finish my profile</button></div>
          </div>
        </div>`;
      }

      return `<div class="card" style="border:1.5px solid #d3e2ff;background:linear-gradient(180deg,#f1f7ff,#ffffff)">
        ${head}
        <div class="card-b" style="display:grid;gap:12px;padding-top:8px">
          ${pageRow('Landing page', base + '/broker/' + slug, '🌐', 'Your public page — send it to prospects or link it in your bio.')}
          ${pageRow('Booking calendar', base + '/book/' + slug, '📅', 'People pick a time here and it lands in your CRM automatically.')}
          <div class="cell-sub" style="margin-top:2px">Just finished your profile? The site rebuilds within a couple of minutes — give it a moment before you share these.</div>
        </div>
      </div>`;
    }
    function pageRow(label, url, icon, note) {
      const short = url.replace(/^https?:\/\/(www\.)?/, '');
      return `<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px;background:#fff">
        <div style="font-size:1.4rem;line-height:1">${icon}</div>
        <div style="flex:1;min-width:190px">
          <div style="font-weight:750;color:#0b2a4a">${label}</div>
          <a href="${url}" target="_blank" rel="noopener" style="color:#2563c9;font-weight:600;word-break:break-all">${esc(short)}</a>
          <div class="cell-sub" style="margin-top:2px">${esc(note)}</div>
        </div>
        <div style="display:flex;gap:8px">
          <a class="btn btn-primary btn-sm" href="${url}" target="_blank" rel="noopener">View</a>
          <button class="btn btn-ghost btn-sm" type="button" data-copy="${esc(url)}">Copy</button>
        </div>
      </div>`;
    }

    // ================= CONTACTS =================
    let cPage = 0, cQuery = '', cTag = '';
    // ---- Contacts filters + column preferences ----
    const cFilters = { disposition: '', tag: '', company_id: '', line: '', polStatus: '', carrier_id: '', premMin: '', premMax: '', bdayMonth: '' };
    const activeFilterCount = () => Object.values(cFilters).filter((x) => x !== '').length;
    const FREQ_X = { Monthly: 12, Quarterly: 4, 'Semi-Annual': 2, Annual: 1, Single: 1 };
    const MONTHS_L = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const ALL_COLS = [
      { key: 'email', label: 'Email' }, { key: 'phone', label: 'Phone' }, { key: 'tags', label: 'Tags' },
      { key: 'added', label: 'Added' }, { key: 'bday', label: 'Birthday' }, { key: 'company', label: 'Company' },
      { key: 'disposition', label: 'Disposition' }, { key: 'lines', label: 'Lines' },
      { key: 'carriers', label: 'Carriers' }, { key: 'policies', label: 'Policies' },
    ];
    let cCols;
    try { cCols = JSON.parse(localStorage.getItem('ph_cols_v1')) || null; } catch { cCols = null; }
    if (!Array.isArray(cCols) || !cCols.length) cCols = ['email', 'phone', 'tags', 'added'];
    let cMode = 'people'; // 'people' | 'companies'
    function renderContacts(v) {
      v.innerHTML = `
      <div class="card">
        <div class="toolbar">
          <div class="seg" role="group">
            <button class="seg-btn ${cMode==='people'?'on':''}" data-cmode="people">People</button>
            <button class="seg-btn ${cMode==='companies'?'on':''}" data-cmode="companies">Companies</button>
          </div>
          <input type="text" id="c-search" placeholder="Search name, email, phone…" value="${esc(cQuery)}" style="min-width:220px"/>
          ${cMode==='people' ? `<button class="btn ${cFilters.disposition==='Lead'?'btn-primary':'btn-ghost'} btn-sm" id="c-newleads">🔔 New leads</button>` : ''}
          ${cMode==='people' ? `<button class="btn btn-ghost btn-sm" id="c-filter-btn">⚙ Filters${activeFilterCount() ? ` <span class="fchip-n">${activeFilterCount()}</span>` : ''}</button>` : ''}
          ${cMode==='people' ? '<button class="btn btn-ghost btn-sm" id="c-cols-btn">☰ Columns</button>' : ''}
          ${cMode==='people'
            ? '<button class="btn btn-primary btn-sm" id="c-add">+ Add Contact</button>'
            : '<button class="btn btn-primary btn-sm" id="co-add">+ Add Company</button>'}
          <button class="btn btn-ghost btn-sm" id="c-import">⤒ Import</button>
          ${state.isAdmin ? '<button class="btn btn-ghost btn-sm" id="c-carriers">Manage carriers</button>' : ''}
          ${state.isAdmin ? '<button class="btn btn-ghost btn-sm" id="c-fields">Manage fields</button>' : ''}
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)" id="c-count"></span>
        </div>
        <div class="fpanel" id="c-fpanel" hidden>
          <div class="fgrid">
            <label class="ffield"><span>Disposition</span><select data-f="disposition"><option value="">Any</option>${DISPOSITIONS.map((d)=>`<option ${cFilters.disposition===d?'selected':''}>${esc(d)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Tag</span><select data-f="tag" id="c-tag"><option value="">Any</option></select></label>
            <label class="ffield"><span>Company</span><select data-f="company_id"><option value="">Any</option>${state.companies.map((co)=>`<option value="${co.id}" ${cFilters.company_id===co.id?'selected':''}>${esc(co.name)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Line of insurance</span><select data-f="line"><option value="">Any</option>${COVERAGE_TYPES.map((l)=>`<option ${cFilters.line===l?'selected':''}>${esc(l)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Policy status</span><select data-f="polStatus"><option value="">Any</option>${POLICY_STATUSES.map((s)=>`<option ${cFilters.polStatus===s?'selected':''}>${esc(s)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Carrier</span><select data-f="carrier_id"><option value="">Any</option>${state.carriers.map((x)=>`<option value="${x.id}" ${cFilters.carrier_id===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label>
            <label class="ffield"><span>Annual premium</span><div class="frange"><input type="number" data-f="premMin" placeholder="Min" value="${esc(cFilters.premMin)}"><span>–</span><input type="number" data-f="premMax" placeholder="Max" value="${esc(cFilters.premMax)}"></div></label>
            <label class="ffield"><span>Birthday month</span><select data-f="bdayMonth"><option value="">Any</option>${MONTHS_L.map((m,i)=>`<option value="${i+1}" ${String(cFilters.bdayMonth)===String(i+1)?'selected':''}>${esc(m)}</option>`).join('')}</select></label>
          </div>
          <div class="factions">
            <button class="btn btn-primary btn-sm" id="c-apply">Apply filters</button>
            <button class="btn btn-ghost btn-sm" id="c-clear">Clear all</button>
            <span class="cell-sub">Premium range uses each policy's annualized amount.</span>
          </div>
        </div>
        <div class="fchips" id="c-chips"></div>
        <div class="bulkbar" id="c-bulk" hidden>
          <span class="bulk-n" id="c-bulk-n"></span>
          <button class="btn btn-danger btn-sm" id="c-bulk-del">Delete selected</button>
          <button class="btn btn-ghost btn-sm" id="c-bulk-clear">Clear selection</button>
        </div>
        <div class="colpop" id="c-colpop" hidden>
          ${ALL_COLS.map((col)=>`<label class="pickbox"><input type="checkbox" data-col="${col.key}" ${cCols.includes(col.key)?'checked':''}/> ${esc(col.label)}</label>`).join('')}
        </div>
        <div id="c-table"></div>
        <div class="pager" id="c-pager"></div>
      </div>`;
      $$('[data-cmode]', v).forEach((b) => b.addEventListener('click', () => { cMode = b.dataset.cmode; renderContacts(v); }));
      const search = $('#c-search', v);
      let t; search.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { cQuery = search.value.trim(); cPage = 0; cMode === 'people' ? loadContacts(v) : renderCompanies(v); }, 250); });
      $('#c-newleads', v)?.addEventListener('click', () => {
        cFilters.disposition = cFilters.disposition === 'Lead' ? '' : 'Lead';
        cPage = 0; renderContacts(v);
      });
      $('#c-filter-btn', v)?.addEventListener('click', () => { const p = $('#c-fpanel', v); p.hidden = !p.hidden; $('#c-colpop', v).hidden = true; });
      $('#c-cols-btn', v)?.addEventListener('click', () => { const p = $('#c-colpop', v); p.hidden = !p.hidden; $('#c-fpanel', v).hidden = true; });
      $('#c-apply', v)?.addEventListener('click', () => {
        $$('#c-fpanel [data-f]', v).forEach((el) => { cFilters[el.dataset.f] = el.value; });
        cPage = 0; renderContacts(v);
      });
      $('#c-clear', v)?.addEventListener('click', () => {
        Object.keys(cFilters).forEach((k) => cFilters[k] = ''); cPage = 0; renderContacts(v);
      });
      $$('#c-colpop [data-col]', v).forEach((cb) => cb.addEventListener('change', () => {
        cCols = ALL_COLS.map((c) => c.key).filter((k) => $(`#c-colpop [data-col="${k}"]`, v).checked);
        try { localStorage.setItem('ph_cols_v1', JSON.stringify(cCols)); } catch {}
        loadContacts(v);
      }));
      $('#c-add', v)?.addEventListener('click', () => openAddContact(v));
      $('#co-add', v)?.addEventListener('click', () => openCompanyForm(null, v));
      $('#c-import', v)?.addEventListener('click', () => openImport(v));
      $('#c-carriers', v)?.addEventListener('click', openCarrierManager);
      $('#c-fields', v)?.addEventListener('click', openFieldManager);
      $('#c-bulk-clear', v)?.addEventListener('click', () => { cSel.clear(); loadContacts(v); });
      $('#c-bulk-del', v)?.addEventListener('click', () => deleteContacts(Array.from(cSel), v));
      cSel.clear();
      if (cMode === 'people') { paintFilterChips(v); loadTags(v); loadContacts(v); }
      else renderCompanies(v);
    }

    // ---- contact delete (soft) ----
    // Rows are tombstoned, never dropped: 8,213 of 8,223 contacts originate in
    // GoHighLevel, and ph_sync_contacts_delta re-upserts on ghl_contact_id every
    // five minutes — a hard delete would simply come back. ph_contact_delete
    // stamps deleted_at (and its trigger closes the contact's pipeline cards),
    // and every read in this app filters deleted_at is null.
    const cSel = new Set();
    function paintBulk(v) {
      const bar = $('#c-bulk', v); if (!bar) return;
      bar.hidden = cSel.size === 0;
      $('#c-bulk-n', v).textContent = cSel.size === 1 ? '1 contact selected' : `${cSel.size} contacts selected`;
    }
    async function deleteContacts(ids, listView, opts = {}) {
      if (!ids.length) return false;
      const what = opts.label || (ids.length === 1 ? 'this contact' : `${ids.length} contacts`);
      // Deliberately does not promise that every automated email stops: a
      // booked appointment still fires its reminders, because those are driven
      // off ph_appointments rather than the contact row.
      if (!confirm(`Delete ${what}? They come off your book, their pipeline cards are removed, and they drop out of campaigns and review requests. This cannot be undone from here.`)) return false;
      // Chunked so one oversized URL can't fail the whole batch.
      let done = 0, failed = 0;
      for (let i = 0; i < ids.length; i += 200) {
        const slice = ids.slice(i, i + 200);
        const { data, error } = await sb.rpc('ph_contact_delete', { p_ids: slice });
        if (error) failed += slice.length; else done += (data ?? 0);
      }
      if (failed) { toast(`Could not delete ${failed} of them — try again.`); if (!done) return false; }
      cSel.clear();
      toast(done === 1 ? 'Contact deleted' : `${done} contacts deleted`);
      // The count badge, the board (cards go with the contact) and the dashboard
      // all move as a result, so put them back in step before repainting.
      const { count } = await mine(sb.from('ph_contacts').select('*', { count: 'exact', head: true })).is('deleted_at', null);
      if (count != null) { state.contactCount = count; buildNav(); }
      await reloadOpps();
      loadDash().catch(() => {});
      if (listView && currentRoute === 'contacts') loadContacts(listView);
      return true;
    }

    // Active filters as removable chips under the toolbar.
    function paintFilterChips(v) {
      const host = $('#c-chips', v); if (!host) return;
      const chip = (key, label) => `<span class="fchip">${esc(label)}<button data-fx="${key}" aria-label="Remove">✕</button></span>`;
      const parts = [];
      if (cFilters.disposition) parts.push(chip('disposition', cFilters.disposition));
      if (cFilters.tag) parts.push(chip('tag', 'Tag: ' + cFilters.tag));
      if (cFilters.company_id) parts.push(chip('company_id', state.companies.find((x) => x.id === cFilters.company_id)?.name || 'Company'));
      if (cFilters.line) parts.push(chip('line', cFilters.line));
      if (cFilters.polStatus) parts.push(chip('polStatus', 'Policy: ' + cFilters.polStatus));
      if (cFilters.carrier_id) parts.push(chip('carrier_id', state.carriers.find((x) => x.id === cFilters.carrier_id)?.name || 'Carrier'));
      if (cFilters.premMin || cFilters.premMax) parts.push(chip('prem', `Premium ${cFilters.premMin ? fmtMoney(cFilters.premMin) : '$0'}–${cFilters.premMax ? fmtMoney(cFilters.premMax) : '∞'}/yr`));
      if (cFilters.bdayMonth) parts.push(chip('bdayMonth', 'Birthday: ' + MONTHS_L[cFilters.bdayMonth - 1]));
      host.innerHTML = parts.join('');
      host.style.display = parts.length ? '' : 'none';
      $$('[data-fx]', host).forEach((b) => b.addEventListener('click', () => {
        if (b.dataset.fx === 'prem') { cFilters.premMin = ''; cFilters.premMax = ''; }
        else cFilters[b.dataset.fx] = '';
        cPage = 0; renderContacts(v);
      }));
    }

    // ---- Companies list ----
    function renderCompanies(v) {
      const q = cQuery.toLowerCase();
      const rows = state.companies.filter((co) => !q || (co.name || '').toLowerCase().includes(q));
      $('#c-count', v).textContent = `${rows.length} compan${rows.length === 1 ? 'y' : 'ies'}`;
      $('#c-table', v).innerHTML = rows.length ? `<table class="data"><thead><tr><th>Company</th><th>Industry</th><th>Phone</th><th>City</th><th>Added</th></tr></thead><tbody>${
        rows.map((co) => `<tr data-co="${co.id}" style="cursor:pointer"><td style="font-weight:650">${esc(co.name)}</td><td class="cell-sub">${esc(co.industry || '—')}</td><td class="cell-sub">${esc(fmtPhone(co.phone) || '—')}</td><td class="cell-sub">${esc(co.city || '—')}</td><td class="cell-sub">${esc(fmtDate(co.created_at))}</td></tr>`).join('')
      }</tbody></table>` : '<div class="empty" style="padding:30px">No companies yet. Add one for group/employer business — the people you add under it become regular contacts automatically.</div>';
      $('#c-pager', v).innerHTML = '';
      $$('[data-co]', v).forEach((r) => r.addEventListener('click', () => openCompany(r.dataset.co)));
    }

    function openCompanyForm(co, listView) {
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">${co ? 'Edit company' : 'Add Company'}</div><div class="cell-sub">Group / employer record</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b"><form id="co-form">
          <div class="field"><label>Company name *</label><input name="name" required value="${esc(co?.name || '')}"/></div>
          <div class="grid2">
            <div class="field"><label>Industry</label><input name="industry" value="${esc(co?.industry || '')}"/></div>
            <div class="field"><label>Employees</label><input name="employee_count" type="number" min="1" value="${esc(co?.employee_count ?? '')}"/></div>
          </div>
          <div class="grid2">
            <div class="field"><label>Phone</label><input name="phone" inputmode="tel" value="${esc(co?.phone || '')}"/></div>
            <div class="field"><label>Email</label><input name="email" type="email" value="${esc(co?.email || '')}"/></div>
          </div>
          <div class="field"><label>Street address</label><input name="street_address" value="${esc(co?.street_address || '')}"/></div>
          <div class="grid3">
            <div class="field"><label>City</label><input name="city" value="${esc(co?.city || '')}"/></div>
            <div class="field"><label>State</label><input name="state" maxlength="2" style="text-transform:uppercase" value="${esc(co?.state || '')}"/></div>
            <div class="field"><label>Zip</label><input name="postal_code" inputmode="numeric" value="${esc(co?.postal_code || '')}"/></div>
          </div>
          <div class="field"><label>Notes</label><textarea name="notes" rows="2">${esc(co?.notes || '')}</textarea></div>
          <button class="btn btn-primary" type="submit">${co ? 'Save changes' : 'Add company'}</button>
          <p class="cell-sub" id="co-status" style="margin-top:8px"></p>
        </form></div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#co-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target;
        const patch = {
          agent_id: co ? co.agent_id : state.me.id,
          name: f.name.value.trim(), industry: f.industry.value.trim() || null,
          employee_count: f.employee_count.value ? parseInt(f.employee_count.value, 10) : null,
          phone: f.phone.value.trim() || null, email: f.email.value.trim() || null,
          street_address: f.street_address.value.trim() || null, city: f.city.value.trim() || null,
          state: f.state.value.trim().toUpperCase() || null, postal_code: f.postal_code.value.trim() || null,
          notes: f.notes.value.trim() || null, updated_at: new Date().toISOString(),
        };
        const q = co ? sb.from('ph_companies').update(patch).eq('id', co.id).select('*').single()
                     : sb.from('ph_companies').insert(patch).select('*').single();
        const { data, error } = await q;
        if (error) { $('#co-status').textContent = 'Could not save: ' + error.message; return; }
        if (co) { const i = state.companies.findIndex((x) => x.id === co.id); if (i >= 0) state.companies[i] = data; }
        else state.companies.push(data);
        state.companies.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        closeDrawer(); toast(co ? 'Company updated' : 'Company added');
        if (co) openCompany(data.id); else if (listView && currentRoute === 'contacts') renderCompanies(listView);
      });
    }

    // Company record drawer: company data + the people tied to it.
    async function openCompany(coId) {
      const co = state.companies.find((x) => x.id === coId); if (!co) return;
      const { data: people } = await mine(sb.from('ph_contacts').select('ghl_contact_id, first_name, last_name, job_title, email, phone, disposition')).eq('company_id', coId).is('deleted_at', null).order('first_name');
      openDrawer(`
        <div class="drawer-h">
          <span class="avatar-sm" style="width:44px;height:44px;font-size:.95rem;background:${avColor(co.name)}">${initials(co.name)}</span>
          <div><div style="font-size:1.15rem;font-weight:800">${esc(co.name)}</div><div class="cell-sub">${esc([co.industry, co.city].filter(Boolean).join(' · ') || 'Company')}</div></div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">
          <div class="kv">
            ${co.phone ? `<div class="k">Phone</div><div class="v">${esc(fmtPhone(co.phone))}</div>` : ''}
            ${co.email ? `<div class="k">Email</div><div class="v">${esc(co.email)}</div>` : ''}
            ${co.employee_count ? `<div class="k">Employees</div><div class="v">${esc(co.employee_count)}</div>` : ''}
            ${(co.street_address || co.city) ? `<div class="k">Address</div><div class="v">${esc([co.street_address, co.city, [co.state, co.postal_code].filter(Boolean).join(' ')].filter(Boolean).join(', '))}</div>` : ''}
          </div>
          ${co.notes ? `<div class="section-t">Notes</div><div style="font-size:.86rem;line-height:1.6;white-space:pre-wrap">${esc(co.notes)}</div>` : ''}
          <div class="section-t">People at ${esc(co.name)} <button class="btn btn-ghost btn-sm" id="co-addperson" style="margin-left:auto">+ Add person</button></div>
          <div id="co-people">${(people && people.length) ? people.map((p) => `
            <div class="feed-item" data-open-contact="${p.ghl_contact_id}" style="cursor:pointer">
              <div class="feed-ic">👤</div>
              <div><div style="font-weight:650">${esc([p.first_name, p.last_name].filter(Boolean).join(' '))}</div>
              <div class="cell-sub">${esc([p.job_title, p.email, fmtPhone(p.phone)].filter(Boolean).join(' · ') || '—')}</div></div>
              <span class="pill-status ${dispClass(p.disposition)}" style="margin-left:auto">${esc(p.disposition || '—')}</span>
            </div>`).join('') : '<div class="cell-sub">No people yet — add the owner and key contacts.</div>'}</div>
          <div class="section-t"></div>
          <button class="btn btn-ghost btn-sm" id="co-edit">Edit company</button>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#co-edit').addEventListener('click', () => openCompanyForm(co, null));
      $$('#co-people [data-open-contact]').forEach((el) => el.addEventListener('click', () => { closeDrawer(); openContact(el.dataset.openContact); }));
      $('#co-addperson').addEventListener('click', () => openCompanyPersonForm(co));
    }

    // Adding a person under a company creates a full contact, linked both ways.
    function openCompanyPersonForm(co) {
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Add person at ${esc(co.name)}</div><div class="cell-sub">They become a contact in your book automatically</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b"><form id="cp-form">
          <div class="grid2">
            <div class="field"><label>First name *</label><input name="first_name" required/></div>
            <div class="field"><label>Last name</label><input name="last_name"/></div>
          </div>
          <div class="field"><label>Role / title</label><input name="job_title" placeholder="Owner, HR Manager, Employee…"/></div>
          <div class="grid2">
            <div class="field"><label>Email</label><input name="email" type="email"/></div>
            <div class="field"><label>Phone</label><input name="phone" inputmode="tel"/></div>
          </div>
          <div class="field"><label>Hire date (optional)</label><input name="hire_date" type="date"/></div>
          <button class="btn btn-primary" type="submit">Add person</button>
          <p class="cell-sub" id="cp-status" style="margin-top:8px"></p>
        </form></div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cp-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target;
        const cid = 'crm:' + crypto.randomUUID();
        const custom = {};
        if (f.hire_date.value) custom.hire_date = f.hire_date.value;
        const { error } = await sb.from('ph_contacts').insert({
          ghl_contact_id: cid, origin: 'crm', agent_id: state.agentId,
          first_name: f.first_name.value.trim(), last_name: f.last_name.value.trim() || null,
          email: f.email.value.trim() || null, phone: f.phone.value.trim() || null,
          company: co.name, company_id: co.id, job_title: f.job_title.value.trim() || null,
          custom, disposition: 'Lead', tags: [], dnd: false, source: 'Group / ' + co.name,
          ghl_date_added: new Date().toISOString(), synced_at: new Date().toISOString(),
        });
        if (error) { $('#cp-status').textContent = 'Could not add: ' + error.message; return; }
        state.contactCount++;
        toast('Person added to ' + co.name);
        openCompany(co.id);
      });
    }

    // ---- Admin: custom field manager ----
    function openFieldManager() {
      const rows = () => state.customFields.map((f) => `
        <div class="feed-item"><div class="feed-ic">▦</div>
          <div><div style="font-weight:650">${esc(f.label)}</div><div class="cell-sub">${esc(f.field_type)}${f.options ? ' · ' + (f.options || []).join(', ') : ''}</div></div>
          <button class="btn btn-ghost btn-sm" data-cf-del="${f.id}" style="margin-left:auto">Remove</button>
        </div>`).join('') || '<div class="cell-sub">No custom fields yet.</div>';
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Contact card fields</div><div class="cell-sub">These appear in Client data on every contact, for every agent</div></div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div id="cf-list">${rows()}</div>
          <div class="section-t">Add a field</div>
          <form id="cf-form">
            <div class="field"><label>Label *</label><input name="label" required placeholder="e.g. Medicare Number"/></div>
            <div class="grid2">
              <div class="field"><label>Type</label><select name="field_type"><option value="text">Text</option><option value="number">Number</option><option value="date">Date</option><option value="select">Dropdown</option></select></div>
              <div class="field"><label>Dropdown options</label><input name="options" placeholder="Comma-separated"/></div>
            </div>
            <button class="btn btn-primary btn-sm" type="submit">Add field</button>
            <p class="cell-sub" id="cf-status" style="margin-top:8px"></p>
          </form>
          <div class="section-t">Tags brokers can use</div>
          <div id="tg-list" style="display:flex;flex-wrap:wrap;gap:8px"></div>
          <form id="tg-form" style="display:flex;gap:8px;margin-top:10px">
            <input name="name" placeholder="New tag, e.g. VIP" style="flex:1"/>
            <button class="btn btn-primary btn-sm" type="submit">Add tag</button>
          </form>
          <p class="cell-sub" id="tg-status" style="margin-top:6px"></p>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      const wireDeletes = () => $$('#cf-list [data-cf-del]').forEach((b) => b.addEventListener('click', async () => {
        const id = b.dataset.cfDel;
        const { error } = await sb.from('ph_custom_fields').update({ is_active: false }).eq('id', id);
        if (error) { toast('Could not remove field.'); return; }
        state.customFields = state.customFields.filter((f) => f.id !== id);
        $('#cf-list').innerHTML = rows(); wireDeletes(); toast('Field removed');
      }));
      wireDeletes();
      $('#cf-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target;
        const label = f.label.value.trim(); if (!label) return;
        const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
        const type = f.field_type.value;
        const opts = type === 'select' ? f.options.value.split(',').map((s) => s.trim()).filter(Boolean) : null;
        if (type === 'select' && (!opts || !opts.length)) { $('#cf-status').textContent = 'Dropdown needs at least one option.'; return; }
        const { data, error } = await sb.from('ph_custom_fields').insert({ key, label, field_type: type, options: opts, position: 100 + state.customFields.length }).select('*').single();
        if (error) { $('#cf-status').textContent = 'Could not add: ' + error.message; return; }
        state.customFields.push(data);
        $('#cf-list').innerHTML = rows(); wireDeletes();
        f.reset(); $('#cf-status').textContent = 'Added — it now shows on every contact card.';
      });

      // Tag vocabulary (admin-only writes; brokers pick from this list).
      const paintTags = () => {
        $('#tg-list').innerHTML = state.adminTags.map((t) => `<span class="fchip">${esc(t.name)}<button data-tg-del="${t.id}" aria-label="Remove">✕</button></span>`).join('') || '<span class="cell-sub">No tags yet.</span>';
        $$('#tg-list [data-tg-del]').forEach((b) => b.addEventListener('click', async () => {
          const { error } = await sb.from('ph_tags').update({ is_active: false }).eq('id', b.dataset.tgDel);
          if (error) { toast('Could not remove tag.'); return; }
          state.adminTags = state.adminTags.filter((t) => t.id !== b.dataset.tgDel);
          paintTags(); toast('Tag removed');
        }));
      };
      paintTags();
      $('#tg-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = e.target.name.value.trim().toLowerCase(); if (!name) return;
        const { data, error } = await sb.from('ph_tags').insert({ name, position: 100 + state.adminTags.length }).select('*').single();
        if (error) { $('#tg-status').textContent = 'Could not add: ' + error.message; return; }
        state.adminTags.push(data); e.target.reset(); paintTags();
        $('#tg-status').textContent = 'Added — brokers can use it now.';
      });
    }

    // ================= ADD CONTACT (slide-in form) =================
    function depRow(i, relation) {
      const isSpouse = relation === 'Spouse';
      return `<div class="dep-row" data-dep="${i}">
        <div style="font-size:.72rem;font-weight:700;color:var(--muted);margin-bottom:4px">${relation}</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 130px;gap:8px">
          <input data-dk="first_name" placeholder="First name"/>
          <input data-dk="last_name" placeholder="Last name"/>
          <input data-dk="dob" type="date" title="Date of birth"/>
        </div>
      </div>`;
    }
    function openAddContact(listView) {
      const carrierOpts = state.carriers.map((c) => `<label class="pickbox"><input type="checkbox" data-carrier="${c.id}"/> ${esc(c.name)}</label>`).join('');
      const covOpts = COVERAGE_TYPES.map((c) => `<label class="pickbox"><input type="checkbox" data-cov="${esc(c)}"/> ${esc(c)}</label>`).join('');
      const dispOpts = DISPOSITIONS.map((d) => `<option value="${esc(d)}"${d==='Lead'?' selected':''}>${esc(d)}</option>`).join('');
      const deps = [depRow(0, 'Spouse'), depRow(1, 'Child 1'), depRow(2, 'Child 2'), depRow(3, 'Child 3'), depRow(4, 'Child 4')].join('');
      openDrawer(`
        <div class="drawer-h">
          <div><div style="font-size:1.15rem;font-weight:800">Add Contact</div><div class="cell-sub">Saved to your book automatically</div></div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">
          <form id="add-form">
            <div class="section-t">Client</div>
            <div class="grid2">
              <div class="field"><label>First name *</label><input name="first_name" required/></div>
              <div class="field"><label>Last name</label><input name="last_name"/></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Company (text)</label><input name="company"/></div>
              <div class="field"><label>Link to company</label><select name="company_id"><option value="">None</option>${state.companies.map((co) => `<option value="${co.id}">${esc(co.name)}</option>`).join('')}</select></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Date of birth</label><input name="date_of_birth" type="date"/></div>
              <div class="field"><label>Phone</label><input name="phone" inputmode="tel"/></div>
            </div>
            <div class="field"><label>Email</label><input name="email" type="email"/></div>
            <div class="field"><label>Street address</label><input name="street_address"/></div>
            <div class="grid3">
              <div class="field"><label>City</label><input name="city"/></div>
              <div class="field"><label>State</label><input name="state" maxlength="2" style="text-transform:uppercase"/></div>
              <div class="field"><label>Zip</label><input name="postal_code" inputmode="numeric"/></div>
            </div>
            <div class="field"><label>Disposition</label><select name="disposition">${dispOpts}</select>
              <div class="hint">Setting this to <b>Active Client</b> marks the client in-force and records you as the writing agent.</div>
            </div>
            <div class="section-t">Tags</div>
            <div>${state.adminTags.map((t) => `<label class="pickbox"><input type="checkbox" data-tagpick="${esc(t.name)}"/> ${esc(t.name)}</label>`).join(' ') || '<span class="cell-sub">No tags defined yet — admins add them under Manage fields.</span>'}</div>

            <div class="section-t">Lines of insurance</div>
            <div class="hint" style="margin-bottom:8px">Each line you check creates a deal in that pipeline.</div>
            <div class="pickgrid">${covOpts}</div>

            <div class="section-t">Carriers</div>
            <div class="pickgrid" id="carrier-pick">${carrierOpts || '<div class="cell-sub">No carriers yet.</div>'}</div>

            <div class="section-t">Dependents</div>
            ${deps}

            <div style="display:flex;gap:10px;margin-top:22px">
              <button type="submit" class="btn btn-primary">Save Contact</button>
              <button type="button" class="btn btn-ghost" data-x>Cancel</button>
            </div>
            <p class="ag-status add-status" style="min-height:1.1em;margin-top:10px"></p>
          </form>
        </div>`);
      $$('[data-x]').forEach((b) => b.addEventListener('click', closeDrawer));
      $('#add-form').addEventListener('submit', (e) => { e.preventDefault(); saveContact(e.target, listView); });
    }

    async function saveContact(form, listView) {
      const status = $('.add-status');
      const g = (n) => form.elements[n]?.value?.trim() || null;
      const first = g('first_name');
      if (!first) { status.textContent = 'First name is required.'; status.classList.add('is-bad'); return; }
      const btn = form.querySelector('button[type="submit"]'); btn.disabled = true;
      status.classList.remove('is-bad'); status.textContent = 'Saving…';

      const coverage = $$('[data-cov]', form).filter((c) => c.checked).map((c) => c.getAttribute('data-cov'));
      const carrierIds = $$('[data-carrier]', form).filter((c) => c.checked).map((c) => c.getAttribute('data-carrier'));
      const dependents = $$('.dep-row', form).map((row, i) => {
        const rel = i === 0 ? 'Spouse' : 'Child';
        const d = {};
        $$('[data-dk]', row).forEach((inp) => { if (inp.value.trim()) d[inp.getAttribute('data-dk')] = inp.value.trim(); });
        return Object.keys(d).length ? { relation: rel, ...d } : null;
      }).filter(Boolean);

      // Local id keeps this out of the GHL sync's path entirely.
      const id = 'local:' + (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(16).slice(2));
      const row = {
        ghl_contact_id: id, origin: 'crm', tags: $$('[data-tagpick]').filter((x) => x.checked).map((x) => x.getAttribute('data-tagpick')), dnd: false, synced_at: new Date().toISOString(),
        first_name: first, last_name: g('last_name'), company: g('company'), company_id: form.elements['company_id']?.value || null, email: g('email'),
        phone: g('phone'), date_of_birth: g('date_of_birth'), street_address: g('street_address'),
        city: g('city'), state: (g('state') || '').toUpperCase() || null, postal_code: g('postal_code'),
        disposition: form.elements['disposition'].value, coverage_types: coverage, dependents,
        ghl_date_added: new Date().toISOString(),
        // agent_id intentionally omitted — the intake trigger assigns the owner.
      };
      const { error } = await sb.from('ph_contacts').insert(row);
      if (error) { btn.disabled = false; status.textContent = 'Could not save: ' + error.message; status.classList.add('is-bad'); return; }

      if (carrierIds.length) {
        const links = carrierIds.map((cid) => ({ contact_id: id, carrier_id: cid }));
        const { error: cErr } = await sb.from('ph_contact_carriers').insert(links);
        if (cErr) toast('Contact saved, but carriers did not attach.');
      }
      closeDrawer();
      toast('Contact added to your book');
      state.contactCount++; buildNav();
      reloadOpps();
      loadContacts(listView);
    }

    // ================= CSV IMPORT =================
    // A four-step wizard in the shared drawer: file → behaviour → column
    // mapping → run. Entirely client side — no edge function, no migration.
    // The parser, the alias table, the matching rules and the batch runner live
    // in src/lib/csv-import.ts and are shared with /admin/contacts.
    let imp = null;

    async function openImport(listView) {
      if (imp && imp.downloadUrl) { URL.revokeObjectURL(imp.downloadUrl); }
      imp = {
        step: 1, listView, target: cMode === 'companies' ? 'companies' : 'contacts',
        header: [], rows: [], lines: [], mapping: [], fileName: '',
        mode: 'create_update', matchField: cMode === 'companies' ? 'name' : 'email', skipBlanks: true,
        ownerId: state.agentId || null, running: false, result: null,
        fatal: null, downloadUrl: null,
      };
      // Admins decide who the rows land on, so they need the roster. A broker
      // never sees the picker: everything they import is theirs, which is also
      // the only thing ph_contacts_agent_insert would let them write.
      if (state.isAdmin && !state.roster) {
        const { data } = await sb.from('ph_agents').select('id, full_name, email').eq('is_active', true).order('full_name');
        state.roster = data ?? [];
      }
      paintImport();
    }

    const impFields = () => fieldsFor(imp.target, state.customFields);

    function paintImport() {
      const steps = ['File', 'Behaviour', 'Columns', 'Import'];
      const body = imp.step === 1 ? impStep1() : imp.step === 2 ? impStep2() : imp.step === 3 ? impStep3() : impStep4();
      openDrawer(`
        <div class="drawer-h">
          <div>
            <div style="font-size:1.15rem;font-weight:800">Import from CSV</div>
            <div class="cell-sub">Step ${imp.step} of 4 · ${esc(steps[imp.step - 1])}${imp.fileName ? ' · ' + esc(imp.fileName) : ''}</div>
          </div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">${body}</div>`);
      $$('#drawer [data-x]').forEach((b) => b.addEventListener('click', closeDrawer));
      if (imp.step === 1) wireStep1();
      else if (imp.step === 2) wireStep2();
      else if (imp.step === 3) wireStep3();
      else wireStep4();
    }

    const impGo = (n) => { imp.step = n; paintImport(); };

    // ---- step 1: what, and from which file ----
    function impStep1() {
      const t = (v, label, hint) => `
        <label class="pickbox"><input type="radio" name="imp-target" value="${v}" ${imp.target === v ? 'checked' : ''}/>
          <span><b>${esc(label)}</b> <span class="cell-sub">${esc(hint)}</span></span></label>`;
      return `
        <div class="section-t">What are you importing</div>
        ${t('contacts', 'Contacts', 'people, into your book')}
        ${t('companies', 'Companies', 'group / employer records')}
        <div class="section-t">Your file</div>
        <div class="field"><label>CSV file</label><input type="file" id="imp-file" accept=".csv,text/csv"/></div>
        <p class="cell-sub" id="imp-msg">The first row must be the column headings. Quoted fields, commas and line breaks inside quotes are all handled.</p>
        <div class="imp-actions">
          <button class="btn btn-primary" id="imp-next" ${imp.rows.length ? '' : 'disabled'}>Next</button>
          <button class="btn btn-ghost" data-x>Cancel</button>
        </div>`;
    }

    function wireStep1() {
      $$('#drawer [name="imp-target"]').forEach((r) => r.addEventListener('change', () => {
        imp.target = r.value;
        imp.matchField = imp.target === 'companies' ? 'name' : 'email';
        imp.mapping = [];
      }));
      // Updates in place rather than repainting: a repaint would blow away the
      // file input and with it the file the browser is holding for us.
      $('#imp-file').addEventListener('change', async (e) => {
        const msg = $('#imp-msg'), next = $('#imp-next');
        const f = e.target.files && e.target.files[0];
        imp.header = []; imp.rows = []; imp.lines = []; imp.mapping = []; imp.fileName = '';
        next.disabled = true; msg.classList.remove('imp-bad');
        if (!f) { msg.textContent = 'Pick a .csv file to continue.'; return; }
        msg.textContent = 'Reading…';
        let text = '';
        try { text = await f.text(); }
        catch { msg.textContent = 'That file could not be read.'; msg.classList.add('imp-bad'); return; }
        const r = readCsv(text);
        if (r.error) { msg.textContent = r.error; msg.classList.add('imp-bad'); return; }
        imp.header = r.header; imp.rows = r.rows; imp.lines = r.lines; imp.fileName = f.name;
        msg.textContent = `${r.rows.length.toLocaleString()} data row${r.rows.length === 1 ? '' : 's'} · ${r.header.length} column${r.header.length === 1 ? '' : 's'}.`;
        next.disabled = false;
      });
      $('#imp-next').addEventListener('click', () => { if (imp.rows.length) impGo(2); });
    }

    // ---- step 2: create, update, or both ----
    function impStep2() {
      const mode = (v, label, hint) => `
        <label class="pickbox"><input type="radio" name="imp-mode" value="${v}" ${imp.mode === v ? 'checked' : ''}/>
          <span><b>${esc(label)}</b> <span class="cell-sub">${esc(hint)}</span></span></label>`;
      const owner = state.isAdmin ? `
        <div class="section-t">Owner</div>
        <div class="field"><label>Assign every imported record to</label>
          <select id="imp-owner">
            <option value="">Unassigned / house</option>
            ${(state.roster || []).map((a) => `<option value="${esc(a.id)}" ${imp.ownerId === a.id ? 'selected' : ''}>${esc(a.full_name || a.email)}</option>`).join('')}
          </select>
          <div class="cell-sub" style="margin-top:5px">An unassigned record is invisible to every broker until somebody is put against it.</div>
        </div>` : `
        <div class="section-t">Owner</div>
        <p class="cell-sub">Everything you import is added to your own book.</p>`;
      return `
        <div class="section-t">What to do with each row</div>
        ${mode('create', 'Create only', 'skip anything that already exists')}
        ${mode('create_update', 'Create and update', 'add the new, patch the matches')}
        ${mode('update', 'Update only', 'skip anything we do not already have')}
        <div class="section-t">Matching</div>
        <div class="field"><label>Find existing records based on</label>
          <select id="imp-match">${matchOptions(imp.target).map((o) => `<option value="${esc(o.value)}" ${imp.matchField === o.value ? 'selected' : ''}>${esc(o.label)}</option>`).join('')}</select>
          <div class="cell-sub" style="margin-top:5px">Email is compared lowercase and trimmed; phone is compared on digits only with a leading 1 stripped, so (702) 555-0134 and +1 702 555 0134 are the same person.</div>
        </div>
        <label class="pickbox"><input type="checkbox" id="imp-blanks" ${imp.skipBlanks ? 'checked' : ''}/>
          <span>Don't overwrite existing values with blanks</span></label>
        ${owner}
        <div class="imp-actions">
          <button class="btn btn-ghost" id="imp-back">Back</button>
          <button class="btn btn-primary" id="imp-next">Next</button>
        </div>`;
    }

    function wireStep2() {
      $$('#drawer [name="imp-mode"]').forEach((r) => r.addEventListener('change', () => { imp.mode = r.value; }));
      $('#imp-match').addEventListener('change', (e) => { imp.matchField = e.target.value; });
      $('#imp-blanks').addEventListener('change', (e) => { imp.skipBlanks = e.target.checked; });
      $('#imp-owner')?.addEventListener('change', (e) => { imp.ownerId = e.target.value || null; });
      $('#imp-back').addEventListener('click', () => impGo(1));
      $('#imp-next').addEventListener('click', () => {
        // The guess only runs once, so a mapping the user has corrected survives
        // a trip back to step 2.
        if (!imp.mapping.length) imp.mapping = autoMap(imp.header, impFields());
        impGo(3);
      });
    }

    // ---- step 3: one row per column in the file ----
    function impStep3() {
      const fields = impFields();
      const obj = objectLabel(imp.target);
      const rows = imp.header.map((h, i) => {
        const val = imp.mapping[i] || '';
        const samples = sampleValues(imp.rows, i);
        return `<tr>
          <td style="font-weight:650">${esc(h || 'Column ' + (i + 1))}</td>
          <td class="cell-sub">${esc(samples.join(' · ')) || '—'}</td>
          <td><span class="pill-status ${val ? 'st-green' : 'st-gray'}" data-mapstatus="${i}">${val ? 'Mapped' : 'Not mapped'}</span></td>
          <td><select class="rec-select" disabled><option>${esc(obj)}</option></select></td>
          <td><select class="rec-select" data-map="${i}">
            <option value="">— Not mapped —</option>
            ${fields.map((f) => `<option value="${esc(f.value)}" ${val === f.value ? 'selected' : ''}>${esc(f.label)}</option>`).join('')}
          </select></td>
        </tr>`;
      }).join('');
      const matchLabel = (matchOptions(imp.target).find((o) => o.value === imp.matchField) || {}).label || imp.matchField;
      return `
        <div class="section-t">Match your columns</div>
        <p class="cell-sub" style="margin-bottom:10px">Anything left unmapped is skipped. <b>Note</b> writes into the contact's notes tab rather than a field. Tags and lines of insurance split on <b>;</b> or <b>,</b>.</p>
        <div class="imp-tablewrap"><table class="data imp-map">
          <thead><tr><th>Column in file</th><th>Sample values</th><th>Status</th><th>Object</th><th>Field</th></tr></thead>
          <tbody>${rows}</tbody>
        </table></div>
        <p class="cell-sub" id="imp-map-msg" style="margin-top:10px">Matching on <b>${esc(matchLabel)}</b> — that column has to be mapped.</p>
        <div class="imp-actions">
          <button class="btn btn-ghost" id="imp-back">Back</button>
          <button class="btn btn-primary" id="imp-next">Start import</button>
        </div>`;
    }

    function wireStep3() {
      $$('#drawer [data-map]').forEach((sel) => sel.addEventListener('change', () => {
        const i = +sel.dataset.map;
        imp.mapping[i] = sel.value;
        const pill = $(`#drawer [data-mapstatus="${i}"]`);
        pill.textContent = sel.value ? 'Mapped' : 'Not mapped';
        pill.classList.toggle('st-green', !!sel.value);
        pill.classList.toggle('st-gray', !sel.value);
      }));
      $('#imp-back').addEventListener('click', () => impGo(2));
      $('#imp-next').addEventListener('click', () => {
        const msg = $('#imp-map-msg');
        const label = (matchOptions(imp.target).find((o) => o.value === imp.matchField) || {}).label || imp.matchField;
        if (imp.mapping.indexOf(imp.matchField) < 0) {
          msg.innerHTML = `You chose to find existing records by <b>${esc(label)}</b>, but no column in the file is mapped to it. Map one, or go back and match on something else.`;
          msg.classList.add('imp-bad');
          return;
        }
        if (!imp.mapping.filter(Boolean).length) {
          msg.textContent = 'Nothing is mapped yet, so there is nothing to import.';
          msg.classList.add('imp-bad');
          return;
        }
        msg.classList.remove('imp-bad');
        impRun();
      });
    }

    // ---- step 4: run it, then show what happened ----
    function impStep4() {
      if (imp.fatal) {
        return `<div class="section-t">Import stopped</div>
          <p class="cell-sub imp-bad">${esc(imp.fatal)}</p>
          <div class="imp-actions"><button class="btn btn-primary" data-x>Close</button></div>`;
      }
      if (!imp.result) {
        return `
          <div class="section-t">Importing</div>
          <p class="cell-sub" style="margin-bottom:10px">${imp.rows.length.toLocaleString()} rows, ${BATCH_SIZE} at a time. Leave this open until it finishes.</p>
          <div class="imp-bar"><span id="imp-fill" style="width:0%"></span></div>
          <p class="cell-sub" id="imp-count">0 of ${imp.rows.length.toLocaleString()}</p>`;
      }
      const r = imp.result;
      const n = (x) => Number(x || 0).toLocaleString();
      const shown = r.errors.slice(0, 100);
      return `
        <div class="section-t">Results</div>
        <div class="kv">
          <div class="k">Created</div><div class="v">${n(r.created)}</div>
          <div class="k">Updated</div><div class="v">${n(r.updated)}</div>
          <div class="k">Skipped as duplicate</div><div class="v">${n(r.skippedDuplicate)}</div>
          <div class="k">Skipped as not found</div><div class="v">${n(r.skippedNotFound)}</div>
          <div class="k">Failed</div><div class="v">${n(r.failed)}</div>
        </div>
        ${r.noteErrors.length ? `<p class="cell-sub imp-bad" style="margin-top:10px">Some notes could not be saved: ${esc(r.noteErrors[0])}</p>` : ''}
        ${r.errors.length ? `
          <div class="section-t">What failed</div>
          <div class="imp-errs">${shown.map((e) => `<div class="feed-item"><div class="feed-ic">⚠</div><div><div style="font-weight:650">Row ${e.line}</div><div class="cell-sub">${esc(e.message)}</div></div></div>`).join('')}</div>
          ${r.errors.length > shown.length ? `<p class="cell-sub">…and ${n(r.errors.length - shown.length)} more. Download the file below for all of them.</p>` : ''}
          <div class="imp-actions">
            <button class="btn btn-ghost btn-sm" id="imp-dl">Download failed rows</button>
          </div>` : '<p class="cell-sub" style="margin-top:12px">No errors.</p>'}
        <div class="imp-actions">
          <button class="btn btn-primary" data-x>Done</button>
        </div>`;
    }

    function wireStep4() {
      $('#imp-dl')?.addEventListener('click', () => {
        const csv = failedRowsCsv(imp.header, imp.result.errors);
        if (imp.downloadUrl) URL.revokeObjectURL(imp.downloadUrl);
        const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
        imp.downloadUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = imp.downloadUrl;
        a.download = (imp.fileName || 'import').replace(/\.csv$/i, '') + '-failed.csv';
        a.click();
      });
    }

    async function impRun() {
      imp.running = true; imp.result = null; imp.fatal = null;
      impGo(4);
      const fill = $('#imp-fill'), count = $('#imp-count');
      const total = imp.rows.length;
      try {
        imp.result = await runImport(sb, {
          target: imp.target, header: imp.header, rows: imp.rows, lines: imp.lines,
          mapping: imp.mapping, mode: imp.mode, matchField: imp.matchField,
          skipBlanks: imp.skipBlanks, ownerId: imp.ownerId,
        }, (done) => {
          if (fill) fill.style.width = (total ? Math.round((done / total) * 100) : 100) + '%';
          if (count) count.textContent = `${done.toLocaleString()} of ${total.toLocaleString()}`;
        });
      } catch (err) {
        imp.fatal = 'Could not finish the import: ' + (err?.message || err);
      }
      imp.running = false;
      paintImport();
      if (imp.result) {
        const r = imp.result;
        toast(`Import done — ${r.created} created, ${r.updated} updated${r.failed ? ', ' + r.failed + ' failed' : ''}`);
        await refreshAfterImport();
      }
    }

    // Put the list behind the drawer back in step with the database.
    async function refreshAfterImport() {
      if (imp.target === 'companies') {
        const { data } = await mine(sb.from('ph_companies').select('*')).order('name');
        state.companies = data ?? [];
      } else {
        const { count } = await mine(sb.from('ph_contacts').select('*', { count: 'exact', head: true })).is('deleted_at', null);
        state.contactCount = count ?? state.contactCount;
        buildNav();
      }
      const v = imp.listView;
      if (!v || currentRoute !== 'contacts') return;
      if (cMode === 'people') loadContacts(v); else renderCompanies(v);
    }

    async function loadTags(v) {
      // Admin-defined tags first, then any other tags that exist in THIS
      // user's own book (ph_contact_tags is RLS-scoped, so a broker only ever
      // sees tags on their own contacts).
      const sel = $('#c-tag', v); if (!sel) return;
      const seen = new Set();
      state.adminTags.forEach((t) => { seen.add(t.name.toLowerCase()); const o = document.createElement('option'); o.value = t.name; o.textContent = t.name; sel.appendChild(o); });
      try {
        const { data } = await sb.rpc('ph_contact_tags');
        (data || []).slice(0, 60).forEach((row) => {
          const tag = row.tag || row; if (seen.has(String(tag).toLowerCase())) return;
          const o = document.createElement('option'); o.value = tag; o.textContent = tag + (row.uses ? ` (${row.uses})` : ''); sel.appendChild(o);
        });
      } catch {}
      if (cFilters.tag) sel.value = cFilters.tag;
    }
    async function loadContacts(v) {
      const per = 25;

      // Policy / carrier filters resolve to a set of contact ids first, then the
      // main contacts query narrows to that set. Policies are RLS-scoped, so an
      // agent only ever matches within their own book.
      let idSet = null;
      const needsPolicies = cFilters.polStatus || cFilters.premMin || cFilters.premMax ||
        (cFilters.line && (cFilters.polStatus || cFilters.premMin || cFilters.premMax));
      if (needsPolicies || cFilters.polStatus) {
        let pq = mine(sb.from('ph_policies').select('contact_id, premium, premium_freq'));
        if (cFilters.line) pq = pq.eq('line', cFilters.line);
        if (cFilters.polStatus) pq = pq.eq('status', cFilters.polStatus);
        if (cFilters.carrier_id) pq = pq.eq('carrier_id', cFilters.carrier_id);
        const { data: pols } = await pq;
        const min = cFilters.premMin !== '' ? parseFloat(cFilters.premMin) : null;
        const max = cFilters.premMax !== '' ? parseFloat(cFilters.premMax) : null;
        idSet = new Set((pols || []).filter((p) => {
          if (min == null && max == null) return true;
          if (p.premium == null) return false;
          const annual = Number(p.premium) * (FREQ_X[p.premium_freq] || 12);
          return (min == null || annual >= min) && (max == null || annual <= max);
        }).map((p) => p.contact_id));
      }
      if (cFilters.carrier_id && !needsPolicies && !cFilters.polStatus) {
        // Carrier filter alone: match via linked carriers OR any policy at that carrier.
        const [{ data: links }, { data: pols }] = await Promise.all([
          sb.from('ph_contact_carriers').select('contact_id').eq('carrier_id', cFilters.carrier_id),
          mine(sb.from('ph_policies').select('contact_id')).eq('carrier_id', cFilters.carrier_id),
        ]);
        idSet = new Set([...(links || []).map((r) => r.contact_id), ...(pols || []).map((r) => r.contact_id)]);
      }

      const tbl = $('#c-table', v);
      const cols = ALL_COLS.filter((c) => cCols.includes(c.key));
      const header = `<tr><th class="pick-c"><input type="checkbox" class="pick" id="c-pick-all" aria-label="Select every contact on this page"/></th><th>Name</th>${cols.map((c) => `<th>${esc(c.label)}</th>`).join('')}</tr>`;
      const span = cols.length + 2;

      if (idSet && idSet.size === 0) {
        tbl.innerHTML = `<table class="data"><thead>${header}</thead><tbody><tr><td colspan="${span}"><div class="empty">No contacts match these filters.</div></td></tr></tbody></table>`;
        $('#c-count', v).textContent = '0 contacts'; $('#c-pager', v).innerHTML = ''; paintBulk(v); return;
      }

      let q = mine(sb.from('ph_contacts').select('*', { count: 'exact' })).is('deleted_at', null).order('ghl_date_added', { ascending: false, nullsFirst: false });
      if (cQuery) { const s = cQuery.replace(/[%,]/g, ' '); q = q.or(`first_name.ilike.%${s}%,last_name.ilike.%${s}%,email.ilike.%${s}%,phone.ilike.%${s}%`); }
      if (cFilters.tag) q = q.contains('tags', [cFilters.tag]);
      if (cFilters.disposition) q = q.eq('disposition', cFilters.disposition);
      if (cFilters.company_id) q = q.eq('company_id', cFilters.company_id);
      if (cFilters.line && !needsPolicies) q = q.contains('coverage_types', [cFilters.line]);
      if (cFilters.bdayMonth) q = q.eq('bday_month', parseInt(cFilters.bdayMonth, 10));
      if (idSet) q = q.in('ghl_contact_id', Array.from(idSet).slice(0, 900));
      q = q.range(cPage * per, cPage * per + per - 1);
      const { data, count } = await q;
      const rows = data ?? [];

      // Enrich the visible page only, and only for the columns that need it.
      const pageIds = rows.map((c) => c.ghl_contact_id);
      let carrierMap = {}, policyMap = {};
      if (pageIds.length && cCols.includes('carriers')) {
        const { data: links } = await sb.from('ph_contact_carriers').select('contact_id, carrier_id').in('contact_id', pageIds);
        (links || []).forEach((l) => {
          const n = state.carriers.find((x) => x.id === l.carrier_id)?.name; if (!n) return;
          (carrierMap[l.contact_id] ||= []).push(n);
        });
      }
      if (pageIds.length && cCols.includes('policies')) {
        const { data: pols } = await mine(sb.from('ph_policies').select('contact_id, line, status, premium, premium_freq')).in('contact_id', pageIds);
        (pols || []).forEach((p) => { (policyMap[p.contact_id] ||= []).push(p); });
      }

      const cellFor = (key, c) => {
        switch (key) {
          case 'email': return `<td class="cell-sub">${esc(c.email || '')}</td>`;
          case 'phone': return `<td class="cell-sub">${esc(fmtPhone(c.phone))}</td>`;
          case 'tags': return `<td>${(c.tags || []).slice(0, 3).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ')}</td>`;
          case 'added': return `<td class="cell-sub">${esc(fmtDate(c.ghl_date_added))}</td>`;
          case 'bday': return `<td class="cell-sub">${c.bday_month ? esc(MONTHS_L[c.bday_month - 1].slice(0, 3) + (c.bday_day ? ' ' + c.bday_day : '')) : '—'}</td>`;
          case 'company': { const co = c.company_id ? state.companies.find((x) => x.id === c.company_id) : null; return `<td class="cell-sub">${esc(co?.name || c.company || '—')}</td>`; }
          case 'disposition': return `<td><span class="pill-status ${dispClass(c.disposition)}">${esc(c.disposition || '—')}</span></td>`;
          case 'lines': return `<td>${(c.coverage_types || []).slice(0, 3).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">—</span>'}</td>`;
          case 'carriers': return `<td class="cell-sub">${esc((carrierMap[c.ghl_contact_id] || []).slice(0, 2).join(', ') || '—')}</td>`;
          case 'policies': {
            const pols = policyMap[c.ghl_contact_id] || [];
            if (!pols.length) return '<td class="cell-sub">—</td>';
            const annual = pols.reduce((s, p) => s + (p.premium != null ? Number(p.premium) * (FREQ_X[p.premium_freq] || 12) : 0), 0);
            return `<td><div style="font-weight:650">${pols.length} ${pols.length === 1 ? 'policy' : 'policies'}</div>${annual ? `<div class="cell-sub">${fmtMoney(annual)}/yr</div>` : ''}</td>`;
          }
          default: return '<td></td>';
        }
      };

      tbl.innerHTML = `<table class="data"><thead>${header}</thead><tbody>${
        rows.map((c) => `<tr class="rowlink${cSel.has(c.ghl_contact_id) ? ' is-picked' : ''}" data-contact="${esc(c.ghl_contact_id)}">
          <td class="pick-c"><input type="checkbox" class="pick" data-pick="${esc(c.ghl_contact_id)}" ${cSel.has(c.ghl_contact_id) ? 'checked' : ''} aria-label="Select ${esc(nameOf(c))}"/></td>
          <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nameOf(c))}">${initials(nameOf(c))}</span>${esc(nameOf(c))}</div></td>
          ${cols.map((col) => cellFor(col.key, c)).join('')}</tr>`).join('') || `<tr><td colspan="${span}"><div class="empty">No contacts match.</div></td></tr>`
      }</tbody></table>`;
      const total = count ?? rows.length;
      $('#c-count', v).textContent = total.toLocaleString() + ' contact' + (total === 1 ? '' : 's');
      const pages = Math.max(1, Math.ceil(total / per));
      $('#c-pager', v).innerHTML = `<button ${cPage<=0?'disabled':''} data-pg="prev">← Prev</button><span>Page ${cPage+1} of ${Math.max(1,pages)}</span><button ${cPage>=pages-1?'disabled':''} data-pg="next">Next →</button>`;
      $$('[data-pg]', v).forEach((b) => b.addEventListener('click', () => { cPage += b.dataset.pg === 'next' ? 1 : -1; loadContacts(v); }));
      // The checkbox sits inside the row, and the row opens the record — so the
      // click has to stop there or picking someone would navigate away.
      // The whole cell, not just the 16px box: clipping the checkbox by a few
      // pixels should never navigate away from a selection in progress.
      $$('td.pick-c', v).forEach((td) => td.addEventListener('click', (e) => e.stopPropagation()));
      $$('[data-pick]', v).forEach((box) => box.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = box.dataset.pick;
        if (box.checked) cSel.add(id); else cSel.delete(id);
        box.closest('tr')?.classList.toggle('is-picked', box.checked);
        const all = $('#c-pick-all', v);
        if (all) all.checked = rows.length > 0 && rows.every((c) => cSel.has(c.ghl_contact_id));
        paintBulk(v);
      }));
      const pickAll = $('#c-pick-all', v);
      if (pickAll) {
        pickAll.checked = rows.length > 0 && rows.every((c) => cSel.has(c.ghl_contact_id));
        pickAll.addEventListener('click', (e) => {
          e.stopPropagation();
          rows.forEach((c) => { if (pickAll.checked) cSel.add(c.ghl_contact_id); else cSel.delete(c.ghl_contact_id); });
          $$('[data-pick]', v).forEach((b) => { b.checked = pickAll.checked; b.closest('tr')?.classList.toggle('is-picked', pickAll.checked); });
          paintBulk(v);
        });
      }
      paintBulk(v);
      $$('tr[data-contact]', v).forEach((r) => r.addEventListener('click', () => openContact(r.dataset.contact, rows)));
    }

    // ================= LEADS =================
    let lFilter = 'all', lQuery = '';
    function renderLeads(v) {
      const stageOpts = ['<option value="all">All stages</option>', ...state.stages.map((s) => `<option value="${s.id}">${esc(s.label)}</option>`)].join('');
      v.innerHTML = `
      <div class="card">
        <div class="toolbar">
          <input type="text" id="l-search" placeholder="Search leads…" value="${esc(lQuery)}" style="min-width:220px"/>
          <select id="l-stage">${stageOpts}</select>
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)" id="l-count"></span>
        </div>
        <div id="l-table"></div>
      </div>`;
      const s = $('#l-search', v); let t;
      s.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { lQuery = s.value.trim().toLowerCase(); paintLeads(v); }, 200); });
      $('#l-stage', v).value = lFilter;
      $('#l-stage', v).addEventListener('change', (e) => { lFilter = e.target.value; paintLeads(v); });
      paintLeads(v);
    }
    function paintLeads(v) {
      let rows = state.leads;
      if (lFilter !== 'all') rows = rows.filter((l) => l.stage_id === lFilter);
      if (lQuery) rows = rows.filter((l) => (nameOf(l) + ' ' + (l.email||'') + ' ' + (l.phone||'')).toLowerCase().includes(lQuery));
      $('#l-count', v).textContent = rows.length + ' leads';
      $('#l-table', v).innerHTML = `<table class="data"><thead><tr><th>Name</th><th>Stage</th><th>Type</th><th>Source</th><th>Appointment</th><th>Added</th></tr></thead><tbody>${
        rows.map((l) => `<tr class="rowlink" data-lead="${l.id}">
          <td><div class="cell-name"><span class="avatar-sm" style="background:${avColor(nameOf(l))}">${initials(nameOf(l))}</span><div>${esc(nameOf(l))}<div class="cell-sub">${esc(l.email || l.phone || '')}</div></div></div></td>
          <td>${stagePill(l)}</td><td><span class="chip">${esc(l.kind || 'form')}</span></td><td class="cell-sub">${esc(l.source_form || l.page || 'web')}</td>
          <td class="cell-sub">${l.appointment_start ? esc(fmtDateTime(l.appointment_start)) : '—'}</td><td class="cell-sub">${esc(fmtDate(l.created_at))}</td></tr>`).join('') || '<tr><td colspan="6"><div class="empty">No leads match.</div></td></tr>'
      }</tbody></table>`;
      $$('tr[data-lead]', v).forEach((r) => r.addEventListener('click', () => openLead(r.dataset.lead)));
    }

    // ============ PIPELINE (per-line opportunity board + line dropdown) ============
    let pipeLineKey = null;
    function pipeName(lk) { const p = state.pipelines.find((x) => x.line_key === lk); return p ? p.name : lk; }
    // Which pipelines this user sees: an admin sees all; a broker sees the lines
    // they wrote at onboarding, plus any line they already hold a deal in.
    function visiblePipelines() {
      if (state.isAdmin) return state.pipelines.slice();
      const mine = new Set(state.me?.lines_of_insurance || []);
      const withOpps = new Set(state.opps.map((o) => o.line_key));
      return state.pipelines.filter((p) => mine.has(p.name) || withOpps.has(p.line_key));
    }
    function renderPipeline(v) {
      const pipes = visiblePipelines().sort((a, b) => a.position - b.position);
      if (!pipes.length) {
        v.innerHTML = `<div class="card"><div class="empty">No pipelines to show yet. Pick the lines you write from <b>Edit profile</b> (bottom-left), or add a contact and choose a coverage type — the deal lands here automatically.</div></div>`;
        return;
      }
      if (!pipeLineKey || !pipes.some((p) => p.line_key === pipeLineKey)) pipeLineKey = pipes[0].line_key;
      const pipe = pipes.find((p) => p.line_key === pipeLineKey);
      const stages = state.pipelineStages.filter((s) => s.pipeline_id === pipe.id).sort((a, b) => a.position - b.position);
      const opts = pipes.map((p) => `<option value="${esc(p.line_key)}"${p.line_key === pipeLineKey ? ' selected' : ''}>${esc(p.name)}</option>`).join('');
      // The board is open work only. Won and Lost are dispositions, not places a
      // card lives: closing one takes it off the board and moves the number to
      // the dashboard tiles, which is what makes the board a to-do list rather
      // than an archive that grows forever.
      const openHere = state.opps.filter((o) => o.pipeline_id === pipe.id && o.status === 'open');
      const total = openHere.length;
      const out = state.outcomes || {};
      v.innerHTML = `
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap">
          <label style="display:flex;align-items:center;gap:8px;font-weight:700;color:#0b2a4a">
            <span>Pipeline</span>
            <select id="pipe-line" style="padding:9px 12px;border:1.5px solid #d9e1ea;border-radius:10px;font-size:0.95rem;font-weight:600;background:#fff;color:#0b2a4a;min-width:190px">${opts}</select>
          </label>
          <div class="cell-sub">${total} open deal${total === 1 ? '' : 's'} in ${esc(pipe.name)}</div>
          <div class="pipe-out cell-sub">Last ${OUTCOME_DAYS} days · <b style="color:var(--green)">${out.won_count ?? 0} won</b> · <b style="color:var(--red)">${out.lost_count ?? 0} lost</b></div>
          ${state.isAdmin ? `<button class="btn btn-danger btn-sm" id="pipe-del" style="margin-left:auto">Delete pipeline</button>` : ''}
        </div>
        <div id="kanban">${stages.map((s) => {
          const closer = s.is_won ? 'won' : s.is_lost ? 'lost' : '';
          // Oldest-in-stage first: what has been sitting longest needs the call.
          const items = openHere
            .filter((o) => o.stage_id === s.id)
            .sort((a, b) => +new Date(a.stage_entered_at || a.created_at || 0) - +new Date(b.stage_entered_at || b.created_at || 0));
          const stale = items.filter((o) => o.stage_entered_at && (Date.now() - +new Date(o.stage_entered_at)) / 864e5 >= STALE_DAYS).length;
          const dot = s.is_won ? 'var(--green)' : s.is_lost ? 'var(--red)' : s.position === 1 ? 'var(--blue)' : s.position === 2 ? 'var(--amber)' : 'var(--violet)';
          // A closing column never holds cards, so its header carries the running
          // count from ph_pipeline_outcomes instead of a deal tally that is
          // always zero.
          const meta = closer
            ? `${closer === 'won' ? (out.won_count ?? 0) : (out.lost_count ?? 0)} in last ${OUTCOME_DAYS} days`
            : `${items.length} deal${items.length === 1 ? '' : 's'}${stale ? ` · <span style="color:var(--amber);font-weight:700">${stale} aging</span>` : ''}`;
          const empty = closer
            ? `<div class="kcol-empty">Drop a deal here to mark it ${closer}. It comes off the board and lands in your numbers.</div>`
            : '<div class="kcol-empty">Drop a deal here</div>';
          return `<div class="kcol${closer ? ' is-closer' : ''}">
            <div class="kcol-h"><div class="t"><span class="status-dot" style="width:8px;height:8px;border-radius:50%;background:${dot}"></span>${esc(s.name)}</div>
              <div class="meta">${meta}</div></div>
            <div class="kcol-b" data-stage="${s.id}"${closer ? ` data-closer="${closer}"` : ''}>${items.map(oppCard).join('') || empty}</div>
          </div>`;
        }).join('')}</div>`;
      $('#pipe-line', v).addEventListener('change', (e) => { pipeLineKey = e.target.value; renderPipeline(v); });
      $('#pipe-del', v)?.addEventListener('click', () => deletePipeline(pipe, total, v));
      wirePipe(v);
    }

    // Retiring a line. Open cards on it are dropped — open work on a pipeline
    // nobody writes any more is noise. Won and lost cards are detached instead
    // of deleted, so the dashboard numbers for closed business do not move
    // retroactively when a line is retired.
    async function deletePipeline(pipe, openCount, v) {
      const tail = openCount
        ? `\n\n${openCount} open deal${openCount === 1 ? '' : 's'} on it will be removed. Deals already marked won or lost stay in your dashboard numbers.`
        : '\n\nDeals already marked won or lost stay in your dashboard numbers.';
      if (!confirm(`Delete the ${pipe.name} pipeline and its stages?${tail}`)) return;
      const { error } = await sb.rpc('ph_pipeline_delete', { p_id: pipe.id });
      if (error) { toast(error.message?.includes('not authorised') ? 'Only an admin can delete a pipeline.' : 'Could not delete that pipeline.'); return; }
      const [pipeRes, pstgRes] = await Promise.all([
        sb.from('ph_pipelines').select('*').eq('is_active', true).order('position'),
        sb.from('ph_pipeline_stages').select('*').order('position'),
      ]);
      state.pipelines = pipeRes.data ?? [];
      state.pipelineStages = pstgRes.data ?? [];
      pipeLineKey = null;
      await reloadOpps();
      loadDash().catch(() => {});
      toast(`${pipe.name} pipeline deleted`);
      if (currentRoute === 'pipeline') renderPipeline($('#view'));
    }

    // Won / Lost from a card or a drop. Goes through ph_opportunity_close so the
    // close is stamped (closed_at / closed_by) and a win also sets the contact to
    // Active Client — a plain status update would move the card but leave the
    // client record saying Lead.
    async function closeOpp(id, outcome, v) {
      const o = state.opps.find((x) => x.id === id);
      const c = o ? (state.oppContacts || {})[o.contact_id] || {} : {};
      const who = [c.first_name, c.last_name].filter(Boolean).join(' ') || o?.title || 'this deal';
      const ask = outcome === 'won'
        ? `Mark ${who} as WON? The card comes off the board, the win counts on your dashboard, and the contact is set to Active Client.`
        : `Mark ${who} as LOST? The card comes off the board and the loss counts on your dashboard.`;
      if (!confirm(ask)) return;
      const prev = o ? o.status : null;
      if (o) o.status = outcome;                      // card leaves the board now
      if (v && currentRoute === 'pipeline') renderPipeline(v);
      const { error } = await sb.rpc('ph_opportunity_close', { p_id: id, p_outcome: outcome });
      if (error) {
        if (o) o.status = prev;
        if (v && currentRoute === 'pipeline') renderPipeline(v);
        toast('Could not close that deal.');
        return;
      }
      toast(outcome === 'won' ? 'Marked won — counted on your dashboard' : 'Marked lost — counted on your dashboard');
      // Refresh the outcome tiles so the number on the board moves with the card.
      await loadDash().catch(() => {});
      if (v && currentRoute === 'pipeline') renderPipeline(v);
    }
    // "3d in stage" / "today" — how long this deal has sat where it is.
    function inStage(ts) {
      if (!ts) return '';
      const days = Math.floor((Date.now() - +new Date(ts)) / 864e5);
      if (days <= 0) return 'today';
      if (days === 1) return '1 day';
      if (days < 30) return days + ' days';
      const mo = Math.floor(days / 30);
      return mo + (mo === 1 ? ' month' : ' months');
    }
    const STALE_DAYS = 14;   // amber flag past this, so nothing quietly rots

    const oppCard = (o) => {
      const c = (state.oppContacts || {})[o.contact_id] || {};
      const name = [c.first_name, c.last_name].filter(Boolean).join(' ') || o.title || 'Untitled';
      const how = (c.source && String(c.source).trim())
        || ({ landing: 'Landing Page', crm: 'Added by broker', lead: 'Website form' }[c.origin] || '');
      const tags = Array.isArray(c.tags) ? c.tags.filter(Boolean).slice(0, 3) : [];
      const extraTags = Array.isArray(c.tags) ? Math.max(0, c.tags.length - 3) : 0;
      const days = o.stage_entered_at ? Math.floor((Date.now() - +new Date(o.stage_entered_at)) / 864e5) : 0;
      const stale = days >= STALE_DAYS;
      return `<div class="kcard" draggable="true" data-opp="${o.id}" data-contact="${esc(o.contact_id)}">
      <div class="k-top">
        <span class="avatar-sm" style="background:${avColor(name)}">${initials(name)}</span>
        <div style="min-width:0">
          <div class="nm">${esc(name)}</div>
          ${c.email || c.phone ? `<div class="k-sub">${esc(c.email || c.phone)}</div>` : ''}
        </div>
      </div>
      <div class="k-chips">
        <span class="chip k-line">${esc(pipeName(o.line_key))}</span>
        ${how ? `<span class="chip k-src" title="How they came in">${esc(how)}</span>` : ''}
        ${tags.map((t) => `<span class="chip tag">${esc(t)}</span>`).join('')}
        ${extraTags ? `<span class="chip">+${extraTags}</span>` : ''}
      </div>
      <div class="k-foot">
        <span class="k-time${stale ? ' is-stale' : ''}" title="Time in this stage">${stale ? '⚠ ' : ''}${esc(inStage(o.stage_entered_at))} in stage</span>
        <span class="k-added" title="Date added">${esc(fmtDate(c.ghl_date_added || o.created_at))}</span>
      </div>
      ${o.value ? `<div class="k-val">$${Number(o.value).toLocaleString()}</div>` : ''}
      <div class="k-act">
        <button class="k-btn is-won" data-close="won" data-id="${o.id}" title="Mark this deal won">✓ Won</button>
        <button class="k-btn is-lost" data-close="lost" data-id="${o.id}" title="Mark this deal lost">✕ Lost</button>
      </div>
    </div>`;
    };
    function wirePipe(v) {
      let dragId = null, didDrag = false;
      // Won / Lost sit inside the card, and the card opens the contact record —
      // so these have to swallow the click or closing a deal would navigate away
      // underneath the confirm.
      $$('[data-close]', v).forEach((b) => b.addEventListener('click', (e) => {
        e.stopPropagation();
        closeOpp(b.dataset.id, b.dataset.close, v);
      }));
      $$('.kcard', v).forEach((c) => {
        c.addEventListener('dragstart', () => { dragId = c.dataset.opp; didDrag = true; c.classList.add('dragging'); });
        c.addEventListener('dragend', () => { dragId = null; c.classList.remove('dragging'); setTimeout(() => { didDrag = false; }, 0); });
        c.addEventListener('click', () => { if (!didDrag) openContact(c.dataset.contact); });
      });
      $$('.kcol-b', v).forEach((col) => {
        col.addEventListener('dragover', (e) => { e.preventDefault(); col.classList.add('dropover'); });
        col.addEventListener('dragleave', () => col.classList.remove('dropover'));
        col.addEventListener('drop', async (e) => {
          e.preventDefault(); col.classList.remove('dropover');
          if (!dragId) return;
          const stageId = col.dataset.stage;
          const o = state.opps.find((x) => x.id === dragId);
          if (!o || o.stage_id === stageId) return;
          // Dropping on the Won or Lost column is the same act as pressing the
          // button on the card: it closes the deal rather than parking it in a
          // column, so it goes through the same RPC.
          if (col.dataset.closer) { const id = dragId; dragId = null; closeOpp(id, col.dataset.closer, v); return; }
          const stage = state.pipelineStages.find((s) => s.id === stageId);
          const prev = o.stage_id, prevStatus = o.status, prevEntered = o.stage_entered_at;
          o.stage_id = stageId;
          o.status = stage?.is_won ? 'won' : stage?.is_lost ? 'lost' : 'open';
          // The DB trigger stamps this server-side; mirror it locally so the
          // card's "in stage" resets the instant it lands.
          o.stage_entered_at = new Date().toISOString();
          renderPipeline(v);
          const { error } = await sb.from('ph_opportunities')
            .update({ stage_id: stageId, status: o.status, updated_at: new Date().toISOString() })
            .eq('id', dragId);
          if (error) { o.stage_id = prev; o.status = prevStatus; o.stage_entered_at = prevEntered; renderPipeline(v); toast('Could not move that deal.'); }
          else { toast('Moved to ' + (stage ? stage.name : 'stage')); }
        });
      });
    }

    // ================= AVAILABILITY (broker sets their booking hours) =========
    // Writes ph_agent_scheduling, which ph-book reads live — so saving here
    // changes the slots on this broker's /book and /broker pages immediately,
    // no site rebuild needed. Weekday keys match ph-book: Sun=0 … Sat=6.
    function renderAvailability(v) {
      const s = state.mySched || {};
      const slot = s.slot_minutes || 30, advance = s.advance_days || 21, notice = s.min_notice_hours ?? 12;
      const avail = s.availability || { '1': [['09:00', '17:00']], '2': [['09:00', '17:00']], '3': [['09:00', '17:00']], '4': [['09:00', '17:00']], '5': [['09:00', '17:00']] };
      const DAYS = [['1', 'Monday'], ['2', 'Tuesday'], ['3', 'Wednesday'], ['4', 'Thursday'], ['5', 'Friday'], ['6', 'Saturday'], ['0', 'Sunday']];
      const dayRow = (num, label) => {
        const w = (avail[num] && avail[num][0]) || null;
        const on = !!w, start = w ? w[0] : '09:00', end = w ? w[1] : '17:00';
        return `<div class="av-day">
          <label class="av-toggle"><input type="checkbox" data-day="${num}" ${on ? 'checked' : ''}><span>${label}</span></label>
          <div class="av-times">
            <input type="time" data-start="${num}" value="${start}" ${on ? '' : 'disabled'}>
            <span class="av-to">to</span>
            <input type="time" data-end="${num}" value="${end}" ${on ? '' : 'disabled'}>
          </div>
        </div>`;
      };
      const slotOpts = [15, 20, 30, 45, 60].map((m) => `<option value="${m}" ${m === slot ? 'selected' : ''}>${m} minutes</option>`).join('');
      const slug = brokerSlug(state.me.full_name || '');
      v.innerHTML = `
        <div class="view-grid" style="max-width:780px">
          <div class="card">
            <div class="card-h"><span class="grad-label">Hours</span><h3 style="margin-left:8px">When can people book you?</h3></div>
            <div class="card-b"><div class="av-days">${DAYS.map(([n, l]) => dayRow(n, l)).join('')}</div>
              <p class="cell-sub" style="margin-top:12px">Turn a day off to remove it from your calendar entirely. Times are Las Vegas time.</p>
            </div>
          </div>
          <div class="card">
            <div class="card-h"><span class="grad-label">Rules</span><h3 style="margin-left:8px">Booking settings</h3></div>
            <div class="card-b av-rules">
              <label class="av-field"><span>Appointment length</span><select id="av-slot">${slotOpts}</select></label>
              <label class="av-field"><span>Let people book up to</span><div class="av-inline"><input type="number" id="av-advance" min="1" max="90" value="${advance}"><em>days ahead</em></div></label>
              <label class="av-field"><span>Minimum notice</span><div class="av-inline"><input type="number" id="av-notice" min="0" max="168" value="${notice}"><em>hours before</em></div></label>
              <label class="av-field"><span>Time zone</span><input type="text" value="Las Vegas (Pacific)" disabled></label>
            </div>
          </div>
          <div class="av-actions">
            <button class="btn" id="av-save">Save availability</button>
            <span class="av-status" id="av-status"></span>
            <a class="av-preview" href="/book/${slug}" target="_blank" rel="noopener">Preview my booking page →</a>
          </div>
          <div class="card">
            <div class="card-h"><span class="grad-label">Google Calendar</span><h3 style="margin-left:8px">Link your Google Calendar</h3>
              <button type="button" class="btn btn-ghost btn-sm" id="gcal-how" style="margin-left:auto">How does this work?</button></div>
            <div class="card-b" id="gcal-panel"><div class="cell-sub">Checking…</div></div>
          </div>
        </div>`;
      $('#gcal-how', v)?.addEventListener('click', openGcalHelp);
      loadGcalPanel();
      $$('[data-day]', v).forEach((cb) => cb.addEventListener('change', () => {
        const n = cb.getAttribute('data-day');
        $(`[data-start="${n}"]`, v).disabled = !cb.checked;
        $(`[data-end="${n}"]`, v).disabled = !cb.checked;
      }));
      $('#av-save', v).addEventListener('click', async () => {
        const btn = $('#av-save', v), st = $('#av-status', v);
        const availability = {};
        $$('[data-day]', v).forEach((cb) => {
          if (!cb.checked) return;
          const n = cb.getAttribute('data-day');
          const start = $(`[data-start="${n}"]`, v).value || '09:00';
          const end = $(`[data-end="${n}"]`, v).value || '17:00';
          if (start < end) availability[n] = [[start, end]];
        });
        const patch = {
          agent_id: state.me.id, timezone: 'America/Los_Angeles',
          slot_minutes: parseInt($('#av-slot', v).value, 10) || 30,
          advance_days: Math.max(1, Math.min(90, parseInt($('#av-advance', v).value, 10) || 21)),
          min_notice_hours: Math.max(0, Math.min(168, parseInt($('#av-notice', v).value, 10) || 12)),
          availability, updated_at: new Date().toISOString(),
        };
        btn.disabled = true; st.textContent = 'Saving…'; st.style.color = '';
        const { error } = await sb.from('ph_agent_scheduling').upsert(patch, { onConflict: 'agent_id' });
        btn.disabled = false;
        if (error) { st.textContent = 'Could not save: ' + error.message; st.style.color = '#c0392b'; return; }
        state.mySched = patch;
        st.textContent = 'Saved — your booking page is updated.'; st.style.color = '#0ea472';
        toast('Availability saved');
      });
    }

    // ---- Google Calendar how-to popup ----
    // Same content as /help/google-calendar (shared from src/lib/gcal-help.ts),
    // shown inline so a broker never loses their place mid-setup.
    function openGcalHelp() {
      const m = $('#gc-help'); if (!m) return;
      m.hidden = false; document.body.style.overflow = 'hidden';
      m.querySelector('.gc-modal-b').scrollTop = 0;
    }
    function closeGcalHelp() {
      const m = $('#gc-help'); if (!m) return;
      m.hidden = true; document.body.style.overflow = '';
    }
    $('#gc-help')?.addEventListener('click', (e) => {
      if (e.target.closest('[data-gc-close]') || e.target.id === 'gc-help') closeGcalHelp();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGcalHelp(); });

    // ---- Google Calendar link (per-agent OAuth via ph-gcal) ----
    async function gcalCall(body) {
      const { data: sess } = await sb.auth.getSession();
      const token = sess?.session?.access_token;
      const r = await fetch(`${root.getAttribute('data-supabase-url')}/functions/v1/ph-gcal`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: root.getAttribute('data-supabase-anon'), Authorization: 'Bearer ' + token },
        body: JSON.stringify(body),
      });
      return await r.json().catch(() => ({}));
    }
    async function loadGcalPanel() {
      const host = $('#gcal-panel'); if (!host) return;
      const st = await gcalCall({ action: 'status' });
      if (!st || st.error) { host.innerHTML = `<div class="cell-sub">${esc(st?.error || 'Could not check Google connection.')}</div>`; return; }
      if (!st.connected) {
        host.innerHTML = `
          <p class="cell-sub" style="margin:0 0 12px">Connect your Google Calendar and two things happen: your Gmail appointments show on your calendar here, and booked times on your Google calendar are automatically blocked on your booking page so nobody can double-book you.</p>
          <button class="btn btn-primary" id="gcal-connect">Connect Google Calendar</button>
          <button type="button" class="btn btn-ghost" id="gcal-how2" style="margin-left:8px">Show me how →</button>
          <div class="cell-sub" id="gcal-msg" style="margin-top:8px"></div>`;
        $('#gcal-how2')?.addEventListener('click', openGcalHelp);
        $('#gcal-connect').addEventListener('click', async () => {
          const b = $('#gcal-connect'); b.disabled = true;
          const r = await gcalCall({ action: 'start' });
          if (r?.url) { location.href = r.url; return; }
          b.disabled = false; $('#gcal-msg').textContent = r?.error || 'Could not start the Google connection.';
        });
        return;
      }
      const cals = st.calendars || [];
      const sel = new Set(st.selected || []);
      host.innerHTML = `
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span class="chip" style="background:#e7f6ee;color:#15803d">Connected</span>
          <b>${esc(st.email || 'Google account')}</b>
          <button class="btn btn-ghost btn-sm" id="gcal-disconnect" style="margin-left:auto">Disconnect</button>
        </div>
        ${st.error ? `<div class="cell-sub" style="color:#b45309;margin-top:8px">${esc(st.error)}</div>` : ''}
        <div class="section-t" style="margin-top:14px">Calendars that block your booking slots</div>
        <div id="gcal-cals">${cals.map((c) => `<label class="pickbox"><input type="checkbox" data-gcal="${esc(c.id)}" ${sel.has(c.id) ? 'checked' : ''}/> ${esc(c.name)}${c.primary ? ' <span class="cell-sub">(main)</span>' : ''}</label>`).join('') || '<div class="cell-sub">No calendars found.</div>'}</div>
        <button class="btn btn-sm" id="gcal-save" style="margin-top:10px">Save calendar selection</button>
        <span class="cell-sub" id="gcal-msg" style="margin-left:8px"></span>`;
      $('#gcal-save').addEventListener('click', async () => {
        const ids = $$('#gcal-cals [data-gcal]').filter((c) => c.checked).map((c) => c.getAttribute('data-gcal'));
        const msg = $('#gcal-msg');
        if (!ids.length) { msg.textContent = 'Pick at least one calendar.'; return; }
        msg.textContent = 'Saving…';
        const r = await gcalCall({ action: 'select', calendars: ids });
        msg.textContent = r?.ok ? 'Saved.' : (r?.error || 'Could not save.');
        if (r?.ok) { state.gcalEvents = null; toast('Google calendars updated'); }
      });
      $('#gcal-disconnect').addEventListener('click', async () => {
        if (!confirm('Disconnect your Google Calendar? Your Gmail events will stop showing here and will no longer block booking slots.')) return;
        await gcalCall({ action: 'disconnect' });
        state.gcalEvents = null;
        toast('Google Calendar disconnected');
        loadGcalPanel();
      });
    }

    // ================= CALENDAR (month grid from appointments) =================
    let calMonth = null;
    function renderCalendar(v) {
      if (!calMonth) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
      const y = calMonth.getFullYear(), m = calMonth.getMonth();
      const first = new Date(y, m, 1), start = new Date(first); start.setDate(1 - ((first.getDay() + 6) % 7)); // Mon-first
      const appts = apptEvents();
      // Google events ride alongside; fetched once per visit and cached until
      // the tab is re-entered or the selection changes.
      if (state.gcalEvents === null || state.gcalEvents === undefined) {
        state.gcalEvents = [];
        gcalCall({ action: 'events', days: 60 }).then((r) => {
          if (r?.connected && Array.isArray(r.events)) {
            state.gcalEvents = r.events.map((e) => ({ id: 'g:' + e.start, when: e.start, name: e.title, gcal: true, all_day: e.all_day }));
            if (currentRoute === 'calendar') renderCalendar($('#view'));
          }
        }).catch(() => {});
      }
      const all = appts.concat(state.gcalEvents || []);
      const byDay = {};
      all.forEach((e) => { const d = new Date(e.when); const k = d.toLocaleDateString('en-CA', { timeZone: TZ }); (byDay[k] ||= []).push(e); });
      const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: TZ });
      const title = calMonth.toLocaleString('en-US', { month: 'long', year: 'numeric' });
      const dows = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
      let cells = '';
      for (let i = 0; i < 42; i++) {
        const d = new Date(start); d.setDate(start.getDate() + i);
        const k = d.toLocaleDateString('en-CA');
        const dim = d.getMonth() !== m ? 'dim' : '';
        const today = k === todayKey ? 'today' : '';
        const evs = (byDay[k] || []).slice(0, 3).map((e) => {
          if (e.gcal) return `<div class="cal-ev cal-ev-gcal" title="From your Google Calendar">${e.all_day ? '' : new Date(e.when).toLocaleTimeString('en-US',{timeZone:TZ,hour:'numeric',minute:'2-digit'}) + ' '}${esc(e.name)}</div>`;
          return `<div class="cal-ev${e.native ? ' cal-ev-native' : ''}"${e.native ? '' : ` data-lead="${e.id}"`}>${new Date(e.when).toLocaleTimeString('en-US',{timeZone:TZ,hour:'numeric',minute:'2-digit'})} ${esc(e.name)}</div>`;
        }).join('');
        const more = (byDay[k] || []).length > 3 ? `<div class="cell-sub" style="margin-top:2px">+${byDay[k].length - 3} more</div>` : '';
        cells += `<div class="cal-cell ${dim} ${today}"><div class="dnum">${d.getDate()}</div>${evs}${more}</div>`;
      }
      v.innerHTML = `
        <div class="cal-head">
          <button class="btn btn-ghost btn-sm" data-mo="-1">←</button>
          <div class="cal-title">${title}</div>
          <button class="btn btn-ghost btn-sm" data-mo="1">→</button>
          <button class="btn btn-ghost btn-sm" data-mo="0">Today</button>
          <span style="margin-left:auto;font-size:.8rem;color:var(--muted)">${appts.length} appointment${appts.length===1?'':'s'} on your calendar</span>
        </div>
        <div class="card" style="padding:0">
          <div class="cal-grid">${dows.map((d) => `<div class="cal-dow">${d}</div>`).join('')}${cells}</div>
        </div>`;
      $$('[data-mo]', v).forEach((b) => b.addEventListener('click', () => {
        const d = +b.dataset.mo;
        if (d === 0) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
        else calMonth = new Date(y, m + d, 1);
        renderCalendar(v);
      }));
      $$('.cal-ev[data-lead]', v).forEach((e) => e.addEventListener('click', () => openLead(e.dataset.lead)));
    }

    // ================= DRAWERS =================
    function openDrawer(html) { $('#drawer').innerHTML = html; $('#drawer').classList.add('on'); $('#overlay').classList.add('on'); }
    function closeDrawer() { $('#drawer').classList.remove('on'); $('#overlay').classList.remove('on'); }
    $('#overlay').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

    async function openLead(id) {
      const l = state.leads.find((x) => x.id === id); if (!l) return;
      const { data: emails } = await sb.from('ph_emails').select('*').eq('lead_id', id).order('scheduled_for');
      const answers = [['Role', l.role], ['Structure', l.structure], ['Coverage', l.coverage], ['Priority', l.priority]].filter((r) => r[1]);
      openDrawer(`
        <div class="drawer-h">
          <span class="avatar-sm" style="width:44px;height:44px;font-size:.95rem;background:${avColor(nameOf(l))}">${initials(nameOf(l))}</span>
          <div><div style="font-size:1.15rem;font-weight:800">${esc(nameOf(l))}</div><div class="cell-sub">${esc(l.email || '')} ${l.phone ? '· ' + esc(fmtPhone(l.phone)) : ''}</div><div style="margin-top:6px">${stagePill(l)}</div></div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">
          <div class="kv">
            <div class="k">Type</div><div class="v">${esc(l.kind || 'form')}</div>
            <div class="k">Source</div><div class="v">${esc(l.source_form || l.page || 'web')}</div>
            <div class="k">Added</div><div class="v">${esc(fmtFull(l.created_at))}</div>
            ${l.appointment_start ? `<div class="k">Appointment</div><div class="v">${esc(fmtFull(l.appointment_start))}</div>` : ''}
          </div>
          ${answers.length ? `<div class="section-t">Intake answers</div><div class="kv">${answers.map((a) => `<div class="k">${esc(a[0])}</div><div class="v">${esc(a[1])}</div>`).join('')}</div>` : ''}
          ${l.notes ? `<div class="section-t">Notes</div><div style="font-size:.86rem;line-height:1.6;white-space:pre-wrap">${esc(l.notes)}</div>` : ''}
          <div class="section-t">Emails to this lead</div>
          ${(emails && emails.length) ? emails.map((e) => `<div class="feed-item"><div class="feed-ic">✉️</div><div><div style="font-weight:650">${esc(e.subject || e.kind)}</div><div class="cell-sub">${esc(e.status)} · ${esc(fmtDateTime(e.sent_at || e.scheduled_for))}</div></div></div>`).join('') : '<div class="cell-sub">None yet.</div>'}
          <div class="section-t">Move stage</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">${state.stages.map((s) => `<button class="btn ${s.id===l.stage_id?'btn-primary':'btn-ghost'} btn-sm" data-setstage="${s.id}">${esc(s.label)}</button>`).join('')}</div>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      const paintStageControls = () => {
        // Update the pill and the button row in place — do NOT reopen the drawer,
        // which would leave the overlay covering the page.
        const pillHost = $('#drawer .drawer-h > div > div:last-child');
        if (pillHost) pillHost.innerHTML = stagePill(l);
        $$('#drawer [data-setstage]').forEach((btn) => {
          const on = btn.dataset.setstage === l.stage_id;
          btn.classList.toggle('btn-primary', on);
          btn.classList.toggle('btn-ghost', !on);
        });
      };
      $$('[data-setstage]').forEach((b) => b.addEventListener('click', async () => {
        const stageId = b.dataset.setstage; if (stageId === l.stage_id) return;
        const prev = l.stage_id; l.stage_id = stageId; paintStageControls();
        const { error } = await sb.from('ph_leads').update({ stage_id: stageId }).eq('id', id);
        if (error) { l.stage_id = prev; paintStageControls(); toast('Could not update stage.'); }
        else { toast('Stage updated'); if (currentRoute === 'pipeline') go('pipeline'); }
      }));
    }

    // Contact record: full three-column view per Rob's layout —
    // LEFT client data · MIDDLE activity · RIGHT notes + appointments.
    async function openContact(cid, cached) {
      let c = (cached || []).find((x) => x.ghl_contact_id === cid);
      if (!c) { const { data } = await mine(sb.from('ph_contacts').select('*')).eq('ghl_contact_id', cid).is('deleted_at', null).maybeSingle(); c = data; }
      if (!c) return;
      currentRoute = 'contact-record';
      $('#page-title').textContent = nameOf(c);
      $('#page-sub').textContent = 'Client record';
      $$('.nav-item[data-route]').forEach((n) => n.classList.toggle('active', n.dataset.route === 'contacts'));
      const v = $('#view'); v.scrollTop = 0;

      // Pull the carriers linked to this client (RLS-scoped) + their policies.
      const [{ data: links }, { data: policies }] = await Promise.all([
        sb.from('ph_contact_carriers').select('carrier_id').eq('contact_id', cid),
        mine(sb.from('ph_policies').select('*')).eq('contact_id', cid).order('created_at', { ascending: false }),
      ]);
      const linkedIds = new Set((links || []).map((r) => r.carrier_id));
      const carrierNames = state.carriers.filter((x) => linkedIds.has(x.id)).map((x) => x.name);
      const deps = Array.isArray(c.dependents) ? c.dependents : [];
      const dob = c.date_of_birth ? new Date(c.date_of_birth).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' }) : '';
      const dispSel = DISPOSITIONS.map((d) => `<option ${d === c.disposition ? 'selected' : ''}>${esc(d)}</option>`).join('');
      const linkedCo = c.company_id ? state.companies.find((x) => x.id === c.company_id) : null;
      const custom = c.custom || {};
      const polStatusClass = (s) => ({ Active: 'st-green', Issued: 'st-green', Pending: 'st-amber', Applied: 'st-amber', Quoted: 'st-blue', Lapsed: 'st-red', Cancelled: 'st-red', Declined: 'st-red' }[s] || 'st-gray');
      const policyRow = (p) => `
        <div class="pol-row" data-pol="${p.id}">
          <div class="pol-top"><b>${esc(p.line)}</b><span class="pill-status ${polStatusClass(p.status)}">${esc(p.status)}</span></div>
          <div class="cell-sub">${esc([p.carrier_name, p.policy_number ? '#' + p.policy_number : ''].filter(Boolean).join(' · ') || 'No carrier yet')}</div>
          ${p.premium != null ? `<div class="pol-prem">${fmtMoney(p.premium)} <em>/ ${esc((p.premium_freq || 'Monthly').toLowerCase())}</em></div>` : ''}
          ${p.renewal_date ? `<div class="cell-sub">Renews ${esc(new Date(p.renewal_date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' }))}</div>` : ''}
        </div>`;
      const customFieldRow = (f) => {
        const val = custom[f.key] ?? '';
        if (f.field_type === 'select') {
          const opts = ['<option value=""></option>'].concat((f.options || []).map((o) => `<option ${o === val ? 'selected' : ''}>${esc(o)}</option>`)).join('');
          return `<div class="k">${esc(f.label)}</div><div class="v"><select class="cf-inline" data-cf="${esc(f.key)}">${opts}</select></div>`;
        }
        const type = f.field_type === 'number' ? 'number' : f.field_type === 'date' ? 'date' : 'text';
        return `<div class="k">${esc(f.label)}</div><div class="v"><input class="cf-inline" type="${type}" data-cf="${esc(f.key)}" value="${esc(val)}"/></div>`;
      };

      v.innerHTML = `
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
        <button class="btn btn-ghost btn-sm" id="rec-back">← Contacts</button>
        <span class="avatar-sm" style="width:40px;height:40px;font-size:.9rem;background:${avColor(nameOf(c))}">${initials(nameOf(c))}</span>
        <div><div class="rec-hd-name" style="font-size:1.2rem;font-weight:800">${esc(nameOf(c))}</div><div class="cell-sub rec-hd-sub">${esc(c.email || '')} ${c.phone ? '· ' + esc(fmtPhone(c.phone)) : ''}</div></div>
        <span class="pill-status ${dispClass(c.disposition)}" id="rec-disp-pill" style="margin-left:8px">${esc(c.disposition || 'No disposition')}</span>
        <button class="btn btn-danger btn-sm" id="rec-delete" style="margin-left:auto">Delete contact</button>
      </div>
      <div class="rec-grid">
        <div class="card"><div class="card-h"><span class="grad-label">Client data</span></div><div class="card-b">
          <div class="kv">
            <div class="k">First name</div><div class="v"><input class="cf-inline" data-fld="first_name" value="${esc(c.first_name || '')}" placeholder="—"/></div>
            <div class="k">Last name</div><div class="v"><input class="cf-inline" data-fld="last_name" value="${esc(c.last_name || '')}" placeholder="—"/></div>
            <div class="k">Company</div><div class="v">${linkedCo ? `<a href="#" id="rec-company" style="color:var(--blue);font-weight:650;text-decoration:none">${esc(linkedCo.name)}</a>` : `<input class="cf-inline" data-fld="company" value="${esc(c.company || '')}" placeholder="—"/>`}</div>
            <div class="k">Role / title</div><div class="v"><input class="cf-inline" data-fld="job_title" value="${esc(c.job_title || '')}" placeholder="—"/></div>
            <div class="k">Date of birth</div><div class="v"><input class="cf-inline" type="date" data-fld="date_of_birth" value="${esc(c.date_of_birth || '')}"/></div>
            <div class="k">Email</div><div class="v"><input class="cf-inline" type="email" data-fld="email" value="${esc(c.email || '')}" placeholder="—"/></div>
            <div class="k">Phone</div><div class="v"><input class="cf-inline" type="tel" data-fld="phone" value="${esc(c.phone || '')}" placeholder="—"/></div>
            <div class="k">Street</div><div class="v"><input class="cf-inline" data-fld="street_address" value="${esc(c.street_address || '')}" placeholder="—"/></div>
            <div class="k">City</div><div class="v"><input class="cf-inline" data-fld="city" value="${esc(c.city || '')}" placeholder="—"/></div>
            <div class="k">State</div><div class="v"><input class="cf-inline" data-fld="state" value="${esc(c.state || '')}" placeholder="—"/></div>
            <div class="k">ZIP</div><div class="v"><input class="cf-inline" data-fld="postal_code" value="${esc(c.postal_code || '')}" placeholder="—"/></div>
            <div class="k">How we met</div><div class="v"><input class="cf-inline" data-fld="source" id="rec-source" value="${esc(c.source || '')}" placeholder="Referral, website, event…"/></div>
            ${state.customFields.map(customFieldRow).join('')}
          </div>
          <div class="section-t">Disposition</div>
          <select id="rec-disp" class="rec-select">${dispSel}</select>
          <div class="hint" id="rec-disp-hint">Active Client marks the client in-force (issued) and records you as the writing agent.</div>
          <div class="section-t">Policies <button class="btn btn-ghost btn-sm" id="rec-add-policy" style="margin-left:auto">+ Add</button></div>
          <div id="rec-policies">${(policies && policies.length) ? policies.map(policyRow).join('') : '<span class="cell-sub">None yet — add what you quote or write for this client.</span>'}</div>
          <div class="section-t">Lines of insurance <button class="btn btn-ghost btn-sm" id="rec-edit-lines" style="margin-left:auto">Edit</button></div>
          <div id="rec-lines">${(c.coverage_types || []).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None — add one to put this client in a pipeline</span>'}</div>
          <div class="section-t">Carriers <button class="btn btn-ghost btn-sm" id="rec-edit-carriers" style="margin-left:auto">Edit</button></div>
          <div id="rec-carriers">${carrierNames.map((n) => `<span class="chip">${esc(n)}</span>`).join(' ') || '<span class="cell-sub">None selected</span>'}</div>
          ${deps.length ? `<div class="section-t">Dependents</div>${deps.map((d) => `<div class="feed-item"><div class="feed-ic">👤</div><div><div style="font-weight:650">${esc([d.first_name, d.last_name].filter(Boolean).join(' ') || d.relation)}</div><div class="cell-sub">${esc(d.relation)}${d.dob ? ' · ' + esc(d.dob) : ''}</div></div></div>`).join('')}` : ''}
          <div class="section-t">Tags <button class="btn btn-ghost btn-sm" id="rec-edit-tags" style="margin-left:auto">Edit</button></div>
          <div id="rec-tags">${(c.tags || []).map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None</span>'}</div>
        </div></div>

        <div class="card"><div class="card-h"><span class="grad-label">Activity</span></div><div class="card-b" id="rec-activity">
          <div class="cell-sub">Loading…</div>
        </div></div>

        <div class="card"><div class="card-h"><span class="grad-label">Emails</span></div><div class="card-b" id="rec-emails">
          <div class="cell-sub">Loading…</div>
        </div></div>

        <div class="card"><div class="card-h"><span class="grad-label">Notes & appointments</span><button class="btn btn-ghost btn-sm" id="rec-book" style="margin-left:auto">+ Book appointment</button></div><div class="card-b">
          <div id="rec-appts"><div class="cell-sub">Loading…</div></div>
          <div class="section-t">Notes</div>
          <textarea id="rec-note" class="rec-select" rows="3" placeholder="Add a note…"></textarea>
          <button class="btn btn-primary btn-sm" id="rec-note-save" style="margin-top:8px">Save note</button>
          <div id="rec-notes" style="margin-top:12px"></div>
        </div></div>
      </div>`;

      $('#rec-back').addEventListener('click', () => go('contacts'));
      $('#rec-book')?.addEventListener('click', () => openBookAppt(cid, c));
      $('#rec-delete')?.addEventListener('click', async () => {
        // confirm() renders plain text, so the name goes in unescaped.
        const gone = await deleteContacts([cid], null, { label: nameOf(c) });
        if (gone) go('contacts');
      });

      // disposition change → writes ph_contacts.disposition; DB trigger handles in-force.
      $('#rec-disp').addEventListener('change', async (e) => {
        const val = e.target.value; const prev = c.disposition;
        const { error } = await sb.from('ph_contacts').update({ disposition: val }).eq('ghl_contact_id', cid);
        if (error) { e.target.value = prev || ''; toast('Could not update disposition.'); return; }
        c.disposition = val;
        const pill = $('#rec-disp-pill'); pill.textContent = val; pill.className = 'pill-status ' + dispClass(val);
        toast(val === 'Active Client' ? 'Marked Active Client — client is now in-force' : 'Disposition updated');
      });

      $('#rec-edit-carriers').addEventListener('click', () => editContactCarriers(cid, linkedIds));
      $('#rec-edit-lines').addEventListener('click', () => editContactLines(cid, c));
      $('#rec-company')?.addEventListener('click', (e) => { e.preventDefault(); openCompany(c.company_id); });

      // Tags: broker picks from the admin-defined list; legacy imported tags
      // on the record are preserved untouched.
      $('#rec-edit-tags').addEventListener('click', () => {
        const adminNames = state.adminTags.map((t) => t.name);
        const cur = c.tags || [];
        openDrawer(`
          <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Tags</div><div class="cell-sub">${esc(nameOf(c))} — pick from the office list</div></div><button class="drawer-x" data-x>✕</button></div>
          <div class="drawer-b">
            <div style="display:flex;flex-wrap:wrap;gap:8px">${adminNames.map((t) => `<label class="pickbox"><input type="checkbox" data-tp="${esc(t)}" ${cur.some((x) => x.toLowerCase() === t.toLowerCase()) ? 'checked' : ''}/> ${esc(t)}</label>`).join('') || '<span class="cell-sub">No tags defined — ask an admin to add some under Manage fields.</span>'}</div>
            <button class="btn btn-primary" id="tp-save" style="margin-top:16px">Save tags</button>
            <p class="cell-sub" id="tp-status" style="margin-top:8px"></p>
          </div>`);
        $('[data-x]').addEventListener('click', closeDrawer);
        $('#tp-save').addEventListener('click', async () => {
          const lowerAdmin = adminNames.map((t) => t.toLowerCase());
          const legacy = cur.filter((t) => !lowerAdmin.includes(t.toLowerCase()));
          const picked = $$('[data-tp]').filter((x) => x.checked).map((x) => x.getAttribute('data-tp'));
          const next = legacy.concat(picked);
          const { error } = await sb.from('ph_contacts').update({ tags: next }).eq('ghl_contact_id', cid);
          if (error) { $('#tp-status').textContent = 'Could not save: ' + error.message; return; }
          c.tags = next;
          $('#rec-tags').innerHTML = next.map((t) => `<span class="chip tag">${esc(t)}</span>`).join(' ') || '<span class="cell-sub">None</span>';
          closeDrawer(); toast('Tags updated');
        });
      });

      // "How we met" + custom fields autosave on change/blur.
      const saveField = async (patch, okMsg) => {
        const { error } = await sb.from('ph_contacts').update(patch).eq('ghl_contact_id', cid);
        if (error) toast('Could not save.'); else if (okMsg) toast(okMsg);
        return !error;
      };
      // Client-data fields autosave on change. Six of these (first_name,
      // last_name, email, phone, date_of_birth, city, state, postal_code,
      // source) are also written by the GHL sync every five minutes, so the
      // ph_contacts_zz_keep_local_edits trigger claims a field the moment a
      // human touches it and refuses the sync's value from then on. Clearing a
      // field releases the claim, which is why '' is sent as null.
      $$('.cf-inline[data-fld]', v).forEach((inp) => {
        let t;
        inp.addEventListener('change', () => {
          clearTimeout(t);
          t = setTimeout(async () => {
            const key = inp.getAttribute('data-fld');
            const val = inp.value.trim() === '' ? null : inp.value.trim();
            if (!(await saveField({ [key]: val }))) return;
            c[key] = val;
            toast('Saved');
            // Keep the header in step so the record does not disagree with itself.
            const hdr = $('.rec-hd-name'), sub = $('.rec-hd-sub');
            if (hdr) hdr.textContent = nameOf(c);
            if (sub) sub.textContent = `${c.email || ''}${c.phone ? ' · ' + fmtPhone(c.phone) : ''}`;
          }, 200);
        });
      });
      $$('.cf-inline[data-cf]', v).forEach((inp) => inp.addEventListener('change', async () => {
        const key = inp.getAttribute('data-cf');
        const next = Object.assign({}, c.custom || {});
        if (inp.value === '' || inp.value == null) delete next[key]; else next[key] = inp.value;
        if (await saveField({ custom: next })) { c.custom = next; toast('Saved'); }
      }));

      // ---- Policies: add / edit drawer ----
      let recPolicies = policies || [];
      const repaintPolicies = () => {
        $('#rec-policies').innerHTML = recPolicies.length ? recPolicies.map(policyRow).join('') : '<span class="cell-sub">None yet — add what you quote or write for this client.</span>';
        $$('#rec-policies [data-pol]').forEach((el) => el.addEventListener('click', () => openPolicyForm(recPolicies.find((p) => p.id === el.dataset.pol))));
      };
      function openPolicyForm(pol) {
        const lineOpts = COVERAGE_TYPES.map((l) => `<option ${pol && pol.line === l ? 'selected' : ''}>${esc(l)}</option>`).join('');
        const carOpts = ['<option value=""></option>'].concat(state.carriers.map((x) => `<option value="${x.id}" ${pol && pol.carrier_id === x.id ? 'selected' : ''}>${esc(x.name)}</option>`)).join('');
        const stOpts = POLICY_STATUSES.map((s) => `<option ${pol && pol.status === s ? 'selected' : (!pol && s === 'Quoted' ? 'selected' : '')}>${esc(s)}</option>`).join('');
        const frOpts = PREMIUM_FREQS.map((f) => `<option ${pol && pol.premium_freq === f ? 'selected' : (!pol && f === 'Monthly' ? 'selected' : '')}>${esc(f)}</option>`).join('');
        openDrawer(`
          <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">${pol ? 'Edit policy' : 'Add policy'}</div><div class="cell-sub">${esc(nameOf(c))}</div></div><button class="drawer-x" data-x>✕</button></div>
          <div class="drawer-b"><form id="pol-form">
            <div class="grid2">
              <div class="field"><label>Line of insurance *</label><select name="line">${lineOpts}</select></div>
              <div class="field"><label>Status</label><select name="status">${stOpts}</select></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Carrier</label><select name="carrier_id">${carOpts}</select></div>
              <div class="field"><label>Policy #</label><input name="policy_number" value="${esc(pol?.policy_number || '')}"/></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Premium</label><input name="premium" type="number" step="0.01" min="0" placeholder="0.00" value="${esc(pol?.premium ?? '')}"/></div>
              <div class="field"><label>Frequency</label><select name="premium_freq">${frOpts}</select></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Effective date</label><input name="effective_date" type="date" value="${esc(pol?.effective_date || '')}"/></div>
              <div class="field"><label>Renewal date</label><input name="renewal_date" type="date" value="${esc(pol?.renewal_date || '')}"/></div>
            </div>
            <div class="field"><label>Notes</label><textarea name="notes" rows="2">${esc(pol?.notes || '')}</textarea></div>
            <div style="display:flex;gap:10px;align-items:center">
              <button class="btn btn-primary" type="submit">${pol ? 'Save policy' : 'Add policy'}</button>
              ${pol ? '<button class="btn btn-ghost btn-sm" type="button" id="pol-del">Delete</button>' : ''}
            </div>
            <p class="cell-sub" id="pol-status" style="margin-top:8px"></p>
          </form></div>`);
        $('[data-x]').addEventListener('click', closeDrawer);
        $('#pol-del')?.addEventListener('click', async () => {
          if (!confirm('Delete this policy?')) return;
          const { error } = await sb.from('ph_policies').delete().eq('id', pol.id);
          if (error) { $('#pol-status').textContent = 'Could not delete: ' + error.message; return; }
          recPolicies = recPolicies.filter((p) => p.id !== pol.id);
          repaintPolicies(); closeDrawer(); toast('Policy deleted');
        });
        $('#pol-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.target;
          const carId = f.carrier_id.value || null;
          const patch = {
            contact_id: cid, agent_id: pol ? pol.agent_id : (c.agent_id || state.me.id),
            line: f.line.value, status: f.status.value,
            carrier_id: carId, carrier_name: carId ? (state.carriers.find((x) => x.id === carId)?.name ?? null) : null,
            policy_number: f.policy_number.value.trim() || null,
            premium: f.premium.value !== '' ? parseFloat(f.premium.value) : null,
            premium_freq: f.premium_freq.value,
            effective_date: f.effective_date.value || null, renewal_date: f.renewal_date.value || null,
            notes: f.notes.value.trim() || null, updated_at: new Date().toISOString(),
          };
          const q = pol ? sb.from('ph_policies').update(patch).eq('id', pol.id).select('*').single()
                        : sb.from('ph_policies').insert(patch).select('*').single();
          const { data, error } = await q;
          if (error) { $('#pol-status').textContent = 'Could not save: ' + error.message; return; }
          if (pol) { const i = recPolicies.findIndex((p) => p.id === pol.id); if (i >= 0) recPolicies[i] = data; }
          else {
            recPolicies.unshift(data);
            // The DB trigger unions the line into coverage_types (which auto-creates
            // the pipeline deal) — mirror it locally so the card reflects it now.
            if (!(c.coverage_types || []).includes(data.line)) { c.coverage_types = (c.coverage_types || []).concat(data.line); reloadOpps(); }
          }
          repaintPolicies(); closeDrawer(); toast(pol ? 'Policy updated' : 'Policy added — now in your pipeline too');
        });
      }
      $('#rec-add-policy').addEventListener('click', () => openPolicyForm(null));
      $$('#rec-policies [data-pol]').forEach((el) => el.addEventListener('click', () => openPolicyForm(recPolicies.find((p) => p.id === el.dataset.pol))));

      // Activity: emails + notes + record events, newest first.
      loadContactActivity(cid, c);
      loadContactNotes(cid);
      loadContactAppointments(c);
      loadContactEmails(cid);
      $('#rec-note-save').addEventListener('click', () => saveNote(cid));
    }

    async function loadContactActivity(cid, c) {
      const host = $('#rec-activity'); if (!host) return;
      const items = [];
      items.push({ icon: '➕', title: 'Contact created', when: c.ghl_date_added });
      if (c.issued_at) items.push({ icon: '✅', title: 'Marked Active Client (in-force)', when: c.issued_at });

      // Web inquiries live in ph_leads (the intake event log). Surface them HERE
      // — what they told us on the form is the most useful thing a broker can
      // read before the first call, and it used to be stranded on a separate tab.
      const email = (c.email || '').toLowerCase();
      const inquiries = state.leads.filter((l) =>
        (l.ghl_contact_id && l.ghl_contact_id === c.ghl_contact_id) ||
        (email && (l.email || '').toLowerCase() === email));
      inquiries.forEach((l) => {
        const answers = [['Describes them', l.role], ['Business structure', l.structure],
          ['Current coverage', l.coverage], ['What matters most', l.priority]].filter((a) => a[1]);
        const where = l.page ? ` on ${esc(l.page)}` : '';
        const detail = [
          answers.length ? `<div class="act-answers">${answers.map((a) => `<div><span>${esc(a[0])}</span>${esc(a[1])}</div>`).join('')}</div>` : '',
          l.notes ? `<div class="act-note">“${esc(l.notes)}”</div>` : '',
        ].join('');
        items.push({
          icon: l.kind === 'booking' ? '📅' : '📝',
          title: l.kind === 'booking' ? `Booked a conversation${where}` : `Submitted the ${esc(l.source_form || 'website')} form${where}`,
          when: l.created_at, detail,
        });
        if (l.appointment_start) items.push({ icon: '🗓️', title: 'Appointment set', when: l.appointment_start });
      });

      // Native landing-page bookings, with whatever the visitor typed in the
      // notes box front and center — that note is the best prep for the call.
      try {
        let q = mine(sb.from('ph_appointments').select('*'));
        q = email
          ? q.or(`contact_id.eq.${c.ghl_contact_id},invitee_email.eq.${email}`)
          : q.eq('contact_id', c.ghl_contact_id);
        const { data: native } = await q;
        (native || []).forEach((a) => {
          items.push({
            icon: '📅',
            title: `Booked on the landing page${a.line_key ? ` · ${esc(a.line_key)}` : ''}`,
            when: a.created_at || a.start_at,
            detail: [
              `<div class="act-answers"><div><span>Appointment</span>${esc(fmtFull(a.start_at))}</div></div>`,
              a.notes ? `<div class="act-note">“${esc(a.notes)}”</div>` : '',
            ].join(''),
          });
        });
      } catch (_e) {}

      items.sort((a, b) => +new Date(b.when || 0) - +new Date(a.when || 0));
      host.innerHTML = items.map((i) => `<div class="feed-item"><div class="feed-ic">${i.icon}</div><div style="min-width:0"><div style="font-weight:650">${i.title}</div><div class="cell-sub">${esc(fmtDateTime(i.when))}</div>${i.detail || ''}</div></div>`).join('') || '<div class="cell-sub">No activity yet.</div>';
    }
    async function loadContactAppointments(c) {
      const host = $('#rec-appts'); if (!host) return;
      // Two sources: GHL-mirror leads with an appointment, PLUS native
      // landing-page bookings in ph_appointments (matched by contact link or
      // invitee email so nothing slips through).
      const fromLeads = state.leads
        .filter((l) => l.ghl_contact_id === c.ghl_contact_id && l.appointment_start)
        .map((l) => ({ when: l.appointment_start, sub: l.kind || 'appointment', note: null }));
      const email = (c.email || '').toLowerCase();
      let q = mine(sb.from('ph_appointments').select('*').eq('status', 'booked'));
      q = email
        ? q.or(`contact_id.eq.${c.ghl_contact_id},invitee_email.eq.${email}`)
        : q.eq('contact_id', c.ghl_contact_id);
      const { data: native } = await q.order('start_at');
      const fromNative = (native || []).map((a) => ({
        when: a.start_at,
        sub: ['Booked on the landing page', a.line_key].filter(Boolean).join(' · '),
        note: a.notes || null,
      }));
      const appts = fromLeads.concat(fromNative).sort((a, b) => +new Date(a.when) - +new Date(b.when));
      host.innerHTML = appts.length ? appts.map((a) => `<div class="feed-item"><div class="feed-ic">📅</div><div style="min-width:0"><div style="font-weight:650">${esc(fmtFull(a.when))}</div><div class="cell-sub">${esc(a.sub)}</div>${a.note ? `<div class="act-note">“${esc(a.note)}”</div>` : ''}</div></div>`).join('') : '<div class="cell-sub">No appointments.</div>';
    }
    async function loadContactNotes(cid) {
      const host = $('#rec-notes'); if (!host) return;
      const { data } = await sb.from('ph_notes').select('*').eq('contact_id', cid).order('created_at', { ascending: false }).limit(50);
      host.innerHTML = (data && data.length) ? data.map((n) => `<div class="feed-item"><div class="feed-ic">📝</div><div><div>${esc(n.body)}</div><div class="cell-sub">${esc(fmtDateTime(n.created_at))}</div></div></div>`).join('') : '<div class="cell-sub">No notes yet.</div>';
    }
    // Broker books an appointment WITH this contact, right from the record.
    // The server (ph-book action 'manual') writes it to the broker's calendar
    // and emails the client a branded confirmation with date, time, and the
    // broker's contact info. Reminders (24h/1h) ride the same rails as
    // landing-page bookings automatically.
    function openBookAppt(cid, c) {
      const today = new Date(); today.setDate(today.getDate() + 1);
      const defDate = today.toISOString().slice(0, 10);
      const lineOpts = BROKER_LINES.map((l) => `<option value="${esc(l)}" ${((c.coverage_types || [])[0] === l) ? 'selected' : ''}>${esc(l)}</option>`).join('');
      openDrawer(`
        <div class="drawer-h"><div><div style="font-size:1.15rem;font-weight:800">Book an appointment</div><div class="cell-sub">${esc([c.first_name, c.last_name].filter(Boolean).join(' ') || 'this client')}${c.email ? ' · ' + esc(c.email) : ''}</div></div><button class="drawer-x" data-x>✕</button></div>
        <form id="ba-form" class="drawer-b">
          <div class="field"><label>Date</label><input name="date" type="date" required value="${defDate}" min="${new Date().toISOString().slice(0, 10)}"/></div>
          <div class="field"><label>Time</label><input name="time" type="time" required value="10:00"/></div>
          <div class="field"><label>Topic / line</label><select name="line"><option value="">General</option>${lineOpts}</select></div>
          <div class="field"><label>Notes (visible to you on the appointment)</label><textarea name="notes" rows="3" placeholder="Anything to prep…"></textarea></div>
          ${c.email ? '<div class="cell-sub" style="margin:4px 0 10px">The client gets a branded confirmation email with the time and your contact info.</div>' : '<div class="cell-sub" style="margin:4px 0 10px;color:#b45309">This contact has no email on file, so no confirmation can be sent. The appointment still lands on your calendar.</div>'}
          <button class="btn btn-primary" type="submit">Book it</button>
          <div class="cell-sub" id="ba-status" style="margin-top:8px"></div>
        </form>`);
      $('#ba-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target; const btn = f.querySelector('button[type="submit"]'); const st = $('#ba-status');
        const start = new Date(f.date.value + 'T' + f.time.value);
        if (isNaN(start.getTime())) { st.textContent = 'Pick a valid date and time.'; return; }
        btn.disabled = true; st.textContent = 'Booking…';
        const { data: sess } = await sb.auth.getSession();
        const token = sess?.session?.access_token;
        try {
          const r = await fetch(`${root.getAttribute('data-supabase-url')}/functions/v1/ph-book`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: root.getAttribute('data-supabase-anon'), Authorization: 'Bearer ' + token },
            body: JSON.stringify({ action: 'manual', contact_id: cid, start_at: start.toISOString(), line: f.line.value || null, notes: f.notes.value.trim() || null }),
          });
          const j = await r.json().catch(() => ({}));
          if (!r.ok || !j.ok) { btn.disabled = false; st.textContent = j.error || 'Could not book that time.'; return; }
          closeDrawer();
          toast(j.emailed ? 'Booked — confirmation emailed to the client' : 'Booked — on your calendar');
          reloadAppts();
          loadContactAppointments(c); loadContactActivity(cid, c);
        } catch (_e) { btn.disabled = false; st.textContent = 'Network error — try again.'; }
      });
    }

    async function saveNote(cid) {
      const ta = $('#rec-note'); const body = ta.value.trim(); if (!body) return;
      const { error } = await sb.from('ph_notes').insert({ contact_id: cid, body });
      if (error) { toast('Could not save note.'); return; }
      ta.value = ''; toast('Note saved'); loadContactNotes(cid);
    }

    // ================= REVIEWS =================
    // The whole funnel for one broker: who was asked, who opened the link, what
    // they rated, and what the unhappy ones wrote. Requests that were never
    // opened still appear — the silence is the useful part.
    //
    // ph_review_tracking() with no argument reports the caller's own clients.
    // /admin passes p_all for the house.
    const RV_OUTCOME = {
      sent: ['Sent, not opened', 'st-gray'],
      opened: ['Opened, no rating', 'st-blue'],
      sent_to_google: ['Sent to Google', 'st-green'],
      private_feedback: ['Private feedback', 'st-red'],
      low_rating_no_comment: ['Low rating, no comment', 'st-amber'],
      unknown: ['Rated', 'st-gray'],
    };
    const starRow = (n) => n ? `<span class="rv-stars-mini" aria-label="${n} out of 5">${'★'.repeat(n)}${'☆'.repeat(5 - n)}</span>` : '<span class="cell-sub">—</span>';

    async function renderReviews(v) {
      v.innerHTML = '<div class="card"><div class="card-b"><div class="cell-sub">Loading…</div></div></div>';
      const { data, error } = await sb.rpc('ph_review_tracking');
      if (error) { v.innerHTML = `<div class="card"><div class="card-b"><div class="empty">Could not load reviews: ${esc(error.message)}</div></div></div>`; return; }
      const rows = data ?? [];
      state.reviewRows = rows;

      const asked = rows.filter((r) => r.sent_at).length;
      const opened = rows.filter((r) => r.clicked_at).length;
      const rated = rows.filter((r) => r.rating).length;
      const toGoogle = rows.filter((r) => r.outcome === 'sent_to_google').length;
      const low = rows.filter((r) => r.rating && r.rating < 4);
      const openLow = low.filter((r) => !r.handled);
      const avg = rated ? (rows.filter((r) => r.rating).reduce((s, r) => s + r.rating, 0) / rated) : 0;

      const sub = (t, cls = 'flat') => `<span class="delta ${cls}">${esc(t)}</span>`;

      v.innerHTML = `
      <div class="view-grid dash-anim">
        <div class="stat-row">
          ${statCard('Requests sent', asked, sub(rated ? 'avg ' + avg.toFixed(1) + '★ from ' + rated : 'no ratings yet'), IC.people)}
          ${statCard('Opened the link', opened, sub(asked ? Math.round(opened / asked * 100) + '% of those sent' : '—'), IC.cal)}
          ${statCard('Sent to Google', toGoogle, sub('4 and 5 stars', toGoogle ? 'up' : 'flat'), IC.shield)}
          ${statCard('Needs follow-up', openLow.length, sub(openLow.length ? 'unhandled low ratings' : 'all clear', openLow.length ? 'flat' : 'up'), IC.funnel)}
        </div>

        ${openLow.length ? `<div class="card" style="border-color:#f0c9c4"><div class="card-h"><span class="grad-label">Needs your attention</span></div><div class="card-b">
          ${openLow.map((r) => `<div class="feed-item">
            <div class="feed-ic">⚠️</div>
            <div style="min-width:0;flex:1">
              <div style="font-weight:700">${esc(r.client_name)} ${starRow(r.rating)}</div>
              <div class="cell-sub">${esc(r.client_email || '')} · rated ${esc(fmtDate(r.rated_at))}</div>
              ${r.feedback ? `<div class="act-note">“${esc(r.feedback)}”</div>` : '<div class="cell-sub" style="color:#96690d">No comment left — call them.</div>'}
            </div>
            <button class="btn btn-ghost btn-sm" data-rv-done="${esc(r.contact_id)}">Mark handled</button>
          </div>`).join('')}
        </div></div>` : ''}

        <div class="card"><div class="card-h"><span class="grad-label">Every request</span></div><div class="card-b">
          ${rows.length ? `<table class="data"><thead><tr>
            <th>Client</th><th>Sent</th><th>Opened</th><th>Rating</th><th>Outcome</th><th>What they said</th>
          </tr></thead><tbody>
          ${rows.map((r) => {
            const [label, cls] = RV_OUTCOME[r.outcome] || RV_OUTCOME.unknown;
            return `<tr>
              <td><div style="font-weight:650">${esc(r.client_name)}</div><div class="cell-sub">${esc(r.client_email || '')}</div></td>
              <td class="cell-sub">${esc(fmtDate(r.sent_at)) || '—'}</td>
              <td class="cell-sub">${r.clicked_at ? esc(fmtDate(r.clicked_at)) : '—'}</td>
              <td>${starRow(r.rating)}</td>
              <td><span class="pill-status ${cls}">${esc(label)}</span></td>
              <td class="cell-sub" style="max-width:280px">${esc(r.feedback || '')}</td>
            </tr>`;
          }).join('')}
          </tbody></table>` : '<div class="empty">No review requests yet. They go out automatically the moment you mark a client Active Client.</div>'}
        </div></div>

        <p class="cell-sub" style="margin-top:14px;line-height:1.6">
          Four and five stars go straight to Google, so we can see that someone was sent there but not whether they
          finished posting — Google does not report that back. One to three stars never reach Google: they open a
          private feedback box, and an alert goes to you, to Janet and to every admin the moment the star is tapped,
          whether or not they write anything.
        </p>
      </div>`;

      $$('[data-rv-done]').forEach((b) => b.addEventListener('click', async () => {
        b.disabled = true;
        const { error: e2 } = await sb.from('ph_reviews').update({ handled: true }).eq('contact_id', b.getAttribute('data-rv-done'));
        if (e2) { b.disabled = false; toast('Could not update.'); return; }
        toast('Marked handled');
        renderReviews($('#view'));
      }));
    }

    // Lines of insurance decide which pipelines this client appears in: a
    // database trigger opens a deal per line. A contact saved without one is
    // invisible on the board and there was previously no way to fix that from
    // the record, so this is an edit, not a display.
    function editContactLines(cid, c) {
      const have = new Set(c.coverage_types || []);
      const opts = COVERAGE_TYPES.map((t) =>
        `<label class="pickbox"><input type="checkbox" data-line="${esc(t)}" ${have.has(t) ? 'checked' : ''}/> ${esc(t)}</label>`).join('');
      openDrawer(`
        <div class="drawer-h"><div style="font-size:1.1rem;font-weight:800">Lines of insurance</div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <p class="cell-sub" style="margin:0 0 12px">Each line opens a deal in that pipeline. Removing a line here leaves any existing deal where it is.</p>
          <div class="pickgrid">${opts}</div>
          <button class="btn btn-primary" id="cl-save" style="margin-top:18px">Save lines</button>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cl-save').addEventListener('click', async () => {
        const want = $$('#drawer [data-line]').filter((x) => x.checked).map((x) => x.getAttribute('data-line'));
        const { error } = await sb.from('ph_contacts').update({ coverage_types: want }).eq('ghl_contact_id', cid);
        if (error) { toast('Could not save lines.'); return; }
        closeDrawer();
        toast(want.length ? 'Lines updated — pipeline deals created' : 'Lines cleared');
        await reloadOpps();
        openContact(cid, null);
      });
    }

    // Every email this contact has been sent, newest first, opened in full.
    // ph_email_log stores the rendered HTML, so this is the message the client
    // actually received rather than a description of it.
    const EMAIL_KINDS = {
      confirmation: 'Booking confirmation',
      agent_notification: 'Agent notification',
      reminder_24h: '24-hour reminder',
      reminder_1h: '1-hour reminder',
      reminder_10m: '10-minute reminder',
      review_request: 'Review request',
      campaign: 'Campaign',
    };
    async function loadContactEmails(cid) {
      const host = $('#rec-emails'); if (!host) return;
      const { data, error } = await mine(sb.from('ph_email_log')
        .select('id, to_email, to_name, to_role, kind, subject, status, error, created_at, html'))
        .eq('contact_id', cid).order('created_at', { ascending: false }).limit(100);
      if (error) { host.innerHTML = `<div class="cell-sub">Could not load emails: ${esc(error.message)}</div>`; return; }
      state.contactEmails = data ?? [];
      if (!state.contactEmails.length) {
        host.innerHTML = '<div class="cell-sub">No emails sent to this contact yet.</div>';
        return;
      }
      host.innerHTML = state.contactEmails.map((m) => {
        const failed = m.status !== 'sent';
        return `<div class="feed-item em-row" data-em="${esc(m.id)}" role="button" tabindex="0">
          <div class="feed-ic">${failed ? '⚠️' : m.to_role === 'agent' ? '🔔' : '✉️'}</div>
          <div style="min-width:0;flex:1">
            <div style="font-weight:650">${esc(m.subject || '(no subject)')}</div>
            <div class="cell-sub">${esc(EMAIL_KINDS[m.kind] || m.kind || 'Email')} · to ${esc(m.to_role === 'agent' ? 'you' : (m.to_name || m.to_email || ''))} · ${esc(fmtDateTime(m.created_at))}</div>
            ${failed ? `<div class="cell-sub" style="color:#b3261e">Did not send: ${esc(m.error || 'unknown error')}</div>` : ''}
          </div>
          <span class="cell-sub">View →</span>
        </div>`;
      }).join('');
      $$('.em-row', host).forEach((r) => {
        const open = () => openEmailPreview(r.getAttribute('data-em'));
        r.addEventListener('click', open);
        r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
      });
    }

    function openEmailPreview(id) {
      const m = (state.contactEmails || []).find((x) => String(x.id) === String(id));
      if (!m) return;
      // The stored body is sanitised email HTML we generated ourselves, but it
      // is still rendered inside a sandboxed iframe rather than injected into
      // the app: no scripts, no same-origin access, no way for a future
      // third-party template to reach the broker's session.
      const body = m.html
        ? `<iframe class="em-frame" sandbox="" srcdoc="${esc(m.html)}" title="Email preview"></iframe>`
        : `<div class="cell-sub" style="padding:18px 0">This email was sent before we started keeping a copy of the message body.</div>`;
      openDrawer(`
        <div class="drawer-h">
          <div style="min-width:0">
            <div style="font-size:1.05rem;font-weight:800;overflow-wrap:anywhere">${esc(m.subject || '(no subject)')}</div>
            <div class="cell-sub">${esc(EMAIL_KINDS[m.kind] || m.kind || 'Email')} · to ${esc(m.to_email || '')} · ${esc(fmtDateTime(m.created_at))}</div>
          </div>
          <button class="drawer-x" data-x>✕</button>
        </div>
        <div class="drawer-b">
          ${m.status !== 'sent' ? `<div class="hint" style="color:#b3261e;margin-bottom:12px">This one did not send: ${esc(m.error || 'unknown error')}</div>` : ''}
          ${body}
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
    }

    // Edit which carriers cover this client, in a small modal-like drawer section.
    function editContactCarriers(cid, linkedIds) {
      const opts = state.carriers.map((c) => `<label class="pickbox"><input type="checkbox" data-carrier="${c.id}" ${linkedIds.has(c.id) ? 'checked' : ''}/> ${esc(c.name)}</label>`).join('');
      openDrawer(`
        <div class="drawer-h"><div style="font-size:1.1rem;font-weight:800">Carriers for this client</div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div class="pickgrid">${opts || '<div class="cell-sub">No carriers.</div>'}</div>
          <button class="btn btn-primary" id="cc-save" style="margin-top:18px">Save carriers</button>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cc-save').addEventListener('click', async () => {
        const want = new Set($$('#drawer [data-carrier]').filter((c) => c.checked).map((c) => c.getAttribute('data-carrier')));
        const add = [...want].filter((id) => !linkedIds.has(id));
        const remove = [...linkedIds].filter((id) => !want.has(id));
        if (add.length) await sb.from('ph_contact_carriers').insert(add.map((carrier_id) => ({ contact_id: cid, carrier_id })));
        for (const id of remove) await sb.from('ph_contact_carriers').delete().eq('contact_id', cid).eq('carrier_id', id);
        closeDrawer(); toast('Carriers updated'); openContact(cid, null);
      });
    }

    // ================= ADMIN: CARRIER MANAGER =================
    async function openCarrierManager() {
      await reloadCarriers();
      const list = (state.allCarriers || []).map((c) => `
        <div class="feed-item" data-cid="${c.id}">
          <input class="cm-name" value="${esc(c.name)}" style="flex:1;border:1px solid var(--line);border-radius:8px;padding:6px 10px"/>
          <label class="cell-sub" style="display:flex;align-items:center;gap:5px"><input type="checkbox" class="cm-active" ${c.is_active ? 'checked' : ''}/> active</label>
          <button class="btn btn-ghost btn-sm cm-save">Save</button>
          <button class="btn btn-ghost btn-sm cm-del" style="color:var(--red)">Delete</button>
        </div>`).join('');
      openDrawer(`
        <div class="drawer-h"><div style="font-size:1.1rem;font-weight:800">Carriers</div><button class="drawer-x" data-x>✕</button></div>
        <div class="drawer-b">
          <div class="hint">Changes here apply for every user's dropdown.</div>
          <div style="display:flex;gap:8px;margin:12px 0">
            <input id="cm-new" placeholder="New carrier name" style="flex:1;border:1px solid var(--line);border-radius:8px;padding:8px 11px"/>
            <button class="btn btn-primary btn-sm" id="cm-add">Add</button>
          </div>
          <div id="cm-list">${list}</div>
        </div>`);
      $('[data-x]').addEventListener('click', closeDrawer);
      $('#cm-add').addEventListener('click', async () => {
        const name = $('#cm-new').value.trim(); if (!name) return;
        const { error } = await sb.from('ph_carriers').insert({ name });
        if (error) { toast(error.message.includes('duplicate') ? 'That carrier already exists.' : 'Could not add.'); return; }
        toast('Carrier added'); openCarrierManager();
      });
      $$('#drawer [data-cid]').forEach((row) => {
        const id = row.getAttribute('data-cid');
        row.querySelector('.cm-save').addEventListener('click', async () => {
          const name = row.querySelector('.cm-name').value.trim();
          const is_active = row.querySelector('.cm-active').checked;
          const { error } = await sb.from('ph_carriers').update({ name, is_active }).eq('id', id);
          toast(error ? 'Could not save.' : 'Saved'); if (!error) reloadCarriers();
        });
        row.querySelector('.cm-del').addEventListener('click', async () => {
          const { error } = await sb.from('ph_carriers').delete().eq('id', id);
          if (error) { toast('In use — set inactive instead of deleting.'); return; }
          toast('Deleted'); openCarrierManager();
        });
      });
    }

    // global search → jump to contacts filtered
    $('#global-search').addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      cQuery = e.target.value.trim(); cPage = 0; go('contacts');
    });

    // ================= BOOT (verbatim auth arrival logic) =================
    (async () => {
      const params = new URLSearchParams(location.search);
      const token = params.get('claim');
      if (token) {
        view('loading');
        const { ok, json } = await authPost({ action: 'claim_info', token });
        if (ok && json.ok) {
          claimToken = token;
          $('.ag-setpw-form').email.value = json.email || '';
          $('.ag-setpw-title').textContent = 'Welcome, ' + (String(json.full_name || '').split(' ')[0] || 'there');
          $('.ag-setpw-intro').textContent = 'Set a password for ' + (json.email || 'your account') + '. You will use it to sign in from now on.';
          view('setpassword'); return;
        }
        const why = { used: 'That link has already been used. Sign in below, or use Forgot your password.', expired: 'That link has expired. Use Forgot your password below and we will send a fresh one.', invalid: 'That link is not valid. Check you copied the whole thing, or ask the office to resend it.' }[json.reason] || 'That link is not valid.';
        view('signin'); setStatus('signin', why, true); return;
      }
      let recovering = false;
      sb.auth.onAuthStateChange((event) => {
        if (event !== 'PASSWORD_RECOVERY') return;
        recovering = true; claimToken = null;
        $('.ag-setpw-title').textContent = 'Choose a new password';
        $('.ag-setpw-intro').textContent = 'Pick something you will remember. At least 10 characters.';
        view('setpassword');
      });
      let settled = false;
      const toSignin = () => { if (!settled) { settled = true; view('signin'); } };
      const stall = setTimeout(toSignin, 8000);
      try {
        const { data } = await sb.auth.getSession();
        const email = data?.session?.user?.email;
        clearTimeout(stall);
        if (recovering) { settled = true; return; }
        if (!email) { toSignin(); return; }
        settled = true;
        await enter(email);
      } catch (err) {
        clearTimeout(stall); toSignin();
        setStatus('signin', 'Could not check your session. Please sign in.', true);
      }
    })();
  }
  </script>
</body>
</html>
