---
// Two-tier team page (owner decision, Aug 11 2026 — resolves meeting items #4/#5):
//   1. "Meet the Leaders"  — the five leadership profiles from TEAM (static).
//   2. "Meet the Brokers"  — Chris (static) + every agent who has completed CRM
//      onboarding with a headshot and bio, pulled from ph_public_brokers at
//      build time. Onboarding fires the deploy hook, so a broker finishing
//      their profile automatically appears here on the next auto-publish —
//      no hand edits.
// Leadership members are deduped out of the brokers list by slug in case one
// of them also completes CRM onboarding.
import { createClient } from '@supabase/supabase-js';
import Base from '../layouts/Base.astro';
import { SITE, TEAM, breadcrumbSchema } from '../lib/site';
import { brokerSlug } from '../lib/broker-lines';

const LEADER_SLUGS = ['brian-douglas', 'robert-morgen', 'brenda-morgen', 'jason-vasquez', 'janet-nevarez'];
const leaders = LEADER_SLUGS.map((s) => TEAM.find((m) => m.slug === s)).filter(Boolean);
const chris = TEAM.find((m) => m.slug === 'chris-bridgeforth');

// Onboarded brokers, fetched at build time. Uses ph_public_team, NOT
// ph_public_brokers: the team RPC additionally excludes admins (email match
// against ph_admins) and anyone flagged hide_from_team (test accounts), while
// landing pages at /broker/[slug] keep building for everyone.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
let onboarded: any[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const { data, error } = await sb.rpc('ph_public_team');
  if (!error && Array.isArray(data)) onboarded = data;
} catch (_e) { onboarded = []; }

const TEAM_SLUGS = new Set(TEAM.map((m) => m.slug));
const brokers = onboarded
  .map((b) => ({ ...b, slug: brokerSlug(b.full_name) }))
  .filter((b) => b.slug && !TEAM_SLUGS.has(b.slug));

// Showcase members: Chris (static) + every onboarded broker. Photos and name
// rows cross-highlight by data-tsid; each is a real link to the profile page.
type Member = { id: string; name: string; role: string; photo: string; href: string; social: { label: string; url: string }[] };
const members: Member[] = [
  ...(chris ? [{ id: 'chris', name: chris.name, role: chris.role, photo: chris.photo, href: `/team-members/${chris.slug}`, social: [] }] : []),
  ...brokers.map((b) => ({
    id: b.slug,
    name: b.full_name,
    role: b.title || 'Licensed Broker',
    photo: b.headshot_url,
    href: `/broker/${b.slug}`,
    social: [
      { label: 'linkedin', url: (b.social_links || {}).linkedin },
      { label: 'facebook', url: (b.social_links || {}).facebook },
      { label: 'instagram', url: (b.social_links || {}).instagram },
    ].filter((s) => s.url),
  })),
];
const cols: Member[][] = [[], [], []];
members.forEach((m, i) => cols[i % 3].push(m));

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Our Team', url: `${SITE.domain}/our-team` },
  ]),
];
---
<Base
  title="Meet The ProtectHealth Team | Las Vegas Insurance Brokers"
  description="Meet the ProtectHealth leadership team and licensed brokers — the people behind Las Vegas's strategy-first insurance brokerage."
  schemas={schemas}
>
  <section class="hero">
    <div class="container">
      <div class="kicker">Our Team</div>
      <h1>Insurance nerds, at your service</h1>
      <p class="lead">A team of dedicated professionals who would rather ask the right questions than make the fast sale.</p>
    </div>
  </section>

  <!-- ===== Tier 1: leadership ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <div class="section-label">Leadership</div>
        <h2 style="margin-top:0;">Meet the Leaders</h2>
      </div>
      <div class="grid team-grid">
        {leaders.map((m) => (
          <a class="team-card" href={`/team-members/${m.slug}`}>
            <div class="photo"><img src={m.photo} alt={`${m.name}, ${m.role} at ProtectHealth`} loading="lazy" /></div>
            <h3>{m.name}</h3>
            <span class="role">{m.role} · ProtectHealth</span>
            <span class="tc-more">View Profile →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Tier 2: brokers (Chris + everyone who has onboarded) ===== -->
  <section class="section soft rounded-section">
    <div class="container">
      <div class="section-head center">
        <div class="section-label">Licensed Brokers</div>
        <h2 style="margin-top:0;">Meet the Brokers</h2>
        <p style="color:var(--muted);max-width:560px;margin:10px auto 0;">Licensed professionals across Nevada, each with their own page where you can read their story and book time directly.</p>
      </div>
      <div class="ts" id="ts">
        <div class="ts-photos">
          {cols.map((col, ci) => (
            <div class={`ts-col ts-col-${ci + 1}`}>
              {col.map((m) => (
                <a class="ts-photo" data-tsid={m.id} href={m.href} aria-label={`${m.name}, ${m.role} at ProtectHealth`}>
                  <img src={m.photo} alt={`${m.name}, ${m.role} at ProtectHealth`} loading="lazy" />
                </a>
              ))}
            </div>
          ))}
        </div>
        <div class="ts-list">
          {members.map((m) => (
            <div class="ts-row" data-tsid={m.id} data-href={m.href}>
              <span class="ts-line">
                <span class="ts-dash"></span>
                <a class="ts-name" href={m.href}>{m.name}</a>
                {m.social.length > 0 && (
                  <span class="ts-social">
                    {m.social.map((s) => (
                      <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.label} aria-label={`${m.name} on ${s.label}`}>
                        {s.label === 'linkedin' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z"/></svg>}
                        {s.label === 'facebook' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"/></svg>}
                        {s.label === 'instagram' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>}
                      </a>
                    ))}
                  </span>
                )}
              </span>
              <span class="ts-role">{m.role}</span>
            </div>
          ))}
        </div>
      </div>
      {brokers.length === 0 && (
        <p style="text-align:center;color:var(--muted);margin-top:18px;">More broker profiles are being added — check back soon.</p>
      )}
    </div>
  </section>

  <script is:inline>
    // Cross-highlight: hovering a photo lights up its name row and vice versa.
    (function () {
      const root = document.getElementById('ts');
      if (!root) return;
      const all = [...root.querySelectorAll('[data-tsid]')];
      const set = (id) => {
        root.classList.toggle('has-active', !!id);
        all.forEach((el) => {
          el.classList.toggle('on', !!id && el.dataset.tsid === id);
        });
      };
      all.forEach((el) => {
        el.addEventListener('mouseenter', () => set(el.dataset.tsid));
        el.addEventListener('mouseleave', () => set(null));
      });
      // Whole name-row is clickable (it is a div so the social links inside
      // stay valid HTML); real links inside it win.
      root.querySelectorAll('.ts-row[data-href]').forEach((row) => {
        row.style.cursor = 'pointer';
        row.addEventListener('click', (e) => {
          if (e.target.closest('a')) return;
          location.href = row.dataset.href;
        });
      });
    })();
  </script>
</Base>

<style is:global>
  /* Team showcase: staggered grayscale mosaic + interlinked name list. Global
     and namespaced under .ts (house rule for anything a script classes at
     runtime). */
  .ts { display: flex; align-items: flex-start; gap: 48px; max-width: 980px; margin: 26px auto 0; }
  .ts-photos { display: flex; gap: 12px; flex-shrink: 0; }
  .ts-col { display: flex; flex-direction: column; gap: 12px; }
  .ts-col-1 { width: 155px; }
  .ts-col-2 { width: 172px; margin-top: 66px; }
  .ts-col-3 { width: 162px; margin-top: 30px; }
  .ts-photo { display: block; border-radius: 14px; overflow: hidden; background: #dfe7f2; }
  .ts-col-1 .ts-photo { height: 165px; }
  .ts-col-2 .ts-photo { height: 182px; }
  .ts-col-3 .ts-photo { height: 172px; }
  /* object-position keeps the FACE in frame no matter what shape the broker
     uploads: portraits and selfies keep the head visible instead of cropping
     it at the top of the card. */
  .ts-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; display: block;
    filter: grayscale(1) brightness(.8); transition: filter .45s ease, opacity .35s ease; }
  .ts.has-active .ts-photo:not(.on) img { opacity: .55; }
  .ts-photo.on img { filter: grayscale(0) brightness(1); }

  .ts-list { display: flex; flex-direction: column; gap: 20px; flex: 1; min-width: 0; padding-top: 8px; }
  .ts-row { display: block; text-decoration: none; transition: opacity .3s ease; }
  .ts.has-active .ts-row:not(.on) { opacity: .45; }
  .ts-line { display: flex; align-items: center; gap: 10px; }
  .ts-dash { width: 16px; height: 11px; border-radius: 5px; background: rgba(15,53,103,.22); flex-shrink: 0;
    transition: background .3s ease, width .3s ease; }
  .ts-row.on .ts-dash { background: var(--blue, #197bff); width: 21px; }
  .ts-name { font-size: 1.06rem; font-weight: 700; letter-spacing: -.3px; color: var(--navy, #0f3567); line-height: 1; text-decoration: none; }
  .ts-role { display: block; margin-top: 7px; padding-left: 26px; font-size: .66rem; font-weight: 650;
    text-transform: uppercase; letter-spacing: .2em; color: var(--muted, #8494ab); }
  .ts-social { display: flex; align-items: center; gap: 6px; margin-left: 2px;
    opacity: 0; transform: translateX(-8px); transition: opacity .2s ease, transform .2s ease; pointer-events: none; }
  .ts-row.on .ts-social { opacity: 1; transform: translateX(0); pointer-events: auto; }
  .ts-social a { display: grid; place-items: center; padding: 4px; border-radius: 6px; color: var(--muted, #8494ab);
    transition: color .15s, background .15s, transform .15s; }
  .ts-social a:hover { color: var(--navy, #0f3567); background: rgba(15,53,103,.08); transform: scale(1.12); }
  .ts-social svg { width: 12px; height: 12px; display: block; }

  @media (max-width: 860px) {
    .ts { flex-direction: column; gap: 28px; }
    .ts-photos { overflow-x: auto; padding-bottom: 6px; max-width: 100%;
      -webkit-overflow-scrolling: touch; }
    .ts-col-1 { width: 120px; }
    .ts-col-2 { width: 134px; margin-top: 48px; }
    .ts-col-3 { width: 126px; margin-top: 22px; }
    .ts-col-1 .ts-photo { height: 130px; }
    .ts-col-2 .ts-photo { height: 144px; }
    .ts-col-3 .ts-photo { height: 136px; }
    .ts-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; padding-top: 0; }
  }
  @media (max-width: 480px) { .ts-list { grid-template-columns: 1fr; } }
</style>
