---
// Two-tier team page (owner decision, Aug 11 2026 — resolves meeting items #4/#5):
//   1. "Meet the Leaders"  — the five leadership profiles from TEAM (static).
//   2. "Meet the Brokers"  — Chris (static) + every agent who has completed CRM
//      onboarding with a headshot and bio, pulled from ph_public_brokers at
//      build time. Onboarding fires the deploy hook, so a broker finishing
//      their profile automatically appears here on the next auto-publish —
//      no hand edits.
// Leadership members are deduped out of the brokers list by slug in case one
// of them also completes CRM onboarding.
import { createClient } from '@supabase/supabase-js';
import Base from '../layouts/Base.astro';
import { SITE, TEAM, breadcrumbSchema } from '../lib/site';
import { brokerSlug } from '../lib/broker-lines';

const LEADER_SLUGS = ['brian-douglas', 'robert-morgen', 'brenda-morgen', 'jason-vasquez', 'janet-nevarez'];
const leaders = LEADER_SLUGS.map((s) => TEAM.find((m) => m.slug === s)).filter(Boolean);
const chris = TEAM.find((m) => m.slug === 'chris-bridgeforth');

// Onboarded brokers, fetched at build time. Uses ph_public_team, NOT
// ph_public_brokers: the team RPC additionally excludes admins (email match
// against ph_admins) and anyone flagged hide_from_team (test accounts), while
// landing pages at /broker/[slug] keep building for everyone.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
let onboarded: any[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const { data, error } = await sb.rpc('ph_public_team');
  if (!error && Array.isArray(data)) onboarded = data;
} catch (_e) { onboarded = []; }

const TEAM_SLUGS = new Set(TEAM.map((m) => m.slug));
const brokers = onboarded
  .map((b) => ({ ...b, slug: brokerSlug(b.full_name) }))
  .filter((b) => b.slug && !TEAM_SLUGS.has(b.slug));

// Showcase members: every onboarded broker from the live roster. Chris's CRM
// profile is pre-filled (Aug 12 2026), so he normally arrives from the DB as
// "Christopher Bridgeforth" with his photo linking to /broker/christopher-bridgeforth.
// The static TEAM card is only a fallback for builds where the fetch fails,
// so the section never renders empty of him.
type Member = { id: string; name: string; role: string; photo: string; href: string; social: { label: string; url: string }[] };
const chrisFromDb = brokers.some((b) => /bridgeforth/i.test(b.full_name || ''));
const members: Member[] = [
  ...(chris && !chrisFromDb ? [{ id: 'chris', name: chris.name, role: chris.role, photo: chris.photo, href: `/team-members/${chris.slug}`, social: [] }] : []),
  ...brokers.map((b) => ({
    id: b.slug,
    name: b.full_name,
    role: b.title || 'Licensed Broker',
    photo: b.headshot_url,
    href: `/broker/${b.slug}`,
    social: [
      { label: 'linkedin', url: (b.social_links || {}).linkedin },
      { label: 'facebook', url: (b.social_links || {}).facebook },
      { label: 'instagram', url: (b.social_links || {}).instagram },
    ].filter((s) => s.url),
  })),
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Our Team', url: `${SITE.domain}/our-team` },
  ]),
];
---
<Base
  title="Meet The ProtectHealth Team | Las Vegas Insurance Brokers"
  description="Meet the ProtectHealth leadership team and licensed brokers — the people behind Las Vegas's strategy-first insurance brokerage."
  schemas={schemas}
>
  <section class="hero">
    <div class="container">
      <div class="kicker">Our Team</div>
      <h1>Insurance nerds, at your service</h1>
      <p class="lead">A team of dedicated professionals who would rather ask the right questions than make the fast sale.</p>
    </div>
  </section>

  <!-- ===== Tier 1: leadership ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <div class="section-label">Leadership</div>
        <h2 style="margin-top:0;">Meet the Leaders</h2>
      </div>
      <div class="grid team-grid">
        {leaders.map((m) => (
          <a class="team-card" href={`/team-members/${m.slug}`}>
            <div class="photo"><img src={m.photo} alt={`${m.name}, ${m.role} at ProtectHealth`} loading="lazy" /></div>
            <h3>{m.name}</h3>
            <span class="role">{m.role} · ProtectHealth</span>
            <span class="tc-more">View Profile →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Tier 2: brokers (Chris + everyone who has onboarded) ===== -->
  <section class="section soft rounded-section">
    <div class="container">
      <div class="section-head center">
        <div class="section-label">Licensed Brokers</div>
        <h2 style="margin-top:0;">Meet the Brokers</h2>
        <p style="color:var(--muted);max-width:560px;margin:10px auto 0;">Licensed professionals across Nevada, each with their own page where you can read their story and book time directly.</p>
      </div>
      <div class="bx">
        {members.map((m) => (
          <div class="bx-card">
            {/* Photo and name are two separate links to the same page rather
                than one stretched link over the whole card. The social icons
                have to sit INSIDE the photo's positioning context (an absolute
                child of .bx-card lands at the bottom of the card, on top of the
                name), and they cannot be nested inside another anchor without
                producing invalid HTML that browsers silently unnest.
                The photo link is out of the tab order so keyboard users get one
                stop per broker, not two identical ones. */}
            <div class="bx-media">
              <a class="bx-shot" href={m.href} tabindex="-1" aria-hidden="true">
                <img src={m.photo} alt="" loading="lazy" decoding="async" />
              </a>
              {m.social.length > 0 && (
                <span class="bx-social">
                  {m.social.map((s) => (
                    <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.label} aria-label={`${m.name} on ${s.label}`}>
                    {s.label === 'linkedin' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z"/></svg>}
                    {s.label === 'facebook' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"/></svg>}
                    {s.label === 'instagram' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>}
                    </a>
                  ))}
                </span>
              )}
            </div>
            <a class="bx-meta" href={m.href}>
              <span class="bx-name">{m.name}</span>
              <span class="bx-role">{m.role}</span>
            </a>
          </div>
        ))}
      </div>
      {brokers.length === 0 && (
        <p style="text-align:center;color:var(--muted);margin-top:18px;">More broker profiles are being added — check back soon.</p>
      )}
    </div>
  </section>

</Base>

<style>
  /* Broker grid.
     Replaces a 980px-wide three-column photo mosaic sat next to a separate list
     of the same names. That layout printed every broker twice, used barely
     four-fifths of the container, and grew a full row taller with each new
     broker -- with twenty of them the section ran most of a screen deep and
     still looked like a narrow column.
     One card per broker in an auto-filling grid instead: five across on a wide
     desktop, and it re-flows to four, three and two without a single hard-coded
     breakpoint for column count. */
  .bx { display: grid; grid-template-columns: repeat(auto-fill, minmax(196px, 1fr));
        gap: 30px 22px; margin-top: 34px; }

  .bx-card { position: relative; transition: opacity .3s ease; }
  /* Dim the rest of the grid on hover -- the one bit of personality worth
     keeping from the old mosaic. Guarded by hover:hover so a touch device,
     where :hover sticks until you tap elsewhere, never leaves the grid
     half-faded. */
  @media (hover: hover) {
    .bx:hover .bx-card { opacity: .5; }
    .bx:hover .bx-card:hover { opacity: 1; }
  }

  /* The photo box is its own positioning context so the social icons land on
     the PHOTO. Anchored to .bx-card they sat at the bottom of the whole card,
     directly on top of the broker's name. */
  .bx-media { position: relative; }
  .bx-shot { display: block; overflow: hidden; border-radius: 18px;
    background: #dfe7f2; aspect-ratio: 3 / 4; box-shadow: 0 1px 2px rgba(15,42,84,.06); }
  /* object-position keeps the FACE in frame whatever shape the broker uploads:
     portraits and phone selfies keep the head visible instead of cropping it
     off at the top of the card. */
  .bx-shot img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    display: block; filter: grayscale(1) brightness(.86);
    transition: filter .45s ease, transform .5s cubic-bezier(.22,1,.36,1); }
  .bx-card:hover .bx-shot img { filter: grayscale(0) brightness(1); transform: scale(1.045); }
  /* Soft floor under the photo so the white icon chips stay legible over a
     pale shirt or a bright backdrop. */
  .bx-media::after { content: ''; position: absolute; inset: auto 0 0 0; height: 42%;
    border-radius: 0 0 18px 18px; pointer-events: none;
    background: linear-gradient(180deg, rgba(11,42,74,0), rgba(11,42,74,.34));
    opacity: 0; transition: opacity .35s ease; }
  .bx-card:hover .bx-media::after { opacity: 1; }

  .bx-meta { display: block; text-decoration: none; }
  .bx-name { display: block; margin-top: 13px; font-size: 1rem; font-weight: 700;
    letter-spacing: -.25px; line-height: 1.25; color: var(--navy, #0f3567);
    /* One broker is on the roster under an email address rather than a name.
       Without this it runs straight over the neighbouring card. */
    overflow-wrap: anywhere; }
  .bx-role { display: block; margin-top: 4px; font-size: .63rem; font-weight: 650;
    text-transform: uppercase; letter-spacing: .18em; color: var(--muted, #8494ab); }

  /* Socials sit ON the photo, revealed on hover. */
  .bx-social { position: absolute; left: 12px; bottom: 12px; z-index: 2;
    display: flex; align-items: center; gap: 6px;
    opacity: 0; transform: translateY(6px);
    transition: opacity .25s ease, transform .25s ease; }
  .bx-card:hover .bx-social, .bx-card:focus-within .bx-social { opacity: 1; transform: translateY(0); }
  .bx-social a { display: grid; place-items: center; width: 27px; height: 27px; border-radius: 8px;
    color: #0f3567; background: rgba(255,255,255,.92); backdrop-filter: blur(4px);
    box-shadow: 0 2px 8px rgba(11,42,74,.18); transition: transform .15s, background .15s; }
  .bx-social a:hover { background: #fff; transform: translateY(-2px); }
  .bx-social svg { width: 13px; height: 13px; display: block; }

  .bx-meta:focus-visible { outline: 2px solid var(--blue, #197bff); outline-offset: 3px; border-radius: 6px; }

  /* Two across on a phone. 138px is the smallest a headshot can be and still
     read as a face; below that the grid drops to a single column on its own. */
  @media (max-width: 780px) {
    .bx { grid-template-columns: repeat(auto-fill, minmax(138px, 1fr)); gap: 22px 14px; margin-top: 26px; }
    .bx-shot { border-radius: 14px; }
    .bx-media::after { border-radius: 0 0 14px 14px; opacity: 1; }
    .bx-name { margin-top: 10px; font-size: .92rem; }
    .bx-role { letter-spacing: .14em; }
    /* No hover on touch, so show the socials rather than hiding them behind a
       gesture that does not exist. */
    .bx-social { opacity: 1; transform: none; left: 9px; bottom: 9px; gap: 5px; }
    .bx-social a { width: 25px; height: 25px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bx-shot img, .bx-card, .bx-social { transition: none; }
    .bx-card:hover .bx-shot img { transform: none; }
  }
</style>
