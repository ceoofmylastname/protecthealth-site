---
import Base from '../../layouts/Base.astro';
import '../../styles/admin-chrome.css';

// The house-wide contact book. This is the ONLY place the whole database is
// visible: /app is deliberately a personal desk, so an admin working there sees
// their own contacts and nothing else. Everything house-wide — the 3,000-odd
// records nobody owns, another broker's book, reassigning an owner — happens
// here.
//
// Reassignment is the reason this page exists rather than being a read-only
// report. An unowned contact is invisible to every broker in the company, so
// the only way it turns into work is an admin handing it to somebody.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
---

<Base title="All Contacts, ProtectHealth Admin" description="Internal dashboard." noindex={true}>
  <section class="ad ac" data-supabase-url={SUPABASE_URL} data-supabase-anon={SUPABASE_ANON}>
    <div class="container">

      <div class="ad-view" data-view="loading">
        <div class="ad-center"><p class="ad-muted">Checking your session…</p></div>
      </div>

      <div class="ad-view" data-view="signin" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">ProtectHealth</span>
            <h1>Admin</h1>
            <p class="ad-muted">Enter your work email and we'll send a one-time sign-in link.</p>
            <form class="ad-login-form">
              <input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="email" required />
              <button type="submit" class="btn no-arrow">Send Sign-In Link</button>
            </form>
            <p class="ad-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>

      <div class="ad-view" data-view="denied" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">Not authorised</span>
            <h1>No access</h1>
            <p class="ad-muted">You're signed in as <b data-who></b>, but that address isn't on the admin list.</p>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </div>
      </div>

      <div class="ad-view" data-view="app" hidden>
        <header class="ad-head">
          <div>
            <span class="section-label">ProtectHealth Admin</span>
            <h1>All Contacts</h1>
            <nav class="ad-nav">
              <a href="/admin">Leads</a>
              <a href="/admin/contacts" class="is-on">All Contacts</a>
              <a href="/admin/calendar">House Calendar</a>
              <a href="/admin/tickets">Support Tickets</a>
              <a href="/admin/campaigns">Campaigns</a>
              <a href="/admin/staff">Staff</a>
              <a href="/app">My CRM</a>
            </nav>
          </div>
          <div class="ad-head-right">
            <span class="ad-muted ad-who" data-who></span>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </header>

        <div class="ad-stats">
          <div class="ad-stat spot"><b data-stat="total">—</b><span>Contacts in the database</span></div>
          <div class="ad-stat spot"><b data-stat="unassigned">—</b><span>With no owner</span></div>
          <div class="ad-stat spot"><b data-stat="active">—</b><span>Active clients</span></div>
          <div class="ad-stat spot"><b data-stat="new30">—</b><span>Added in 30 days</span></div>
        </div>

        <p class="ac-note ad-muted">
          A contact with no owner is invisible to every broker in the company — it only becomes
          somebody's work once it has a name against it. Assign from the Owner column, or tick
          several and assign them together.
        </p>

        <div class="ad-toolbar ac-toolbar">
          <input type="search" class="ac-search" placeholder="Search name, email or phone…" aria-label="Search contacts" />
          <select class="ac-owner-filter" aria-label="Filter by owner">
            <option value="">Every owner</option>
            <option value="__none">No owner</option>
          </select>
          <select class="ac-disp-filter" aria-label="Filter by disposition">
            <option value="">Any disposition</option>
          </select>
          <button type="button" class="cm-btn ac-clear">Clear filters</button>
          <button type="button" class="cm-btn primary ac-import">⤒ Import CSV</button>
        </div>

        <div class="ac-bulk" hidden>
          <span class="ac-bulk-n"></span>
          <select class="ac-bulk-owner" aria-label="Assign selected to">
            <option value="">Assign selected to…</option>
          </select>
          <button type="button" class="ac-bulk-go">Assign</button>
          <button type="button" class="ac-bulk-clear">Clear selection</button>
          <span class="ac-bulk-status" role="status"></span>
        </div>

        <p class="ac-count ad-muted"></p>
        <div class="ac-list"></div>
        <div class="ac-pager"></div>
      </div>

    </div>

    <!-- CSV import wizard. Inside .ac on purpose: every helper on this page is
         scoped to that root, so a modal hung off <body> would be invisible to
         them. -->
    <div class="ac-imp" hidden>
      <div class="ac-imp-back"></div>
      <div class="ac-imp-card" role="dialog" aria-modal="true" aria-label="Import from CSV">
        <button type="button" class="ac-imp-x" aria-label="Close">×</button>
        <div class="ac-imp-body"></div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .ac .ad-nav { display: flex; gap: 18px; margin-top: 10px; flex-wrap: wrap; }
  .ac .ad-nav a { font-size: 0.9rem; font-weight: 700; color: var(--muted); text-decoration: none; padding-bottom: 3px; border-bottom: 2px solid transparent; }
  .ac .ad-nav a.is-on, .ac .ad-nav a:hover { color: var(--blue); border-color: var(--blue); }
  .ac-note { margin: -6px 0 18px; font-size: 0.86rem; max-width: 76ch; line-height: 1.65; }

  .ac-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
  .ac-toolbar input, .ac-toolbar select {
    padding: 10px 13px; border: 1.5px solid var(--line); border-radius: 10px;
    font-family: var(--font); font-size: 0.9rem; background: #fff; color: var(--ink);
  }
  .ac-search { flex: 1 1 260px; min-width: 0; }
  .ac-toolbar input:focus, .ac-toolbar select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(25,123,255,.13); }

  .ac-bulk {
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
    background: #eef3f8; border: 1.5px solid var(--line); border-radius: 12px;
    padding: 11px 14px; margin-bottom: 14px;
  }
  /* Same trap as the ticket modal: a class rule with a display value beats the
   * UA's `[hidden]`, so this bar showed with nothing selected. */
  .ac-bulk[hidden] { display: none; }
  .ac-bulk-n { font-weight: 800; color: var(--navy, #0b2a4a); font-size: 0.9rem; }
  .ac-bulk select { padding: 8px 11px; border: 1.5px solid var(--line); border-radius: 9px; font-family: var(--font); font-size: 0.86rem; background: #fff; }
  .ac-bulk button { padding: 8px 15px; border: 0; border-radius: 9px; font-family: var(--font); font-weight: 700; font-size: 0.86rem; cursor: pointer; }
  .ac-bulk-go { background: var(--navy, #0b2a4a); color: #fff; }
  .ac-bulk-go:hover { background: var(--blue); }
  .ac-bulk-go:disabled { opacity: .55; cursor: default; }
  .ac-bulk-clear { background: #fff; border: 1.5px solid var(--line) !important; color: var(--ink); }
  .ac-bulk-status { font-size: 0.85rem; color: var(--muted); }
  .ac-bulk-status.is-bad { color: #b3261e; }
  .ac-bulk-status.is-good { color: #0a7d3c; }

  .ac-count { font-size: 0.84rem; margin: 0 0 10px; }

  .ac-list { overflow-x: auto; border: 1.5px solid var(--line); border-radius: 14px; background: #fff; }
  .ac-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .ac-table th {
    text-align: left; padding: 12px 14px; font-size: 0.72rem; letter-spacing: 1px;
    text-transform: uppercase; color: var(--muted); border-bottom: 1.5px solid var(--line); white-space: nowrap;
  }
  .ac-table td { padding: 11px 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .ac-table tr:last-child td { border-bottom: 0; }
  .ac-table tr.is-picked td { background: #f3f8ff; }
  .ac-nm { font-weight: 700; color: var(--ink); }
  .ac-sub { color: var(--muted); font-size: 0.82rem; }
  .ac-sub a { color: var(--blue); text-decoration: none; }
  .ac-pick { width: 16px; height: 16px; accent-color: var(--blue); cursor: pointer; }

  .ac-pill { font-size: 0.68rem; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: #eef3f8; color: #5a6f85; white-space: nowrap; }
  .ac-pill.green { background: #e6f7ed; color: #16803c; }
  .ac-pill.blue { background: #eaf3ff; color: #0f3567; }
  .ac-pill.amber { background: #fdf3e3; color: #96690d; }
  .ac-pill.red { background: #fdecea; color: #b3261e; }

  .ac-own { padding: 7px 10px; border: 1.5px solid var(--line); border-radius: 9px; font-family: var(--font); font-size: 0.84rem; background: #fff; max-width: 210px; }
  .ac-own:focus { outline: none; border-color: var(--blue); }
  .ac-own.is-none { border-color: #e6c98a; background: #fffaf0; }
  .ac-own:disabled { opacity: .55; }
  .ac-saved { font-size: 0.78rem; font-weight: 700; color: #16803c; margin-left: 7px; }
  .ac-saved.is-bad { color: #b3261e; }

  .ac-pager { display: flex; gap: 8px; align-items: center; justify-content: center; padding: 16px 0 4px; flex-wrap: wrap; }
  .ac-pager button {
    padding: 8px 14px; border: 1.5px solid var(--line); border-radius: 9px; background: #fff;
    font-family: var(--font); font-weight: 700; font-size: 0.85rem; cursor: pointer; color: var(--ink);
  }
  .ac-pager button:hover:not(:disabled) { border-color: var(--blue); color: var(--blue); }
  .ac-pager button:disabled { opacity: .45; cursor: default; }
  .ac-pager span { font-size: 0.85rem; color: var(--muted); }
  .ac-empty { padding: 30px; text-align: center; color: var(--muted); }

  /* ---------- CSV import ---------- */
  /* .cm-btn is the shared admin button vocabulary. It was only ever defined
   * inside /admin/campaigns, so the toolbar's Clear filters button on this page
   * rendered as a bare UA button. Same rules, defined where they are used. */
  .cm-btn {
    padding: 10px 18px; border-radius: 10px; border: 1.5px solid var(--line); background: #fff;
    font-family: var(--font); font-weight: 700; font-size: 0.9rem; cursor: pointer; color: var(--ink);
  }
  .cm-btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
  .cm-btn:disabled { opacity: .5; cursor: default; }
  .cm-field { display: grid; gap: 5px; margin-bottom: 12px; }
  .cm-field label { font-size: 0.72rem; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; color: var(--muted); }
  .cm-field input, .cm-field select {
    padding: 10px 12px; border-radius: 10px; border: 1.5px solid var(--line);
    font-family: var(--font); font-size: 0.94rem; background: #fff; width: 100%;
  }
  .cm-field input:focus, .cm-field select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(25,123,255,.13); }

  .ac-imp { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 20px 14px; }
  /* Same trap as the ticket modal and the bulk bar: a class rule with a display
   * value beats the UA's `[hidden]`, so this has to say so explicitly. */
  .ac-imp[hidden] { display: none; }
  .ac-imp-back { position: absolute; inset: 0; background: rgba(11,42,74,.42); backdrop-filter: blur(2px); }
  .ac-imp-card {
    position: relative; background: #fff; border-radius: 18px; width: min(860px, 100%);
    max-height: 88vh; overflow: auto; box-shadow: 0 24px 70px rgba(11,42,74,.28); padding: 26px 26px 30px;
  }
  .ac-imp-x { position: absolute; top: 12px; right: 14px; background: none; border: 0; font-size: 1.8rem; line-height: 1; color: var(--muted); cursor: pointer; padding: 4px 8px; }
  .ac-imp-x:hover { color: var(--ink); }
  .ac-imp-h { margin: 0 30px 3px 0; font-size: 1.28rem; color: var(--ink); line-height: 1.25; }
  .ac-imp-sub { color: var(--muted); font-size: 0.86rem; margin: 0 0 18px; }
  .ac-imp-sec { font-size: 0.72rem; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; color: var(--muted); margin: 20px 0 9px; }
  .ac-imp-opt { display: flex; gap: 9px; align-items: flex-start; font-size: 0.9rem; padding: 5px 0; cursor: pointer; }
  .ac-imp-opt input { width: 16px; height: 16px; margin-top: 2px; accent-color: var(--blue); flex: none; }
  .ac-imp-opt b { color: var(--ink); }
  .ac-imp-note { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin: 6px 0 0; }
  .ac-imp-note.is-bad { color: #b3261e; }
  .ac-imp-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .ac-imp-wrap { overflow-x: auto; border: 1.5px solid var(--line); border-radius: 12px; }
  .ac-imp-wrap .ac-table td, .ac-imp-wrap .ac-table th { white-space: nowrap; padding: 9px 11px; }
  .ac-imp-wrap select { padding: 7px 9px; border: 1.5px solid var(--line); border-radius: 9px; font-family: var(--font); font-size: 0.83rem; background: #fff; min-width: 160px; }
  .ac-imp-bar { height: 9px; border-radius: 999px; background: #eef3f8; overflow: hidden; margin: 6px 0 8px; }
  .ac-imp-bar span { display: block; height: 100%; width: 0; background: linear-gradient(120deg, var(--blue), #19c8ff); transition: width .2s; }
  .ac-imp-res { display: grid; grid-template-columns: 190px 1fr; gap: 7px 14px; font-size: 0.9rem; }
  .ac-imp-res .k { color: var(--muted); font-weight: 700; }
  .ac-imp-errs { max-height: 260px; overflow-y: auto; border: 1.5px solid var(--line); border-radius: 12px; }
  .ac-imp-err { padding: 9px 12px; border-bottom: 1px solid var(--line); font-size: 0.85rem; }
  .ac-imp-err:last-child { border-bottom: 0; }
  .ac-imp-err b { color: var(--ink); }
  .ac-imp-err span { color: var(--muted); }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  // CSV import: parser, alias table, matching rules and the batch runner. Shared
  // verbatim with the broker CRM at /app so the two importers cannot drift.
  import {
    readCsv, fieldsFor, matchOptions, autoMap, sampleValues, objectLabel,
    failedRowsCsv, runImport, BATCH_SIZE,
  } from '../../lib/csv-import';

  const root = document.querySelector('.ac');
  if (root) {
    const sb = createClient(
      root.getAttribute('data-supabase-url'),
      root.getAttribute('data-supabase-anon'),
      { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } },
    );

    const $ = (s) => root.querySelector(s);
    const $$ = (s) => Array.from(root.querySelectorAll(s));
    const view = (n) => $$('.ad-view').forEach((v) => (v.hidden = v.getAttribute('data-view') !== n));
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    const PER = 50;
    const DISPOSITIONS = ['Lead', 'Active Client', 'Follow-Up', 'Not Interested', 'No Answer', 'Wrong Number', 'Do Not Call'];
    const PILL = {
      'Active Client': 'green', 'Lead': 'blue', 'Follow-Up': 'amber',
      'Wrong Number': 'red', 'Do Not Call': 'red',
    };

    let agents = [];          // active roster, for the owner dropdowns
    let agentName = new Map();
    let rows = [];
    let total = 0;
    let page = 0;
    let query = '';
    let ownerFilter = '';     // '' = any, '__none' = unassigned, else agent id
    let dispFilter = '';
    let picked = new Set();
    let searchTimer = null;
    let customFields = [];    // ph_custom_fields, offered as import targets

    const fmtPhone = (p) => {
      const d = String(p ?? '').replace(/\D/g, '').replace(/^1/, '');
      return d.length === 10 ? `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}` : (p || '');
    };
    const fmtDate = (s) => {
      if (!s) return '';
      const d = new Date(s);
      return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    };
    const nameOf = (c) => [c.first_name, c.last_name].filter(Boolean).join(' ').trim() || '(no name)';

    // ---------- sign in / out ----------
    $('.ad-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = $('.ad-status');
      status.classList.remove('is-bad');
      status.textContent = 'Sending…';
      const { error } = await sb.auth.signInWithOtp({
        email: e.target.email.value.trim(),
        options: { emailRedirectTo: `${location.origin}/admin/contacts` },
      });
      if (error) { status.classList.add('is-bad'); status.textContent = error.message; }
      else status.textContent = 'Check your inbox. The link signs you straight in.';
    });

    $$('.ad-signout').forEach((b) => b.addEventListener('click', async () => {
      await sb.auth.signOut(); location.reload();
    }));

    // ---------- filters ----------
    $('.ac-search').addEventListener('input', (e) => {
      // Typing hits an 8,000-row table, so wait for a pause rather than firing
      // a query per keystroke.
      clearTimeout(searchTimer);
      const v = e.target.value.trim();
      searchTimer = setTimeout(() => { query = v; page = 0; clearPicks(); loadRows(); }, 300);
    });
    $('.ac-owner-filter').addEventListener('change', (e) => { ownerFilter = e.target.value; page = 0; clearPicks(); loadRows(); });
    $('.ac-disp-filter').addEventListener('change', (e) => { dispFilter = e.target.value; page = 0; clearPicks(); loadRows(); });
    $('.ac-clear').addEventListener('click', () => {
      query = ''; ownerFilter = ''; dispFilter = ''; page = 0;
      $('.ac-search').value = ''; $('.ac-owner-filter').value = ''; $('.ac-disp-filter').value = '';
      clearPicks(); loadRows();
    });

    // ---------- selection + bulk assign ----------
    function clearPicks() { picked.clear(); paintBulk(); }
    function paintBulk() {
      const bar = $('.ac-bulk');
      bar.hidden = picked.size === 0;
      $('.ac-bulk-n').textContent = picked.size === 1 ? '1 contact selected' : `${picked.size} contacts selected`;
      $$('.ac-table tr[data-cid]').forEach((tr) => tr.classList.toggle('is-picked', picked.has(tr.getAttribute('data-cid'))));
    }
    $('.ac-bulk-clear').addEventListener('click', () => { clearPicks(); renderRows(); });

    $('.ac-bulk-go').addEventListener('click', async () => {
      const sel = $('.ac-bulk-owner');
      const val = sel.value;
      const st = $('.ac-bulk-status');
      st.classList.remove('is-good', 'is-bad');
      if (!val) { st.textContent = 'Pick who they go to first.'; st.classList.add('is-bad'); return; }
      const ids = Array.from(picked);
      const who = val === '__none' ? 'no owner' : (agentName.get(val) || 'that broker');
      if (!confirm(`Assign ${ids.length} contact${ids.length === 1 ? '' : 's'} to ${who}?`)) return;

      const btn = $('.ac-bulk-go');
      btn.disabled = true; st.textContent = 'Assigning…';
      // Chunked so one oversized URL cannot fail the whole batch.
      let done = 0, failed = 0;
      for (let i = 0; i < ids.length; i += 100) {
        const slice = ids.slice(i, i + 100);
        const { error } = await sb.from('ph_contacts')
          .update({ agent_id: val === '__none' ? null : val })
          .in('ghl_contact_id', slice);
        if (error) failed += slice.length; else done += slice.length;
      }
      btn.disabled = false;
      if (failed) { st.textContent = `${done} assigned, ${failed} failed.`; st.classList.add('is-bad'); }
      else { st.textContent = `${done} assigned to ${who}.`; st.classList.add('is-good'); }
      sel.value = '';
      clearPicks();
      await Promise.all([loadRows(), loadStats()]);
    });

    // ---------- data ----------
    async function loadAgents() {
      const { data } = await sb.from('ph_agents')
        .select('id, full_name, email, is_active')
        .eq('is_active', true).order('full_name');
      agents = data ?? [];
      agentName = new Map(agents.map((a) => [a.id, a.full_name || a.email]));

      const opts = agents.map((a) => `<option value="${esc(a.id)}">${esc(a.full_name || a.email)}</option>`).join('');
      $('.ac-owner-filter').innerHTML =
        '<option value="">Every owner</option><option value="__none">No owner</option>' + opts;
      $('.ac-bulk-owner').innerHTML =
        '<option value="">Assign selected to…</option>' + opts + '<option value="__none">Remove the owner</option>';
      $('.ac-disp-filter').innerHTML =
        '<option value="">Any disposition</option>' + DISPOSITIONS.map((d) => `<option value="${esc(d)}">${esc(d)}</option>`).join('');
    }

    async function loadCustomFields() {
      const { data } = await sb.from('ph_custom_fields')
        .select('key, label').eq('is_active', true).order('position');
      customFields = data ?? [];
    }

    async function loadStats() {
      const [statsRes, unRes] = await Promise.all([
        // p_all is the house-wide switch; the same RPC with no argument is what
        // /app calls for a personal book.
        sb.rpc('ph_dashboard_stats', { p_all: true }),
        sb.from('ph_contacts').select('*', { count: 'exact', head: true }).is('agent_id', null),
      ]);
      const d = statsRes.data || {};
      const set = (k, v) => { const el = $(`[data-stat="${k}"]`); if (el) el.textContent = Number(v || 0).toLocaleString(); };
      set('total', d.total_contacts);
      set('unassigned', unRes.count);
      set('active', d.active_clients);
      set('new30', d.new_30);
    }

    function buildQuery(forCount) {
      let q = sb.from('ph_contacts')
        .select('ghl_contact_id, first_name, last_name, email, phone, disposition, source, origin, agent_id, ghl_date_added',
          forCount ? { count: 'exact' } : undefined);
      if (query) {
        const s = query.replace(/[%,()]/g, ' ');
        q = q.or(`first_name.ilike.%${s}%,last_name.ilike.%${s}%,email.ilike.%${s}%,phone.ilike.%${s}%`);
      }
      if (ownerFilter === '__none') q = q.is('agent_id', null);
      else if (ownerFilter) q = q.eq('agent_id', ownerFilter);
      if (dispFilter) q = q.eq('disposition', dispFilter);
      return q;
    }

    async function loadRows() {
      $('.ac-list').innerHTML = '<div class="ac-empty">Loading…</div>';
      const { data, count, error } = await buildQuery(true)
        .order('ghl_date_added', { ascending: false, nullsFirst: false })
        .range(page * PER, page * PER + PER - 1);
      if (error) {
        $('.ac-list').innerHTML = `<div class="ac-empty">Could not load contacts: ${esc(error.message)}</div>`;
        return;
      }
      rows = data ?? [];
      total = count ?? 0;
      renderRows();
      renderPager();
    }

    function renderRows() {
      const host = $('.ac-list');
      if (!rows.length) {
        host.innerHTML = '<div class="ac-empty">No contacts match these filters.</div>';
        $('.ac-count').textContent = '0 contacts';
        return;
      }
      const from = page * PER + 1;
      const to = Math.min(total, page * PER + rows.length);
      $('.ac-count').textContent = `Showing ${from.toLocaleString()}–${to.toLocaleString()} of ${total.toLocaleString()} contacts`;

      const ownerOpts = (cur) =>
        `<option value="__none"${!cur ? ' selected' : ''}>— No owner —</option>` +
        agents.map((a) => `<option value="${esc(a.id)}"${a.id === cur ? ' selected' : ''}>${esc(a.full_name || a.email)}</option>`).join('') +
        // A contact owned by a deactivated broker would otherwise silently show
        // as unowned in this dropdown, so keep that name visible.
        (cur && !agentName.has(cur) ? `<option value="${esc(cur)}" selected>Inactive broker</option>` : '');

      host.innerHTML = `<table class="ac-table">
        <thead><tr>
          <th><input type="checkbox" class="ac-pick ac-pick-all" aria-label="Select all on this page" /></th>
          <th>Name</th><th>Contact</th><th>Disposition</th><th>Source</th><th>Owner</th><th>Added</th>
        </tr></thead>
        <tbody>${rows.map((c) => {
          const cid = c.ghl_contact_id;
          const cls = PILL[c.disposition] || '';
          return `<tr data-cid="${esc(cid)}"${picked.has(cid) ? ' class="is-picked"' : ''}>
            <td><input type="checkbox" class="ac-pick ac-pick-one" data-cid="${esc(cid)}"${picked.has(cid) ? ' checked' : ''} aria-label="Select ${esc(nameOf(c))}" /></td>
            <td><div class="ac-nm">${esc(nameOf(c))}</div></td>
            <td>
              <div class="ac-sub">${c.email ? `<a href="mailto:${esc(c.email)}">${esc(c.email)}</a>` : '—'}</div>
              <div class="ac-sub">${esc(fmtPhone(c.phone)) || '—'}</div>
            </td>
            <td>${c.disposition ? `<span class="ac-pill ${cls}">${esc(c.disposition)}</span>` : '<span class="ac-sub">—</span>'}</td>
            <td><div class="ac-sub">${esc(c.source || c.origin || '—')}</div></td>
            <td>
              <select class="ac-own${c.agent_id ? '' : ' is-none'}" data-cid="${esc(cid)}">${ownerOpts(c.agent_id)}</select>
              <span class="ac-saved" data-saved="${esc(cid)}"></span>
            </td>
            <td><div class="ac-sub">${esc(fmtDate(c.ghl_date_added))}</div></td>
          </tr>`;
        }).join('')}</tbody></table>`;

      $$('.ac-own').forEach((sel) => sel.addEventListener('change', onReassign));
      $$('.ac-pick-one').forEach((box) => box.addEventListener('change', () => {
        const cid = box.getAttribute('data-cid');
        if (box.checked) picked.add(cid); else picked.delete(cid);
        paintBulk();
      }));
      const all = $('.ac-pick-all');
      all.checked = rows.length > 0 && rows.every((c) => picked.has(c.ghl_contact_id));
      all.addEventListener('change', () => {
        rows.forEach((c) => { if (all.checked) picked.add(c.ghl_contact_id); else picked.delete(c.ghl_contact_id); });
        $$('.ac-pick-one').forEach((b) => (b.checked = all.checked));
        paintBulk();
      });
      paintBulk();
    }

    async function onReassign(e) {
      const sel = e.target;
      const cid = sel.getAttribute('data-cid');
      const val = sel.value;
      // Contact ids carry prefixes like `crm:` and `local:`, so look the flag up
      // by scanning rather than building a selector that would need escaping.
      const flag = $$('.ac-saved').find((el) => el.getAttribute('data-saved') === cid);
      if (!flag) return;
      sel.disabled = true;
      flag.classList.remove('is-bad');
      flag.textContent = 'Saving…';

      const { error } = await sb.from('ph_contacts')
        .update({ agent_id: val === '__none' ? null : val })
        .eq('ghl_contact_id', cid);
      sel.disabled = false;

      if (error) {
        flag.textContent = 'Failed';
        flag.classList.add('is-bad');
        return;
      }
      sel.classList.toggle('is-none', val === '__none');
      const row = rows.find((r) => r.ghl_contact_id === cid);
      if (row) row.agent_id = val === '__none' ? null : val;
      flag.textContent = 'Saved';
      setTimeout(() => { flag.textContent = ''; }, 2000);
      loadStats();
      // A row that no longer matches an owner filter should leave the list.
      if (ownerFilter) loadRows();
    }

    function renderPager() {
      const pages = Math.max(1, Math.ceil(total / PER));
      $('.ac-pager').innerHTML = `
        <button type="button" data-pg="first"${page === 0 ? ' disabled' : ''}>« First</button>
        <button type="button" data-pg="prev"${page === 0 ? ' disabled' : ''}>‹ Back</button>
        <span>Page ${(page + 1).toLocaleString()} of ${pages.toLocaleString()}</span>
        <button type="button" data-pg="next"${page + 1 >= pages ? ' disabled' : ''}>Next ›</button>
        <button type="button" data-pg="last"${page + 1 >= pages ? ' disabled' : ''}>Last »</button>`;
      $$('.ac-pager button').forEach((b) => b.addEventListener('click', () => {
        const to = b.getAttribute('data-pg');
        if (to === 'first') page = 0;
        else if (to === 'prev') page = Math.max(0, page - 1);
        else if (to === 'next') page = page + 1;
        else page = pages - 1;
        loadRows();
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
    }

    // ---------- CSV import ----------
    // Four steps in the modal: file → behaviour → column mapping → run. This
    // page is admin-only by definition, so the owner picker is always shown and
    // "Unassigned / house" is a real choice here in a way it is not in /app.
    // The parser, alias table, matching rules and batch runner are shared with
    // /app via src/lib/csv-import.ts.
    const impModal = $('.ac-imp');
    const impBody = $('.ac-imp-body');
    let imp = null;

    $('.ac-import').addEventListener('click', openImport);
    $('.ac-imp-x').addEventListener('click', closeImport);
    $('.ac-imp-back').addEventListener('click', closeImport);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !impModal.hidden && !(imp && imp.running)) closeImport();
    });

    function openImport() {
      if (imp && imp.downloadUrl) URL.revokeObjectURL(imp.downloadUrl);
      imp = {
        step: 1, target: 'contacts', header: [], rows: [], lines: [], mapping: [],
        fileName: '', mode: 'create_update', matchField: 'email', skipBlanks: true,
        ownerId: null, running: false, result: null, fatal: null, downloadUrl: null,
      };
      impModal.hidden = false;
      paintImport();
    }
    function closeImport() {
      impModal.hidden = true;
      if (imp && imp.downloadUrl) { URL.revokeObjectURL(imp.downloadUrl); imp.downloadUrl = null; }
    }

    const impFields = () => fieldsFor(imp.target, customFields);
    const impGo = (n) => { imp.step = n; paintImport(); };

    function paintImport() {
      const steps = ['File', 'Behaviour', 'Columns', 'Import'];
      const body = imp.step === 1 ? impStep1() : imp.step === 2 ? impStep2() : imp.step === 3 ? impStep3() : impStep4();
      impBody.innerHTML = `
        <h2 class="ac-imp-h">Import from CSV</h2>
        <p class="ac-imp-sub">Step ${imp.step} of 4 · ${esc(steps[imp.step - 1])}${imp.fileName ? ' · ' + esc(imp.fileName) : ''}</p>
        ${body}`;
      if (imp.step === 1) wireStep1();
      else if (imp.step === 2) wireStep2();
      else if (imp.step === 3) wireStep3();
      else wireStep4();
    }

    // ---- step 1: what, and from which file ----
    function impStep1() {
      const t = (v, label, hint) => `
        <label class="ac-imp-opt"><input type="radio" name="imp-target" value="${v}"${imp.target === v ? ' checked' : ''} />
          <span><b>${esc(label)}</b> — ${esc(hint)}</span></label>`;
      return `
        <div class="ac-imp-sec">What are you importing</div>
        ${t('contacts', 'Contacts', 'people, into ph_contacts')}
        ${t('companies', 'Companies', 'group / employer records')}
        <div class="ac-imp-sec">Your file</div>
        <div class="cm-field"><label>CSV file</label><input type="file" class="imp-file" accept=".csv,text/csv" /></div>
        <p class="ac-imp-note imp-msg">The first row must be the column headings. Quoted fields, commas and line breaks inside quotes are all handled.</p>
        <div class="ac-imp-actions">
          <button type="button" class="cm-btn primary imp-next" disabled>Next</button>
          <button type="button" class="cm-btn imp-cancel">Cancel</button>
        </div>`;
    }

    function wireStep1() {
      $$('[name="imp-target"]').forEach((r) => r.addEventListener('change', () => {
        imp.target = r.value; imp.matchField = imp.target === 'companies' ? 'name' : 'email'; imp.mapping = [];
      }));
      // Updated in place rather than repainted: a repaint would replace the file
      // input and drop the file the browser is holding for us.
      $('.imp-file').addEventListener('change', async (e) => {
        const msg = $('.imp-msg'), next = $('.imp-next');
        const f = e.target.files && e.target.files[0];
        imp.header = []; imp.rows = []; imp.lines = []; imp.mapping = []; imp.fileName = '';
        next.disabled = true; msg.classList.remove('is-bad');
        if (!f) { msg.textContent = 'Pick a .csv file to continue.'; return; }
        msg.textContent = 'Reading…';
        let text = '';
        try { text = await f.text(); }
        catch { msg.textContent = 'That file could not be read.'; msg.classList.add('is-bad'); return; }
        const r = readCsv(text);
        if (r.error) { msg.textContent = r.error; msg.classList.add('is-bad'); return; }
        imp.header = r.header; imp.rows = r.rows; imp.lines = r.lines; imp.fileName = f.name;
        msg.textContent = `${r.rows.length.toLocaleString()} data row${r.rows.length === 1 ? '' : 's'} · ${r.header.length} column${r.header.length === 1 ? '' : 's'}.`;
        next.disabled = false;
      });
      $('.imp-next').addEventListener('click', () => { if (imp.rows.length) impGo(2); });
      $('.imp-cancel').addEventListener('click', closeImport);
    }

    // ---- step 2: create, update, or both ----
    function impStep2() {
      const mode = (v, label, hint) => `
        <label class="ac-imp-opt"><input type="radio" name="imp-mode" value="${v}"${imp.mode === v ? ' checked' : ''} />
          <span><b>${esc(label)}</b> — ${esc(hint)}</span></label>`;
      return `
        <div class="ac-imp-sec">What to do with each row</div>
        ${mode('create', 'Create only', 'skip anything that already exists')}
        ${mode('create_update', 'Create and update', 'add the new, patch the matches')}
        ${mode('update', 'Update only', 'skip anything we do not already have')}
        <div class="ac-imp-sec">Matching</div>
        <div class="cm-field"><label>Find existing records based on</label>
          <select class="imp-match">${matchOptions(imp.target).map((o) => `<option value="${esc(o.value)}"${imp.matchField === o.value ? ' selected' : ''}>${esc(o.label)}</option>`).join('')}</select>
        </div>
        <p class="ac-imp-note">Email is compared lowercase and trimmed; phone is compared on digits only with a leading 1 stripped, so (702) 555-0134 and +1 702 555 0134 are the same person.</p>
        <label class="ac-imp-opt" style="margin-top:10px"><input type="checkbox" class="imp-blanks"${imp.skipBlanks ? ' checked' : ''} />
          <span>Don't overwrite existing values with blanks</span></label>
        <div class="ac-imp-sec">Owner</div>
        <div class="cm-field"><label>Assign every imported record to</label>
          <select class="imp-owner">
            <option value=""${imp.ownerId ? '' : ' selected'}>Unassigned / house</option>
            ${agents.map((a) => `<option value="${esc(a.id)}"${imp.ownerId === a.id ? ' selected' : ''}>${esc(a.full_name || a.email)}</option>`).join('')}
          </select>
        </div>
        <p class="ac-imp-note">An unassigned contact is invisible to every broker in the company until somebody is put against it.</p>
        <div class="ac-imp-actions">
          <button type="button" class="cm-btn imp-back">Back</button>
          <button type="button" class="cm-btn primary imp-next">Next</button>
        </div>`;
    }

    function wireStep2() {
      $$('[name="imp-mode"]').forEach((r) => r.addEventListener('change', () => { imp.mode = r.value; }));
      $('.imp-match').addEventListener('change', (e) => { imp.matchField = e.target.value; });
      $('.imp-blanks').addEventListener('change', (e) => { imp.skipBlanks = e.target.checked; });
      $('.imp-owner').addEventListener('change', (e) => { imp.ownerId = e.target.value || null; });
      $('.imp-back').addEventListener('click', () => impGo(1));
      $('.imp-next').addEventListener('click', () => {
        // Guess once, so a mapping the admin has corrected survives a trip back.
        if (!imp.mapping.length) imp.mapping = autoMap(imp.header, impFields());
        impGo(3);
      });
    }

    // ---- step 3: one row per column in the file ----
    function impStep3() {
      const fields = impFields();
      const obj = objectLabel(imp.target);
      const body = imp.header.map((h, i) => {
        const val = imp.mapping[i] || '';
        const samples = sampleValues(imp.rows, i);
        return `<tr>
          <td class="ac-nm">${esc(h || 'Column ' + (i + 1))}</td>
          <td class="ac-sub">${esc(samples.join(' · ')) || '—'}</td>
          <td><span class="ac-pill${val ? ' green' : ''}" data-mapstatus="${i}">${val ? 'Mapped' : 'Not mapped'}</span></td>
          <td><select disabled><option>${esc(obj)}</option></select></td>
          <td><select data-map="${i}">
            <option value="">— Not mapped —</option>
            ${fields.map((f) => `<option value="${esc(f.value)}"${val === f.value ? ' selected' : ''}>${esc(f.label)}</option>`).join('')}
          </select></td>
        </tr>`;
      }).join('');
      const label = (matchOptions(imp.target).find((o) => o.value === imp.matchField) || {}).label || imp.matchField;
      return `
        <div class="ac-imp-sec">Match your columns</div>
        <p class="ac-imp-note" style="margin-bottom:12px">Anything left unmapped is skipped. <b>Note</b> writes into the contact's notes tab rather than a field. Tags and lines of insurance split on <b>;</b> or <b>,</b>.</p>
        <div class="ac-imp-wrap"><table class="ac-table">
          <thead><tr><th>Column in file</th><th>Sample values</th><th>Status</th><th>Object</th><th>Field</th></tr></thead>
          <tbody>${body}</tbody>
        </table></div>
        <p class="ac-imp-note imp-msg">Matching on <b>${esc(label)}</b> — that column has to be mapped.</p>
        <div class="ac-imp-actions">
          <button type="button" class="cm-btn imp-back">Back</button>
          <button type="button" class="cm-btn primary imp-next">Start import</button>
        </div>`;
    }

    function wireStep3() {
      $$('[data-map]').forEach((sel) => sel.addEventListener('change', () => {
        const i = Number(sel.getAttribute('data-map'));
        imp.mapping[i] = sel.value;
        const pill = $$('[data-mapstatus]').find((el) => el.getAttribute('data-mapstatus') === String(i));
        if (!pill) return;
        pill.textContent = sel.value ? 'Mapped' : 'Not mapped';
        pill.classList.toggle('green', !!sel.value);
      }));
      $('.imp-back').addEventListener('click', () => impGo(2));
      $('.imp-next').addEventListener('click', () => {
        const msg = $('.imp-msg');
        const label = (matchOptions(imp.target).find((o) => o.value === imp.matchField) || {}).label || imp.matchField;
        if (imp.mapping.indexOf(imp.matchField) < 0) {
          msg.innerHTML = `You chose to find existing records by <b>${esc(label)}</b>, but no column in the file is mapped to it. Map one, or go back and match on something else.`;
          msg.classList.add('is-bad');
          return;
        }
        if (!imp.mapping.filter(Boolean).length) {
          msg.textContent = 'Nothing is mapped yet, so there is nothing to import.';
          msg.classList.add('is-bad');
          return;
        }
        msg.classList.remove('is-bad');
        impRun();
      });
    }

    // ---- step 4: run it, then show what happened ----
    function impStep4() {
      if (imp.fatal) {
        return `<div class="ac-imp-sec">Import stopped</div>
          <p class="ac-imp-note is-bad">${esc(imp.fatal)}</p>
          <div class="ac-imp-actions"><button type="button" class="cm-btn primary imp-done">Close</button></div>`;
      }
      if (!imp.result) {
        return `
          <div class="ac-imp-sec">Importing</div>
          <p class="ac-imp-note" style="margin-bottom:10px">${imp.rows.length.toLocaleString()} rows, ${BATCH_SIZE} at a time. Leave this open until it finishes.</p>
          <div class="ac-imp-bar"><span class="imp-fill"></span></div>
          <p class="ac-imp-note imp-count">0 of ${imp.rows.length.toLocaleString()}</p>`;
      }
      const r = imp.result;
      const n = (x) => Number(x || 0).toLocaleString();
      const shown = r.errors.slice(0, 100);
      return `
        <div class="ac-imp-sec">Results</div>
        <div class="ac-imp-res">
          <div class="k">Created</div><div>${n(r.created)}</div>
          <div class="k">Updated</div><div>${n(r.updated)}</div>
          <div class="k">Skipped as duplicate</div><div>${n(r.skippedDuplicate)}</div>
          <div class="k">Skipped as not found</div><div>${n(r.skippedNotFound)}</div>
          <div class="k">Failed</div><div>${n(r.failed)}</div>
        </div>
        ${r.noteErrors.length ? `<p class="ac-imp-note is-bad">Some notes could not be saved: ${esc(r.noteErrors[0])}</p>` : ''}
        ${r.errors.length ? `
          <div class="ac-imp-sec">What failed</div>
          <div class="ac-imp-errs">${shown.map((e) => `<div class="ac-imp-err"><b>Row ${e.line}</b> <span>${esc(e.message)}</span></div>`).join('')}</div>
          ${r.errors.length > shown.length ? `<p class="ac-imp-note">…and ${n(r.errors.length - shown.length)} more. Download the file below for all of them.</p>` : ''}
          <div class="ac-imp-actions"><button type="button" class="cm-btn imp-dl">Download failed rows</button></div>` : '<p class="ac-imp-note">No errors.</p>'}
        <div class="ac-imp-actions"><button type="button" class="cm-btn primary imp-done">Done</button></div>`;
    }

    function wireStep4() {
      $('.imp-done')?.addEventListener('click', closeImport);
      $('.imp-dl')?.addEventListener('click', () => {
        const csv = failedRowsCsv(imp.header, imp.result.errors);
        if (imp.downloadUrl) URL.revokeObjectURL(imp.downloadUrl);
        // BOM so Excel opens the accented names correctly.
        const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
        imp.downloadUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = imp.downloadUrl;
        a.download = (imp.fileName || 'import').replace(/\.csv$/i, '') + '-failed.csv';
        a.click();
      });
    }

    async function impRun() {
      imp.running = true; imp.result = null; imp.fatal = null;
      impGo(4);
      const fill = $('.imp-fill'), count = $('.imp-count');
      const total = imp.rows.length;
      try {
        imp.result = await runImport(sb, {
          target: imp.target, header: imp.header, rows: imp.rows, lines: imp.lines,
          mapping: imp.mapping, mode: imp.mode, matchField: imp.matchField,
          skipBlanks: imp.skipBlanks, ownerId: imp.ownerId,
        }, (done) => {
          if (fill) fill.style.width = (total ? Math.round((done / total) * 100) : 100) + '%';
          if (count) count.textContent = `${done.toLocaleString()} of ${total.toLocaleString()}`;
        });
      } catch (err) {
        imp.fatal = 'Could not finish the import: ' + ((err && err.message) || err);
      }
      imp.running = false;
      paintImport();
      if (imp.result) {
        clearPicks();
        await Promise.all([loadRows(), loadStats()]);
      }
    }

    // ---------- boot ----------
    async function boot() {
      const { data: { session } } = await sb.auth.getSession();
      if (!session) { view('signin'); return; }
      $$('[data-who]').forEach((el) => (el.textContent = session.user.email || ''));

      // Admin gate: ph_admins is readable only by admins, so an empty result is
      // the answer, not an error.
      const { data: admin } = await sb.from('ph_admins').select('email').limit(1);
      if (!admin || !admin.length) { view('denied'); return; }
      view('app');

      await loadAgents();
      await Promise.all([loadRows(), loadStats(), loadCustomFields()]);
    }

    sb.auth.onAuthStateChange((evt) => { if (evt === 'SIGNED_IN') boot(); });
    boot();
  }
</script>
