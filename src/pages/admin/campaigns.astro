        { g: 'Lead routing', name: '60-minute reassignment', trig: 'Lead unclaimed for an hour', to: 'Jason', subj: 'Reassigned to you: {name} (unclaimed for 60 minutes)', html: () => shell('A lead has been reassigned to you', `<p style="margin:0 0 12px;color:#0f172a;font-size:16px"><b>${S.client}</b> &middot; maria@example.com</p><p style="margin:0 0 12px;color:#334155;font-size:15px;line-height:1.6">This lead sat unclaimed for over 60 minutes, so it's now in your book — lead, contact record and all.</p>${btn('Open your CRM')}`) },
        { g: 'Client milestones', name: 'Commission qualified 🎉', trig: 'Disposition → Active Client', to: 'Writing agent', subj: 'Congratulations — {client} qualifies for commission payout', html: () => shell(`Nice work, ${S.agentFirst} 🎉`, `<p style="margin:0 0 12px;color:#0f172a;font-size:16px"><b>${S.client}</b> is now marked <b>Active Client</b> in your CRM — this client qualifies for commission payout.</p><p style="margin:0 0 12px;color:#334155;font-size:15px;line-height:1.6">You're on record as the writing agent. Keep the record complete (carrier, policy, premium) so payout processing is smooth.</p>${btn('Open the client record')}`) },
        { g: 'Client milestones', name: 'Review request ($100 gift card)', trig: 'Active Client (auto) or admin blast', to: 'Client', subj: '{first}, your experience matters to us', html: () => `<!DOCTYPE html><html><body style="margin:0;background:#dbe9f7;padding:24px 12px;font-family:-apple-system,Segoe UI,Roboto,sans-serif"><table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;margin:0 auto;background:#fff;border-radius:16px;overflow:hidden"><tr><td style="padding:24px 28px 18px"><img src="${LOGO}" width="210" style="display:block;border:0"></td></tr><tr><td style="height:4px;background:linear-gradient(90deg,#2563c9,#123f6b)"></td></tr><tr><td style="padding:26px 30px;text-align:center"><h1 style="font-family:Georgia,serif;color:#0b2a4a;font-size:30px;margin:2px 0 18px">Your Experience Matters to Us</h1><p style="color:#334155;font-size:15px;line-height:1.6">Hello ${S.clientFirst}, would you mind taking 30 seconds to tell us about the experience you had with <b>${S.agent}</b>? Leave a personal review and be entered to win our monthly drawing for a <b>$100 VISA Gift Card!</b></p><img src="${GIFT}" width="440" style="width:100%;max-width:440px;height:auto;display:block;margin:10px auto"><p style="margin:18px 0 0"><a href="#" style="background:#0b2a4a;color:#fff;text-decoration:none;padding:16px 44px;border-radius:999px;font-weight:750;font-size:16px;display:inline-block">Write a Review</a></p><div style="text-align:left;margin-top:22px">${agentCard}</div></td></tr></table></body></html>` },
        { g: 'Client milestones', name: 'Low-star feedback alert', trig: 'Client leaves 1–3★ private feedback', to: 'Agent + Janet', subj: 'Follow up: {n}-star feedback from {client}', html: () => shell(`Client feedback for ${S.agent}`, `<p style="margin:0 0 12px;color:#0f172a;font-size:16px">A client left <b>2-star</b> feedback that needs a personal follow-up.</p><p style="margin:0 0 8px;color:#334155;font-size:15px">${S.client} &middot; maria@example.com</p><p style="margin:0 0 14px;color:#334155;font-size:15px;line-height:1.6;background:#f6f9fe;border:1px solid #e6edf6;border-radius:12px;padding:14px">"I waited two weeks for a call back."</p><p style="margin:0;color:#5b6b7c;font-size:14px">Reach out promptly — they were told someone would contact them.</p>`) },
        { g: 'Campaigns', name: 'Birthday & holiday campaigns', trig: 'Dates + audience tags (this page)', to: 'Tagged contacts', subj: 'Per campaign', note: 'Managed in the list below — each one automatically carries the assigned agent and their booking link.' },
      ];

      const list = $('.am-list'); if (!list) return;
      const groups = [...new Set(CATALOG.map((e) => e.g))];
      list.innerHTML = groups.map((g) => `<div class="am-group">${g}</div>` +
        CATALOG.filter((e) => e.g === g).map((e, i) => `
          <div class="am-row">
            <div class="am-main"><b>${e.name}</b><span>${e.trig} &nbsp;→&nbsp; <b class="am-to">${e.to}</b></span><em>"${e.subj}"</em>${e.note ? `<i class="am-note">${e.note}</i>` : ''}</div>
            ${e.html ? `<button type="button" class="cm-btn am-preview" data-am="${CATALOG.indexOf(e)}">Preview</button>` : ''}
          </div>`).join('')).join('');

      const modal = $('.am-modal'), frame = $('.am-frame'), title = $('.am-modal-title');
      list.querySelectorAll('.am-preview').forEach((b) => b.addEventListener('click', () => {
        const e = CATALOG[+b.dataset.am];
        title.textContent = e.name;
        frame.srcdoc = e.html();
        modal.hidden = false;
      }));
      $('.am-modal-x').addEventListener('click', () => { modal.hidden = true; frame.srcdoc = ''; });
      modal.addEventListener('click', (ev) => { if (ev.target === modal) { modal.hidden = true; frame.srcdoc = ''; } });
    })();

    // ---------- boot ----------
    sb.auth.getSession().then(({ data }) => {
      if (data.session) { $$('[data-who]').forEach((n) => (n.textContent = data.session.user.email)); load(); }
      else view('signin');
    });
    sb.auth.onAuthStateChange((event, session) => {
      if (event === 'SIGNED_IN' && session) {
        $$('[data-who]').forEach((n) => (n.textContent = session.user.email));
        load();
      }
    });
  }
</script>
