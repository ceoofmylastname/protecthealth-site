---
import Base from '../../layouts/Base.astro';

// The House Calendar. Every appointment in the business, across every broker,
// on one month grid — the same view brokers already know from /app, so nobody
// has to learn a second calendar.
//
// The CRM calendar is deliberately personal: a broker, including an admin, sees
// only their own bookings there. So house-wide viewing needs its own page, and
// it reads ph_house_calendar(), which returns nothing at all to a non-admin
// rather than a partial view that looks whole.
//
// The one thing this view has to solve that a personal calendar does not is
// telling sixty brokers apart at a glance. Every agent gets a stable colour
// derived from their id, so the same broker is the same colour every time the
// page loads, and each pill carries the client name with the broker beneath it.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
---

<Base title="House Calendar, ProtectHealth Admin" description="Internal dashboard." noindex={true}>
  <section class="ad hc" data-supabase-url={SUPABASE_URL} data-supabase-anon={SUPABASE_ANON}>
    <div class="container">

      <div class="ad-view" data-view="loading">
        <div class="ad-center"><p class="ad-muted">Checking your session…</p></div>
      </div>

      <div class="ad-view" data-view="signin" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">ProtectHealth</span>
            <h1>Admin</h1>
            <p class="ad-muted">Enter your work email and we'll send a one-time sign-in link.</p>
            <form class="ad-login-form">
              <input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="email" required />
              <button type="submit" class="btn no-arrow">Send Sign-In Link</button>
            </form>
            <p class="ad-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>

      <div class="ad-view" data-view="denied" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">Not authorised</span>
            <h1>No access</h1>
            <p class="ad-muted">You're signed in as <b data-who></b>, but that address isn't on the admin list.</p>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </div>
      </div>

      <div class="ad-view" data-view="app" hidden>
        <header class="ad-head">
          <div>
            <span class="section-label">ProtectHealth Admin</span>
            <h1>House Calendar</h1>
            <nav class="ad-nav">
              <a href="/admin">Leads</a>
              <a href="/admin/contacts">All Contacts</a>
              <a href="/admin/calendar" class="is-on">House Calendar</a>
              <a href="/admin/tickets">Support Tickets</a>
              <a href="/admin/campaigns">Campaigns</a>
              <a href="/admin/staff">Staff</a>
              <a href="/app">My CRM</a>
            </nav>
          </div>
          <div class="ad-head-right">
            <span class="ad-muted ad-who" data-who></span>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </header>

        <div class="ad-stats">
          <div class="ad-stat spot"><b data-stat="month">—</b><span>This month</span></div>
          <div class="ad-stat spot"><b data-stat="today">—</b><span>Today</span></div>
          <div class="ad-stat spot"><b data-stat="week">—</b><span>Next 7 days</span></div>
          <div class="ad-stat spot"><b data-stat="brokers">—</b><span>Brokers booked</span></div>
          <div class="ad-stat spot"><b data-stat="house">—</b><span>House account</span></div>
        </div>

        <div class="hc-bar">
          <button type="button" class="hc-nav" data-mo="-1" aria-label="Previous month">←</button>
          <div class="hc-title"></div>
          <button type="button" class="hc-nav" data-mo="1" aria-label="Next month">→</button>
          <button type="button" class="hc-today" data-mo="0">Today</button>
          <select class="hc-agent" aria-label="Filter by broker"><option value="">Every broker</option></select>
          <input type="search" class="hc-search" placeholder="Search client, email or phone…" aria-label="Search" />
          <span class="hc-count ad-muted"></span>
        </div>

        <div class="hc-wrap"><div class="hc-grid"></div></div>
        <div class="hc-legend"></div>
      </div>

    </div>
  </section>
</Base>

<style is:global>
  .hc .ad-nav { display: flex; gap: 18px; margin-top: 10px; flex-wrap: wrap; }
  .hc .ad-nav a { font-size: 0.9rem; font-weight: 700; color: var(--muted); text-decoration: none; padding-bottom: 3px; border-bottom: 2px solid transparent; }
  .hc .ad-nav a.is-on, .hc .ad-nav a:hover { color: var(--blue); border-color: var(--blue); }

  .hc-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  .hc-nav, .hc-today {
    border: 1.5px solid var(--line); background: #fff; color: var(--ink); cursor: pointer;
    font-family: var(--font); font-weight: 700; font-size: 0.86rem; border-radius: 10px; padding: 8px 14px;
  }
  .hc-nav { padding: 8px 12px; }
  .hc-nav:hover, .hc-today:hover { border-color: var(--blue); color: var(--blue); }
  .hc-title { font-size: 1.15rem; font-weight: 800; letter-spacing: -.3px; min-width: 190px; color: var(--navy, #0b2a4a); }
  .hc-bar select, .hc-bar input {
    padding: 9px 12px; border: 1.5px solid var(--line); border-radius: 10px;
    font-family: var(--font); font-size: 0.88rem; background: #fff; color: var(--ink);
  }
  .hc-search { flex: 1 1 200px; min-width: 0; max-width: 320px; }
  .hc-bar select:focus, .hc-bar input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(25,123,255,.13); }
  .hc-count { margin-left: auto; font-size: 0.82rem; white-space: nowrap; }

  .hc-wrap { background: #fff; border: 1.5px solid var(--line); border-radius: 14px; overflow: hidden; }
  .hc-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
  .hc-dow {
    background: #f0f4fa; font-size: 0.7rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); padding: 9px 10px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .hc-dow:nth-child(7n) { border-right: 0; }
  .hc-cell {
    background: #fff; min-height: 124px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 6px; position: relative; overflow: hidden;
  }
  .hc-cell:nth-child(7n) { border-right: 0; }
  .hc-cell.dim { background: #f8fafd; }
  .hc-cell.dim .hc-dnum { color: #b6c2d2; }
  .hc-dnum {
    font-size: 0.76rem; font-weight: 700; color: var(--ink); width: 24px; height: 24px;
    display: grid; place-items: center; border-radius: 50%; margin-bottom: 2px;
  }
  .hc-cell.today .hc-dnum { background: var(--blue); color: #fff; }

  .hc-ev {
    display: block; width: 100%; text-align: left; border: 0; cursor: pointer; font-family: var(--font);
    font-size: 0.7rem; line-height: 1.3; padding: 3px 7px; border-radius: 6px; margin-top: 3px;
    color: #fff; overflow: hidden; border-left: 3px solid rgba(0,0,0,.22);
  }
  .hc-ev:hover { filter: brightness(1.08); }
  .hc-ev:focus-visible { outline: 2px solid var(--navy, #0b2a4a); outline-offset: 1px; }
  .hc-ev b { font-weight: 750; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hc-ev span { display: block; opacity: .85; font-size: 0.64rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hc-ev.cancelled { opacity: .5; }
  .hc-ev.cancelled b { text-decoration: line-through; }
  .hc-more {
    margin-top: 3px; font-size: 0.66rem; font-weight: 700; color: var(--blue); background: none;
    border: 0; cursor: pointer; font-family: var(--font); padding: 1px 4px;
  }
  .hc-more:hover { text-decoration: underline; }

  .hc-legend { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 14px; }
  .hc-leg { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--muted); }
  .hc-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

  @media (max-width: 900px) {
    .hc-cell { min-height: 92px; }
    .hc-ev span { display: none; }
  }

  .hc-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 20px; }
  .hc-modal-bg { position: absolute; inset: 0; background: rgba(11,42,74,.45); backdrop-filter: blur(3px); }
  .hc-modal-card {
    position: relative; background: #fff; border-radius: 20px; width: 100%; max-width: 560px;
    max-height: 86vh; overflow: auto; box-shadow: 0 40px 80px rgba(11,42,74,.28); padding: 26px 28px 28px;
  }
  .hc-modal-x { position: absolute; top: 16px; right: 16px; border: 0; background: #eef3f8; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 1rem; color: var(--ink); }
  .hc-modal-card h2 { margin: 0 0 4px; font-size: 1.35rem; color: var(--navy, #0b2a4a); }
  .hc-when { font-size: 1rem; font-weight: 700; color: var(--blue); margin: 0 0 18px; }
  .hc-kv { display: grid; grid-template-columns: 132px 1fr; gap: 9px 14px; font-size: 0.9rem; align-items: start; }
  .hc-kv dt { color: var(--muted); font-weight: 650; }
  .hc-kv dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }
  .hc-kv a { color: var(--blue); text-decoration: none; font-weight: 600; }
  .hc-sec { margin: 20px 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }
  .hc-note { background: #f6f9fe; border: 1px solid #e6edf6; border-radius: 12px; padding: 13px 15px; font-size: 0.92rem; line-height: 1.6; color: var(--ink); }
  .hc-rem { display: flex; gap: 8px; flex-wrap: wrap; }
  .hc-pill { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: #eef3f8; color: #5a6f85; }
  .hc-pill.on { background: #e6f7ed; color: #16803c; }
  .hc-daylist { display: grid; gap: 8px; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector('.hc');
  if (root) {
    const sb = createClient(
      root.getAttribute('data-supabase-url'),
      root.getAttribute('data-supabase-anon'),
      { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } },
    );

    const $ = (s) => root.querySelector(s);
    const $$ = (s, r = root) => Array.from(r.querySelectorAll(s));
    const view = (n) => $$('.ad-view').forEach((v) => (v.hidden = v.getAttribute('data-view') !== n));
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    const TZ = 'America/Los_Angeles';
    let rows = [];
    let calMonth = null;
    let agentFilter = '';
    let query = '';
    let searchTimer = null;

    const dayKey = (s) => new Date(s).toLocaleDateString('en-CA', { timeZone: TZ });
    const fmtTime = (s) => new Date(s).toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' });
    const fmtFull = (s) => new Intl.DateTimeFormat('en-US', { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(new Date(s));
    const fmtDayLabel = (s) => new Intl.DateTimeFormat('en-US', { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(s));
    const fmtPhone = (p) => {
      const d = String(p ?? '').replace(/\D/g, '').replace(/^1/, '');
      return d.length === 10 ? `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}` : (p || '');
    };
    const mins = (a, b) => Math.max(0, Math.round((new Date(b) - new Date(a)) / 60000));

    // Stable colour per broker. Hashing the id rather than the array position
    // means a broker keeps the same colour between loads and between months,
    // which is the only thing that makes sixty people legible on one grid.
    const HOUSE_COLOR = '#8b5cf6';
    function agentColor(r) {
      if (r.is_house) return HOUSE_COLOR;
      const id = String(r.agent_id || 'unassigned');
      let h = 0;
      for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
      // Skip the purple band so nothing is mistaken for the House Account.
      const hue = [210, 152, 22, 340, 190, 45, 262, 4, 172, 300, 96, 232][h % 12];
      return `hsl(${hue} 62% 42%)`;
    }

    // ---------- sign in / out ----------
    $('.ad-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = $('.ad-status');
      status.classList.remove('is-bad');
      status.textContent = 'Sending…';
      const { error } = await sb.auth.signInWithOtp({
        email: e.target.email.value.trim(),
        options: { emailRedirectTo: `${location.origin}/admin/calendar` },
      });
      if (error) { status.classList.add('is-bad'); status.textContent = error.message; }
      else status.textContent = 'Check your inbox. The link signs you straight in.';
    });
    $$('.ad-signout').forEach((b) => b.addEventListener('click', async () => { await sb.auth.signOut(); location.reload(); }));

    // ---------- filters ----------
    $('.hc-agent').addEventListener('change', (e) => { agentFilter = e.target.value; render(); });
    $('.hc-search').addEventListener('input', (e) => {
      clearTimeout(searchTimer);
      const v = e.target.value.trim().toLowerCase();
      searchTimer = setTimeout(() => { query = v; render(); }, 200);
    });

    // ---------- data ----------
    async function load() {
      const { data, error } = await sb.rpc('ph_house_calendar');
      if (error) { $('.hc-wrap').innerHTML = `<div style="padding:34px;text-align:center;color:var(--muted)">Could not load the calendar: ${esc(error.message)}</div>`; return; }
      rows = data ?? [];

      const byAgent = new Map();
      rows.forEach((r) => { if (r.agent_id) byAgent.set(r.agent_id, r.agent_name || r.agent_email || 'Unnamed'); });
      $('.hc-agent').innerHTML = '<option value="">Every broker</option>'
        + [...byAgent.entries()].sort((a, b) => String(a[1]).localeCompare(String(b[1])))
            .map(([id, name]) => `<option value="${esc(id)}">${esc(name)}</option>`).join('');

      render();
    }

    function visible() {
      return rows.filter((r) => {
        if (agentFilter && r.agent_id !== agentFilter) return false;
        if (query) {
          const hay = [r.invitee_name, r.invitee_email, r.invitee_phone, r.agent_name, r.line_key].join(' ').toLowerCase();
          if (!hay.includes(query)) return false;
        }
        return true;
      });
    }

    function render() {
      if (!calMonth) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
      const y = calMonth.getFullYear(), m = calMonth.getMonth();
      const first = new Date(y, m, 1);
      const start = new Date(first);
      start.setDate(1 - ((first.getDay() + 6) % 7)); // Monday-first, same as the CRM

      const list = visible();
      const byDay = {};
      list.forEach((r) => { (byDay[dayKey(r.start_at)] ||= []).push(r); });
      Object.values(byDay).forEach((d) => d.sort((a, b) => +new Date(a.start_at) - +new Date(b.start_at)));

      const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: TZ });
      $('.hc-title').textContent = calMonth.toLocaleString('en-US', { month: 'long', year: 'numeric' });

      const dows = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      let cells = '';
      let monthCount = 0;
      for (let i = 0; i < 42; i++) {
        const d = new Date(start); d.setDate(start.getDate() + i);
        const k = d.toLocaleDateString('en-CA');
        const inMonth = d.getMonth() === m;
        const items = byDay[k] || [];
        if (inMonth) monthCount += items.length;
        const shown = items.slice(0, 3).map((r) => {
          const who = r.agent_name || r.agent_email || 'Unassigned';
          return `<button type="button" class="hc-ev${r.status !== 'booked' ? ' cancelled' : ''}" data-appt="${esc(r.id)}"
            style="background:${agentColor(r)}" title="${esc(r.invitee_name || 'Client')} · ${esc(who)}">
            <b>${esc(fmtTime(r.start_at))} ${esc(r.invitee_name || 'Client')}</b><span>${r.is_house ? '🏠 ' : ''}${esc(who)}</span>
          </button>`;
        }).join('');
        const more = items.length > 3 ? `<button type="button" class="hc-more" data-day="${k}">+${items.length - 3} more</button>` : '';
        cells += `<div class="hc-cell${inMonth ? '' : ' dim'}${k === todayKey ? ' today' : ''}">
          <div class="hc-dnum">${d.getDate()}</div>${shown}${more}</div>`;
      }

      $('.hc-grid').innerHTML = dows.map((x) => `<div class="hc-dow">${x}</div>`).join('') + cells;
      $('.hc-count').textContent = monthCount === 1 ? '1 appointment this month' : `${monthCount} appointments this month`;

      // Legend, only for brokers who actually appear in the month on screen.
      const seen = new Map();
      list.forEach((r) => {
        const d = new Date(r.start_at);
        if (d.getFullYear() === y && d.getMonth() === m && r.agent_id && !seen.has(r.agent_id)) {
          seen.set(r.agent_id, { name: r.agent_name || r.agent_email || 'Unassigned', color: agentColor(r), house: r.is_house });
        }
      });
      $('.hc-legend').innerHTML = [...seen.values()]
        .sort((a, b) => String(a.name).localeCompare(String(b.name)))
        .map((a) => `<span class="hc-leg"><i class="hc-dot" style="background:${a.color}"></i>${a.house ? '🏠 ' : ''}${esc(a.name)}</span>`)
        .join('');

      paintStats();

      $$('.hc-ev').forEach((b) => b.addEventListener('click', () => openAppt(b.getAttribute('data-appt'))));
      $$('.hc-more').forEach((b) => b.addEventListener('click', () => openDay(b.getAttribute('data-day'), byDay[b.getAttribute('data-day')] || [])));
    }

    function paintStats() {
      const now = Date.now();
      const y = calMonth.getFullYear(), m = calMonth.getMonth();
      const booked = rows.filter((r) => r.status === 'booked');
      const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: TZ });
      const set = (k, v) => { const el = $(`[data-stat="${k}"]`); if (el) el.textContent = String(v); };
      const inMonth = booked.filter((r) => { const d = new Date(r.start_at); return d.getFullYear() === y && d.getMonth() === m; });
      set('month', inMonth.length);
      set('today', booked.filter((r) => dayKey(r.start_at) === todayKey).length);
      set('week', booked.filter((r) => +new Date(r.start_at) >= now && +new Date(r.start_at) <= now + 7 * 864e5).length);
      set('brokers', new Set(inMonth.map((r) => r.agent_id)).size);
      set('house', inMonth.filter((r) => r.is_house).length);
    }

    $$('[data-mo]').forEach((b) => b.addEventListener('click', () => {
      const d = +b.getAttribute('data-mo');
      if (d === 0) { const n = new Date(); calMonth = new Date(n.getFullYear(), n.getMonth(), 1); }
      else calMonth = new Date(calMonth.getFullYear(), calMonth.getMonth() + d, 1);
      render();
    }));

    // ---------- modals ----------
    function modal(inner) {
      const wrap = document.createElement('div');
      wrap.className = 'hc-modal';
      wrap.innerHTML = `<div class="hc-modal-bg" data-close></div>
        <div class="hc-modal-card" role="dialog" aria-modal="true">
          <button class="hc-modal-x" data-close aria-label="Close">✕</button>${inner}</div>`;
      document.body.appendChild(wrap);
      const close = () => { wrap.remove(); document.removeEventListener('keydown', onKey); };
      const onKey = (e) => { if (e.key === 'Escape') close(); };
      wrap.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
      document.addEventListener('keydown', onKey);
      return { wrap, close };
    }

    function openDay(key, items) {
      const label = items.length ? fmtDayLabel(items[0].start_at) : key;
      const { wrap, close } = modal(`<h2>${esc(label)}</h2>
        <p class="hc-when">${items.length} appointment${items.length === 1 ? '' : 's'}</p>
        <div class="hc-daylist">${items.map((r) => {
          const who = r.agent_name || r.agent_email || 'Unassigned';
          return `<button type="button" class="hc-ev" data-appt="${esc(r.id)}" style="background:${agentColor(r)};padding:9px 12px;font-size:.82rem">
            <b>${esc(fmtTime(r.start_at))} · ${esc(r.invitee_name || 'Client')}</b><span style="font-size:.72rem">${r.is_house ? '🏠 ' : ''}${esc(who)}</span></button>`;
        }).join('')}</div>`);
      $$('.hc-ev', wrap).forEach((b) => b.addEventListener('click', () => { close(); openAppt(b.getAttribute('data-appt')); }));
    }

    function openAppt(id) {
      const r = rows.find((x) => String(x.id) === String(id));
      if (!r) return;
      const pill = (label, at) => `<span class="hc-pill${at ? ' on' : ''}">${esc(label)}${at ? ' ✓' : ''}</span>`;
      const row = (k, v) => v ? `<dt>${esc(k)}</dt><dd>${v}</dd>` : '';
      modal(`
        <h2>${esc(r.invitee_name || 'Unnamed client')}</h2>
        <p class="hc-when">${esc(fmtFull(r.start_at))} · ${esc(mins(r.start_at, r.end_at))} minutes</p>

        <div class="hc-sec">Client</div>
        <dl class="hc-kv">
          ${row('Email', r.invitee_email ? `<a href="mailto:${esc(r.invitee_email)}">${esc(r.invitee_email)}</a>` : '')}
          ${row('Phone', r.invitee_phone ? `<a href="tel:${esc(String(r.invitee_phone).replace(/\D/g, ''))}">${esc(fmtPhone(r.invitee_phone))}</a>` : '')}
          ${row('Disposition', r.contact_disposition ? esc(r.contact_disposition) : '')}
          ${row('Contact record', r.contact_id ? `<code>${esc(r.contact_id)}</code>` : 'Not linked to a contact')}
        </dl>

        <div class="hc-sec">Broker</div>
        <dl class="hc-kv">
          ${row('Assigned to', esc(r.agent_name || 'Unassigned') + (r.is_house ? ' <span class="hc-pill">House Account</span>' : ''))}
          ${row('Email', r.agent_email ? `<a href="mailto:${esc(r.agent_email)}">${esc(r.agent_email)}</a>` : '')}
          ${row('Phone', r.agent_phone ? `<a href="tel:${esc(String(r.agent_phone).replace(/\D/g, ''))}">${esc(fmtPhone(r.agent_phone))}</a>` : '')}
        </dl>

        <div class="hc-sec">Appointment</div>
        <dl class="hc-kv">
          ${row('Status', esc(r.status || ''))}
          ${row('Booked via', esc(r.source === 'landing' ? 'Broker landing page' : r.source === 'manual' ? 'Booked by the broker' : (r.source || 'unknown')))}
          ${row('Line', r.line_key ? esc(r.line_key) : '')}
          ${row('Time zone', esc(r.timezone || TZ))}
          ${row('Created', esc(fmtFull(r.created_at)))}
        </dl>

        <div class="hc-sec">Reminders sent</div>
        <div class="hc-rem">
          ${pill('24 hour', r.reminder_24_sent_at)}
          ${pill('1 hour', r.reminder_1_sent_at)}
          ${pill('10 minute', r.reminder_10_sent_at)}
        </div>

        ${r.notes ? `<div class="hc-sec">What the client wrote</div><div class="hc-note">${esc(r.notes)}</div>` : ''}`);
    }

    // ---------- boot ----------
    async function boot() {
      const { data: { session } } = await sb.auth.getSession();
      if (!session) { view('signin'); return; }
      $$('[data-who]').forEach((el) => (el.textContent = session.user.email || ''));
      const { data: admin } = await sb.from('ph_admins').select('email').limit(1);
      if (!admin || !admin.length) { view('denied'); return; }
      view('app');
      await load();
    }

    sb.auth.onAuthStateChange((evt) => { if (evt === 'SIGNED_IN') boot(); });
    boot();
  }
</script>
