      <label class="fl"><input name="lastName" autocomplete="family-name" required placeholder=" " /><span>Last name</span></label>
    </div>
    <label class="fl"><input name="company" autocomplete="organization" required placeholder=" " /><span>Business</span></label>
    <div class="row">
      <label class="fl"><input type="email" name="email" autocomplete="email" required placeholder=" " /><span>Email</span></label>
      <label class="fl"><input type="tel" name="phone" autocomplete="tel" required placeholder=" " /><span>Phone</span></label>
    </div>
    <button class="btn btn-wide" type="submit">Book my strategy call</button>
