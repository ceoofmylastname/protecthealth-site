<div class="sticky-cta" id="sticky"><a class="btn btn-wide" href="#ask">Book a strategy call · $0</a></div>

<script>
  const q = new URLSearchParams(location.search);
  const utm = ["utm_source","utm_medium","utm_campaign","utm_content","arm"].map(k => `${k}=${q.get(k) || ""}`).join("&");
  document.getElementById("utm").value = utm;
  const ev = (name, extra = {}) => { (window.dataLayer = window.dataLayer || []).push({ event: name, page: location.pathname, ...extra }); if (window.fbq) window.fbq("trackCustom", name, extra); };
  ev("page_view", { utm });
  document.querySelectorAll("[data-ev]").forEach(a => a.addEventListener("click", () => ev(a.dataset.ev)));

  const form = document.getElementById("lead"), err = document.getElementById("lead-err");
  form.addEventListener("submit", async (e) => {
    e.preventDefault(); err.textContent = "";
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = form.querySelector("button[type=submit]"); btn.disabled = true; btn.textContent = "Sending";
    const data = Object.fromEntries(new FormData(form).entries());
    data.name = `${data.firstName} ${data.lastName}`.trim(); data.notes = `Campaign: paychex. UTM: ${utm}`;
    try {
      const r = await fetch("/api/lead", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
      if (!r.ok) throw new Error();
      ev("pdf_request", { door: data.friction });
      form.innerHTML = `<div class="done"><h3>Got it. A broker will call you within the hour during business hours.</h3><p>Want to pick the time instead? <a href="/talk-to-a-broker?skip=qualify">Choose a slot</a>.</p></div>`;
    } catch { err.textContent = "That didn't go through. Call 800-240-8185 and we'll take it by phone."; btn.disabled = false; btn.textContent = "Book my strategy call"; }
  });

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const rv = [...document.querySelectorAll(".reveal")];
  const countUp = (el) => { const end = +el.dataset.count, t0 = performance.now(), dur = 1100; const step = (t) => { const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(end * e).toLocaleString(); if (p < 1) requestAnimationFrame(step); }; requestAnimationFrame(step); };
  if (reduce) { rv.forEach(x => x.classList.add("in")); document.querySelectorAll(".cnt").forEach(c => c.textContent = (+c.dataset.count).toLocaleString()); }
  else {
    const io = new IntersectionObserver(es => es.forEach(e => { if (!e.isIntersecting) return; e.target.classList.add("in"); e.target.querySelectorAll(".cnt").forEach(countUp); io.unobserve(e.target); }), { rootMargin: "0px 0px -10% 0px" });
    rv.forEach(x => io.observe(x)); setTimeout(() => rv.forEach(x => { if (!x.classList.contains("in")) { x.classList.add("in"); x.querySelectorAll(".cnt").forEach(countUp); } }), 3000);
  }
  const st = document.getElementById("sticky"), ask = document.getElementById("ask");
  new IntersectionObserver(es => es.forEach(e => st.classList.toggle("hide", e.isIntersecting)), { rootMargin: "0px 0px -40% 0px" }).observe(ask);
  if (matchMedia("(hover: hover)").matches) document.addEventListener("pointermove", (e) => { document.querySelectorAll(".spot").forEach(c => { const r = c.getBoundingClientRect(); c.style.setProperty("--mx", `${e.clientX - r.left}px`); c.style.setProperty("--my", `${e.clientY - r.top}px`); }); }, { passive: true });
</script>

<style is:global>
  :root{--navy:#0f3567;--accent:#197bff;--cyan:#66e0ff;--ink:#0b1d33;--muted:#5a6f85;--line:#dfe8f2;--bg:#fff;--bg-soft:#f2f7fb;--px-blue:#0059a2;--font:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--r-md:18px;--r-lg:24px;--r-pill:999px;--ease:cubic-bezier(.2,.7,.2,1);--track-display:-.035em;--track-lg:-.02em;--track-md:-.01em}
  *{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{margin:0;font-family:var(--font);font-size:1.0625rem;line-height:1.65;color:var(--ink);background:var(--bg);touch-action:manipulation;overflow-x:hidden}
  :focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:6px}
  .skip{position:absolute;left:12px;top:-100px;z-index:999;padding:12px 20px;border-radius:var(--r-pill);background:var(--navy);color:#fff;font-weight:800;text-decoration:none}.skip:focus{top:12px}
  .wrap{max-width:1120px;margin:0 auto;padding:0 1.25rem}.wrap-2{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
  h1{font-size:clamp(2.3rem,5.6vw,4.4rem);line-height:1.04;letter-spacing:var(--track-display);font-weight:800;margin:0 0 1.1rem;text-wrap:balance}
  h2{font-size:clamp(1.7rem,3.4vw,2.6rem);line-height:1.1;letter-spacing:var(--track-lg);font-weight:750;margin:0 0 1rem;max-width:24ch;text-wrap:balance}
  h3{font-size:1.25rem;line-height:1.28;letter-spacing:var(--track-md);font-weight:700;margin:0 0 .5rem}
  p{margin:0 0 1rem;max-width:62ch}a{color:var(--accent)}
  .section-label{display:inline-block;font-size:.72rem;font-weight:800;letter-spacing:3px;margin:0 0 .7rem;background:linear-gradient(90deg,var(--accent),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
  .kicker-chip{font-size:.72rem;font-weight:700;letter-spacing:2.4px;color:var(--navy);border:1px solid var(--line);border-radius:var(--r-pill);padding:.35rem .8rem;background:#fff;white-space:nowrap}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.95rem 1.5rem;border-radius:var(--r-pill);font-weight:800;font-size:1rem;font-family:var(--font);text-decoration:none;color:#fff;border:0;cursor:pointer;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--accent),#0f5fe0);box-shadow:0 8px 26px rgba(25,123,255,.35);transition:transform .18s var(--ease)}
  .btn::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-120%);transition:transform .6s var(--ease)}.btn:hover::after{transform:translateX(120%)}
  .btn:active{transform:scale(.96)}.btn:disabled{opacity:.6}.btn-sm{padding:.65rem 1.1rem;font-size:.92rem}.btn-wide{width:100%}.btn-ghost{background:#fff;color:var(--navy);border:1.5px solid var(--line);box-shadow:none}.btn-px{background:var(--px-blue);box-shadow:0 8px 26px rgba(0,89,162,.3)}
  .glass{background:rgba(255,255,255,.78);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.8);box-shadow:0 1px 0 rgba(15,53,103,.06),0 10px 30px rgba(15,53,103,.1)}
  .card{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:1.5rem;box-shadow:0 1px 0 rgba(15,53,103,.04),0 12px 32px rgba(15,53,103,.06);overflow:hidden}
  .spot::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(260px circle at var(--mx,-200px) var(--my,-200px),rgba(102,224,255,.18),transparent 60%);opacity:0;transition:opacity .25s}.spot:hover::before{opacity:1}
  @media(hover:none){.spot::before{display:none!important}}

  .nav{position:sticky;top:0;z-index:10;padding:.75rem 1.25rem}.nav-in{max-width:1120px;margin:0 auto;display:flex;align-items:center;gap:1rem;padding:.55rem .75rem .55rem 1rem;border-radius:var(--r-pill)}
  .nav-logo img{display:block;height:32px;width:auto}.nav .kicker-chip{margin-left:auto}
  @media(max-width:720px){.nav .kicker-chip{display:none}.nav .btn{margin-left:auto}}

  .hero{background:radial-gradient(ellipse at 15% 0%,#17457e 0%,var(--navy) 50%,#0a2246 100%);color:#fff;padding:clamp(3rem,8vw,6.5rem) 0 clamp(2.5rem,6vw,4.5rem);overflow:hidden}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:3rem;align-items:center}
  .hero h1{background:linear-gradient(100deg,#fff 25%,#8ee4ff,#fff 65%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero .u{position:relative}.hero .u::after{content:"";position:absolute;left:0;right:0;bottom:.02em;height:.08em;border-radius:4px;background:linear-gradient(90deg,var(--cyan),var(--accent))}
  .hero-sub{font-size:1.15rem;color:#c9def5;max-width:52ch}.hero-cta{display:flex;flex-wrap:wrap;gap:.75rem;margin:1.5rem 0 1.25rem}.hero-proof{color:#9fc0e4;font-size:.92rem}.hero-proof a{color:#9fc0e4;text-decoration:none}
  .hero-visual{display:grid;gap:.9rem}
  .glass-frame{position:relative;border-radius:28px;overflow:hidden;border:1px solid rgba(255,255,255,.25);box-shadow:0 40px 100px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.35);aspect-ratio:16/10;background:#0a2246}
  .glass-frame img{width:100%;height:100%;object-fit:cover;object-position:right center;display:block}
  .hero-chips{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
  .hero-chip{display:grid;gap:.15rem;padding:.9rem 1.1rem;border-radius:18px;color:var(--navy)}
  .hc-n{font-weight:800;font-size:1.5rem;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums;background:linear-gradient(90deg,var(--navy),var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}.hc-l{font-size:.78rem;color:var(--muted);font-weight:600;line-height:1.3}
  @media(forced-colors:active){.hero h1,.section-label,.hc-n,.num{background:none!important;-webkit-text-fill-color:currentColor!important;color:CanvasText!important}}

  .marquee{overflow:hidden;border-bottom:1px solid var(--line);background:var(--bg-soft)}
  .marquee-track{display:flex;gap:1.5rem;white-space:nowrap;padding:.6rem 0;animation:mq 40s linear infinite;font-size:.8rem;letter-spacing:.22em;color:var(--muted);font-weight:600}.marquee-track span{flex:none}.mq-star{color:var(--accent)}@keyframes mq{to{transform:translateX(-50%)}}

  .band{padding:clamp(3rem,7vw,5.5rem) 0}.band-soft{background:radial-gradient(ellipse at 10% 0%,#e6f2ff 0%,var(--bg-soft) 45%,#f7f3ff 100%)}
  .lede{font-size:1.15rem;color:#2c3e52}

  .doors{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1.5rem}
  .door{position:relative;display:block;aspect-ratio:4/5;border-radius:var(--r-lg);overflow:hidden;text-decoration:none;color:#fff;box-shadow:0 12px 32px rgba(15,53,103,.12);isolation:isolate}
  .door img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}.door:hover img{transform:scale(1.05)}
  .door::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,34,70,0) 35%,rgba(10,34,70,.55) 65%,rgba(10,34,70,.92) 100%)}
  .door-k{position:absolute;top:1rem;left:1rem;z-index:1;font-size:.7rem;font-weight:800;letter-spacing:2px;padding:.35rem .7rem;border-radius:var(--r-pill);background:rgba(255,255,255,.85);color:var(--navy);backdrop-filter:blur(8px)}
  .door-h{position:absolute;left:1.1rem;right:3.2rem;bottom:1.1rem;z-index:1;font-weight:800;font-size:1.2rem;line-height:1.2;letter-spacing:var(--track-md);text-wrap:balance}
  .door-go{position:absolute;right:1rem;bottom:1rem;z-index:1;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--cyan);color:var(--navy);font-weight:800;font-size:1.1rem;transition:transform .25s var(--ease)}.door:hover .door-go{transform:translateX(3px)}.door:active{transform:scale(.985)}

  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1.25rem}
  .stat{position:relative;overflow:hidden;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(135deg,rgba(25,123,255,.6),rgba(102,224,255,.6)) border-box;border:1.5px solid transparent;border-radius:var(--r-lg);padding:1.5rem 1.4rem 1.6rem;display:grid;gap:.25rem;box-shadow:0 12px 32px rgba(15,53,103,.08)}
  .stat .num{font-size:clamp(2.4rem,4.5vw,3.4rem);font-weight:800;letter-spacing:var(--track-lg);line-height:1;font-variant-numeric:tabular-nums;background:linear-gradient(90deg,var(--navy),var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}
  .stat .lbl{color:#2c3e52;font-size:.95rem;line-height:1.4}.stat .src{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.5px}
  .stat .tick{position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--accent),var(--cyan));transform:scaleX(0);transform-origin:left;transition:transform .9s var(--ease) .2s}.stat.in .tick{transform:scaleX(1)}

  .ticks{list-style:none;padding:0;margin:1rem 0 0;display:grid;gap:.5rem}.ticks li{padding-left:1.7rem;position:relative}.ticks li::before{content:"✓";position:absolute;left:0;top:0;width:1.2rem;height:1.2rem;border-radius:6px;display:grid;place-items:center;font-size:.75rem;background:linear-gradient(135deg,var(--accent),var(--cyan));color:#fff;font-weight:800;margin-top:.2rem}
  .lead{display:grid;gap:1rem;padding:1.6rem;border-radius:28px;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(135deg,var(--accent),var(--cyan)) border-box;border:1.5px solid transparent;box-shadow:0 24px 60px rgba(15,53,103,.14)}
  .lead-step{font-size:.72rem;font-weight:800;letter-spacing:2px;color:var(--accent);margin:.25rem 0 0}
  .pills{border:0;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:.45rem}.pills legend{font-size:.88rem;font-weight:700;color:var(--navy);margin-bottom:.5rem;padding:0}
  .pills label{position:relative}.pills input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
  .pills span{display:inline-block;padding:.55rem .9rem;border-radius:var(--r-pill);border:1.5px solid var(--line);background:var(--bg-soft);font-size:.9rem;font-weight:600;color:var(--ink);transition:all .18s var(--ease);min-height:40px;line-height:1.2}
  .pills input:checked+span{background:var(--navy);border-color:var(--navy);color:#fff;box-shadow:0 6px 18px rgba(15,53,103,.25)}.pills input:focus-visible+span{outline:3px solid var(--accent);outline-offset:2px}.pills label:active span{transform:scale(.96)}
  .lead .row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
  .fl{position:relative;display:block}.fl input{width:100%;font:inherit;font-size:1rem;padding:1.25rem .95rem .55rem;border:1.5px solid var(--line);border-radius:14px;background:var(--bg-soft);color:var(--ink)}
  .fl span{position:absolute;left:.95rem;top:.95rem;font-size:.95rem;color:var(--muted);pointer-events:none;transition:all .15s var(--ease)}
  .fl input:focus{border-color:var(--accent);background:#fff;outline:3px solid rgba(25,123,255,.2);outline-offset:0}
  .fl input:focus+span,.fl input:not(:placeholder-shown)+span{top:.4rem;font-size:.7rem;font-weight:700;letter-spacing:.5px;color:var(--accent)}
  .fine{font-size:.8rem;color:var(--muted);margin:0}.err{min-height:1.3em;color:#b3261e;font-size:.92rem;margin:0}.done h3{margin-bottom:.5rem}

  .rv-band{padding-bottom:clamp(2rem,5vw,4rem)}
  .rv-wall{display:grid;gap:1rem;margin-top:1.5rem;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .rv-row{display:flex;gap:1rem;width:max-content;animation:rvm 70s linear infinite}.rv-row-rev{animation-direction:reverse;animation-duration:80s}.rv-wall:hover .rv-row{animation-play-state:paused}@keyframes rvm{to{transform:translateX(-50%)}}
  .rv{flex:none;width:320px;display:grid;gap:.5rem;padding:1.1rem 1.2rem;background:#fff;border:1px solid var(--line);border-radius:var(--r-md);text-decoration:none;color:var(--ink);box-shadow:0 8px 24px rgba(15,53,103,.06)}
  .rv-head{display:flex;align-items:center;gap:.7rem}.rv-av{width:40px;height:40px;border-radius:50%;object-fit:cover;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--cyan));color:#fff;font-weight:800}
  .rv-who{display:grid;line-height:1.2}.rv-who strong{font-size:.95rem}.rv-who em{font-style:normal;font-size:.78rem;color:var(--muted)}
  .rv-g{margin-left:auto;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:.85rem;color:#4285f4;border:1.5px solid var(--line)}
  .rv-stars{color:#f5b301;letter-spacing:1px;font-size:.9rem}.rv-t{font-size:.92rem;color:#2c3e52;line-height:1.45;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}

  .split .card h3{margin-bottom:.4rem}.card-px{border-color:rgba(0,89,162,.35)}
  .px-band{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.px-mark{display:block;height:52px;width:auto;margin:0 0 1.25rem}.px-h2{color:#111;font-weight:750}.px-h3{color:var(--px-blue);font-weight:700}.px-band p,.px-band dd{color:#222}.px-list{padding-left:1.2rem;margin:0 0 1.25rem;color:#222}.px-why dl{margin:0}.px-why dt{font-weight:700;color:#111;margin-top:.9rem}.px-why dd{margin:.15rem 0 0;font-size:.96rem}
  .lib{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:.9rem;margin-top:1.25rem}.lib-i{position:relative;display:block;padding:1.1rem 1.2rem;background:#fff;border:1px solid var(--line);border-radius:var(--r-md);color:var(--ink);text-decoration:none;font-weight:600;line-height:1.35;overflow:hidden}.lib-i span{display:block;font-size:.7rem;font-weight:800;letter-spacing:2px;color:var(--accent);margin-bottom:.3rem}.lib-i:active{transform:scale(.985)}
  .foot{background:var(--navy);color:#c9def5;padding:3rem 0 2.5rem}.lockup{display:inline-flex;align-items:center;gap:2.25rem;background:#fff;padding:1.25rem 1.75rem;border-radius:var(--r-md);margin-bottom:1.5rem}.lockup img{display:block;height:42px;width:auto}.legal{font-size:.8rem;color:#8ba5c4;max-width:90ch}.legal a{color:#9fc0e4}
  .reveal{opacity:0;transform:translateY(16px);transition:opacity .55s var(--ease),transform .55s var(--ease);transition-delay:calc(var(--i,0)*90ms)}.reveal.in{opacity:1;transform:none}
  .sticky-cta{position:fixed;left:0;right:0;bottom:0;padding:.6rem .9rem calc(.6rem + env(safe-area-inset-bottom));background:rgba(255,255,255,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid var(--line);z-index:20;transition:transform .25s var(--ease)}.sticky-cta.hide{transform:translateY(110%)}
  @media(min-width:861px){.sticky-cta{display:none}}
  @media(max-width:1000px){.doors{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:860px){.wrap-2,.hero-grid{grid-template-columns:1fr;gap:2rem}.hero{padding-top:2.5rem}.hero-visual{order:2}.lead .row{grid-template-columns:1fr}.lockup{gap:1.25rem;padding:1rem 1.25rem}.lockup img{height:32px}.rv{width:280px}h2{max-width:none}body{padding-bottom:4.5rem}}
  @media(max-width:520px){.doors{grid-template-columns:1fr 1fr;gap:.6rem}.door-h{font-size:1rem;right:2.6rem}.door-go{width:32px;height:32px;font-size:.95rem}.stats{grid-template-columns:1fr}.hero-chips{grid-template-columns:1fr 1fr;gap:.6rem}.hc-n{font-size:1.25rem}.hero-cta .btn{width:100%}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn::after,.marquee-track{animation:none;display:none}.rv-row{animation:none;flex-wrap:wrap;width:auto}.reveal{transition:none;opacity:1;transform:none}.stat .tick{transform:scaleX(1);transition:none}.door img{transition:none}}
  @media(prefers-reduced-transparency:reduce){.glass,.sticky-cta,.door-k{backdrop-filter:none!important;-webkit-backdrop-filter:none!important;background:#fff!important}}
</style>
</body>
</html>
