<div class="sticky-cta" id="sticky"><a class="btn btn-wide" href="#ask">Book a strategy call · $0</a></div>
<script>
  const rv = [...document.querySelectorAll(".reveal")];
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) rv.forEach(x => x.classList.add("in"));
  else { const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -10% 0px" }); rv.forEach(x => io.observe(x)); setTimeout(() => rv.forEach(x => x.classList.add("in")), 3000); }
  const st = document.getElementById("sticky"), ask = document.getElementById("ask");
  const io2 = new IntersectionObserver(es => es.forEach(e => st.classList.toggle("hide", e.isIntersecting)), { rootMargin: "0px 0px -40% 0px" }); io2.observe(ask);
</script>

<script>
  // UTM capture, event hooks, and lead submit to the existing /api/lead function.
  const q = new URLSearchParams(location.search);
  const utm = ["utm_source","utm_medium","utm_campaign","utm_content","arm"].map(k => `${k}=${q.get(k) || ""}`).join("&");
  const utmEl = document.getElementById("utm"); if (utmEl) utmEl.value = utm;
  const ev = (name, extra = {}) => { (window.dataLayer = window.dataLayer || []).push({ event: name, page: location.pathname, ...extra }); if (window.fbq) window.fbq("trackCustom", name, extra); };
  ev("page_view", { utm });
  document.querySelectorAll("[data-ev]").forEach(a => a.addEventListener("click", () => ev(a.dataset.ev)));

  const form = document.getElementById("lead"), err = document.getElementById("lead-err");
  form.addEventListener("submit", async (e) => {
    e.preventDefault(); err.textContent = "";
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = form.querySelector("button"); btn.disabled = true; btn.textContent = "Sending";
    const data = Object.fromEntries(new FormData(form).entries());
    data.name = `${data.firstName} ${data.lastName}`.trim();
    data.notes = `Campaign: paychex. UTM: ${utm}`;
    try {
      const r = await fetch("/api/lead", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
      if (!r.ok) throw new Error();
      ev("pdf_request", { door: data.friction });
      form.innerHTML = `<div class="done"><h3>Got it. A broker will call you within the hour during business hours.</h3><p>Want to pick the time instead? <a href="/talk-to-a-broker?skip=qualify">Choose a slot</a>.</p></div>`;
    } catch {
      err.textContent = "That didn't go through. Call 800-240-8185 and we'll take it by phone.";
      btn.disabled = false; btn.textContent = "Book my strategy call";
    }
  });

  // Pointer spotlight on cards, matching the site.
  if (matchMedia("(hover: hover)").matches) document.addEventListener("pointermove", (e) => {
    document.querySelectorAll(".spot").forEach(c => { const r = c.getBoundingClientRect(); c.style.setProperty("--mx", `${e.clientX - r.left}px`); c.style.setProperty("--my", `${e.clientY - r.top}px`); });
  }, { passive: true });
</script>

<style is:global>
  :root {
    --navy: #0f3567; --accent: #197bff; --cyan: #66e0ff; --ink: #0b1d33; --muted: #5a6f85; --line: #dfe8f2;
    --bg: #fff; --bg-soft: #f2f7fb; --px-blue: #0059a2;
    --font: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --r-md: 18px; --r-lg: 24px; --r-pill: 999px; --ease: cubic-bezier(.2,.7,.2,1);
    --track-display: -.035em; --track-lg: -.02em; --track-md: -.01em;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; font-family: var(--font); font-size: 1.0625rem; line-height: 1.65; color: var(--ink); background: var(--bg); touch-action: manipulation; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
  .skip { position: absolute; left: 12px; top: -100px; z-index: 999; padding: 12px 20px; border-radius: var(--r-pill); background: var(--navy); color: #fff; font-weight: 800; text-decoration: none; }
  .skip:focus { top: 12px; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.25rem; }
  .wrap-2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; }
  h1 { font-size: clamp(2.6rem, 6.2vw, 4.7rem); line-height: 1.04; letter-spacing: var(--track-display); font-weight: 800; margin: 0 0 1.25rem; max-width: 16ch; }
  h2 { font-size: clamp(1.8rem, 3.6vw, 2.7rem); line-height: 1.12; letter-spacing: var(--track-lg); font-weight: 750; margin: 0 0 1rem; max-width: 22ch; }
  h3 { font-size: 1.3rem; line-height: 1.28; letter-spacing: var(--track-md); font-weight: 700; margin: 0 0 .5rem; }
  p { margin: 0 0 1rem; max-width: 62ch; }
  a { color: var(--accent); }

  .section-label { display: inline-block; font-size: .75rem; font-weight: 800; letter-spacing: 3px; text-transform: none; margin: 0 0 .75rem; background: linear-gradient(90deg, var(--accent), var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kicker-chip { font-size: .74rem; font-weight: 700; letter-spacing: 2.6px; color: var(--navy); border: 1px solid var(--line); border-radius: var(--r-pill); padding: .35rem .8rem; background: #fff; }

