---
import Base from '../layouts/Base.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { SITE, breadcrumbSchema } from '../lib/site';

// Copy ported verbatim from the Webflow original at /t-c. Article and section
// numbering is preserved exactly, because these clauses may already be cited
// elsewhere. Only presentation was rebuilt. Do not reword without counsel.

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Terms & Conditions', url: `${SITE.domain}/terms-and-conditions` },
  ]),
];

const sections = [
  {
    id: 'article-i',
    label: 'I — Introduction',
    title: 'Article I — Introduction',
    blocks: [
      { type: 'p', text: 'Welcome to ProtectHealth ("Company," "we," "us," or "our"). By accessing or using our website ("Web Site"), you agree to be bound by the following terms and conditions ("Terms"). If you do not agree with these Terms, please do not use the Web Site.' },
    ],
  },
  {
    id: 'article-ii',
    label: 'II — Services',
    title: 'Article II — Services',
    blocks: [
      { type: 'p', text: 'Section 2.01 — Services Provided: ProtectHealth offers a variety of insurance products, including health, life, dental, and GAP insurance policies. We provide our services through consultations, policy management, and customer support, both in-person and online. The Web Site serves as an information portal and platform for these services.' },
    ],
  },
  {
    id: 'article-iii',
    label: 'III — User responsibilities',
    title: 'Article III — User responsibilities',
    blocks: [
      { type: 'p', text: 'Section 3.01 — Eligibility: You must be at least 18 years old to use the Web Site and purchase our services. By using the Web Site, you confirm that you meet this age requirement.' },
      { type: 'p', text: 'Section 3.02 — Account Security: You are responsible for maintaining the confidentiality of your account credentials, including your username and password. You agree to notify us immediately of any unauthorized use of your account. ProtectHealth is not liable for any loss or damage arising from your failure to secure your account.' },
      { type: 'p', text: 'Section 3.03 — Prohibited Conduct: You agree not to use the Web Site for any unlawful purposes, including but not limited to:' },
      {
        type: 'list',
        items: [
          'Engaging in fraudulent activities.',
          'Distributing harmful or malicious content.',
          'Infringing on the intellectual property rights of others.',
          'Violating the privacy of other users.',
        ],
      },
    ],
  },
  {
    id: 'article-iv',
    label: 'IV — Payments',
    title: 'Article IV — Payments and subscriptions',
    blocks: [
      { type: 'p', text: 'Section 4.01 — Payment Terms: Payments for services and products are due at the time of purchase, unless otherwise stated. We accept various forms of payment, including credit cards and other methods displayed on the Web Site. By providing payment information, you authorize us to charge the applicable fees to your payment method.' },
      { type: 'p', text: 'Section 4.02 — Subscription Renewals: Annual subscriptions automatically renew on the anniversary of the purchase date unless canceled in writing at least thirty (30) days before the renewal date. You will be billed at the then-current subscription rate.' },
      { type: 'p', text: 'Section 4.03 — Refund Policy: Refunds are not provided unless explicitly stated. If you believe you are entitled to a refund, please contact us with the details of your case.' },
    ],
  },
  {
    id: 'article-v',
    label: 'V — Privacy and data',
    title: 'Article V — Privacy and data collection',
    blocks: [
      { type: 'p', text: 'Section 5.01 — Privacy Policy: Our Privacy Policy, which outlines how we collect, use, and protect your information, is incorporated into these Terms by reference. By using the Web Site, you agree to the terms of our Privacy Policy.' },
      { type: 'p', text: 'Section 5.02 — Cookies and Tracking: We use cookies and other tracking technologies to improve your experience on our Web Site. For more information, refer to our Privacy Policy.' },
    ],
  },
  {
    id: 'article-vi',
    label: 'VI — Intellectual property',
    title: 'Article VI — Intellectual property',
    blocks: [
      { type: 'p', text: 'Section 6.01 — Ownership: All content on the Web Site, including text, graphics, logos, images, and software, is the property of ProtectHealth or its content suppliers and is protected by intellectual property laws. You may not reproduce, distribute, or use any content from the Web Site without our explicit written permission.' },
      { type: 'p', text: 'Section 6.02 — Trademarks: ProtectHealth and other trademarks, service marks, and logos used on the Web Site are the property of ProtectHealth. Unauthorized use of any trademarks displayed on the Web Site is strictly prohibited.' },
    ],
  },
  {
    id: 'article-vii',
    label: 'VII — Liability',
    title: 'Article VII — Limitation of liability',
    blocks: [
      { type: 'p', text: 'Section 7.01 — No Warranties: The Web Site and services are provided "as is" and "as available" without any warranties, express or implied. We do not guarantee that the Web Site will be uninterrupted, error-free, or secure.' },
      { type: 'p', text: 'Section 7.02 — Limitation of Liability: To the fullest extent permitted by law, ProtectHealth will not be liable for any indirect, incidental, consequential, or punitive damages arising out of your use of the Web Site or services, even if we have been advised of the possibility of such damages.' },
      { type: 'p', text: 'Section 7.03 — Indemnification: You agree to indemnify and hold harmless ProtectHealth, its affiliates, and their respective directors, officers, employees, and agents from any claims, liabilities, damages, and expenses (including legal fees) arising out of your use of the Web Site or breach of these Terms.' },
    ],
  },
  {
    id: 'article-viii',
    label: 'VIII — Termination',
    title: 'Article VIII — Termination',
    blocks: [
      { type: 'p', text: 'Section 8.01 — Termination by Us: We reserve the right to terminate or suspend your access to the Web Site and services at our sole discretion, without prior notice, for conduct that we believe violates these Terms or is harmful to other users of the Web Site, ProtectHealth, or third parties.' },
      { type: 'p', text: 'Section 8.02 — Termination by You: You may terminate your account and subscription at any time by contacting us. Termination of your account does not relieve you of any payment obligations incurred prior to termination.' },
    ],
  },
  {
    id: 'article-ix',
    label: 'IX — Disputes',
    title: 'Article IX — Dispute resolution',
    blocks: [
      { type: 'p', text: 'Section 9.01 — Governing Law: These Terms and any disputes arising out of or relating to them will be governed by and construed in accordance with the laws of the state of Nevada, without regard to its conflict of law principles.' },
      { type: 'p', text: 'Section 9.02 — Arbitration: Any disputes or claims arising out of or relating to these Terms, including breach or termination, will be resolved through binding arbitration in accordance with the rules of the American Arbitration Association. The arbitration will take place in Nevada, and the arbitration award may be entered in any court having jurisdiction.' },
    ],
  },
  {
    id: 'article-x',
    label: 'X — Miscellaneous',
    title: 'Article X — Miscellaneous',
    blocks: [
      { type: 'p', text: 'Section 10.01 — Entire Agreement: These Terms, together with the Privacy Policy, constitute the entire agreement between you and ProtectHealth regarding the use of the Web Site and services.' },
      { type: 'p', text: 'Section 10.02 — Modifications: We may modify these Terms at any time. Any changes will be effective immediately upon posting on the Web Site. Your continued use of the Web Site following the posting of any changes constitutes your acceptance of those changes.' },
      { type: 'p', text: 'Section 10.03 — Severability: If any provision of these Terms is found to be invalid or unenforceable by a court of competent jurisdiction, the remaining provisions will remain in full force and effect.' },
      { type: 'p', text: 'Section 10.04 — Contact Information: If you have any questions or concerns about these Terms, please contact us at ProtectHealth, 2915 W. Charleston Blvd Ste 170, Las Vegas, NV 89102, or call 800-240-8185.' },
      { type: 'callout', title: 'By using the Web Site', text: 'You acknowledge that you have read, understood, and agree to these Terms and Conditions.' },
    ],
  },
];
---

<Base
  title="Terms & Conditions | ProtectHealth Las Vegas"
  description="The terms governing use of the ProtectHealth website and services: eligibility, payments, intellectual property, liability, termination and dispute resolution under Nevada law."
  schemas={schemas}
>
  <LegalDoc
    kicker="Legal"
    title="Terms and conditions."
    effective="2024"
    intro="These are the terms that govern your use of the ProtectHealth website and services. Ten articles, plain numbering, nothing buried. If you do not agree with them, please do not use the site."
    sections={sections}
  />
</Base>
