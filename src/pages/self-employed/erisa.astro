<script>
  // State switcher. All three panels are in the HTML; this only toggles
  // visibility, so a crawler or a reader without JS sees every state.
  // Also pre-selects the state on the form when the panel CTA is used.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.er-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.er-panel'));
  function show(code: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.state === code;
      t.classList.toggle('act', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p) => {
      const on = p.dataset.state === code;
      p.hidden = !on;
      p.classList.toggle('act', on);
    });
    try { history.replaceState(null, '', `#${code}`); } catch {}
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t.dataset.state!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      show(tabs[next].dataset.state!, true);
    });
  });
  const fromHash = location.hash.replace('#', '');
  if (['nv', 'az', 'ut'].includes(fromHash)) show(fromHash);

  // Guess the state from the visitor's timezone on first paint. Mountain time
  // without DST is Arizona; Mountain with DST is Utah; Pacific stays Nevada.
  // Only a guess, the tabs remain one tap away.
  if (!['nv', 'az', 'ut'].includes(fromHash)) {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      if (tz === 'America/Phoenix') show('az');
      else if (tz === 'America/Denver' || tz === 'America/Boise') show('ut');
    } catch {}
  }

  // Panel CTA: pre-select the state answer on the form. Only the `sel` class
  // is set (never a synthetic click), because LeadForm's option click
  // advances whichever step is CURRENT, which would validate step one
  // instead. The visitor reaches the state step with it already marked and
  // presses OK, and validate() reads the marked option at that moment.
  document.querySelectorAll<HTMLAnchorElement>('[data-prefill-state]').forEach((a) => {
    a.addEventListener('click', () => {
      const want = a.dataset.prefillState;
      const opts = Array.from(document.querySelectorAll<HTMLButtonElement>('#form-erisa .tf-step[data-name="state"] .tf-option'));
      opts.forEach((b) => b.classList.toggle('sel', b.dataset.value === want));
    });
  });
</script>
