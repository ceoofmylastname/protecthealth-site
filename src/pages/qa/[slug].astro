---
// Q&A page template (wiki: qa-page-architecture).
// One top-level QAPage schema with FAQPage nested via hasPart, avoids the
// "Duplicate field mainEntity" conflict (wiki: qapage-faqpage-mainentity-conflict).
// quickAnswer (acceptedAnswer) and speakableText (#ai-summary) are different
// fields with different content (wiki: speakable-vs-accepted-answer).
import Base from '../../layouts/Base.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE, ORG_ID, QA_ART, breadcrumbSchema, speakableSchema, authorFor, personSchema, personId } from '../../lib/site';
import AuthorByline from '../../components/AuthorByline.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const qas = await getCollection('qa');
  return qas.map((qa) => ({ params: { slug: qa.id }, props: { qa } }));
}
const { qa } = Astro.props;
const { Content } = await render(qa);
const d = qa.data;
const pageUrl = `${SITE.domain}/qa/${qa.id}`;

// Sibling and parent lookups moved into RelatedContent, which now owns the
// whole related block for both templates.

// Per-page share card off the page's own art, same reasoning as the blog
// template. PNG rather than WebP because several social scrapers still refuse
// to render a WebP og:image.
const ogImage = QA_ART[qa.id] ? QA_ART[qa.id].png : undefined;

// Reviewer, not author. These answers carry the agency's voice; the accurate
// claim is that a licensed broker with expertise in this cluster checked them.
const reviewer = authorFor(d.cluster);

const qaPageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'QAPage',
  url: pageUrl,
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'Question',
    name: d.question,
    answerCount: 1,
    acceptedAnswer: { '@type': 'Answer', text: d.quickAnswer },
  },
  // FAQPage nested via hasPart, single root mainEntity.
  hasPart: {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: d.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  datePublished: d.datePublished,
  // E-E-A-T on the Q&A layer: expert-reviewed rather than expert-authored.
  // reviewedBy sits on the QAPage; the Person node is emitted once below and
  // referenced by @id so there is a single Person entity per page.
  reviewedBy: { '@id': personId(reviewer.slug) },
  // The Answer itself is attributed to the agency, which is who stands behind it.
  author: { '@id': ORG_ID },
  image: QA_ART[qa.id] ? { '@type': 'ImageObject', url: QA_ART[qa.id].png } : undefined,
};
if (d.dateModified) qaPageSchema.dateModified = d.dateModified;

const schemas = [
  qaPageSchema,
  { '@context': 'https://schema.org', ...personSchema(reviewer) },
  speakableSchema(pageUrl),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Q&A', url: `${SITE.domain}/qa` },
    { name: d.question, url: pageUrl },
  ]),
];

const QA_CTA: Record<string, string> = {
  employers: '/employers',
  ichra: '/self-employed',
  life: '/services/life-insurance',
  'dental-vision': '/services/dental-insurance',
  medicare: '/services/medicare',
  'nevada-core': '/contact-us',
};
const ctaUrl = QA_CTA[d.cluster] ?? '/contact-us';
---
<Base
  title={`${d.question} | ProtectHealth Q&A`}
  description={d.description}
  schemas={schemas}
  ogImage={ogImage}
  ogImageAlt={QA_ART[qa.id]?.alt}
  article={{ publishedTime: d.datePublished, modifiedTime: d.dateModified }}
>
  <section class="section">
    <div class="container article">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/qa">Q&amp;A</a> › <span>{d.question}</span>
      </nav>
      <h1>{d.question}</h1>

      {QA_ART[qa.id] && <div class="hero-img"><img src={QA_ART[qa.id].webp} alt={QA_ART[qa.id].alt} loading="eager" /></div>}

      <div class="quick-answer">
        <h2>Quick Answer</h2>
        <p>{d.quickAnswer}</p>
      </div>

      <div id="ai-summary">{d.speakableText}</div>

      <AuthorByline author={reviewer} mode="reviewer" />

      <Content />

      <FAQSection faq={d.faq} pageUrl={pageUrl} emitSchema={false} />

      <div class="cta-band">
        <h2>Want an answer specific to your situation?</h2>
        <p>General answers only go so far. A free 20-minute ProtectHealth strategy conversation maps what actually fits.</p>
        <a href={ctaUrl} class="btn big" style="background:#fff;color:var(--navy);">Book A Conversation</a>
      </div>

      {/* Replaces the old flat <ul> of siblings. Surfaces the parent guide, the
          cluster's other posts, sibling questions and one supporting page , 
          below the CTA, per the content depth and linking standard. */}
      <RelatedContent cluster={d.cluster} type="qa" currentId={qa.id} parentPost={d.parentPost} />
      <p class="compliance-note">ProtectHealth brokers are insurance professionals, not tax professionals. Eligibility for any coverage or tax-advantaged structure depends on business structure, income, and household situation.</p>
    </div>
  </section>
</Base>
