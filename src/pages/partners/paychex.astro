---
// /partners/paychex
// Gated partner review. Static shell only; content is served by ph-review-gate
// after a valid code. Self-contained on purpose: no layout import, scoped styles.
// Keep out of: sitemap, llms.txt, CLUSTER_ORDER, blog browser, nav.
const GATE_URL = "https://hrzonmnswzwridwqbspb.supabase.co/functions/v1/ph-review-gate";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#0f3567" />
  <title>Partner review · ProtectHealth</title>
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<!-- ============================================================ GATE -->
<section id="gate" class="gate" aria-labelledby="gate-h">
  <div class="gate-glow" aria-hidden="true"></div>
  <form class="gate-panel" id="gate-form" novalidate>
    <img class="gate-logo" src="/assets/logo.webp" alt="ProtectHealth" width="190" height="48" />
    <p class="gate-kicker">Partner review</p>
    <h1 id="gate-h">Enter your review code</h1>
    <p class="gate-help">Six digits, sent to you directly. Sessions last eight hours.</p>
    <div class="code" role="group" aria-label="Six-digit code">
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 2" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 3" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 4" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 5" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 6" />
    </div>
    <p class="gate-err" id="gate-err" role="alert"></p>
    <button class="btn" type="submit" id="gate-btn">Open the review</button>
    <p class="gate-foot">Official Paychex Partner · Las Vegas, Nevada</p>
  </form>
</section>

<!-- ============================================================= DOC -->
<div id="doc" class="doc" hidden>
  <header class="top">
    <div class="top-in">
      <a class="top-logo" href="/"><img src="/assets/logo.webp" alt="ProtectHealth" width="150" height="38" /></a>
      <span class="top-partner">Official Paychex Partner</span>
      <span class="top-meta" id="top-meta"></span>
      <button class="btn-quiet" id="signout" type="button">Sign out</button>
    </div>
  </header>

  <section class="hero" id="hero">
    <div class="hero-art" id="hero-art" aria-hidden="true"></div>
    <div class="hero-in">
      <p class="eyebrow" id="hero-kicker"></p>
      <h1 id="doc-title"></h1>
      <p class="hero-sub" id="doc-sub"></p>
      <ol class="order" id="order"></ol>
    </div>
  </section>

  <div class="marquee" aria-hidden="true"><div class="marquee-track" id="marquee"></div></div>

  <div class="frame">
    <nav class="rail" aria-label="Sections"><ol id="rail-list"></ol></nav>
    <main id="main" class="page" tabindex="-1">
      <div class="notice" id="notice"></div>
      <div id="sections"></div>
      <footer class="doc-foot">
        <div class="lockup">
          <img src="/assets/logo.webp" alt="ProtectHealth" width="170" height="43" />
          <img src="/assets/partners/paychex-lockup.png" alt="Paychex. HR, Payroll, Benefits, Insurance." width="176" height="48" />
        </div>
        <p class="lockup-note">Co-branded lockup as approved on the Winning Team flyer, document 173193. Paychex mark on white only, one cap-height of clear space, never recolored.</p>
        <p class="foot-meta" id="doc-version"></p>
        <p class="foot-meta">This page is not indexed and is not linked from the site. ProtectHealth brokers are insurance professionals, not tax professionals.</p>
      </footer>
    </main>
  </div>
</div>

<script define:vars={{ GATE_URL }}>
  const $ = (s, r = document) => r.querySelector(s);
  const el = (tag, attrs = {}, ...kids) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === "class") n.className = v;
      else if (k === "html") n.innerHTML = v;
      else if (k.startsWith("on")) n.addEventListener(k.slice(2), v);
      else n.setAttribute(k, v);
    }
    for (const k of kids.flat()) if (k != null) n.append(k.nodeType ? k : document.createTextNode(String(k)));
    return n;
  };
  const KEY = "ph_review_token";

  async function call(payload) {
    const r = await fetch(GATE_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
    const j = await r.json().catch(() => ({ error: "Something went wrong." }));
    if (!r.ok) throw new Error(j.error || "Something went wrong.");
    return j;
  }

  // ---------------------------------------------------------------- gate
  const inputs = [...document.querySelectorAll(".code input")];
  const err = $("#gate-err"), btn = $("#gate-btn");
  inputs.forEach((inp, i) => {
    inp.addEventListener("input", () => {
      inp.value = inp.value.replace(/\D/g, "").slice(-1);
      if (inp.value && inputs[i + 1]) inputs[i + 1].focus();
      if (inputs.every((x) => x.value)) $("#gate-form").requestSubmit();
    });
    inp.addEventListener("keydown", (e) => { if (e.key === "Backspace" && !inp.value && inputs[i - 1]) inputs[i - 1].focus(); });
    inp.addEventListener("paste", (e) => {
      const t = (e.clipboardData.getData("text") || "").replace(/\D/g, "").slice(0, 6);
      if (t.length === 6) { e.preventDefault(); inputs.forEach((x, k) => (x.value = t[k])); $("#gate-form").requestSubmit(); }
    });
  });
  $("#gate-form").addEventListener("submit", async (e) => {
    e.preventDefault(); err.textContent = "";
    const code = inputs.map((x) => x.value).join("");
    if (code.length !== 6) { err.textContent = "Enter all six digits."; return; }
    btn.disabled = true; btn.textContent = "Checking";
    try { const { token } = await call({ action: "verify", code }); sessionStorage.setItem(KEY, token); await open(token); }
    catch (ex) { err.textContent = ex.message; inputs.forEach((x) => (x.value = "")); inputs[0].focus(); }
    finally { btn.disabled = false; btn.textContent = "Open the review"; }
  });
  $("#signout").addEventListener("click", () => { sessionStorage.removeItem(KEY); location.reload(); });

  async function open(token) {
    const { content, assets } = await call({ action: "load", token });
    render(content, assets);
    $("#gate").hidden = true; $("#doc").hidden = false;
    $("#main").focus({ preventScroll: true });
  }
  (async () => {
    const t = sessionStorage.getItem(KEY);
    if (!t) { inputs[0].focus(); return; }
    try { await open(t); } catch { sessionStorage.removeItem(KEY); inputs[0].focus(); }
  })();

  // -------------------------------------------------------------- render
  const chip = (text, kind) => el("span", { class: `chip chip-${kind}` }, text);
  const laneChip = (l) => chip(`Lane ${l}`, "lane");
  const statusChip = (s) => chip(s, "st-" + s.toLowerCase().replace(/\s+/g, "-"));

  const table = (b) => el("div", { class: "tbl-wrap" }, el("table", {},
    el("thead", {}, el("tr", {}, b.head.map((h) => el("th", { scope: "col" }, h)))),
    el("tbody", {}, b.rows.map((r) => el("tr", {}, r.map((c, i) => el(i === 0 ? "th" : "td", i === 0 ? { scope: "row" } : {}, c)))))));
  const callout = (b) => el("aside", { class: `callout callout-${b.kind}` }, el("p", { class: "callout-t" }, b.title), el("p", {}, b.text));
  const quote = (b) => el("figure", { class: "quote" }, el("blockquote", {}, b.lines.map((l) => el("p", {}, l))), el("figcaption", {}, b.attribution));
  const script = (b) => el("article", { class: "script glass", id: b.id },
    el("div", { class: "script-head" }, el("h3", {}, b.title), el("div", { class: "chips" }, chip(b.door, "door"), laneChip(b.lane), statusChip(b.status))),
    el("p", { class: "script-why" }, b.why),
    el("ol", { class: "script-lines" }, b.lines.map((l) => el("li", {}, l))),
    el("p", { class: "script-note" }, el("strong", {}, "On screen: "), b.onscreen),
    el("p", { class: "script-note" }, el("strong", {}, "Sources: "), b.sources));
  const timeline = (b) => el("ol", { class: "tl" }, b.items.map((it) => el("li", { class: "tl-i" },
    el("span", { class: "tl-when" }, it.when), el("div", { class: "tl-body" }, el("p", {}, it.what), statusChip(it.status)))));
  const decisions = (b) => el("ol", { class: "dec" }, b.items.map((d) => el("li", { class: "dec-i glass" },
    el("span", { class: "dec-n", "aria-hidden": "true" }, String(d.n).padStart(2, "0")),
    el("div", { class: "dec-body" }, el("h3", {}, d.q), el("p", {}, d.context), el("p", { class: "dec-default" }, el("strong", {}, "Default: "), d.default)))));

  function gallery(content, assets) {
    return el("div", { class: "gal" }, content.gallery.map((g) => {
      const url = assets[g.id];
      const isVideo = /\.mp4$/i.test(g.asset), isPdf = /\.pdf$/i.test(g.asset);
      let media;
      if (!url) media = el("div", { class: "gal-ph" }, el("span", {}, "In production"), el("small", {}, g.format));
      else if (isVideo) media = el("video", { src: url, controls: "", playsinline: "", preload: "metadata" });
      else if (isPdf) media = el("a", { class: "gal-ph gal-link", href: url, target: "_blank", rel: "noopener" }, "Open PDF");
      else media = el("img", { src: url, alt: g.title, loading: "lazy" });
      return el("figure", { class: "gal-i glass" },
        el("div", { class: "gal-media" }, media),
        el("figcaption", {},
          el("p", { class: "gal-t" }, g.title),
          el("p", { class: "gal-m" }, `${g.door} · ${g.format}`),
          el("div", { class: "chips" }, laneChip(g.lane), statusChip(g.status)),
          el("p", { class: "gal-n" }, g.note)));
    }));
  }

  function diagramLeadPath() {
    const s = `<svg viewBox="0 0 720 300" role="img" aria-labelledby="lp-t" xmlns="http://www.w3.org/2000/svg"><title id="lp-t">Lead path: ad, landing page, CRM, broker, Fred</title>
<defs><marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#5cc8ff"/></marker></defs>
<g font-family="system-ui,-apple-system,Segoe UI,Roboto,sans-serif" font-size="13" fill="#eaf2ff">
<rect x="10" y="40" width="130" height="56" rx="8" fill="rgba(255,255,255,.06)" stroke="rgba(92,200,255,.6)"/><text x="75" y="63" text-anchor="middle" font-weight="600">Ad click</text><text x="75" y="82" text-anchor="middle" font-size="11" fill="#9fb8d8">Meta · LinkedIn · UTM</text>
<rect x="200" y="40" width="150" height="56" rx="8" fill="rgba(255,255,255,.06)" stroke="rgba(92,200,255,.6)"/><text x="275" y="63" text-anchor="middle" font-weight="600">Landing page</text><text x="275" y="82" text-anchor="middle" font-size="11" fill="#9fb8d8">tracking fires first</text>
<rect x="410" y="40" width="130" height="56" rx="8" fill="rgba(255,255,255,.06)" stroke="rgba(92,200,255,.6)"/><text x="475" y="63" text-anchor="middle" font-weight="600">CRM</text><text x="475" y="82" text-anchor="middle" font-size="11" fill="#9fb8d8">formId employers</text>
<rect x="590" y="40" width="120" height="56" rx="8" fill="rgba(255,255,255,.06)" stroke="rgba(92,200,255,.6)"/><text x="650" y="63" text-anchor="middle" font-weight="600">Broker</text><text x="650" y="82" text-anchor="middle" font-size="11" fill="#9fb8d8">first call</text>
<rect x="410" y="180" width="130" height="56" rx="8" fill="#fff" stroke="#0059a2"/><text x="475" y="203" text-anchor="middle" font-weight="600" fill="#0059a2">Paychex form</text><text x="475" y="222" text-anchor="middle" font-size="11" fill="#333">PartnerId=461541</text>
<rect x="590" y="180" width="120" height="56" rx="8" fill="#fff" stroke="#0059a2"/><text x="650" y="203" text-anchor="middle" font-weight="600" fill="#0059a2">Fred</text><text x="650" y="222" text-anchor="middle" font-size="11" fill="#333">weekly count</text>
<text x="360" y="150" text-anchor="middle" font-size="11" fill="#9fb8d8">Split CTA on the page: benefits stay with us, payroll and HR go to Paychex with the ID attached</text>
<text x="280" y="275" text-anchor="middle" font-size="11" fill="#9fb8d8">Arm A of the test skips the page and sends the click straight to the Paychex form. Arm B is the path drawn above.</text></g>
<g fill="none" stroke="#5cc8ff" stroke-width="1.5" marker-end="url(#ar)"><path d="M140,68 L200,68"/><path d="M350,68 L410,68"/><path d="M540,68 L590,68"/><path d="M650,96 L650,180"/><path d="M300,96 C300,160 380,208 410,208"/><path d="M540,208 L590,208"/></g></svg>`;
    return el("figure", { class: "diagram glass", html: s });
  }

  function block(b, content, assets) {
    switch (b.type) {
      case "p": return el("p", {}, b.text);
      case "h3": return el("h3", {}, b.text);
      case "table": return table(b);
      case "callout": return callout(b);
      case "quote": return quote(b);
      case "script": return script(b);
      case "timeline": return timeline(b);
      case "decisions": return decisions(b);
      case "gallery": return gallery(content, assets);
      case "diagram": return b.id === "lead-path" ? diagramLeadPath() : null;
      default: return null;
    }
  }

  function render(content, assets) {
    const m = content.meta;
    $("#top-meta").textContent = m.version;
    $("#hero-kicker").textContent = m.kicker;
    $("#doc-title").textContent = m.title;
    $("#doc-sub").textContent = m.sub;
    $("#doc-version").textContent = m.version;
    if (m.hero_art) $("#hero-art").style.backgroundImage = `url("${m.hero_art}")`;

    $("#order").replaceChildren(...m.reading_order.map((o) => el("li", {},
      el("a", { href: o.href, class: "order-a glass" }, el("span", { class: "order-n" }, o.n), el("span", { class: "order-t" }, o.title), el("span", { class: "order-w" }, o.what)))));

    const mq = [...m.marquee, ...m.marquee];
    $("#marquee").replaceChildren(...mq.flatMap((t) => [el("span", {}, t), el("span", { class: "mq-star" }, "✦")]));

    $("#notice").replaceChildren(
      el("p", { class: "callout-t" }, "Read this first"),
      el("p", {}, m.notice),
      el("dl", { class: "lanes" }, Object.entries(m.lanes).flatMap(([k, v]) => [el("dt", {}, laneChip(k)), el("dd", {}, v)])),
      el("div", { class: "chips" }, m.statuses.map(statusChip)));

    const rail = $("#rail-list"), secs = $("#sections");
    rail.replaceChildren(); secs.replaceChildren();
    content.sections.forEach((s, i) => {
      const n = String(i + 1).padStart(2, "0");
      rail.append(el("li", {}, el("a", { href: `#${s.id}` }, el("span", { class: "rail-n" }, n), s.title)));
      const head = el("div", { class: "sec-head" },
        el("p", { class: "eyebrow" }, `${n} ✦ ${s.title}`),
        el("h2", {}, s.title),
        s.lede ? el("p", { class: "lede" }, s.lede) : null);
      const sec = el("section", { id: s.id, class: "sec" + (s.art ? " sec-art" : "") },
        s.art ? el("div", { class: "sec-art-img", style: `background-image:url("${s.art}")`, "aria-hidden": "true" }) : null,
        head, el("div", { class: "sec-body" }, s.blocks.map((b) => block(b, content, assets))));
      secs.append(sec);
    });

    const links = [...rail.querySelectorAll("a")];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.removeAttribute("aria-current"));
      const a = links.find((x) => x.getAttribute("href") === `#${e.target.id}`);
      if (a) a.setAttribute("aria-current", "true");
    }), { rootMargin: "-20% 0px -70% 0px" });
    secs.querySelectorAll(".sec").forEach((x) => io.observe(x));
  }
</script>

<style is:global>
  :root {
    --navy: #0f3567; --deep: #071a36; --ink-dark: #0b2a51;
    --cyan: #5cc8ff; --gold: #e8b84a;
    --text: #eaf2ff; --muted: #9fb8d8; --line: rgba(255,255,255,.12);
    --glass: rgba(255,255,255,.055); --glass-2: rgba(255,255,255,.09);
    --px-blue: #0059a2;
    --serif: Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --measure: 66ch; --r: 14px; --r-s: 8px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--deep); color: var(--text); font-family: var(--sans); font-size: 1.0625rem; line-height: 1.6; touch-action: manipulation; }
  :focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--cyan); color: var(--deep); padding: .5rem .75rem; border-radius: var(--r-s); z-index: 10; }
  .skip:focus { left: 8px; }
  [hidden] { display: none !important; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.2rem, 5.2vw, 4rem); line-height: 1.05; letter-spacing: -.025em; margin: 0 0 .75rem; max-width: 22ch; }
  h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.7rem, 3.4vw, 2.5rem); line-height: 1.12; letter-spacing: -.02em; margin: 0 0 .6rem; max-width: 24ch; }
  h3 { font-weight: 650; font-size: 1.15rem; line-height: 1.35; margin: 1.75rem 0 .5rem; color: #fff; }
  p { margin: 0 0 1rem; max-width: var(--measure); }
  a { color: var(--cyan); }
  .eyebrow { color: var(--gold); font-size: .85rem; letter-spacing: .02em; margin: 0 0 .5rem; }
  .glass { background: var(--glass); border: 1px solid var(--line); border-radius: var(--r); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }

  /* ---------------------------------------------------------------- gate */
  .gate { position: relative; min-height: 100dvh; display: grid; place-items: center; padding: 1.5rem; background: radial-gradient(ellipse at 30% 20%, #16437f 0%, var(--deep) 55%); overflow: hidden; }
  .gate-glow { position: absolute; inset: auto -20% -30% auto; width: 60vw; height: 60vw; border-radius: 50%; background: radial-gradient(circle, rgba(92,200,255,.28), transparent 60%); filter: blur(30px); pointer-events: none; }
  .gate-panel { position: relative; background: var(--glass-2); border: 1px solid var(--line); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-radius: 22px; padding: 2.25rem; width: min(100%, 27rem); box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .gate-logo { display: block; height: 44px; width: auto; margin-bottom: 1.25rem; }
  .gate-kicker { color: var(--gold); font-size: .85rem; margin: 0 0 .35rem; }
  .gate h1 { font-size: 1.9rem; }
  .gate-help { color: var(--muted); font-size: .95rem; margin-bottom: 1.25rem; }
  .code { display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; margin-bottom: .75rem; }
  .code input { width: 100%; aspect-ratio: 1 / 1.2; font: 600 1.5rem var(--sans); text-align: center; border: 1.5px solid var(--line); border-radius: var(--r-s); background: rgba(0,0,0,.25); color: #fff; }
  .code input:focus { border-color: var(--cyan); background: rgba(0,0,0,.35); }
  .gate-err { min-height: 1.4em; color: #ffb4a8; font-size: .95rem; margin: 0 0 .75rem; }
  .btn { width: 100%; padding: .95rem 1rem; font: 650 1rem var(--sans); color: var(--deep); background: var(--cyan); border: 0; border-radius: var(--r-s); cursor: pointer; }
  .btn:active { transform: scale(.98); }
  .btn:disabled { opacity: .6; cursor: default; }
  .gate-foot { color: var(--muted); font-size: .82rem; margin: 1.25rem 0 0; }
  .btn-quiet { font: 500 .88rem var(--sans); color: var(--text); background: transparent; border: 1px solid var(--line); border-radius: var(--r-s); padding: .45rem .75rem; cursor: pointer; }
  .btn-quiet:active { transform: scale(.98); }

  /* ----------------------------------------------------------------- top */
  .top { position: sticky; top: 0; z-index: 5; background: rgba(7,26,54,.78); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .top-in { max-width: 1240px; margin: 0 auto; padding: .65rem 1.25rem; display: flex; align-items: center; gap: 1rem; }
  .top-logo img { display: block; height: 34px; width: auto; }
  .top-partner { font-size: .8rem; color: var(--gold); border: 1px solid rgba(232,184,74,.4); border-radius: 999px; padding: .2rem .6rem; white-space: nowrap; }
  .top-meta { flex: 1; font-size: .85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ---------------------------------------------------------------- hero */
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-art { position: absolute; inset: 0; background-size: cover; background-position: center right; opacity: .55; }
  .hero-art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--deep) 0%, rgba(7,26,54,.85) 45%, rgba(7,26,54,.2) 100%), linear-gradient(0deg, var(--deep) 0%, transparent 40%); }
  .hero-in { position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(3rem, 8vw, 6.5rem) 1.25rem clamp(2.5rem, 5vw, 4rem); }
  .hero-sub { font-size: 1.2rem; color: var(--muted); max-width: 52ch; margin-bottom: 2.25rem; }
  .order { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; max-width: 900px; }
  .order-a { display: grid; gap: .25rem; padding: 1.1rem 1.2rem; text-decoration: none; color: var(--text); }
  .order-a:active { background: var(--glass-2); }
  .order-n { font-family: var(--serif); color: var(--gold); font-size: 1.4rem; line-height: 1; }
  .order-t { font-weight: 650; font-size: 1.1rem; color: #fff; }
  .order-w { color: var(--muted); font-size: .92rem; line-height: 1.4; }

  .marquee { overflow: hidden; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.03); }
  .marquee-track { display: flex; gap: 1.5rem; white-space: nowrap; padding: .6rem 0; animation: mq 48s linear infinite; font-size: .85rem; color: var(--muted); }
  .marquee-track span { flex: none; }
  .mq-star { color: var(--gold); }
  @keyframes mq { to { transform: translateX(-50%); } }

  /* --------------------------------------------------------------- frame */
  .frame { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 250px 1fr; gap: 3rem; padding: 2rem 1.25rem 4rem; }
  .rail { position: sticky; top: 4.25rem; align-self: start; max-height: calc(100dvh - 5rem); overflow: auto; }
  .rail ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .rail a { display: flex; gap: .6rem; align-items: baseline; padding: .4rem .9rem; color: var(--muted); text-decoration: none; font-size: .9rem; line-height: 1.3; margin-left: -1px; border-left: 2px solid transparent; }
  .rail-n { font-family: var(--serif); color: var(--gold); font-size: .85rem; min-width: 1.6em; }
  .rail a[aria-current] { color: #fff; border-left-color: var(--cyan); }
  .page { min-width: 0; }

  .notice { background: var(--glass); border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: var(--r); padding: 1.1rem 1.25rem; margin: 0 0 2.5rem; }
  .callout-t { font-weight: 650; margin-bottom: .25rem; color: #fff; }
  .lanes { display: grid; grid-template-columns: auto 1fr; gap: .35rem .75rem; margin: .75rem 0; max-width: var(--measure); }
  .lanes dt, .lanes dd { margin: 0; } .lanes dd { font-size: .95rem; color: var(--muted); }

  .sec { padding: 3rem 0; border-top: 1px solid var(--line); scroll-margin-top: 4.5rem; position: relative; }
  .sec-art { display: grid; grid-template-columns: 1fr; }
  .sec-art-img { height: 220px; border-radius: var(--r); background-size: cover; background-position: center; margin-bottom: 1.5rem; opacity: .9; }
  .lede { font-size: 1.18rem; line-height: 1.5; color: #d6e4f7; margin-bottom: 1.5rem; }

  .chips { display: flex; flex-wrap: wrap; gap: .35rem; margin: .35rem 0; }
  .chip { display: inline-block; font-size: .76rem; font-weight: 600; line-height: 1; padding: .32rem .55rem; border-radius: 999px; border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--muted); }
  .chip-lane { color: var(--cyan); border-color: rgba(92,200,255,.5); }
  .chip-door { color: #d6e4f7; }
  .chip-st-draft { background: rgba(232,184,74,.14); border-color: rgba(232,184,74,.55); color: var(--gold); }
  .chip-st-needs-review { background: rgba(92,200,255,.14); border-color: rgba(92,200,255,.5); color: var(--cyan); }
  .chip-st-approved, .chip-st-done { background: rgba(80,220,150,.14); border-color: rgba(80,220,150,.5); color: #7ff0b6; }
  .chip-st-live { background: var(--cyan); border-color: var(--cyan); color: var(--deep); }
  .chip-st-in-progress { background: rgba(92,200,255,.14); border-color: rgba(92,200,255,.5); color: var(--cyan); }
  .chip-st-waiting-on-you { background: rgba(232,184,74,.14); border-color: rgba(232,184,74,.55); color: var(--gold); }
  .chip-st-planned { color: var(--muted); }

  .tbl-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: var(--r); }
  table { border-collapse: collapse; width: 100%; min-width: 560px; font-size: .95rem; }
  th, td { text-align: left; vertical-align: top; padding: .7rem .85rem; border-bottom: 1px solid var(--line); }
  thead th { font-weight: 650; color: var(--gold); background: rgba(255,255,255,.04); }
  tbody th { font-weight: 600; width: 22%; color: #fff; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  .callout { background: var(--glass); border: 1px solid var(--line); border-radius: var(--r); padding: 1rem 1.15rem; margin: 1.25rem 0; max-width: var(--measure); }
  .callout-warn { border-left: 3px solid var(--gold); }
  .callout-note { border-left: 3px solid var(--cyan); }
  .callout p:last-child { margin-bottom: 0; }

  .quote { margin: 1.25rem 0; padding: 1.1rem 1.3rem; background: #fff; color: #111; border-radius: var(--r); max-width: var(--measure); border-left: 4px solid var(--px-blue); }
  .quote blockquote { margin: 0; } .quote p { font-size: .98rem; color: #111; }
  .quote figcaption { font-size: .85rem; color: #555; margin-top: .5rem; }

  .script { padding: 1.4rem 1.5rem; margin: 1.25rem 0; }
  .script-head h3 { margin: 0 0 .35rem; }
  .script-why { color: var(--muted); font-size: .95rem; }
  .script-lines { font-family: var(--serif); font-size: 1.2rem; line-height: 1.5; padding-left: 1.25rem; margin: 1rem 0; max-width: var(--measure); color: #fff; }
  .script-lines li { margin-bottom: .65rem; }
  .script-note { font-size: .92rem; color: var(--muted); }

  .tl { list-style: none; margin: 1rem 0; padding: 0; border-left: 1px solid rgba(92,200,255,.5); }
  .tl-i { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; padding: .7rem 0 .7rem 1.4rem; position: relative; }
  .tl-i::before { content: ""; position: absolute; left: -6px; top: 1.15rem; width: 11px; height: 11px; border-radius: 50%; background: var(--deep); border: 2px solid var(--cyan); }
  .tl-when { font-weight: 650; color: var(--gold); font-variant-numeric: tabular-nums; }
  .tl-body p { margin-bottom: .25rem; }

  .dec { list-style: none; margin: 1rem 0; padding: 0; display: grid; gap: .9rem; }
  .dec-i { display: grid; grid-template-columns: 3rem 1fr; gap: .9rem; padding: 1.25rem 1.4rem; }
  .dec-n { font-family: var(--serif); font-size: 1.9rem; line-height: 1; color: var(--gold); }
  .dec-body h3 { margin: 0 0 .45rem; }
  .dec-body p { font-size: .98rem; }
  .dec-default { background: rgba(92,200,255,.1); border: 1px solid rgba(92,200,255,.35); padding: .65rem .85rem; border-radius: var(--r-s); margin-bottom: 0; }

  .gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.25rem; margin: 1rem 0; }
  .gal-i { margin: 0; overflow: hidden; }
  .gal-media { aspect-ratio: 4 / 5; background: radial-gradient(ellipse at 50% 30%, #16437f, var(--deep)); display: grid; place-items: center; }
  .gal-media img, .gal-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gal-ph { display: grid; gap: .25rem; place-items: center; color: var(--muted); font-size: .92rem; text-align: center; padding: 1rem; }
  .gal-ph small { font-size: .78rem; opacity: .8; }
  .gal-link { text-decoration: underline; color: var(--cyan); }
  .gal figcaption { padding: .9rem 1rem 1.1rem; }
  .gal-t { font-weight: 650; margin-bottom: .15rem; color: #fff; }
  .gal-m, .gal-n { font-size: .88rem; color: var(--muted); margin-bottom: .4rem; }

  .diagram { margin: 1rem 0 1.5rem; padding: .9rem; }
  .diagram svg { width: 100%; height: auto; display: block; }

  .doc-foot { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .lockup { display: inline-flex; align-items: center; gap: 2.25rem; background: #fff; padding: 1.25rem 1.75rem; border-radius: var(--r); }
  .lockup img { display: block; height: 44px; width: auto; }
  .lockup-note { color: var(--muted); font-size: .88rem; margin: .9rem 0 1.25rem; }
  .foot-meta { color: var(--muted); font-size: .85rem; margin-bottom: .35rem; }

  @media (max-width: 900px) {
    .frame { grid-template-columns: 1fr; gap: 1rem; padding-top: 1.25rem; }
    .rail { position: static; max-height: none; }
    .rail ol { border-left: 0; display: flex; gap: .35rem; overflow-x: auto; padding-bottom: .5rem; }
    .rail a { white-space: nowrap; border: 1px solid var(--line); border-radius: 999px; padding: .4rem .75rem; background: var(--glass); margin-left: 0; }
    .rail a[aria-current] { background: var(--cyan); color: var(--deep); border-color: var(--cyan); }
    .rail a[aria-current] .rail-n { color: var(--deep); }
    .order { grid-template-columns: 1fr; }
    .tl-i { grid-template-columns: 1fr; gap: .15rem; }
    .dec-i { grid-template-columns: 2.4rem 1fr; padding: 1rem 1.1rem; }
    .top-partner, .top-meta { display: none; }
    .lockup { gap: 1.25rem; padding: 1rem 1.25rem; } .lockup img { height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .marquee-track { animation: none; } .btn:active, .btn-quiet:active { transform: none; } }
  @media (forced-colors: active) { .glass, .chip, .callout, .tbl-wrap { border: 1px solid CanvasText; } }
  @media print { .top, .rail, .gate, .marquee, .hero-art { display: none !important; } body { background: #fff; color: #000; } .glass { background: #fff; } }
</style>
</body>
</html>
