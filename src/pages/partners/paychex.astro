---
// /partners/paychex — gated review. Static shell; content via ph-review-gate.
const GATE_URL = "https://hrzonmnswzwridwqbspb.supabase.co/functions/v1/ph-review-gate";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#0f3567" />
  <title>Partner review · ProtectHealth</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.ico" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<section id="gate" class="gate" aria-labelledby="gate-h">
  <form class="gate-panel" id="gate-form" novalidate>
    <img class="gate-logo" src="/assets/logo.webp" alt="ProtectHealth" width="190" height="48" />
    <p class="section-label">Partner review</p>
    <h1 id="gate-h">Enter your review code</h1>
    <p class="muted">Six digits, sent to you directly. Sessions last eight hours.</p>
    <div class="code" role="group" aria-label="Six-digit code">
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 2" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 3" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 4" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 5" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 6" />
    </div>
    <p class="err" id="gate-err" role="alert"></p>
    <button class="btn btn-wide" type="submit" id="gate-btn">Open the review</button>
    <p class="fine">Official Paychex Partner · Las Vegas, Nevada</p>
  </form>
</section>

<div id="doc" hidden>
  <header class="nav">
    <div class="nav-in glass">
      <a href="/" class="nav-logo"><img src="/assets/logo.webp" alt="ProtectHealth" width="150" height="38" /></a>
      <span class="kicker-chip">Official Paychex Partner</span>
      <span class="nav-meta" id="top-meta"></span>
      <button class="btn btn-ghost btn-sm" id="signout" type="button">Sign out</button>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <p class="section-label section-label-light" id="hero-kicker"></p>
      <h1 id="doc-title"></h1>
      <p class="hero-sub" id="doc-sub"></p>
      <ol class="order" id="order"></ol>
    </div>
  </section>

  <div class="marquee" aria-hidden="true"><div class="marquee-track" id="marquee"></div></div>

  <div class="frame wrap">
    <nav class="rail" aria-label="Sections"><ol id="rail-list"></ol></nav>
    <main id="main" class="page" tabindex="-1">
      <div class="notice card" id="notice"></div>
      <div id="sections"></div>
      <footer class="doc-foot">
        <div class="lockup">
          <img src="/assets/logo.webp" alt="ProtectHealth" width="170" height="43" />
          <img src="/assets/partners/paychex-lockup.png" alt="Paychex. HR, Payroll, Benefits, Insurance." width="176" height="48" />
        </div>
        <p class="fine">Co-branded lockup as approved on the Winning Team flyer, document 173193. Paychex mark on white only, one cap-height clear space, never recolored.</p>
        <p class="fine" id="doc-version"></p>
        <p class="fine">Not indexed. Not linked from the site. ProtectHealth brokers are insurance professionals, not tax professionals.</p>
      </footer>
    </main>
  </div>
</div>

<script define:vars={{ GATE_URL }}>
  const $ = (s, r = document) => r.querySelector(s);
  const el = (tag, attrs = {}, ...kids) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === "class") n.className = v; else if (k === "html") n.innerHTML = v;
      else if (k.startsWith("on")) n.addEventListener(k.slice(2), v); else n.setAttribute(k, v);
    }
    for (const k of kids.flat()) if (k != null) n.append(k.nodeType ? k : document.createTextNode(String(k)));
    return n;
  };
  const KEY = "ph_review_token";
  async function call(payload) {
    const r = await fetch(GATE_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
    const j = await r.json().catch(() => ({ error: "Something went wrong." }));
    if (!r.ok) throw new Error(j.error || "Something went wrong."); return j;
  }

  const inputs = [...document.querySelectorAll(".code input")], err = $("#gate-err"), btn = $("#gate-btn");
  inputs.forEach((inp, i) => {
    inp.addEventListener("input", () => { inp.value = inp.value.replace(/\D/g, "").slice(-1); if (inp.value && inputs[i + 1]) inputs[i + 1].focus(); if (inputs.every((x) => x.value)) $("#gate-form").requestSubmit(); });
    inp.addEventListener("keydown", (e) => { if (e.key === "Backspace" && !inp.value && inputs[i - 1]) inputs[i - 1].focus(); });
    inp.addEventListener("paste", (e) => { const t = (e.clipboardData.getData("text") || "").replace(/\D/g, "").slice(0, 6); if (t.length === 6) { e.preventDefault(); inputs.forEach((x, k) => (x.value = t[k])); $("#gate-form").requestSubmit(); } });
  });
  $("#gate-form").addEventListener("submit", async (e) => {
    e.preventDefault(); err.textContent = "";
    const code = inputs.map((x) => x.value).join("");
    if (code.length !== 6) { err.textContent = "Enter all six digits."; return; }
    btn.disabled = true; btn.textContent = "Checking";
    try { const { token } = await call({ action: "verify", code }); sessionStorage.setItem(KEY, token); await open(token); }
    catch (ex) { err.textContent = ex.message; inputs.forEach((x) => (x.value = "")); inputs[0].focus(); }
    finally { btn.disabled = false; btn.textContent = "Open the review"; }
  });
  $("#signout").addEventListener("click", () => { sessionStorage.removeItem(KEY); location.reload(); });
  async function open(token) { const { content, assets } = await call({ action: "load", token }); render(content, assets); $("#gate").hidden = true; $("#doc").hidden = false; $("#main").focus({ preventScroll: true }); }
  (async () => { const t = sessionStorage.getItem(KEY); if (!t) { inputs[0].focus(); return; } try { await open(t); } catch { sessionStorage.removeItem(KEY); inputs[0].focus(); } })();

  const chip = (t, k) => el("span", { class: `chip chip-${k}` }, t);
  const laneChip = (l) => chip(`Lane ${l}`, "lane");
  const statusChip = (s) => chip(s, "st-" + s.toLowerCase().replace(/\s+/g, "-"));
  const table = (b) => el("div", { class: "tbl-wrap" }, el("table", {}, el("thead", {}, el("tr", {}, b.head.map((h) => el("th", { scope: "col" }, h)))), el("tbody", {}, b.rows.map((r) => el("tr", {}, r.map((c, i) => el(i === 0 ? "th" : "td", i === 0 ? { scope: "row" } : {}, c)))))));
  const callout = (b) => el("aside", { class: `callout callout-${b.kind}` }, el("p", { class: "callout-t" }, b.title), el("p", {}, b.text));
  const quote = (b) => el("figure", { class: "quote" }, el("blockquote", {}, b.lines.map((l) => el("p", {}, l))), el("figcaption", {}, b.attribution));
  const link = (b) => el("div", { class: "linkrow card spot" }, el("a", { class: "btn", href: b.href, target: "_blank", rel: "noopener" }, b.label), el("p", { class: "fine" }, b.note));
  const script = (b) => el("article", { class: "script card spot", id: b.id },
    el("div", { class: "script-head" }, el("h3", {}, b.title), el("div", { class: "chips" }, chip(b.door, "door"), laneChip(b.lane), statusChip(b.status))),
    el("p", { class: "muted" }, b.why), el("ol", { class: "script-lines" }, b.lines.map((l) => el("li", {}, l))),
    el("p", { class: "fine" }, el("strong", {}, "On screen: "), b.onscreen), el("p", { class: "fine" }, el("strong", {}, "Sources: "), b.sources));
  const timeline = (b) => el("ol", { class: "tl" }, b.items.map((it) => el("li", { class: "tl-i" }, el("span", { class: "tl-when" }, it.when), el("div", {}, el("p", {}, it.what), statusChip(it.status)))));
  const decisions = (b) => el("ol", { class: "dec" }, b.items.map((d) => el("li", { class: "dec-i card spot" }, el("span", { class: "dec-n" }, String(d.n).padStart(2, "0")), el("div", {}, el("h3", {}, d.q), el("p", {}, d.context), el("p", { class: "dec-default" }, el("strong", {}, "Default: "), d.default)))));

  const visuals = {
    chairs: () => el("div", { class: "vz vz-chairs" }, [0,1,2,3,4,5].map((i) => el("span", { class: "chair" + (i === 5 ? " chair-on" : "") }))),
    bars: (v) => el("div", { class: "vz vz-bars" }, [v.a, v.b].map((x, i) => el("div", { class: "bar-row" }, el("span", { class: "bar-l" }, x.label), el("div", { class: "bar-t" }, el("div", { class: "bar-f" + (i ? " bar-f2" : ""), style: `width:${Math.round(100 * x.value / x.max)}%` })), el("span", { class: "bar-v" }, "$" + x.value.toLocaleString())))),
    toggle: (v) => el("div", { class: "vz vz-toggle" }, el("span", { class: "tg-l" }, v.label), el("span", { class: "tg" }, el("span", { class: "tg-knob" })), el("span", { class: "tg-v" }, v.value)),
    checklist: (v) => el("ul", { class: "vz vz-check" }, v.items.map((t) => el("li", {}, el("span", { class: "ck" }, "✓"), t))),
    timeline: (v) => el("div", { class: "vz vz-tl" }, el("div", { class: "tl-bar" }, el("div", { class: "tl-fill" })), el("div", { class: "tl-txt" }, el("span", {}, v.label), el("strong", {}, v.value))),
    doc: (v) => el("div", { class: "vz vz-doc" }, el("div", { class: "doc-h" }, v.title), [92,70,84,55].map((w) => el("div", { class: "doc-line", style: `width:${w}%` })), el("span", { class: "stamp" }, v.stamp)),
    nameplate: (v) => el("div", { class: "vz vz-plate" }, el("div", { class: "plate" }, el("strong", {}, v.name), el("span", {}, v.sub))),
    paystub: (v) => el("div", { class: "vz vz-stub" }, v.rows.map((r, i) => el("div", { class: "stub-r" + (i === v.rows.length - 1 ? " stub-hi" : "") }, el("span", {}, r[0]), el("strong", {}, r[1])))),
    stats: (v) => el("div", { class: "vz vz-stats" }, v.items.map((s) => el("div", { class: "st" }, el("strong", {}, s[0]), el("span", {}, s[1])))),
  };
  const creativeCard = (c) => el("div", { class: "cr", id: `cr-${c.id}` },
    el("div", { class: "cr-bg" }),
    el("div", { class: "cr-top" }, el("img", { src: "/assets/logo.webp", alt: "", width: "120", height: "30" }), el("span", { class: "cr-eyebrow" }, c.eyebrow)),
    el("h3", { class: "cr-h" }, c.headline.split("\n").map((l, i) => [i ? el("br") : null, l])),
    el("div", { class: "cr-visual" }, (visuals[c.visual.type] || visuals.stats)(c.visual)),
    el("p", { class: "cr-m" }, c.message),
    el("div", { class: "cr-foot" }, el("img", { src: "/assets/logo.webp", alt: "", width: "110", height: "28" }), el("img", { src: "/assets/partners/paychex-lockup.png", alt: "", width: "100", height: "27" })));
  async function downloadPng(c, b) {
    if (!window.html2canvas) { b.textContent = "Renderer loading, try again"; return; }
    b.disabled = true; b.textContent = "Rendering";
    try { await document.fonts.ready; const canvas = await html2canvas($(`#cr-${c.id}`), { scale: 3, useCORS: true, backgroundColor: "#ffffff", logging: false });
      const a = document.createElement("a"); a.download = `protecthealth-paychex-${c.id}.png`; a.href = canvas.toDataURL("image/png"); a.click(); }
    finally { b.disabled = false; b.textContent = "Download PNG 1080×1350"; }
  }
  const creatives = (content) => el("div", { class: "crs" }, content.creatives.map((c) => el("div", { class: "cr-wrap card spot" },
    el("div", { class: "cr-frame" }, creativeCard(c)),
    el("div", { class: "cr-side" },
      el("div", { class: "chips" }, chip(c.door, "door"), laneChip(c.lane), statusChip(c.status)),
      el("p", { class: "cr-cap" }, c.caption),
      el("div", { class: "cr-actions" },
        el("button", { class: "btn btn-sm", type: "button", onclick: (e) => downloadPng(c, e.currentTarget) }, "Download PNG 1080×1350"),
        el("button", { class: "btn btn-ghost btn-sm", type: "button", onclick: (e) => { navigator.clipboard.writeText(c.caption); const b = e.currentTarget; b.textContent = "Copied"; setTimeout(() => (b.textContent = "Copy caption"), 1400); } }, "Copy caption"))))));

  function diagramLeadPath() {
    const s = `<svg viewBox="0 0 720 300" role="img" aria-labelledby="lp-t" xmlns="http://www.w3.org/2000/svg"><title id="lp-t">Lead path</title>
<defs><marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#197bff"/></marker></defs>
<g font-family="Bricolage Grotesque,system-ui,sans-serif" font-size="13" fill="#0b1d33">
<rect x="10" y="40" width="130" height="56" rx="12" fill="#fff" stroke="#dfe8f2"/><text x="75" y="63" text-anchor="middle" font-weight="700">Ad click</text><text x="75" y="82" text-anchor="middle" font-size="11" fill="#5a6f85">Meta · LinkedIn · UTM</text>
<rect x="200" y="40" width="150" height="56" rx="12" fill="#fff" stroke="#dfe8f2"/><text x="275" y="63" text-anchor="middle" font-weight="700">Landing page</text><text x="275" y="82" text-anchor="middle" font-size="11" fill="#5a6f85">tracking fires first</text>
<rect x="410" y="40" width="130" height="56" rx="12" fill="#fff" stroke="#dfe8f2"/><text x="475" y="63" text-anchor="middle" font-weight="700">CRM</text><text x="475" y="82" text-anchor="middle" font-size="11" fill="#5a6f85">formId employers</text>
<rect x="590" y="40" width="120" height="56" rx="12" fill="#fff" stroke="#dfe8f2"/><text x="650" y="63" text-anchor="middle" font-weight="700">Broker</text><text x="650" y="82" text-anchor="middle" font-size="11" fill="#5a6f85">first call</text>
<rect x="410" y="180" width="130" height="56" rx="12" fill="#fff" stroke="#0059a2"/><text x="475" y="203" text-anchor="middle" font-weight="700" fill="#0059a2">Paychex form</text><text x="475" y="222" text-anchor="middle" font-size="11" fill="#333">PartnerId=461541</text>
<rect x="590" y="180" width="120" height="56" rx="12" fill="#fff" stroke="#0059a2"/><text x="650" y="203" text-anchor="middle" font-weight="700" fill="#0059a2">Fred</text><text x="650" y="222" text-anchor="middle" font-size="11" fill="#333">weekly count</text>
<text x="360" y="150" text-anchor="middle" font-size="11" fill="#5a6f85">Split CTA: benefits stay with us, payroll and HR go to Paychex with the ID attached</text>
<text x="280" y="275" text-anchor="middle" font-size="11" fill="#5a6f85">Arm A skips the page and sends the click straight to the Paychex form. Arm B is the path above.</text></g>
<g fill="none" stroke="#197bff" stroke-width="1.5" marker-end="url(#ar)"><path d="M140,68 L200,68"/><path d="M350,68 L410,68"/><path d="M540,68 L590,68"/><path d="M650,96 L650,180"/><path d="M300,96 C300,160 380,208 410,208"/><path d="M540,208 L590,208"/></g></svg>`;
    return el("figure", { class: "diagram card", html: s });
  }
  function block(b, content, assets) {
    switch (b.type) {
      case "p": return el("p", {}, b.text); case "h3": return el("h3", {}, b.text);
      case "table": return table(b); case "callout": return callout(b); case "quote": return quote(b); case "link": return link(b);
      case "script": return script(b); case "timeline": return timeline(b); case "decisions": return decisions(b);
      case "creatives": return creatives(content); case "diagram": return b.id === "lead-path" ? diagramLeadPath() : null;
      default: return null;
    }
  }
  function render(content, assets) {
    const m = content.meta;
    $("#top-meta").textContent = m.version; $("#hero-kicker").textContent = m.kicker;
    $("#doc-title").textContent = m.title; $("#doc-sub").textContent = m.sub; $("#doc-version").textContent = m.version;
    $("#order").replaceChildren(...m.reading_order.map((o) => el("li", {}, el("a", { href: o.href, class: "order-a glass" }, el("span", { class: "order-n" }, o.n), el("span", { class: "order-t" }, o.title), el("span", { class: "order-w" }, o.what)))));
    $("#marquee").replaceChildren(...[...m.marquee, ...m.marquee].flatMap((t) => [el("span", {}, t), el("span", { class: "mq-star" }, "✦")]));
    $("#notice").replaceChildren(el("p", { class: "callout-t" }, "Read this first"), el("p", {}, m.notice), el("dl", { class: "lanes" }, Object.entries(m.lanes).flatMap(([k, v]) => [el("dt", {}, laneChip(k)), el("dd", {}, v)])), el("div", { class: "chips" }, m.statuses.map(statusChip)));
    const rail = $("#rail-list"), secs = $("#sections"); rail.replaceChildren(); secs.replaceChildren();
    content.sections.forEach((s, i) => {
      const n = String(i + 1).padStart(2, "0");
      rail.append(el("li", {}, el("a", { href: `#${s.id}` }, el("span", { class: "rail-n" }, n), s.title)));
      secs.append(el("section", { id: s.id, class: "sec" }, el("p", { class: "section-label" }, `${n} ✦ ${s.title.replace(/\.$/, "")}`), el("h2", {}, s.title), s.lede ? el("p", { class: "lede" }, s.lede) : null, el("div", { class: "sec-body" }, s.blocks.map((b) => block(b, content, assets)))));
    });
    const links = [...rail.querySelectorAll("a")];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; links.forEach((a) => a.removeAttribute("aria-current")); const a = links.find((x) => x.getAttribute("href") === `#${e.target.id}`); if (a) a.setAttribute("aria-current", "true"); }), { rootMargin: "-20% 0px -70% 0px" });
    secs.querySelectorAll(".sec").forEach((x) => io.observe(x));
    if (matchMedia("(hover: hover)").matches) document.addEventListener("pointermove", (e) => { document.querySelectorAll(".spot").forEach((c) => { const r = c.getBoundingClientRect(); c.style.setProperty("--mx", `${e.clientX - r.left}px`); c.style.setProperty("--my", `${e.clientY - r.top}px`); }); }, { passive: true });
  }
</script>

<style is:global>
  :root{--navy:#0f3567;--accent:#197bff;--cyan:#66e0ff;--ink:#0b1d33;--muted:#5a6f85;--line:#dfe8f2;--bg:#fff;--bg-soft:#f2f7fb;--px-blue:#0059a2;--font:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--r-md:18px;--r-lg:24px;--r-pill:999px;--ease:cubic-bezier(.2,.7,.2,1);--track-display:-.035em;--track-lg:-.02em;--track-md:-.01em;--measure:66ch}
  *{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{margin:0;font-family:var(--font);font-size:1.0625rem;line-height:1.65;color:var(--ink);background:var(--bg);touch-action:manipulation}
  :focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:6px}
  .skip{position:absolute;left:12px;top:-100px;z-index:999;padding:12px 20px;border-radius:var(--r-pill);background:var(--navy);color:#fff;font-weight:800;text-decoration:none}.skip:focus{top:12px}
  [hidden]{display:none!important}.wrap{max-width:1180px;margin:0 auto;padding:0 1.25rem}
  h1{font-size:clamp(2.4rem,5.4vw,4.2rem);line-height:1.04;letter-spacing:var(--track-display);font-weight:800;margin:0 0 1rem;max-width:18ch}
  h2{font-size:clamp(1.7rem,3.2vw,2.4rem);line-height:1.12;letter-spacing:var(--track-lg);font-weight:750;margin:0 0 .6rem;max-width:26ch}
  h3{font-size:1.2rem;line-height:1.28;letter-spacing:var(--track-md);font-weight:700;margin:1.6rem 0 .5rem}
  p{margin:0 0 1rem;max-width:var(--measure)}a{color:var(--accent)}.muted{color:var(--muted)}.fine{font-size:.82rem;color:var(--muted);margin:.35rem 0}
  .section-label{display:inline-block;font-size:.75rem;font-weight:800;letter-spacing:3px;margin:0 0 .6rem;background:linear-gradient(90deg,var(--accent),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
  .section-label-light{background:linear-gradient(90deg,#8ee4ff,#fff);-webkit-background-clip:text;background-clip:text}
  .kicker-chip{font-size:.72rem;font-weight:700;letter-spacing:2.4px;color:var(--navy);border:1px solid var(--line);border-radius:var(--r-pill);padding:.3rem .75rem;background:#fff;white-space:nowrap}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.85rem 1.35rem;border-radius:var(--r-pill);font-weight:800;font-size:.98rem;font-family:var(--font);text-decoration:none;color:#fff;border:0;cursor:pointer;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--accent),#0f5fe0);box-shadow:0 8px 26px rgba(25,123,255,.3);transition:transform .18s var(--ease)}
  .btn::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-120%);transition:transform .6s var(--ease)}.btn:hover::after{transform:translateX(120%)}
  .btn:active{transform:scale(.96)}.btn:disabled{opacity:.6;cursor:default}.btn-sm{padding:.6rem 1rem;font-size:.9rem}.btn-wide{width:100%}.btn-ghost{background:#fff;color:var(--navy);border:1.5px solid var(--line);box-shadow:none}
  .glass{background:rgba(255,255,255,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.75);box-shadow:0 1px 0 rgba(15,53,103,.06),0 10px 30px rgba(15,53,103,.08)}
