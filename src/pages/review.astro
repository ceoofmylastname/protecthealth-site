---
// Star-rating review page. Reached from the "Write a Review" button in the
// review-request email. Reads the agent + contact from the URL query so the
// rating and any private feedback are tied to the right broker.
//   /review?a=<agentId>&c=<contactId>&ag=<Agent Name>&n=<Client First>
//
// 4-5 stars -> straight to the Google review page.
// 1-3 stars -> a private feedback panel; the assigned broker + house are
//               emailed to follow up, and the client is told they'll be contacted.
import Base from '../layouts/Base.astro';
import { SITE, GOOGLE_REVIEW_URL } from '../lib/site';

const FN_URL = 'https://hrzonmnswzwridwqbspb.supabase.co/functions/v1';
const ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
const title = 'Leave a Review — ProtectHealth';
---
<Base title={title} description="Tell us about your experience with ProtectHealth." noindex={true}>
  <main class="rv">
    <div class="rv-card" id="rv">
      <div class="rv-brand">
        <img src="/assets/logo.webp" alt="ProtectHealth" width="180" />
      </div>

      <!-- STEP 1: stars -->
      <section class="rv-step" data-step="stars">
        <div class="rv-avatar" id="rv-avatar">P</div>
        <h1 id="rv-title">How was your experience?</h1>
        <p class="rv-sub" id="rv-sub">Your feedback helps us serve you better. Tap a star to rate.</p>
        <div class="rv-stars" id="rv-stars" role="radiogroup" aria-label="Star rating">
          <button type="button" class="rv-star" data-v="1" aria-label="1 star">★</button>
          <button type="button" class="rv-star" data-v="2" aria-label="2 stars">★</button>
          <button type="button" class="rv-star" data-v="3" aria-label="3 stars">★</button>
          <button type="button" class="rv-star" data-v="4" aria-label="4 stars">★</button>
          <button type="button" class="rv-star" data-v="5" aria-label="5 stars">★</button>
        </div>
        <p class="rv-hint" id="rv-hint">&nbsp;</p>
      </section>

      <!-- STEP 2: redirecting (4-5) -->
      <section class="rv-step" data-step="google" hidden>
        <div class="rv-check">★</div>
        <h1>Thank you!</h1>
        <p class="rv-sub">We're taking you to Google to share your review…</p>
        <p class="rv-hint"><a id="rv-google" href="#">Click here if you're not redirected.</a></p>
      </section>

      <!-- STEP 3: feedback (1-3) -->
      <section class="rv-step" data-step="feedback" hidden>
        <div class="rv-emoji">💙</div>
        <h1>We're sorry we missed the mark.</h1>
        <p class="rv-sub">Tell us what happened. This goes straight to our team, and we'll make it right.</p>
        <textarea id="rv-feedback" rows="5" placeholder="What could we have done differently?"></textarea>
        <button type="button" class="rv-btn" id="rv-send">Send feedback</button>
        <p class="rv-err" id="rv-err"></p>
      </section>

      <!-- STEP 4: thanks for feedback -->
      <section class="rv-step" data-step="done" hidden>
        <div class="rv-check ok">✓</div>
        <h1>Thank you for telling us.</h1>
        <p class="rv-sub">We take this seriously. Someone from our team will personally reach out to you soon.</p>
      </section>
    </div>
  </main>

  <script is:inline define:vars={{ FN_URL, ANON, GOOGLE_REVIEW_URL }}>
    (function () {
      const root = document.getElementById('rv');
      const q = new URLSearchParams(location.search);
      const agentId = q.get('a') || null, contactId = q.get('c') || null;
      const agentName = (q.get('ag') || '').trim(), clientFirst = (q.get('n') || '').trim();
      const $ = (s) => root.querySelector(s);
      const step = (name) => root.querySelectorAll('.rv-step').forEach((s) => s.hidden = s.dataset.step !== name);
      let reviewId = null, chosen = 0;

      if (agentName) {
        $('#rv-title').textContent = `How was your experience with ${agentName}?`;
        $('#rv-avatar').textContent = (agentName[0] || 'P').toUpperCase();
      }
      $('#rv-google').href = GOOGLE_REVIEW_URL;

      async function call(body) {
        try {
          const r = await fetch(FN_URL + '/ph-review', { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + ANON }, body: JSON.stringify(body) });
          return await r.json().catch(() => ({}));
        } catch (_e) { return {}; }
      }

      const stars = [...root.querySelectorAll('.rv-star')];
      const paint = (n) => stars.forEach((s) => s.classList.toggle('on', +s.dataset.v <= n));
      stars.forEach((s) => {
        s.addEventListener('mouseenter', () => paint(+s.dataset.v));
        s.addEventListener('mouseleave', () => paint(chosen));
        s.addEventListener('click', () => choose(+s.dataset.v));
      });
      const HINTS = { 1: 'We can do better.', 2: 'We can do better.', 3: 'Let us make it right.', 4: 'Thank you!', 5: 'Awesome — thank you!' };
      stars.forEach((s) => s.addEventListener('mouseenter', () => { $('#rv-hint').textContent = HINTS[+s.dataset.v] || ' '; }));
      $('#rv-stars').addEventListener('mouseleave', () => { $('#rv-hint').textContent = ' '; });

      async function choose(v) {
        if (chosen) return; chosen = v; paint(v);
        const res = await call({ action: 'rate', agent_id: agentId, contact_id: contactId, name: clientFirst || null, rating: v });
        reviewId = res && res.review_id ? res.review_id : null;
        if (v >= 4) {
          step('google');
          setTimeout(() => { location.href = GOOGLE_REVIEW_URL; }, 1200);
        } else {
          step('feedback');
        }
      }

      $('#rv-send').addEventListener('click', async () => {
        const btn = $('#rv-send'); btn.disabled = true; btn.textContent = 'Sending…';
        const text = $('#rv-feedback').value.trim();
        await call({ action: 'feedback', review_id: reviewId, feedback: text });
        step('done');
      });
    })();
  </script>

  <style is:global>
    .rv { min-height: 82vh; display: grid; place-items: center; padding: 40px 16px;
      background: radial-gradient(120% 90% at 50% -10%, #e9f1ff 0%, #f4f7fc 60%); }
    .rv-card { width: 100%; max-width: 480px; background: #fff; border-radius: 24px; padding: 40px 32px;
      text-align: center; box-shadow: 0 30px 70px rgba(11,42,74,.14), 0 2px 8px rgba(11,42,74,.06); border: 1px solid #eef2f8; }
    .rv-brand { margin-bottom: 22px; }
    .rv-brand img { height: auto; display: inline-block; }
    .rv-avatar { width: 66px; height: 66px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center;
      background: linear-gradient(135deg, #2563c9, #123f6b); color: #fff; font-weight: 800; font-size: 1.7rem; box-shadow: 0 10px 24px rgba(37,99,201,.3); }
    .rv-card h1 { color: #0b2a4a; font-size: 1.5rem; line-height: 1.25; margin: 0 0 10px; }
    .rv-sub { color: #5b6b7c; font-size: 1rem; line-height: 1.55; margin: 0 0 20px; }
    .rv-stars { display: flex; justify-content: center; gap: 8px; margin: 8px 0 4px; }
    .rv-star { font-size: 2.9rem; line-height: 1; background: none; border: 0; cursor: pointer; color: #d8e0ec;
      transition: transform .12s ease, color .12s ease; padding: 2px; }
    .rv-star:hover { transform: scale(1.16); }
    .rv-star.on { color: #f5b301; text-shadow: 0 4px 14px rgba(245,179,1,.4); }
    .rv-hint { color: #8493a6; font-size: .9rem; font-weight: 600; margin: 6px 0 0; min-height: 1.2em; }
    .rv-check { width: 76px; height: 76px; margin: 0 auto 18px; border-radius: 50%; display: grid; place-items: center;
      font-size: 2.3rem; color: #fff; background: linear-gradient(135deg, #f5b301, #f59e0b); box-shadow: 0 16px 34px rgba(245,158,11,.4); }
    .rv-check.ok { background: linear-gradient(135deg, #0ea472, #22d3ee); box-shadow: 0 16px 34px rgba(14,164,114,.4); }
    .rv-emoji { font-size: 3rem; margin-bottom: 10px; }
    .rv textarea { width: 100%; box-sizing: border-box; border: 1px solid #d7e0ec; border-radius: 14px; padding: 14px;
      font-family: inherit; font-size: 1rem; resize: vertical; background: #fbfdff; transition: border-color .14s, box-shadow .14s; }
    .rv textarea:focus { outline: none; border-color: #2563c9; box-shadow: 0 0 0 4px rgba(37,99,201,.14); }
    .rv-btn { margin-top: 16px; background: #2563c9; color: #fff; border: 0; border-radius: 14px; padding: 14px 34px;
      font-weight: 750; font-size: 1rem; cursor: pointer; box-shadow: 0 12px 26px rgba(37,99,201,.3); transition: background .14s, transform .14s; }
    .rv-btn:hover { background: #1d4ed8; transform: translateY(-1px); }
    .rv-btn:disabled { opacity: .6; }
    .rv-err { color: #c0392b; font-size: .9rem; margin: 10px 0 0; min-height: 1em; }
    .rv-card a { color: #2563c9; font-weight: 600; }
    @media (max-width: 480px) { .rv-card { padding: 30px 22px; } .rv-star { font-size: 2.5rem; } }
  </style>
</Base>
