---
import Base from '../layouts/Base.astro';
import '../styles/admin-chrome.css';

// Internal tool. Static page. Every byte of data is fetched in the browser
// through Supabase with the anon key, and Row Level Security decides whether
// the signed-in user sees anything at all. No service key ever ships here.
const SUPABASE_URL = 'https://hrzonmnswzwridwqbspb.supabase.co';
const SUPABASE_ANON =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhyem9ubW5zd3p3cmlkd3Fic3BiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc3MTQ0NDcsImV4cCI6MjA2MzI5MDQ0N30.tGq9b0awwwTUBlwjCbOnlRDqUOV2NtQEUkBrU3gcbSo';
---

<Base
  title="Admin, ProtectHealth"
  description="Internal dashboard."
  noindex={true}
>
  <section class="ad" data-supabase-url={SUPABASE_URL} data-supabase-anon={SUPABASE_ANON}>
    <div class="container">

      <!-- boot -->
      <div class="ad-view" data-view="loading">
        <div class="ad-center"><p class="ad-muted">Checking your session…</p></div>
      </div>

      <!-- signed out -->
      <div class="ad-view" data-view="signin" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">ProtectHealth</span>
            <h1>Admin</h1>
            <p class="ad-muted">Enter your work email and we'll send a one-time sign-in link. No password to remember or lose.</p>
            <form class="ad-login-form">
              <input type="email" name="email" placeholder="you@protecthealth.com" autocomplete="email" required />
              <button type="submit" class="btn no-arrow">Send Sign-In Link</button>
            </form>
            <p class="ad-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>

      <!-- signed in but not on the allowlist -->
      <div class="ad-view" data-view="denied" hidden>
        <div class="ad-center">
          <div class="ad-card ad-login">
            <span class="section-label">Not authorised</span>
            <h1>No access</h1>
            <p class="ad-muted">You're signed in as <b data-who></b>, but that address isn't on the admin list for this dashboard.</p>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </div>
      </div>

      <!-- dashboard -->
      <div class="ad-view" data-view="app" hidden>
        <header class="ad-head">
          <div>
            <span class="section-label">ProtectHealth Admin</span>
            <h1>Appointments &amp; inquiries</h1>
            <nav class="ad-nav">
              <a href="/admin" class="is-on">Leads</a>
              <a href="/admin/contacts">All Contacts</a>
              <a href="/admin/calendar">House Calendar</a>
              <a href="/admin/tickets">Support Tickets</a>
              <a href="/admin/campaigns">Campaigns</a>
              <a href="/admin/staff">Staff</a>
            </nav>
          </div>
          <div class="ad-head-right">
            <span class="ad-muted ad-who" data-who></span>
            <button type="button" class="btn ghost no-arrow ad-signout">Sign out</button>
          </div>
        </header>

        <div class="ad-stats">
          <div class="ad-stat spot"><b data-stat="upcoming">, </b><span>Upcoming conversations</span></div>
          <div class="ad-stat spot"><b data-stat="bookings">, </b><span>Bookings all time</span></div>
          <div class="ad-stat spot"><b data-stat="forms">, </b><span>Form inquiries</span></div>
          <div class="ad-stat spot"><b data-stat="emails">, </b><span>Emails sent</span></div>
          <div class="ad-stat spot"><b data-stat="queued">, </b><span>Emails queued</span></div>
        </div>

        <details class="ad-addbroker">
          <summary>+ Add a broker login</summary>
          <form class="ab-form">
            <div class="ab-row">
              <input type="email" name="email" class="ab-email" placeholder="broker@protecthealth.com" autocomplete="off" required />
              <input type="text" name="full_name" class="ab-name" placeholder="Full name (optional)" autocomplete="off" />
              <button type="submit" class="ab-go">Add &amp; send set-up link</button>
            </div>
            <p class="ab-hint ad-muted">Creates their login and emails them a one-time link to set a password. They can also use Forgot password at <code>/app</code> afterward.</p>
            <p class="ab-status" role="status"></p>
          </form>
        </details>

        <details class="ad-addbroker sc-panel">
          <summary>🔑 Setup code &mdash; first-time broker logins</summary>
          <div class="sc-body">
            <p class="ab-hint ad-muted">Brokers set their own password at <code>/app</code> using this code. Say it out loud in the meeting, then clear it when the room empties. The code only ever works on an account that has <b>never</b> had a password, so it can't be used against a broker who is already set up.</p>
            <p class="sc-status-line ad-muted">Checking&hellip;</p>
            <div class="ab-row">
              <input type="text" class="sc-code" placeholder="Setup code (6+ characters)" autocomplete="off" spellcheck="false" />
              <input type="datetime-local" class="sc-exp" title="When the code stops working. Defaults to 24 hours." />
              <button type="button" class="ab-go sc-save">Set code</button>
              <button type="button" class="ab-go sc-clear" style="background:#b91c1c;display:none">Clear</button>
            </div>
            <p class="sc-msg" role="status"></p>
            <div class="sc-progress">
              <p class="sc-count ad-muted">&nbsp;</p>
              <details class="sc-pending"><summary>Who hasn't set up yet</summary><div class="sc-pending-list ad-muted"></div></details>
            </div>
          </div>
        </details>

        <details class="ad-addbroker rv-panel">
          <summary>★ Send review requests to active clients</summary>
          <div class="rv-body">
            <p class="ab-hint ad-muted">Sends the branded "Your Experience Matters" email to active clients (tagged <b>client</b>, with an email and an assigned broker). Each email carries that client's own broker and a Write-a-Review button. Already-emailed clients are skipped automatically. <b>Send a test to yourself first.</b></p>
            <p class="rv-count ad-muted">Counting eligible clients…</p>
            <div class="ab-row">
              <input type="email" class="rv-test-email" placeholder="your@email.com — send a test here" autocomplete="off" />
              <button type="button" class="ab-go rv-test-btn">Send test to me</button>
            </div>
            <div class="ab-row" style="margin-top:10px">
              <button type="button" class="ab-go rv-send-btn" style="background:#0b2a4a">Send to ALL active clients</button>
            </div>
            <p class="rv-status" role="status"></p>
          </div>
        </details>

        <details class="ad-addbroker rv-track">
          <summary>★ Review tracking — who got it, who clicked, who rated</summary>
          <div class="rv-body">
            <p class="ab-hint ad-muted">Every review request that went out, whether the client opened the link, and the star they chose. Updates each time you open this.</p>
            <div class="rvt-summary ad-muted">Open to load review activity…</div>
            <div class="rvt-wrap"><table class="rvt-table"><tbody></tbody></table></div>
          </div>
        </details>

        <details class="ad-addbroker lg-panel">
          <summary>👤 Broker logins — who's been in, who never has</summary>
          <div class="rv-body">
            <p class="ab-hint ad-muted">Last sign-in and last activity per active broker, most recent first. <b>Never</b> means they have not logged in yet.</p>
            <div class="rvt-wrap"><table class="rvt-table lg-table"><tbody></tbody></table></div>
          </div>
        </details>

        <details class="ad-addbroker rr-panel">
          <summary>⇄ Lead routing — round robin</summary>
          <div class="rv-body">
            <p class="ab-hint ad-muted">Pick which agents receive incoming website leads and each agent's share. <b>Double</b> and <b>Triple</b> get proportionally more leads, interleaved (a Double next to an Equal deals A&nbsp;B&nbsp;A&nbsp;A&nbsp;B&nbsp;A). Assigned leads land in that agent's contacts and calendar, the agent gets a new-lead email, and the lead gets a branded welcome introducing their broker. <b>While this list is empty, GoHighLevel keeps assigning — adding agents here is the cutover switch.</b></p>
            <p class="rr-status ad-muted">Open to load…</p>
            <div class="rr-list"></div>
            <div class="ab-row" style="margin-top:12px">
              <button type="button" class="ab-go rr-save">Save rotation</button>
            </div>
            <p class="rr-saved" role="status"></p>
            <div style="border-top:1px solid var(--line);margin-top:16px;padding-top:14px">
              <p style="margin:0 0 4px;font-weight:700;color:var(--navy);font-size:.92rem">⏱ 60-minute reassignments</p>
              <p class="ab-hint ad-muted" style="margin-top:0">Leads that sat unclaimed for an hour and were moved to Jason — who they were taken from, and when.</p>
              <div class="rr-ttl-list ad-muted">Loading…</div>
            </div>
          </div>
        </details>

        <div class="ad-toolbar">
          <input type="search" class="ad-search" placeholder="Search name, email or phone…" aria-label="Search" />
          <div class="ad-filters" role="group" aria-label="Filter">
            <button type="button" class="ad-chip is-on" data-filter="all">All</button>
            <button type="button" class="ad-chip" data-filter="booking">Bookings</button>
            <button type="button" class="ad-chip" data-filter="form">Inquiries</button>
            <button type="button" class="ad-chip" data-filter="upcoming">Upcoming</button>
          </div>
          <button type="button" class="ad-refresh" title="Refresh">↻</button>
        </div>

        <div class="ad-split">
          <div class="ad-list" role="list"></div>
          <aside class="ad-detail">
            <div class="ad-detail-empty ad-muted">Pick someone on the left to see everything they told us and every email they've been sent.</div>
            <div class="ad-detail-body" hidden></div>
          </aside>
        </div>
      </div>

    </div>
  </section>
</Base>

<style is:global>
  .ad-addbroker { border: 1.5px solid var(--line); border-radius: 14px; background: #fff; margin-bottom: 20px; overflow: hidden; }
  .ad-addbroker > summary { cursor: pointer; padding: 14px 18px; font-weight: 600; color: var(--navy); list-style: none; }
  .ad-addbroker > summary::-webkit-details-marker { display: none; }
  .ad-addbroker[open] > summary { border-bottom: 1px solid var(--line); }
  .rv-body { padding: 16px 18px; }
  .rvt-summary { font-size: .92rem; margin: 6px 0 14px; line-height: 1.7; }
  .rvt-wrap { max-height: 460px; overflow: auto; border: 1px solid var(--line); border-radius: 12px; }
  .rvt-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .rvt-table td { padding: 10px 12px; border-bottom: 1px solid #eef2f8; vertical-align: top; }
  .rvt-table tr:last-child td { border-bottom: 0; }
  .rvt-table tr.rvt-head td { position: sticky; top: 0; background: #f6f9fe; font-weight: 700; color: var(--navy); font-size: .72rem; text-transform: uppercase; letter-spacing: .5px; }
  .rr-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px 2px; border-bottom: 1px solid #eef2f8; }
  .rr-row:last-child { border-bottom: 0; }
  .rr-check { display: flex; align-items: center; gap: 10px; cursor: pointer; min-width: 0; }
  .rr-check input { width: 17px; height: 17px; accent-color: #2563c9; flex: none; }
  .rr-check b { color: var(--navy); font-size: .92rem; display: block; }
  .rr-check em { color: #5b6b7c; font-style: normal; font-size: .78rem; display: block; }
  .rr-row select { padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; font-family: inherit; font-size: .85rem; background: #fff; }
  .rr-row select:disabled { opacity: .45; }
  .rr-ttl-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; padding: 9px 2px; border-bottom: 1px solid #eef2f8; }
  .rr-ttl-row:last-child { border-bottom: 0; }
  .rr-ttl-row b { color: var(--navy); font-size: .9rem; }
  .ab-form { padding: 16px 18px; }
  .ab-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .ab-row input { flex: 1 1 200px; min-width: 0; padding: 11px 13px; border: 1.5px solid var(--line); border-radius: 10px; font-size: 0.95rem; }
  .ab-row input:focus { outline: none; border-color: var(--blue); }
  .ab-go { flex: 0 0 auto; padding: 11px 20px; border: 0; border-radius: 10px; background: var(--navy); color: #fff; font-weight: 600; cursor: pointer; }
  .ab-go:hover { background: var(--blue); }
  .ab-go:disabled { opacity: 0.6; cursor: default; }
  .ab-hint { margin: 10px 0 0; font-size: 0.85rem; }
  .ab-hint code, .ab-status code { background: #eef2f7; padding: 1px 5px; border-radius: 5px; }
  .ab-status { margin: 10px 0 0; font-size: 0.9rem; min-height: 1.1em; }
  .ab-status.is-good { color: #0a7d3c; }
  .ab-status.is-bad { color: #c0392b; }
  /* .sc-msg carries the setup-code result. It used to render in the same muted
     grey as the surrounding hints, so a rejected save read as instructions
     rather than an error and looked like the button simply did nothing. */
  .sc-msg { margin: 10px 0 0; font-size: 0.9rem; min-height: 1.1em; }
  .sc-msg.is-bad { color: #c0392b; font-weight: 650; }

  .ad-split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .ad-list { display: grid; gap: 9px; max-height: 74vh; overflow-y: auto; padding-right: 4px; }

  .ad-row {
    display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center;
    background: #fff; border: 1.5px solid var(--line); border-radius: 14px;
    padding: 14px 16px; cursor: pointer; text-align: left; font-family: var(--font);
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
  }
  .ad-row:hover { border-color: var(--blue); box-shadow: 0 8px 22px rgba(25,123,255,0.14); transform: translateX(2px); }
  .ad-row.is-on { border-color: var(--blue); box-shadow: 0 8px 22px rgba(25,123,255,0.2); }
  .ad-row-name { font-weight: 800; color: var(--navy); font-size: 1rem; }
  .ad-row-sub { color: var(--muted); font-size: 0.84rem; margin-top: 2px; }
  /* Owner is read back from GoHighLevel by the sync sweep, so it can lag a
     lead by up to a minute. Its own line rather than appended to the contact
     details, because "who has this" is what you scan the list for. */
  .ad-row-owner { display: block; margin-top: 3px; font-size: 0.78rem; font-weight: 700; color: var(--blue); }
  .ad-row-owner.none { color: var(--muted); font-weight: 600; }
  .ad-synced { display: block; margin-top: 1px; color: var(--muted); font-size: 0.74rem; font-weight: 500; }
  .ad-row-when { text-align: right; font-size: 0.84rem; font-weight: 700; color: var(--navy); white-space: nowrap; }
  .ad-row-when small { display: block; font-weight: 700; color: var(--muted); font-size: 0.74rem; }

  .ad-tag {
    display: inline-block; font-size: 0.66rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
    padding: 3px 9px; border-radius: 999px; margin-right: 6px;
  }
  .ad-tag.booking { background: rgba(25,123,255,0.12); color: var(--blue); }
  .ad-tag.form { background: rgba(90,111,133,0.12); color: var(--muted); }
  .ad-tag.past { background: rgba(15,53,103,0.09); color: var(--navy); }

  .ad-detail { position: sticky; top: 90px; background: #fff; border: 1.5px solid var(--line); border-radius: var(--radius-lg); padding: 24px; max-height: 74vh; overflow-y: auto; }
  .ad-detail h2 { font-size: 1.3rem; margin: 0 0 2px; }
  .ad-detail-empty { padding: 30px 6px; text-align: center; }
  .ad-kv { display: grid; grid-template-columns: minmax(120px, 40%) 1fr; gap: 7px 14px; margin: 16px 0 4px; font-size: 0.9rem; }
  .ad-kv dt { color: var(--muted); }
  .ad-kv dd { margin: 0; color: var(--ink); font-weight: 700; word-break: break-word; }
  .ad-sec { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  .ad-sec h3 { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 2px; color: var(--muted); margin: 0 0 12px; }

  .ad-mail { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: start; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 0.86rem; }
  .ad-mail:last-child { border-bottom: none; }
  .ad-dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 5px; }
  .ad-dot.sent { background: #1e9e5a; }
  .ad-dot.pending { background: var(--gold); }
  .ad-dot.failed { background: #d64545; }
  .ad-dot.skipped { background: #9ab0c6; }
  .ad-mail-kind { font-weight: 800; color: var(--navy); }
  .ad-mail-sub { color: var(--muted); font-size: 0.8rem; margin-top: 1px; }
  .ad-mail-when { text-align: right; color: var(--muted); font-size: 0.78rem; white-space: nowrap; }

  .ad-empty { padding: 40px; text-align: center; }

  @media (max-width: 940px) {
    .ad-split { grid-template-columns: 1fr; }
    .ad-detail { position: static; max-height: none; }
    .ad-list { max-height: none; }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector('.ad');
  if (root) {
    const sb = createClient(
      root.getAttribute('data-supabase-url'),
      root.getAttribute('data-supabase-anon'),
      { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } },
    );

    const $ = (s) => root.querySelector(s);
    const $$ = (s) => Array.from(root.querySelectorAll(s));
    const view = (name) =>
      $$('.ad-view').forEach((v) => (v.hidden = v.getAttribute('data-view') !== name));

    let leads = [];
    let emailsByLead = new Map();
    let selected = null;
    let filter = 'all';
    let query = '';

    const TZ = 'America/Los_Angeles';
    const fmtDateTime = (iso) =>
      new Date(iso).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const fmtFull = (iso) =>
      new Date(iso).toLocaleString('en-US', { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const nameOf = (l) => [l.first_name, l.last_name].filter(Boolean).join(' ') || l.email || l.phone || 'Unknown';

    // Three states worth telling apart, because they mean different things to
    // whoever is looking. A name means GoHighLevel has assigned it. Unassigned
    // means we asked and GHL genuinely has nobody on it, which is a problem to
    // chase. Never synced means we have not looked yet, which usually resolves
    // itself within a minute and is not worth chasing.
    const ownerLabel = (l) => {
      if (l.assigned_user_name) return esc(l.assigned_user_name);
      if (l.owner_synced_at) return 'Unassigned';
      return l.ghl_contact_id ? 'Assigning…' : 'Not in GoHighLevel';
    };

    const MAIL_LABEL = {
      confirmation: 'Booking confirmation',
      reminder_24h: '24-hour reminder',
      reminder_1h: '1-hour reminder',
    };

    // ---------- auth ----------
    $('.ad-login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = $('.ad-status');
      const email = e.target.email.value.trim();
      status.classList.remove('is-bad');
      status.textContent = 'Sending…';
      const { error } = await sb.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${location.origin}/admin` },
      });
      if (error) {
        status.classList.add('is-bad');
        status.textContent = error.message;
      } else {
        status.textContent = 'Check your inbox. The link signs you straight in.';
      }
    });

    $$('.ad-signout').forEach((b) =>
      b.addEventListener('click', async () => {
        await sb.auth.signOut();
        location.reload();
      }),
    );

    // ---------- add a broker login ----------
    const abForm = $('.ab-form');
    if (abForm) {
      abForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const statusEl = $('.ab-status');
        const go = $('.ab-go');
        const email = abForm.email.value.trim();
        const full_name = abForm.full_name.value.trim();
        statusEl.classList.remove('is-good', 'is-bad');
        if (!email) { statusEl.textContent = 'Enter an email address.'; statusEl.classList.add('is-bad'); return; }
        go.disabled = true; statusEl.textContent = 'Adding…';

        // Send the function a fresh token; a stale one comes back unauthorized.
        let { data: { session } } = await sb.auth.getSession();
        const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
        if (session && stale) { const r = await sb.auth.refreshSession(); if (r?.data?.session) session = r.data.session; }
        if (!session) { go.disabled = false; statusEl.textContent = 'Your session expired. Sign out and back in.'; statusEl.classList.add('is-bad'); return; }

        const { data, error } = await sb.functions.invoke('ph-auth', { body: { action: 'admin_add_broker', email, full_name } });
        go.disabled = false;
        if (error || !data?.ok) {
          let msg = data?.error || 'Something went wrong.';
          try { if (error?.context?.json) { const j = await error.context.json(); if (j?.error) msg = j.error; } } catch (_) {}
          statusEl.textContent = msg; statusEl.classList.add('is-bad');
          return;
        }
        const who = data.full_name && data.full_name !== data.email ? data.full_name : data.email;
        if (data.emailed) {
          statusEl.textContent = `${who} is set up. A set-up link is on its way to ${data.email}.`;
          statusEl.classList.add('is-good');
        } else {
          statusEl.textContent = `${who} is set up, but the set-up email did not send${data.email_error ? ' (' + data.email_error + ')' : ''}. They can still use Forgot password at /app.`;
          statusEl.classList.add('is-bad');
        }
        abForm.reset();
        load();
      });
    }

    // ---------- review-request blast ----------
    async function freshSession() {
      let { data: { session } } = await sb.auth.getSession();
      const stale = !session?.expires_at || (session.expires_at * 1000 - Date.now() < 120000);
      if (session && stale) { const r = await sb.auth.refreshSession(); if (r?.data?.session) session = r.data.session; }
      return session;
    }
    // ---------- setup code (first-time broker logins) ----------
    // All four operations live in ph-auth, which verifies the caller is an
    // admin server-side. Nothing here trusts the browser.
    const scPanel = $('.sc-panel');
    if (scPanel) {
      const AUTH_FN = root.getAttribute('data-supabase-url') + '/functions/v1/ph-auth';
      // Local escaper: the other panels define their own inside their blocks,
      // so there is nothing named esch in scope here.
      const scEsc = (v) => String(v == null ? '' : v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const codeEl = $('.sc-code'), expEl = $('.sc-exp'), msgEl = $('.sc-msg');
      const lineEl = $('.sc-status-line'), saveBtn = $('.sc-save'), clearBtn = $('.sc-clear');
      const countEl = $('.sc-count'), pendWrap = $('.sc-pending'), pendList = $('.sc-pending-list');

      async function scCall(body) {
        const session = await freshSession();
        if (!session) return { ok: false, json: { error: 'Session expired. Sign in again.' } };
        const r = await fetch(AUTH_FN, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: root.getAttribute('data-supabase-anon'),
            Authorization: 'Bearer ' + session.access_token,
          },
          body: JSON.stringify(body),
        });
        let j = {}; try { j = await r.json(); } catch (_e) {}
        return { ok: r.ok, json: j };
      }

      const fmtWhen = (iso) => {
        try {
          return new Date(iso).toLocaleString('en-US', {
            timeZone: 'America/Los_Angeles', month: 'short', day: 'numeric',
            hour: 'numeric', minute: '2-digit',
          }) + ' Vegas';
        } catch (_e) { return iso; }
      };

      async function scRefresh() {
        const { ok, json } = await scCall({ action: 'admin_setup_status' });
        if (!ok || !json.ok) {
          lineEl.textContent = json.error || 'Could not read the setup code status.';
          return;
        }
        if (!json.code_set) {
          lineEl.innerHTML = 'No code active. Brokers cannot self-serve until you set one.';
          clearBtn.style.display = 'none';
        } else if (json.expired) {
          lineEl.innerHTML = '<b style="color:#b91c1c">EXPIRED</b> — the code stopped working ' + scEsc(fmtWhen(json.expires_at)) + '. Set a new one to reopen setup.';
          clearBtn.style.display = '';
        } else {
          lineEl.innerHTML = '<b style="color:#15803d">LIVE</b> — working until ' + scEsc(fmtWhen(json.expires_at)) + '.';
          clearBtn.style.display = '';
        }
        countEl.innerHTML = '<b>' + json.completed + ' of ' + json.active + '</b> brokers have set up their login.';
        const list = json.pending_list || [];
        pendWrap.style.display = list.length ? '' : 'none';
        pendList.innerHTML = list.length
          ? list.map((r) => '<div>' + scEsc(r.full_name || '(no name)') + ' <span style="opacity:.7">' + scEsc(r.email || '') + '</span></div>').join('')
          : '';
      }

      // Must match MIN_SETUP_CODE in ph-auth. If this floor is ever the lower of
      // the two, the button appears to work and the server rejects it, which is
      // exactly how a 6-digit code looked like a broken Save button for a week.
      const SC_MIN = 6;
      saveBtn.addEventListener('click', async () => {
        const code = codeEl.value.trim();
        const n = code.replace(/\s+/g, '').length;
        if (n < SC_MIN) {
          // Say what was wrong with THIS input, not the rule in the abstract.
          // The old copy read like a placeholder hint sitting under the field,
          // so a rejected save was indistinguishable from a save that did
          // nothing at all.
          msgEl.textContent = `That code is ${n} character${n === 1 ? '' : 's'}. It needs at least ${SC_MIN}.`;
          msgEl.classList.add('is-bad');
          return;
        }
        msgEl.classList.remove('is-bad');
        saveBtn.disabled = true; msgEl.textContent = 'Saving…';
        // datetime-local is wall-clock with no zone; hand the server an ISO instant.
        const expires_at = expEl.value ? new Date(expEl.value).toISOString() : '';
        const { ok, json } = await scCall({ action: 'admin_set_setup_code', code, expires_at });
        saveBtn.disabled = false;
        if (!ok || !json.ok) { msgEl.textContent = json.error || 'Could not save the code.'; msgEl.classList.add('is-bad'); return; }
        msgEl.classList.remove('is-bad');
        msgEl.textContent = 'Code is live. Read it out to the room.';
        codeEl.value = '';
        scRefresh();
      });

      clearBtn.addEventListener('click', async () => {
        if (!confirm('Clear the setup code? Brokers who have not set up yet will not be able to until you set a new one.')) return;
        clearBtn.disabled = true; msgEl.textContent = 'Clearing…';
        const { ok, json } = await scCall({ action: 'admin_clear_setup_code' });
        clearBtn.disabled = false;
        msgEl.textContent = (ok && json.ok) ? 'Code cleared.' : (json.error || 'Could not clear the code.');
        scRefresh();
      });

      scPanel.addEventListener('toggle', () => { if (scPanel.open) scRefresh(); });
    }

    const rvPanel = $('.rv-panel');
    if (rvPanel) {
      const countEl = $('.rv-count'), statusEl = $('.rv-status');
      const testEmail = $('.rv-test-email'), testBtn = $('.rv-test-btn'), sendBtn = $('.rv-send-btn');
      let counted = false;
      async function refreshCount() {
        try {
          const { data } = await sb.functions.invoke('ph-review-blast', { body: { action: 'count' } });
          if (data && typeof data.count === 'number') countEl.textContent = `${data.count.toLocaleString()} active clients have not been sent a review request yet.`;
        } catch (_) { countEl.textContent = 'Could not load the eligible count.'; }
      }
      rvPanel.addEventListener('toggle', () => { if (rvPanel.open && !counted) { counted = true; refreshCount(); if (!testEmail.value) { const w = ($('[data-who]')?.textContent || '').trim(); if (w.includes('@')) testEmail.value = w; } } });

      testBtn.addEventListener('click', async () => {
        const to = testEmail.value.trim();
        statusEl.classList.remove('is-good', 'is-bad');
        if (!to) { statusEl.textContent = 'Enter an email to send the test to.'; statusEl.classList.add('is-bad'); return; }
        testBtn.disabled = true; statusEl.textContent = 'Sending test…';
        if (!(await freshSession())) { testBtn.disabled = false; statusEl.textContent = 'Session expired. Sign out and back in.'; statusEl.classList.add('is-bad'); return; }
        try {
          const { data, error } = await sb.functions.invoke('ph-review-blast', { body: { action: 'test', test_email: to } });
          if (error || !data?.ok) { statusEl.textContent = data?.error || 'Test failed.'; statusEl.classList.add('is-bad'); }
          else { statusEl.textContent = `Test sent to ${to}. Check your inbox.`; statusEl.classList.add('is-good'); }
        } catch (e) { statusEl.textContent = 'Test failed.'; statusEl.classList.add('is-bad'); }
        testBtn.disabled = false;
      });

      sendBtn.addEventListener('click', async () => {
        statusEl.classList.remove('is-good', 'is-bad');
        if (!confirm('Send the review-request email to ALL eligible active clients? This cannot be undone. Send a test to yourself first if you have not.')) return;
        sendBtn.disabled = true; testBtn.disabled = true;
        let total = 0;
        try {
          for (let i = 0; i < 60; i++) {   // up to 60 batches (150 each) per run
            if (!(await freshSession())) { statusEl.textContent = 'Session expired mid-send. Sign back in and click again to continue where it left off.'; statusEl.classList.add('is-bad'); break; }
            statusEl.textContent = `Sending… ${total.toLocaleString()} sent so far.`;
            const { data, error } = await sb.functions.invoke('ph-review-blast', { body: { action: 'send', limit: 150 } });
            if (error || !data?.ok) { statusEl.textContent = data?.error || 'Send failed — click again to resume.'; statusEl.classList.add('is-bad'); break; }
            if (data.busy) {
              // A campaign pass holds the send lock (keeps combined rate under
              // Resend's 2/sec). Wait it out and retry — doesn't burn a batch slot.
              statusEl.textContent = `Waiting for a campaign send to finish… ${total.toLocaleString()} sent so far.`;
              await new Promise((r) => setTimeout(r, 30000));
              i--; continue;
            }
            total += data.sent || 0;
            if ((data.remaining || 0) <= 0 || (data.batch || 0) === 0) { statusEl.textContent = `Done. ${total.toLocaleString()} review requests sent.`; statusEl.classList.add('is-good'); break; }
          }
        } catch (e) { statusEl.textContent = 'Send interrupted — click again to resume.'; statusEl.classList.add('is-bad'); }
        sendBtn.disabled = false; testBtn.disabled = false;
        refreshCount();
      });
    }

    // ---------- review tracking ----------
    const rvTrack = $('.rv-track');
    if (rvTrack) {
      const summaryEl = $('.rvt-summary'), tbody = $('.rvt-table tbody');
      const fmt = (t) => t ? new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
      const esch = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      async function loadTracking() {
        summaryEl.textContent = 'Loading…'; tbody.innerHTML = '';
        // p_all widens scope from "my own clients" to the whole house. The
        // function still checks ph_is_admin() internally, so a non-admin passing
        // it sees only their own. The zero-argument overload was dropped in
        // migration fix_review_tracking_overload_ambiguity — having both made
        // PostgREST refuse to choose, and this panel errored out entirely.
        const { data, error } = await sb.rpc('ph_review_tracking', { p_all: true });
        if (error) { summaryEl.textContent = 'Could not load tracking.'; return; }
        const rows = data || [];
        const sent = rows.length;
        const clicked = rows.filter((r) => r.clicked_at).length;
        const rated = rows.filter((r) => r.rating != null).length;
        const hi = rows.filter((r) => r.rating >= 4).length;
        const lo = rows.filter((r) => r.rating != null && r.rating <= 3).length;
        const pct = sent ? Math.round(clicked / sent * 100) : 0;
        summaryEl.innerHTML = `<b style="color:#0b2a4a">${sent.toLocaleString()}</b> sent &nbsp;·&nbsp; <b style="color:#0b2a4a">${clicked.toLocaleString()}</b> clicked (${pct}%) &nbsp;·&nbsp; <b style="color:#0b2a4a">${rated.toLocaleString()}</b> rated &nbsp;·&nbsp; <b style="color:#0ea472">${hi}</b> sent to Google (4–5★) &nbsp;·&nbsp; <b style="color:#c0392b">${lo}</b> private feedback (1–3★)`;
        const engaged = rows.filter((r) => r.clicked_at || r.rating != null);
        const show = engaged.length ? engaged : rows.slice(0, 100);
        tbody.innerHTML = `<tr class="rvt-head"><td>Client</td><td>Broker</td><td>Sent</td><td>Clicked</td><td>Stars</td><td>Feedback</td></tr>` +
          show.map((r) => {
            const stars = r.rating != null ? '★'.repeat(r.rating) + '<span style="color:#d8e0ec">' + '★'.repeat(5 - r.rating) + '</span>' : '<span class="ad-muted">—</span>';
            const starColor = r.rating >= 4 ? '#f5b301' : r.rating != null ? '#e67e22' : '#d8e0ec';
            return `<tr>
              <td><div style="font-weight:600">${esch(r.client_name || '—')}</div><div class="ad-muted" style="font-size:.8rem">${esch(r.client_email || '')}</div></td>
              <td class="ad-muted">${esch(r.agent_name || '—')}</td>
              <td class="ad-muted">${fmt(r.sent_at)}${r.send_status === 'failed' ? ' <span style="color:#c0392b">(failed)</span>' : ''}</td>
              <td>${r.clicked_at ? '<span style="color:#0ea472;font-weight:700">✓ ' + fmt(r.clicked_at) + '</span>' : '<span class="ad-muted">—</span>'}</td>
              <td style="color:${starColor};font-weight:700;letter-spacing:1px">${stars}</td>
              <td class="ad-muted" style="font-size:.82rem;max-width:220px">${esch(r.feedback || '')}</td>
            </tr>`;
          }).join('');
        if (!engaged.length && sent) summaryEl.innerHTML += ' &nbsp;— no clicks or ratings yet; showing the most recent sends.';
      }
      let loadedT = false;
      rvTrack.addEventListener('toggle', () => { if (rvTrack.open && !loadedT) { loadedT = true; loadTracking(); } });
    }

    // ---------- broker logins (last sign-in / last activity) ----------
    const lgPanel = $('.lg-panel');
    if (lgPanel) {
      const tbody = $('.lg-table tbody');
      const esch2 = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const ago = (t) => {
        if (!t) return null;
        const m = Math.round((Date.now() - new Date(t).getTime()) / 60000);
        if (m < 2) return 'just now'; if (m < 60) return m + ' min ago';
        const h = Math.round(m / 60); if (h < 48) return h + ' hr ago';
        return new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      };
      let loadedLG = false;
      lgPanel.addEventListener('toggle', async () => {
        if (!lgPanel.open || loadedLG) return; loadedLG = true;
        const { data, error } = await sb.rpc('ph_agent_logins');
        if (error || !data) { tbody.innerHTML = '<tr><td>Could not load.</td></tr>'; return; }
        tbody.innerHTML = `<tr class="rvt-head"><td>Broker</td><td>Clients</td><td>Last sign-in</td><td>Last active</td></tr>` +
          data.map((r) => `<tr>
            <td><div style="font-weight:600">${esch2(r.full_name)}</div><div class="ad-muted" style="font-size:.8rem">${esch2(r.email)}</div></td>
            <td class="ad-muted">${(r.contacts || 0).toLocaleString()}</td>
            <td>${r.last_sign_in_at ? '<span style="color:#0b7d55;font-weight:650">' + ago(r.last_sign_in_at) + '</span>' : (r.has_login ? '<span style="color:#b45309;font-weight:700">Never</span>' : '<span class="ad-muted">No account</span>')}</td>
            <td class="ad-muted">${ago(r.last_seen_at) || '—'}</td>
          </tr>`).join('');
      });
    }

    // ---------- round-robin lead routing ----------
    const rrPanel = $('.rr-panel');
    if (rrPanel) {
      const statusEl = $('.rr-status'), listEl = $('.rr-list'), savedEl = $('.rr-saved');
      const esch = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      let agents = [], rotation = [];
      async function loadRR() {
        statusEl.textContent = 'Loading…';
        const [agRes, rrRes] = await Promise.all([
          sb.from('ph_agents').select('id, full_name, email').eq('is_active', true).order('full_name'),
          sb.from('ph_round_robin').select('*'),
        ]);
        agents = (agRes.data || []).filter((a) => a.email);
        rotation = rrRes.data || [];
        const inRot = rotation.filter((r) => r.is_active).length;
        statusEl.innerHTML = inRot
          ? `<b style="color:#0b7d55">Native routing is ON</b> — ${inRot} agent${inRot === 1 ? '' : 's'} in rotation.`
          : '<b style="color:#b45309">Native routing is OFF</b> — rotation is empty, GoHighLevel is still assigning.';
        listEl.innerHTML = agents.map((a) => {
          const r = rotation.find((x) => x.agent_id === a.id);
          const on = r && r.is_active, w = r ? r.weight : 1;
          return `<div class="rr-row">
            <label class="rr-check"><input type="checkbox" data-rr-on="${a.id}" ${on ? 'checked' : ''}><span><b>${esch(a.full_name)}</b><em>${esch(a.email)}</em></span></label>
            <select data-rr-w="${a.id}" ${on ? '' : 'disabled'}>
              <option value="1" ${w === 1 ? 'selected' : ''}>Equal share (1×)</option>
              <option value="2" ${w === 2 ? 'selected' : ''}>Double (2×)</option>
              <option value="3" ${w === 3 ? 'selected' : ''}>Triple (3×)</option>
            </select>
          </div>`;
        }).join('') || '<p class="ad-muted">No active agents with an email on file.</p>';
        listEl.querySelectorAll('[data-rr-on]').forEach((cb) => cb.addEventListener('change', () => {
          listEl.querySelector(`[data-rr-w="${cb.dataset.rrOn}"]`).disabled = !cb.checked;
        }));
        loadTtlHistory();
      }

      // Reassignment history: leads the TTL sweep moved to Jason.
      async function loadTtlHistory() {
        const host = $('.rr-ttl-list'); if (!host) return;
        const { data: rows } = await sb.from('ph_leads')
          .select('first_name, last_name, email, created_at, ttl_reassigned_at, ttl_from_agent_id, source_form, page')
          .eq('assigned_via', 'rr_ttl')
          .order('ttl_reassigned_at', { ascending: false }).limit(50);
        if (!rows || !rows.length) { host.textContent = 'None yet — every routed lead has been claimed within the hour.'; return; }
        const nameOfAgent = (id) => (agents.find((a) => a.id === id)?.full_name) || 'previous agent';
        const fmt2 = (t) => t ? new Date(t).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
        host.classList.remove('ad-muted');
        host.innerHTML = rows.map((r) => {
          const who = [r.first_name, r.last_name].filter(Boolean).join(' ') || r.email || 'Lead';
          return `<div class="rr-ttl-row">
            <div><b>${esch(who)}</b><span class="ad-muted" style="font-size:.8rem;display:block">${esch(r.email || '')}${r.source_form ? ' · ' + esch(r.source_form) : ''}</span></div>
            <div class="ad-muted" style="font-size:.82rem;text-align:right">
              <span style="color:#b45309;font-weight:650">${esch(nameOfAgent(r.ttl_from_agent_id))}</span> → <b style="color:#0b2a4a">Jason</b><br>
              in ${fmt2(r.created_at)} · moved ${fmt2(r.ttl_reassigned_at)}
            </div>
          </div>`;
        }).join('');
      }
      let loadedRR = false;
      rrPanel.addEventListener('toggle', () => { if (rrPanel.open && !loadedRR) { loadedRR = true; loadRR(); } });

      $('.rr-save').addEventListener('click', async () => {
        savedEl.classList.remove('is-good', 'is-bad'); savedEl.textContent = 'Saving…';
        const rows = [], off = [];
        listEl.querySelectorAll('[data-rr-on]').forEach((cb) => {
          const id = cb.dataset.rrOn;
          if (cb.checked) rows.push({ agent_id: id, weight: parseInt(listEl.querySelector(`[data-rr-w="${id}"]`).value, 10) || 1, is_active: true });
          else if (rotation.some((r) => r.agent_id === id && r.is_active)) off.push(id);
        });
        let err = null;
        if (rows.length) { const { error } = await sb.from('ph_round_robin').upsert(rows, { onConflict: 'agent_id' }); err = err || error; }
        if (off.length) { const { error } = await sb.from('ph_round_robin').update({ is_active: false }).in('agent_id', off); err = err || error; }
        if (err) { savedEl.textContent = 'Could not save: ' + err.message; savedEl.classList.add('is-bad'); return; }
        savedEl.textContent = rows.length
          ? `Saved — ${rows.length} agent${rows.length === 1 ? '' : 's'} in rotation. New website leads now route natively.`
          : 'Saved — rotation is empty, GoHighLevel keeps assigning.';
        savedEl.classList.add('is-good');
        loadRR();
      });
    }

    // ---------- data ----------
    async function load() {
      // RLS returns rows only for allowlisted emails, so an empty ph_admins
      // read is the authorisation signal, not an error we need to interpret.
      const { data: admin } = await sb.from('ph_admins').select('email').limit(1);
      if (!admin || !admin.length) { view('denied'); return; }

      view('app');
      const [{ data: l }, { data: e }] = await Promise.all([
        sb.from('ph_leads').select('*').order('created_at', { ascending: false }).limit(1000),
        sb.from('ph_emails').select('*').order('scheduled_for', { ascending: true }).limit(4000),
      ]);
      leads = l ?? [];
      emailsByLead = new Map();
      for (const row of e ?? []) {
        if (!emailsByLead.has(row.lead_id)) emailsByLead.set(row.lead_id, []);
        emailsByLead.get(row.lead_id).push(row);
      }
      renderStats(e ?? []);
      renderList();
    }

    function renderStats(allEmails) {
      const now = Date.now();
      const set = (k, v) => ($(`[data-stat="${k}"]`).textContent = String(v));
      set('upcoming', leads.filter((l) => l.appointment_start && new Date(l.appointment_start) > now).length);
      set('bookings', leads.filter((l) => l.kind === 'booking').length);
      set('forms', leads.filter((l) => l.kind === 'form').length);
      set('emails', allEmails.filter((e) => e.status === 'sent').length);
      set('queued', allEmails.filter((e) => e.status === 'pending').length);
    }

    function visible() {
      const now = Date.now();
      return leads.filter((l) => {
        if (filter === 'booking' && l.kind !== 'booking') return false;
        if (filter === 'form' && l.kind !== 'form') return false;
        if (filter === 'upcoming' && !(l.appointment_start && new Date(l.appointment_start) > now)) return false;
        if (!query) return true;
        return [l.first_name, l.last_name, l.email, l.phone].join(' ').toLowerCase().includes(query);
      });
    }

    function renderList() {
      const list = $('.ad-list');
      const rows = visible();
      if (!rows.length) {
        list.innerHTML = '<div class="ad-empty ad-muted">Nothing here yet.</div>';
        return;
      }
      const now = Date.now();
      list.innerHTML = rows
        .map((l) => {
          const upcoming = l.appointment_start && new Date(l.appointment_start) > now;
          const tag = l.kind === 'booking'
            ? `<span class="ad-tag ${upcoming ? 'booking' : 'past'}">${upcoming ? 'Upcoming' : 'Booking'}</span>`
            : '<span class="ad-tag form">Inquiry</span>';
          const when = l.appointment_start
            ? `${fmtDateTime(l.appointment_start)}<small>appointment</small>`
            : `${fmtDateTime(l.created_at)}<small>inquired</small>`;
          return `<button type="button" class="ad-row${selected === l.id ? ' is-on' : ''}" role="listitem" data-id="${l.id}">
            <span>
              <span class="ad-row-name">${tag}${esc(nameOf(l))}</span>
              <span class="ad-row-sub">${esc(l.email || '')}${l.phone ? ' · ' + esc(l.phone) : ''}</span>
              <span class="ad-row-owner${l.assigned_user_name ? '' : ' none'}">${ownerLabel(l)}</span>
            </span>
            <span class="ad-row-when">${when}</span>
          </button>`;
        })
        .join('');
      list.querySelectorAll('.ad-row').forEach((b) =>
        b.addEventListener('click', () => { selected = b.getAttribute('data-id'); renderList(); renderDetail(); }),
      );
    }

    function renderDetail() {
      const lead = leads.find((l) => l.id === selected);
      const empty = $('.ad-detail-empty');
      const body = $('.ad-detail-body');
      if (!lead) { empty.hidden = false; body.hidden = true; return; }
      empty.hidden = true; body.hidden = false;

      const answers = [
        ['Which best describes you', lead.role],
        ['Business structure', lead.structure],
        ['Current coverage', lead.coverage],
        ['What matters most', lead.priority],
        ['Notes', lead.notes],
      ].filter(([, v]) => v);

      const mails = emailsByLead.get(lead.id) ?? [];

      body.innerHTML = `
        <h2>${esc(nameOf(lead))}</h2>
        <p class="ad-muted">${lead.kind === 'booking' ? 'Booked a conversation' : 'Form inquiry'} · ${fmtFull(lead.created_at)}</p>

        <dl class="ad-kv">
          ${lead.email ? `<dt>Email</dt><dd><a href="mailto:${esc(lead.email)}">${esc(lead.email)}</a></dd>` : ''}
          ${lead.phone ? `<dt>Phone</dt><dd><a href="tel:${esc(String(lead.phone).replace(/\D/g, ''))}">${esc(lead.phone)}</a></dd>` : ''}
          ${lead.appointment_start ? `<dt>Appointment</dt><dd>${fmtFull(lead.appointment_start)}</dd>` : ''}
          ${lead.timezone ? `<dt>Their timezone</dt><dd>${esc(lead.timezone)}</dd>` : ''}
          ${lead.source_form ? `<dt>Source</dt><dd>${esc(lead.source_form)}</dd>` : ''}
          <dt>Assigned to</dt><dd>${lead.assigned_user_email
            ? `<a href="mailto:${esc(lead.assigned_user_email)}">${ownerLabel(lead)}</a>`
            : ownerLabel(lead)}${lead.owner_synced_at
            ? `<small class="ad-synced">checked ${fmtDateTime(lead.owner_synced_at)}</small>` : ''}</dd>
        </dl>

        ${answers.length ? `<div class="ad-sec"><h3>What they told us</h3>
          <dl class="ad-kv">${answers.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')}</dl>
        </div>` : ''}

        <div class="ad-sec">
          <h3>Emails (${mails.length})</h3>
          ${mails.length ? mails.map((m) => `
            <div class="ad-mail">
              <span class="ad-dot ${m.status}"></span>
              <span>
                <span class="ad-mail-kind">${MAIL_LABEL[m.kind] ?? m.kind}</span>
                <span class="ad-mail-sub">${m.status === 'sent' ? 'Delivered to Resend' : m.status === 'pending' ? 'Queued' : m.status === 'failed' ? esc(m.error || 'Failed') : esc(m.error || 'Skipped')}</span>
              </span>
              <span class="ad-mail-when">${fmtDateTime(m.sent_at || m.scheduled_for)}</span>
            </div>`).join('')
            : '<p class="ad-muted">No emails for this person.</p>'}
        </div>`;
    }

    // ---------- controls ----------
    $('.ad-search').addEventListener('input', (e) => { query = e.target.value.trim().toLowerCase(); renderList(); });
    $$('.ad-chip').forEach((c) =>
      c.addEventListener('click', () => {
        $$('.ad-chip').forEach((x) => x.classList.toggle('is-on', x === c));
        filter = c.getAttribute('data-filter');
        renderList();
      }),
    );
    $('.ad-refresh').addEventListener('click', load);

    // ---------- boot ----------
    sb.auth.getSession().then(({ data }) => {
      if (data.session) {
        $$('[data-who]').forEach((n) => (n.textContent = data.session.user.email));
        load();
      } else {
        view('signin');
      }
    });

    sb.auth.onAuthStateChange((event, session) => {
      if (event === 'SIGNED_IN' && session) {
        $$('[data-who]').forEach((n) => (n.textContent = session.user.email));
        load();
      }
    });
  }
</script>
