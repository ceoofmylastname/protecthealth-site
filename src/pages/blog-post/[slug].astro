---
import Base from '../../layouts/Base.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE, ORG_ID, BLOG_ART, breadcrumbSchema, speakableSchema, authorFor, personSchema, personId, citationsFrom } from '../../lib/site';
import AuthorByline from '../../components/AuthorByline.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const pageUrl = `${SITE.domain}/blog-post/${post.id}`;

// Funnel CTA target: MOFU/TOFU posts route toward the cluster's BOFU terminus.
const CLUSTER_BOFU: Record<string, { url: string; label: string; line: string }> = {
  ichra: {
    url: '/self-employed',
    label: 'Book A Strategy Conversation',
    line: 'Self-employed and wondering which of these options fit how your business is structured? That is exactly what a 20-minute ProtectHealth strategy conversation figures out.',
  },
  employers: {
    url: '/employers',
    label: 'Book An Employer Strategy Conversation',
    line: 'Running a business with employees? ProtectHealth has officially partnered with Paychex. One conversation covers benefits, payroll, HR, and the whole employer picture.',
  },
  'nevada-core': {
    url: '/contact-us',
    label: 'Talk To A Broker',
    line: 'Coverage questions are personal. A free 20-minute conversation with a ProtectHealth broker gets you real answers built on your actual situation.',
  },
  life: {
    url: '/services/life-insurance',
    label: 'Explore Life Insurance Strategy',
    line: 'The right life insurance answer depends on income, debts, and the people counting on you. ProtectHealth builds the strategy first, then matches the policy.',
  },
  'dental-vision': {
    url: '/services/dental-insurance',
    label: 'Explore Dental & Vision Coverage',
    line: 'Dental and vision coverage either pays for itself or it does not, the math depends on your situation. A quick ProtectHealth conversation runs the numbers with you.',
  },
  medicare: {
    url: '/services/medicare',
    label: 'Get Medicare Guidance',
    line: 'Medicare decisions made at 65 follow you for decades. A free conversation with a ProtectHealth broker maps the choice before the deadlines make it for you.',
  },
};
const cta = CLUSTER_BOFU[d.cluster];

// Byline is assigned by cluster, i.e. by subject expertise. See CLUSTER_AUTHOR
// in site.ts for why it is not round-robin.
const byline = authorFor(d.cluster);

// Child Q&A lookup moved into RelatedContent, which now owns the related block.

// Per-post share card. Every post has its own art in BLOG_ART; falling back to
// og-default meant 110 content pages all shared one generic card on Facebook,
// LinkedIn, iMessage and Slack. PNG, not the WebP: several social scrapers
// still will not render a WebP og:image.
const ogImage = BLOG_ART[post.id] ? BLOG_ART[post.id].png : undefined;

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  inLanguage: 'en-US',
  datePublished: d.datePublished,
  // E-E-A-T: a named licensed broker authors the pillar, the agency publishes it.
  // The Person is emitted once per page as its own node (see `schemas` below)
  // and referenced here by @id, so there is exactly one Person entity to match.
  author: { '@id': personId(byline.slug) },
  publisher: { '@id': ORG_ID },
  image: { '@type': 'ImageObject', url: BLOG_ART[post.id]?.png ?? `${SITE.domain}/assets/og-default.webp` },
};
// dateModified only when content genuinely changed (wiki: date-modified-schema)
if (d.dateModified) articleSchema.dateModified = d.dateModified;
// Mirror the visible Sources section into the schema (same body links).
const citation = citationsFrom(post.body);
if (citation) articleSchema.citation = citation;

const schemas = [
  articleSchema,
  // Standalone Person node. BlogPosting.author points at it by @id above.
  { '@context': 'https://schema.org', ...personSchema(byline) },
  speakableSchema(pageUrl),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Blog', url: `${SITE.domain}/blog` },
    { name: d.title, url: pageUrl },
  ]),
];
---
<Base
  title={`${d.title} | ProtectHealth`}
  description={d.description}
  schemas={schemas}
  ogImage={ogImage}
  ogImageAlt={BLOG_ART[post.id]?.alt}
  article={{ publishedTime: d.datePublished, modifiedTime: d.dateModified, authorName: byline.name }}
>
  <section class="section">
    <div class="container article">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/blog">Blog</a> › <span>{d.title}</span>
      </nav>
      <span class="badge">{d.category}</span>
      <h1>{d.title}</h1>
      {/* Dates here, authorship in the byline card below. The meta line used to
          also print d.author ("ProtectHealth Team"), which read as a second,
          contradictory answer to who wrote the page now that a named broker
          carries the byline. The Organization is still the publisher in the
          JSON-LD. That is where the agency attribution belongs. */}
      <p class="meta">Published {d.datePublished}{d.dateModified ? ` · Updated ${d.dateModified}` : ''}</p>

      <AuthorByline author={byline} mode="author" />

      {BLOG_ART[post.id] && <div class="hero-img"><img src={BLOG_ART[post.id].webp} alt={BLOG_ART[post.id].alt} loading="eager" /></div>}

      <div id="ai-summary">{d.speakableText}</div>

      <div class="quick-answer">
        <h2>Quick Answer</h2>
        <ul>
          {d.quickAnswer.map((qa: string) => <li>{qa}</li>)}
        </ul>
      </div>

      <Content />

      <FAQSection faq={d.faq} pageUrl={pageUrl} />

      <div class="cta-band">
        <h2>What's the next step?</h2>
        <p>{cta.line}</p>
        <a href={cta.url} class="btn big" style="background:#fff;color:var(--navy);">{cta.label}</a>
      </div>

      {/* Related Reading sits BELOW the CTA, conversion first, education after.
          The old plain <ul> of child Q&A links lived above it and offered no
          related posts at all. Do not move this block up. */}
      <RelatedContent cluster={d.cluster} type="blog" currentId={post.id} />

      <p class="compliance-note">ProtectHealth brokers are insurance professionals, not tax professionals. Nothing on this page implies every self-employed person or business automatically qualifies for any specific structure. Eligibility depends on business structure, income, and household situation. When tax or business structure enters the conversation, a brief chat with a licensed tax professional is a make-sense next step.</p>
    </div>
  </section>
</Base>
